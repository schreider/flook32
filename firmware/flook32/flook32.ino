    float thermalCoolingRate;       // Скорость охлаждения по данным термальной модели (°C/сек)
    float thermalNoiseFloor;        // Уровень шума системы по данным термальной модели (°C)
    float thermalError;             // Средняя ошибка предсказания термальной модели (°C)
    uint32_t version;               // Версия снапшота (инкрементируется при каждом обновлении)
