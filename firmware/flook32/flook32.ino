    doc["tI"] = config.trendInterval;
    doc["hI"] = config.heapCheckInterval;
    doc["lW"] = config.loopWatchdogTimeout;
    doc["uD"] = config.udpDiscoveryTimeout;
    doc["dR"] = config.discoveryRetryInterval;
    doc["eL"] = config.enableLoopWatchdog;
    
    // ----- 3.13 Автоотключение по Moonraker -----
    doc["aSd"] = config.autoShutdownEnabled;
    doc["aSm"] = config.autoShutdownMinutes;
    doc["kIp"] = klipperStatus.detected ? klipperStatus.ip.toString() : "";
    
    // ----- 3.14 Термальная модель -----
    doc["tM"] = config.enableThermalModel;
    doc["tS"] = config.thermalModelSensitivity;
    doc["tC"] = config.thermalModelCheckInterval;
    doc["tL"] = config.thermalModelLogWarnings;
    
    // ----- 3.15 Аппаратные пины -----
    doc["pS"] = config.pinSsr;
    doc["pF"] = config.pinFan;
    doc["pW"] = config.pinWatchdog;
    doc["pO"] = config.pinOneWire;
    doc["pK"] = config.pinMaxSck;
    doc["pM"] = config.pinMaxSo;
    doc["pC"] = config.pinMaxCs;
    doc["pB"] = config.pinBuzzer;
    doc["pL"] = config.pinLed;
    doc["pBt"] = config.pinButton;
    
    // ----- 3.16 Интервалы защит -----
    doc["hC"] = config.heaterControlInterval;
    doc["fC"] = config.fanControlInterval;
    doc["rC"] = config.runawayCheckInterval;
    doc["uCc"] = config.unexpectedCheckInterval;
    doc["rAc"] = config.rateCheckInterval;
    
    // ----- 3.17 Адаптированные параметры -----
    doc["aPd"] = config.adaptationPerformed;
    doc["aTt"] = config.adaptationTimestamp;
    doc["aTg"] = config.adaptedTimeToTarget;
    doc["aHr"] = config.adaptedHeaterRiseRate;
    doc["aAr"] = config.adaptedAirRiseRate;
    doc["aCr"] = config.adaptedCoolingRate;
    doc["aNt"] = config.adaptedNoiseThreshold;
    doc["aUr"] = config.adaptedUnstableRange;
    doc["fEf"] = config.fanEffective;

     // ----- 3.17a Профиль нагрева -----
    doc["hPC"] = config.heatingProfileCount;
    doc["hPS"] = config.heatingProfileStartTemp;
    doc["hPT"] = config.heatingProfileTargetTemp;
    
    // ----- 3.18 Автоограничение вентилятора -----
    doc["eFAL"] = config.enableFanAutoLimit;
    doc["fALH"] = config.fanAutoLimitHysteresis;
    doc["fALA"] = config.fanAutoLimitAdjustStep;
    doc["fALM"] = config.fanAutoLimitMinDuty;
    doc["fALI"] = config.fanAutoLimitCheckInterval;
    doc["fALS"] = config.fanAutoLimitStableCount;
    doc["fALAd"] = config.fanAutoLimitAdapted;
    
    // ----- 3.19 Зуммер -----
    doc["bE"] = config.buzzerEnabled;
    doc["bN"] = config.buzzerNonCriticalEnabled;
    doc["bM"] = config.buzzerMelody;
    
    // ========== 4. СОХРАНЕНИЕ В КЭШ ==========
    cachedConfigDoc.clear();                              // Очищаем старый кэш
    cachedConfigDoc = doc;                                // Копируем новый
    configCacheValid = true;
    configCacheTime = now;
    
    // ========== 5. ОТПРАВКА ОТВЕТА ==========
    AsyncResponseStream *response = request->beginResponseStream("application/json");
    response->addHeader("X-Cache", "MISS");               // Заголовок отладки кэша
    serializeJson(doc, *response);
    request->send(response);
}

// ========== GET /api/wifi/status - СТАТУС WI-FI ПОДКЛЮЧЕНИЯ ==========
// Возвращает SSID, IP адрес и уровень сигнала текущего подключения
// Вызывается: веб-интерфейсом для отображения сетевой информации
// Особенности:
//   - Использует статический буфер вместо конкатенации String (без фрагментации кучи)
//   - Не аллоцирует динамическую память (snprintf в стековый буфер)
void handleApiWifiStatus(AsyncWebServerRequest *request) {
    char json[128];
    snprintf(json, sizeof(json), 
             "{\"ssid\":\"%s\",\"ip\":\"%s\",\"rssi\":%d}",
             WiFi.SSID().c_str(),
             WiFi.localIP().toString().c_str(),
             WiFi.RSSI());
    request->send(200, "application/json", json);
}

// ========== GET /api/wifi/scan - СКАНИРОВАНИЕ ДОСТУПНЫХ WI-FI СЕТЕЙ ==========
// Запускает асинхронное сканирование или возвращает результат предыдущего
// При первом вызове: запускает WiFi.scanNetworks(true), возвращает {"scanning":true}
// При последующих: возвращает список сетей с SSID и RSSI
// Вызывается: веб-интерфейсом для отображения списка доступных сетей
// Особенности:
//   - Асинхронное сканирование (не блокирует веб-сервер)
//   - Ограничение на 10 сетей для предотвращения переполнения буфера
//   - Использует стековый буфер вместо String-конкатенации
void handleApiWifiScan(AsyncWebServerRequest *request) {
    int n = WiFi.scanComplete();                    // Проверяем статус сканирования
    
    // ----- СЛУЧАЙ 1: СКАНИРОВАНИЕ ЕЩЁ НЕ ЗАПУЩЕНО -----
    if (n == -2) {                                  // WIFI_SCAN_RUNNING = -2
        WiFi.scanNetworks(true);                    // Запускаем асинхронное (true = не показывать скрытые)
        request->send(200, "application/json", "{\"networks\":[],\"scanning\":true}");
        return;
    }
    
    // ----- СЛУЧАЙ 2: СКАНИРОВАНИЕ ЕЩЁ ИДЁТ -----
    if (n == -1) {                                  // WIFI_SCAN_RUNNING = -1
        request->send(200, "application/json", "{\"networks\":[],\"scanning\":true}");
        return;
    }
    
    // ----- СЛУЧАЙ 3: СКАНИРОВАНИЕ ЗАВЕРШЕНО -----
    // Ограничиваем количество сетей для предотвращения переполнения буфера
    const int maxNetworks = (n < 10) ? n : 10;      // Не больше 10 сетей в ответе
    
    // Формируем JSON в стековом буфере (без String-конкатенации)
    char json[1024];
    int pos = snprintf(json, sizeof(json), "{\"networks\":[");
    
    for (int i = 0; i < maxNetworks; i++) {
        // Экранируем SSID (может содержать кавычки или обратные слеши)
        String ssid = WiFi.SSID(i);
        ssid.replace("\\", "\\\\");                  // Экранируем обратный слеш
        ssid.replace("\"", "\\\"");                  // Экранируем кавычки
        
        pos += snprintf(json + pos, sizeof(json) - pos,
                       "%s{\"ssid\":\"%s\",\"rssi\":%d}",
                       (i > 0) ? "," : "",           // Запятая перед элементами кроме первого
                       ssid.c_str(),
                       WiFi.RSSI(i));
        
        // Защита от переполнения буфера
        if (pos >= (int)sizeof(json) - 50) break;    // 50 байт запас на закрывающие скобки
    }
    
    snprintf(json + pos, sizeof(json) - pos, "]}");
    WiFi.scanDelete();                               // Очищаем результаты сканирования
    
    request->send(200, "application/json", json);
}

// ========== GET /api/wifi/connect - ПОДКЛЮЧЕНИЕ К WI-FI СЕТИ ==========
// Сохраняет SSID и пароль в конфигурацию и подключается к указанной сети
// Параметры: ssid (обязательный), password (опциональный, для открытых сетей)
// Вызывается: веб-интерфейсом при первоначальной настройке или смене сети
// Особенности:
//   - Неблокирующее ожидание: использует vTaskDelay вместо delay
//   - Таймаут 10 секунд (20 попыток × 500 мс)
//   - Защита от вызова во время OTA-обновления
void handleApiWifiConnect(AsyncWebServerRequest *request) {
    // ----- 1. ВАЛИДАЦИЯ ПАРАМЕТРОВ -----
    if (!request->hasParam("ssid")) { 
        request->send(400, "application/json", "{\"success\":false,\"error\":\"SSID required\"}"); 
        return; 
    }
    
    String newSsid = request->getParam("ssid")->value();
    String newPassword = request->hasParam("password") ? request->getParam("password")->value() : "";
    
    if (newSsid.length() == 0) { 
        request->send(400, "application/json", "{\"success\":false,\"error\":\"SSID cannot be empty\"}"); 
        return; 
    }
    
    if (newSsid.length() > 31) {
        request->send(400, "application/json", "{\"success\":false,\"error\":\"SSID too long (max 31 chars)\"}");
        return;
    }
    
    // ----- 2. СОХРАНЕНИЕ В КОНФИГУРАЦИЮ -----
    strncpy(config.ssid, newSsid.c_str(), 31);
    config.ssid[31] = '\0';                          // Гарантированный нуль-терминатор
    strncpy(config.password, newPassword.c_str(), 63);
    config.password[63] = '\0';
    config.wifiConfigured = true;
    saveConfig();
    
    LOG_INFO("Подключение к Wi-Fi: %s", config.ssid);
    
    // ----- 3. ПОДКЛЮЧЕНИЕ С НЕБЛОКИРУЮЩИМ ОЖИДАНИЕМ -----
    wifiReconfigInProgress = true;
    WiFi.disconnect(true);
    delay(100);
    WiFi.begin(config.ssid, config.password);
    // Установка имени устройства в роутере (будет отображаться как "FLOOK32" вместо "esp32-XXXXXX")
    esp_netif_t *netif = esp_netif_get_handle_from_ifkey("WIFI_STA_DEF");
    if (netif) esp_netif_set_hostname(netif, "FLOOK32");
    
    const int maxAttempts = 20;                      // 20 попыток × 500 мс = 10 секунд таймаут
    bool connected = false;
    
    for (int i = 0; i < maxAttempts; i++) {
        if (WiFi.status() == WL_CONNECTED) { 
            connected = true; 
            break; 
        }
        vTaskDelay(pdMS_TO_TICKS(500));              // Неблокирующая задержка (FreeRTOS)
        esp_task_wdt_reset();                        // Сбрасываем WDT на случай долгого ожидания
    }
    
    wifiReconfigInProgress = false;
    
    // ----- 4. ОТВЕТ -----
    if (connected) {
        char json[128];
        snprintf(json, sizeof(json), 
                 "{\"success\":true,\"ip\":\"%s\",\"rssi\":%d}",
                 WiFi.localIP().toString().c_str(),
                 WiFi.RSSI());
        LOG_INFO("Wi-Fi подключён: %s", WiFi.localIP().toString().c_str());
        request->send(200, "application/json", json);
    } else {
        LOG_ERROR("Ошибка подключения к Wi-Fi: %s", config.ssid);
        request->send(400, "application/json", "{\"success\":false,\"error\":\"Connection failed after 10s\"}");
    }
}

// ========== POST /api/wifi/reset - СБРОС WI-FI НАСТРОЕК ==========
// Очищает сохранённые SSID и пароль, перезагружает устройство в режим точки доступа
// Вызывается: веб-интерфейсом для сброса сетевых настроек к заводским
// Особенности:
//   - После сброса ESP32 перезагружается и стартует в режиме AP (точка доступа)
void handleApiWifiReset(AsyncWebServerRequest *request) {
    // Очистка Wi-Fi настроек в конфигурации
    config.wifiConfigured = false;
    config.ssid[0] = '\0';                          // Пустая строка = сеть не настроена
    config.password[0] = '\0';
    saveConfig();                                   // Сохраняем в энергонезависимую память
    
    // Отправляем ответ ДО перезагрузки (после не успеем)
    request->send(200, "application/json", "{\"success\":true,\"message\":\"Wi-Fi reset, restarting in AP mode\"}");
    
    // Даём время на отправку ответа клиенту (WebSocket уведомление тоже успеет уйти)
    vTaskDelay(pdMS_TO_TICKS(1000));                // Неблокирующая задержка (FreeRTOS)
    ESP.restart();                                  // Перезагрузка → старт в режиме AP
}

// ========== GET /api/memory - СОСТОЯНИЕ ПАМЯТИ (HEAP) ==========
// Возвращает информацию о куче для диагностики утечек и фрагментации
// Вызывается: веб-интерфейсом для отладки, не чаще раза в 10 секунд
// Особенности:
//   - Защита от деления на ноль при вычислении фрагментации
//   - Возвращает также размер кучи, минимальный свободный блок и счётчик циклов
void handleApiMemory(AsyncWebServerRequest *request) {
    uint32_t freeHeap = ESP.getFreeHeap();              // Свободная куча (байт)
    uint32_t maxAlloc = ESP.getMaxAllocHeap();          // Максимальный непрерывный блок (байт)
    uint32_t heapSize = ESP.getHeapSize();              // Общий размер кучи (байт)
    uint32_t minFree = ESP.getMinFreeHeap();            // Минимальный уровень за всё время
    
    // Фрагментация = % памяти, которую нельзя аллоцировать одним блоком
    uint32_t fragmentation = 0;
    if (freeHeap > 0) {
        fragmentation = 100 - (maxAlloc * 100 / freeHeap);
    }
    
    char json[192];
    snprintf(json, sizeof(json),
             "{\"freeHeap\":%u,\"maxAlloc\":%u,\"heapSize\":%u,\"minFree\":%u,\"fragmentation\":%u}",
             freeHeap, maxAlloc, heapSize, minFree, fragmentation);
    
    request->send(200, "application/json", json);
    
    // Логируем в Serial если памяти критически мало
    if (freeHeap < LOW_MEMORY_THRESHOLD) {
        LOG_WARN("Низкая память: free=%u, maxBlock=%u, frag=%u%%", freeHeap, maxAlloc, fragmentation); 
    }
}

// ========== POST /api/config/defaults - СБРОС К ЗАВОДСКИМ НАСТРОЙКАМ ==========
// Сбрасывает все настройки к значениям по умолчанию, сохраняя Wi-Fi
// Wi-Fi настройки НЕ сбрасываются — устройство остаётся в сети после перезагрузки
// Вызывается: веб-интерфейсом для полного сброса конфигурации
// Особенности:
//   - Требует разблокировки настроек (если settingsLocked == true)
//   - Сбрасывает адаптацию, термальную модель и счётчики ошибок
//   - Отправляет уведомление в лог
void handleApiConfigDefaults(AsyncWebServerRequest *request) {
    // ----- 1. ПРОВЕРКА БЛОКИРОВКИ НАСТРОЕК -----
    if (config.settingsLocked) { 
        request->send(403, "application/json", "{\"error\":\"Settings are locked\"}"); 
        return; 
    }
    
    LOG_INFO("Сброс конфигурации к заводским настройкам (Wi-Fi сохранён)");
    addNotificationToLog("🔄 Сброс настроек к заводским (Wi-Fi сохранён)");
    
    // ----- 2. СОХРАНЕНИЕ WI-FI НАСТРОЕК -----
    // Копируем во временные переменные перед уничтожением структуры
    char savedSsid[32]; 
    char savedPassword[64]; 
    bool savedWifiConfigured = config.wifiConfigured;
    strncpy(savedSsid, config.ssid, 31);
    savedSsid[31] = '\0';
    strncpy(savedPassword, config.password, 63);
    savedPassword[63] = '\0';
    
    // ----- 3. СБРОС К ЗАВОДСКИМ ЗНАЧЕНИЯМ -----
    Config defaultConfig;                             // Конструктор по умолчанию = заводские значения
    config = defaultConfig;
    
    // ----- 4. ВОССТАНОВЛЕНИЕ WI-FI -----
    config.wifiConfigured = savedWifiConfigured;
    strncpy(config.ssid, savedSsid, 31);
    config.ssid[31] = '\0';
    strncpy(config.password, savedPassword, 63);
    config.password[63] = '\0';
    
    // ----- 5. СБРОС ЗАВИСИМЫХ ФЛАГОВ -----
    config.adaptationPerformed = false;               // Адаптация не пройдена
    config.adaptationTimestamp = 0;
    config.enableThermalModel = false;                // Модель требует адаптации → выключаем
    config.fanAutoLimitAdapted = false;               // Автоограничение тоже сброшено
    config.fanAutoLimitAdaptedTimestamp = 0;
    
    // ----- 6. СБРОС СЧЁТЧИКОВ ОШИБОК -----
    errors.clear();                                   // Очищаем все флаги и счётчики
    
    // ----- 7. СОХРАНЕНИЕ -----
    config.validate();                                // Приводим к допустимым диапазонам
    saveConfig();                                     // Сохраняем в энергонезависимую память
    configCacheValid = false;                         // Инвалидируем кэш API
    
    // Очищаем таблицу duty и термальную модель в Preferences
    Preferences prefs;
    prefs.begin("dutyTable", false);
    prefs.clear();
    prefs.end();
    
    prefs.begin("thermal", false);
    prefs.clear();
    prefs.end();
    
    // Сбрасываем обученную модель в RAM
    adaptiveModel.resetToAdaptation();
    dutyTableSize = 0;                                // Очищаем таблицу автоограничения
    
    // ----- 8. ОТВЕТ -----
    request->send(200, "application/json", "{\"success\":true}");
}

// ========== GET /api/error-log - ПОЛУЧЕНИЕ ЖУРНАЛА ОШИБОК ==========
// Возвращает массив записей ошибок с временными метками, уровнями серьёзности и трендами.
// Максимум MAX_ERROR_LOG (20) записей, отсортированных от новых к старым.
// Вызывается: веб-интерфейсом для отображения истории ошибок.
//
// ВАЖНО: Буфер 16KB объявлен static, чтобы размещаться в .bss-сегменте, а не на стеке.
// Стек webTask = 16KB, локальный char[16384] на стеке вызвал бы переполнение
// и падение прошивки (см. Guru Meditation / Stack canary).
// Экраннирование спецсимволов — ручное, без ArduinoJson, для скорости и экономии кучи.
// Критическая секция (errorLogMux) — только на время копирования вектора, не на всю функцию.
void handleApiErrorLog(AsyncWebServerRequest *request) {
    // ----- 1. КОПИРОВАНИЕ ЖУРНАЛА ИЗ КРИТИЧЕСКОЙ СЕКЦИИ -----
    // Быстро копируем вектор, чтобы не блокировать другие задачи.
    std::vector<ErrorLogEntry> copy;
    taskENTER_CRITICAL(&errorLogMux);
    copy = errorLog;
    taskEXIT_CRITICAL(&errorLogMux);
    
    // ----- 2. ПОСТРОЕНИЕ JSON ВРУЧНУЮ (БЕЗ ARDUINOJSON) -----
    // static: буфер живёт в .bss, не занимает стек. 16KB достаточно для 20 записей с трендами.
    static char buffer[16384];
    int offset = snprintf(buffer, sizeof(buffer), "[");   // Начало массива JSON
    
    size_t maxEntries = min(copy.size(), (size_t)MAX_ERROR_LOG);
    
    for (size_t i = 0; i < maxEntries; i++) {
        const auto& entry = copy[i];
        
        // Проверка, что влезает ещё минимум одна запись (~200 байт с запасом).
        if (offset > (int)sizeof(buffer) - 500) {
            LOG_WARN("Журнал ошибок обрезан на записи %u/%u", i, maxEntries);
            break;
        }
        
        // Запятая между элементами массива (кроме первого).
        if (i > 0) buffer[offset++] = ',';
        
        // Временная метка в секундах от запуска устройства.
        offset += snprintf(buffer + offset, sizeof(buffer) - offset,
                          "{\"ts\":%lu,\"msg\":\"",
                          (unsigned long)(entry.timestamp / 1000));
        
        // Экранирование сообщения об ошибке: кавычки и обратные слеши.
        for (size_t j = 0; j < entry.message.length() && offset < (int)sizeof(buffer) - 10; j++) {
            char c = entry.message[j];
            if (c == '"' || c == '\\') buffer[offset++] = '\\';
            buffer[offset++] = c;
        }
        
        // Уровень серьёзности: critical, warning или info.
        const char* severity = entry.isCritical ? "critical" : 
                               (entry.errorCount > 1 ? "warning" : "info");
        
        // Счётчик повторений (минимум 1).
        int count = entry.errorCount > 0 ? entry.errorCount : 1;
        
        offset += snprintf(buffer + offset, sizeof(buffer) - offset,
                          "\",\"sev\":\"%s\",\"count\":%d",
                          severity, count);
        
        // Тренды — только для критических ошибок и если данные влезают в 3000 символов.
        if (entry.trendData.length() > 0 && entry.trendData.length() < 3000) {
            offset += snprintf(buffer + offset, sizeof(buffer) - offset, ",\"td\":\"");
            
            // Экранирование: кавычки, бэкслеши, переводы строк, табуляции.
            for (size_t j = 0; j < entry.trendData.length() && offset < (int)sizeof(buffer) - 10; j++) {
                char c = entry.trendData[j];
                if (c == '"' || c == '\\') buffer[offset++] = '\\';
                else if (c == '\n') { buffer[offset++] = '\\'; buffer[offset++] = 'n'; }
                else if (c == '\r') { buffer[offset++] = '\\'; buffer[offset++] = 'r'; }
                else if (c == '\t') { buffer[offset++] = '\\'; buffer[offset++] = 't'; }
                else buffer[offset++] = c;
            }
            buffer[offset++] = '"';
        }
        
        buffer[offset++] = '}';   // Закрываем объект записи
    }
    
    offset += snprintf(buffer + offset, sizeof(buffer) - offset, "]");   // Закрываем массив
    
    // ----- 3. ОТПРАВКА ОТВЕТА -----
    AsyncWebServerResponse *response = request->beginResponse(200, "application/json", buffer);
    response->addHeader("Cache-Control", "no-cache, no-store, must-revalidate");
    request->send(response);
}

// ========== POST /api/error-log/clear - ОЧИСТКА ЖУРНАЛА ОШИБОК ==========
// Полностью очищает журнал ошибок и сбрасывает переменные дедупликации
// Вызывается: веб-интерфейсом для сброса истории ошибок
// Особенности:
//   - Критическая секция защищает вектор от одновременного доступа
//   - Сбрасывает также флаги логирования ошибок (можно логировать заново)
//   - Отправляет уведомление в очищенный журнал
void handleApiErrorLogClear(AsyncWebServerRequest *request) {
    taskENTER_CRITICAL(&errorLogMux);
    
    errorLog.clear();                                 // Очищаем вектор записей
    errorLog.shrink_to_fit();                         // Освобождаем память вектора
    
    // Сбрасываем переменные дедупликации (чтобы ошибки логировались заново)
    lastErrorMessage = "";
    lastErrorTime = 0;
    lastErrorHash = 0;
    
    taskEXIT_CRITICAL(&errorLogMux);
    
    // Сбрасываем флаги логирования в структуре ошибок
    errors.criticalOverheatLogged = false;
    errors.airOverheatLogged = false;
    errors.thermalRunawayLogged = false;
    errors.unexpectedHeatLogged = false;
    errors.max6675DisconnectedLogged = false;
    errors.ds18b20DisconnectedLogged = false;
    errors.max6675StuckLogged = false;
    errors.max6675NoiseLogged = false;
    errors.max6675OutOfRangeLogged = false;
    errors.max6675UnstableLogged = false;
    errors.airSensorNoiseLogged = false;
    errors.airSensorOutOfRangeLogged = false;
    errors.airSensorUnstableLogged = false;
    
    // Добавляем запись о том что журнал очищен
    addNotificationToLog("🗑️ Журнал ошибок очищен");
    
    request->send(200, "application/json", "{\"success\":true}");
}

// ========== POST /api/target?value=XX - УСТАНОВКА ЦЕЛЕВОЙ ТЕМПЕРАТУРЫ ==========
// Устанавливает целевую температуру воздуха в градусах Цельсия
// При установке 0 — нагрев выключается, блокировки снимаются
// При установке >0 — сбрасываются флаги Thermal Runaway и Unexpected Heat
// Диапазон: TEMP_MIN (0) до min(TEMP_MAX, config.maxAirTemp)
// Вызывается: веб-интерфейсом, Moonraker (через GCODE M141)
// Особенности:
//   - Сохраняет цель в Preferences для восстановления после перезагрузки
//   - При положительной цели сбрасывает критические ошибки нагрева
//   - Инвалидирует кэш снапшота для немедленного отображения в API
void handleApiTarget(AsyncWebServerRequest *request) {
    // ----- 1. ВАЛИДАЦИЯ ПАРАМЕТРОВ -----
    if (!request->hasParam("value")) {
        request->send(400, "application/json", "{\"error\":\"Missing 'value' parameter\"}");
        return;
    }
    
    float newTarget = request->getParam("value")->value().toFloat();
    float maxAllowed = min((float)TEMP_MAX, config.maxAirTemp);
    
    // Проверка диапазона
    if (newTarget < TEMP_MIN || newTarget > maxAllowed) {
        char err[64];
        snprintf(err, sizeof(err), "{\"error\":\"Value must be %.0f..%.0f\"}", 
                 (float)TEMP_MIN, maxAllowed);
        request->send(400, "application/json", err);
        return;
    }
    
    // ----- 2. УСТАНОВКА ЦЕЛИ -----
    float oldTarget = targetTemp;
    targetTemp = newTarget;
    
    // Логирование изменения
    if (newTarget > 0 && oldTarget != newTarget) {
        LOG_INFO("Целевая температура: %.1f°C (было %.1f°C)", newTarget, oldTarget);
    } else if (newTarget == 0 && oldTarget > 0) {
        LOG_INFO("Нагрев выключен (цель снята)");
        addNotificationToLog("🌡️ Нагрев выключен");
    }
    
    // ----- 3. СОХРАНЕНИЕ В PREFERENCES -----
    Preferences prefs;
    if (prefs.begin("flook", false)) {
        prefs.putFloat("lastTarget", newTarget > 0 ? newTarget : 0.0f);
        prefs.end();
    }
    
    // ----- 4. СБРОС ОШИБОК ПРИ НОВОЙ ЦЕЛИ -----
    if (newTarget > 0) {
        // Сброс Thermal Runaway (новая цель = новый цикл нагрева)
        runawayTriggered = false;
        runawayMonitoring = false;
        errors.thermalRunaway = false;
        errors.thermalRunawayLogged = false;
        
        // Сброс Unexpected Heat (пользователь явно хочет нагрев)
        errors.unexpectedHeat = false;
        errors.unexpectedHeatLogged = false;
        unexpectedHeatDetected = false;

        // Сброс Термальной модели (пользователь явно хочет нагрев)
        errors.thermalModelAnomaly = false;
        errors.thermalModelAnomalyLogged = false;        
        
        // Сброс таймера бездействия
        resetActivityTimer();
    }
    
    // ----- 5. ИНВАЛИДАЦИЯ КЭША -----
    configCacheValid = false;                         // Конфиг мог измениться
    
    // ----- 6. ОТВЕТ -----
    char json[64];
    snprintf(json, sizeof(json), "{\"success\":true,\"target\":%.1f}", targetTemp);
    request->send(200, "application/json", json);
}

// ========== POST /api/heater-off - ПРИНУДИТЕЛЬНОЕ ВЫКЛЮЧЕНИЕ НАГРЕВА ==========
// Немедленно выключает SSR, сбрасывает целевую температуру и ошибки нагрева
// Вызывается: кнопка аварийной остановки в веб-интерфейсе, M-code аварийного выключения
// Особенности:
//   - Сбрасывает ВСЕ флаги ошибок нагрева (Runaway, Unexpected Heat, перегревы)
//   - Сохраняет состояние в Preferences для восстановления после перезагрузки
//   - Не разблокирует систему (если была полная блокировка)
void handleApiHeaterOff(AsyncWebServerRequest *request) {
    // ----- 1. НЕМЕДЛЕННОЕ ОТКЛЮЧЕНИЕ SSR -----
    digitalWrite(config.pinSsr, config.invertHeaterSignal ? HIGH : LOW);
    heaterState = false;
    targetTemp = 0;
    
    LOG_INFO("Принудительное выключение нагрева (heaterTemp=%.1f°C)", heaterTemp);
    addNotificationToLog("🛑 Нагрев принудительно выключен");
    
    // ----- 2. СБРОС ВСЕХ ОШИБОК НАГРЕВА -----
    // Thermal Runaway
    runawayTriggered = false;
    runawayMonitoring = false;
    errors.thermalRunaway = false;
    errors.thermalRunawayLogged = false;
    errors.thermalRunawayLockTime = 0;
    
    // Unexpected Heat
    unexpectedHeatDetected = false;
    unexpectedHeatStart = 0;
    errors.unexpectedHeat = false;
    errors.unexpectedHeatLogged = false;
    errors.unexpectedHeatLockTime = 0;

    // Термальная модель
    errors.thermalModelAnomaly = false;
    errors.thermalModelAnomalyLogged = false;
    
    // Перегрев нагревателя
    criticalOverheatLock = false;
    
    // Перегрев воздуха
    airOverheatLock = false;
    
    // Счётчики (не сбрасываем — система помнит историю, но не блокирует)
    
    // ----- 3. СНЯТИЕ ФОРСИРОВАНИЯ ВЕНТИЛЯТОРА -----
    restoreFanNormalMode();
    
    // ----- 4. СБРОС ПРОГРЕСС-БАРА LED -----
    ledState.progress = 0;
    ledState.smoothProgress = 0;
    
    // ----- 5. СОХРАНЕНИЕ В PREFERENCES -----
    Preferences prefs;
    if (prefs.begin("flook", false)) {
        prefs.putFloat("lastTarget", 0.0f);
        prefs.end();
    }
    
    // ----- 6. ОТВЕТ -----
    char json[64];
    snprintf(json, sizeof(json), 
             "{\"success\":true,\"heaterTemp\":%.1f}", heaterTemp);
    request->send(200, "application/json", json);
}

// ========== POST /api/reboot - ПЕРЕЗАГРУЗКА ESP32 ==========
// Выполняет программную перезагрузку микроконтроллера
// Вызывается: веб-интерфейсом для перезагрузки системы
// Особенности:
//   - Отправляет ответ ДО перезагрузки (после не успеем)
//   - Неблокирующая задержка через vTaskDelay для отправки ответа
void handleApiReboot(AsyncWebServerRequest *request) {
    if (request->method() != HTTP_POST) {
        request->send(405, "application/json", "{\"error\":\"Method not allowed\"}");
        return;
    }
    
    LOG_INFO("Перезагрузка ESP32...");
    
    request->send(200, "application/json", "{\"success\":true,\"message\":\"Rebooting...\"}");
    
    // Даём время на отправку ответа клиенту
    vTaskDelay(pdMS_TO_TICKS(500));
    ESP.restart();
}

// ========== POST /api/reboot-all - ПЕРЕЗАГРУЗКА (АЛИАС) ==========
void handleApiRebootAll(AsyncWebServerRequest *request) {
    handleApiReboot(request);
}

// ========== POST /api/unlock?password=XX - РАЗБЛОКИРОВКА СИСТЕМЫ ==========
// Разблокирует систему после срабатывания критических защит
// Требуется пароль из конфигурации (по умолчанию "unlock")
// Вызывается: веб-интерфейсом после устранения причин блокировки
// Особенности:
//   - Сбрасывает полную блокировку и все флаги ошибок
//   - Восстанавливает нормальный режим вентилятора
//   - Сбрасывает LED в нормальный режим
void handleApiUnlock(AsyncWebServerRequest *request) {
    // ----- 1. ВАЛИДАЦИЯ -----
    if (!request->hasParam("password")) {
        request->send(400, "application/json", "{\"error\":\"Missing password\"}");
        return;
    }
    
    String password = request->getParam("password")->value();
    
    if (password != config.unlockPassword) {
        LOG_WARN("Неверная попытка разблокировки");
        request->send(403, "application/json", "{\"error\":\"Invalid password\"}");
        return;
    }
    
    // ----- 2. РАЗБЛОКИРОВКА -----
    LOG_INFO("Система разблокирована");
    addNotificationToLog("🔓 Система разблокирована пользователем");
    
    errors.unlockSystem();                            // Снимаем полную блокировку
    clearErrorFlags();                                // Сбрасываем все флаги ошибок
    
    // Сбрасываем дополнительные состояния
    criticalOverheatLock = false;
    airOverheatLock = false;
    runawayTriggered = false;
    runawayMonitoring = false;
    unexpectedHeatDetected = false;
    
    // Восстанавливаем нормальный режим вентилятора
    restoreFanNormalMode();
    
    // Сбрасываем LED в нормальный режим
    ledState.progress = 0;
    ledState.smoothProgress = 0;
    
    // ----- 3. ОТВЕТ -----
    request->send(200, "application/json", "{\"success\":true,\"message\":\"System unlocked\"}");
}

// ========== POST /api/lock-settings - БЛОКИРОВКА НАСТРОЕК ==========
// Запрещает изменение конфигурации через API до ввода пароля разблокировки
// Вызывается: веб-интерфейсом для защиты от случайных изменений
// Особенности:
//   - Сохраняет состояние в энергонезависимую память (переживёт перезагрузку)
//   - Блокировка не влияет на работу системы, только на изменение настроек
void handleApiLockSettings(AsyncWebServerRequest *request) {
    if (config.settingsLocked) {
        request->send(200, "application/json", "{\"success\":true,\"message\":\"Already locked\"}");
        return;
    }
    
    config.settingsLocked = true;
    saveConfig();
    
    LOG_INFO("Настройки заблокированы");
    addNotificationToLog("🔒 Изменение настроек заблокировано");
    
    request->send(200, "application/json", "{\"success\":true,\"message\":\"Settings locked\"}");
}

// ========== POST /api/unlock-settings?password=XX - РАЗБЛОКИРОВКА НАСТРОЕК ==========
// Разрешает изменение конфигурации после ввода правильного пароля
// Пароль должен совпадать с config.unlockPassword
// Вызывается: веб-интерфейсом для разблокировки кнопки "Сохранить настройки"
void handleApiUnlockSettings(AsyncWebServerRequest *request) {
    // ----- 1. ВАЛИДАЦИЯ -----
    if (!request->hasParam("password")) {
        request->send(400, "application/json", "{\"error\":\"Missing password\"}");
        return;
    }
    
    String password = request->getParam("password")->value();
    
    if (password != config.unlockPassword) {
        request->send(403, "application/json", "{\"error\":\"Invalid password\"}");
        return;
    }
    
    // ----- 2. РАЗБЛОКИРОВКА -----
    if (!config.settingsLocked) {
        request->send(200, "application/json", "{\"success\":true,\"message\":\"Already unlocked\"}");
        return;
    }
    
    config.settingsLocked = false;
    saveConfig();
    
    LOG_INFO("Настройки разблокированы");
    addNotificationToLog("🔓 Настройки разблокированы");
    
    request->send(200, "application/json", "{\"success\":true,\"message\":\"Settings unlocked\"}");
}

// ========== POST /api/adapt/start?target=XX - ЗАПУСК АДАПТАЦИИ ==========
// Запускает процесс самонастройки системы с указанной целевой температурой
// Диапазон: 40-70°C (оптимально для камеры 3D-принтера)
// Вызывается: веб-интерфейсом перед первым использованием или после смены камеры
// Особенности:
//   - Проверяет что адаптация ещё не запущена
//   - Проверяет готовность системы (датчики, отсутствие ошибок)
//   - Возвращает причину отказа если запуск невозможен
void handleApiStartAdaptation(AsyncWebServerRequest *request) {
    // ----- 1. ВАЛИДАЦИЯ -----
    if (!request->hasParam("target")) {
        request->send(400, "application/json", "{\"error\":\"Missing 'target' parameter\"}");
        return;
    }
    
    float target = request->getParam("target")->value().toFloat();
    
    if (target < 40.0f || target > 70.0f) { 
        char err[64];
        snprintf(err, sizeof(err), "{\"error\":\"Target must be 40..70°C, got %.1f\"}", target);
        request->send(400, "application/json", err);
        return;
    }
    
    // ----- 2. ПРОВЕРКА СОСТОЯНИЯ -----
    if (adaptationInProgress) {
        request->send(409, "application/json", "{\"error\":\"Adaptation already in progress\"}");
        return;
    }
    
    if (errors.isSystemLocked()) {
        request->send(423, "application/json", "{\"error\":\"System is locked, unlock first\"}");
        return;
    }
    
    // ----- 3. ЗАПУСК -----
    LOG_INFO("Запуск адаптации с целью %.1f°C", target);
    addNotificationToLog("🧪 Адаптация запущена (цель " + String(target, 1) + "°C)");
    
    startAdaptation(target);
    
    char json[64];
    snprintf(json, sizeof(json), "{\"success\":true,\"target\":%.1f}", target);
    request->send(200, "application/json", json);
}

// ========== POST /api/adapt/abort - ПРЕРЫВАНИЕ АДАПТАЦИИ ==========
// Останавливает процесс адаптации, выключает нагрев, возвращает систему в нормальный режим
// Вызывается: веб-интерфейсом для ручной остановки самонастройки
// Особенности:
//   - Безопасно даже если адаптация не запущена (no-op)
//   - Сбрасывает прогресс LED и восстанавливает нормальную индикацию
void handleApiAbortAdaptation(AsyncWebServerRequest *request) {
    if (!adaptationInProgress) {
        request->send(200, "application/json", "{\"success\":true,\"message\":\"No adaptation in progress\"}");
        return;
    }
    
    LOG_INFO("Адаптация прервана пользователем");
    addNotificationToLog("⏹️ Адаптация прервана");
    
    abortAdaptation();
    
    // Сбрасываем LED прогресс
    ledState.progress = 0;
    ledState.smoothProgress = 0;
    
    request->send(200, "application/json", "{\"success\":true,\"message\":\"Adaptation aborted\"}");
}

// ========== GET /api/adapt/status - СТАТУС АДАПТАЦИИ ==========
// Возвращает JSON с текущим состоянием процесса самонастройки
// Вызывается: веб-интерфейсом для отображения прогресс-бара адаптации
// Поля ответа:
//   - inProgress: активна ли адаптация
//   - phase: текущая фаза (0=IDLE, 8=COMPLETE, 9=FAILED)
//   - progress: прогресс в процентах (0-100)
//   - message: текстовое описание текущего шага
//   - blocked: заблокирован ли запуск (и причина)
//   - target: целевая температура адаптации
void handleApiAdaptationStatus(AsyncWebServerRequest *request) {
    // Экранирование сообщения для безопасного JSON
    String escapedMessage = adaptStatusMessage;
    escapedMessage.replace("\\", "\\\\");
    escapedMessage.replace("\"", "\\\"");
    escapedMessage.replace("\n", "\\n");
    escapedMessage.replace("\r", "");
    
    String blockedReason = adaptationBlockReason;
    blockedReason.replace("\\", "\\\\");
    blockedReason.replace("\"", "\\\"");
    
    char json[512];
    snprintf(json, sizeof(json),
        "{\"inProgress\":%s,\"phase\":%d,\"progress\":%d,"
        "\"message\":\"%s\",\"blocked\":%s,\"blockedReason\":\"%s\","
        "\"target\":%.1f}",
        adaptationInProgress ? "true" : "false",
        (int)currentAdaptPhase,
        adaptProgressPercent,
        escapedMessage.c_str(),
        adaptationBlocked ? "true" : "false",
        blockedReason.c_str(),
        adaptTargetTemp);
    
    request->send(200, "application/json", json);
}

// ========== POST /api/adapt/continue - ПРОДОЛЖИТЬ АДАПТАЦИЮ ПОСЛЕ ПОДГОТОВКИ ==========
// Подтверждает готовность пользователя и продолжает адаптацию
// Вызывается: нажатием кнопки "ПРОДОЛЖИТЬ" в веб-интерфейсе после:
//   - Опускания стола принтера в нижнее положение
//   - Включения нагрева стола до 100-110°C
//   - Закрытия камеры для минимизации теплопотерь
// Особенности:
//   - Работает только на фазе ADAPT_WAITING_USER
//   - Включает нагрев камеры (SSR) для следующей фазы
//   - Сбрасывает таймер ожидания пользователя
void handleApiAdaptContinue(AsyncWebServerRequest *request) {
    // ----- 1. ПРОВЕРКА СОСТОЯНИЯ -----
    if (!adaptationInProgress) {
        request->send(400, "application/json", "{\"error\":\"No adaptation in progress\"}");
        return;
    }
    
    if (currentAdaptPhase != ADAPT_WAITING_USER) {
        request->send(400, "application/json", "{\"error\":\"Not waiting for user, current phase: " + String((int)currentAdaptPhase) + "\"}");
        return;
    }
    
    // ----- 2. ПЕРЕХОД К СЛЕДУЮЩЕЙ ФАЗЕ -----
    LOG_INFO("Адаптация: пользователь подтвердил готовность, фаза HEATING_PHASE2");
    
    adaptWaitingForUser = false;
    adaptUserWaitStartTime = 0;
    currentAdaptPhase = ADAPT_HEATING_PHASE2;
    adaptPhaseStartTime = millis();
    
    // Включаем нагрев камеры
    digitalWrite(config.pinSsr, config.invertHeaterSignal ? LOW : HIGH);
    heaterState = true;
    adaptStats.heatingStartTime = millis();
    
    addNotificationToLog("✅ Продолжение адаптации...");
    addNotificationToLog("📢 ВНИМАНИЕ: НАГРЕВ СТОЛА ДОЛЖЕН ОСТАВАТЬСЯ ВКЛЮЧЁННЫМ!");
    
    // ----- 3. ОТВЕТ -----
    request->send(200, "application/json", "{\"success\":true,\"phase\":\"HEATING_PHASE2\"}");
}

// ========== GET /api/uptime - ВРЕМЯ РАБОТЫ УСТРОЙСТВА ==========
// Возвращает количество секунд с момента последней перезагрузки ESP32
// Вызывается: веб-интерфейсом для отображения аптайма
void handleApiUptime(AsyncWebServerRequest *request) {
    unsigned long seconds = (millis() - deviceStartTime) / 1000;
    unsigned long days = seconds / 86400;
    unsigned long hours = (seconds % 86400) / 3600;
    unsigned long minutes = (seconds % 3600) / 60;
    unsigned long secs = seconds % 60;
    
    char json[96];
    snprintf(json, sizeof(json),
        "{\"seconds\":%lu,\"formatted\":\"%lud %luh %lum %lus\"}",
        seconds, days, hours, minutes, secs);
    
    request->send(200, "application/json", json);
}

// ========== GET /api/target - ПОЛУЧЕНИЕ ЦЕЛЕВОЙ ТЕМПЕРАТУРЫ ==========
// Возвращает текущую целевую температуру в °C с одним знаком после запятой
// Вызывается: Moonraker для получения статуса, макросами GCODE
void handleApiGetTarget(AsyncWebServerRequest *request) {
    char json[16];
    snprintf(json, sizeof(json), "%.1f", targetTemp);
    request->send(200, "application/json", json);
}


// ========== GET /api/heater-state - СТАТУС НАГРЕВАТЕЛЯ ==========
// Возвращает "1" если нагреватель включён, "0" если выключен
// Вызывается: Moonraker для проверки состояния SSR
void handleApiGetHeaterState(AsyncWebServerRequest *request) { 
    request->send(200, "application/json", heaterState ? "1" : "0"); 
}


// ========== GET /api/fan-state - СТАТУС ВЕНТИЛЯТОРА ==========
// Возвращает "1" если вентилятор вращается, "0" если остановлен
// Вызывается: Moonraker для проверки состояния вентилятора
void handleApiGetFanState(AsyncWebServerRequest *request) { 
    request->send(200, "application/json", fanState ? "1" : "0"); 
}

// ========== POST /api/thermal-model/reset - СБРОС ТЕРМАЛЬНОЙ МОДЕЛИ ==========
// Сбрасывает обученные коэффициенты модели к исходным значениям из адаптации
// Требует разблокировки настроек (config.settingsLocked == false)
// Вызывается: если модель "переобучилась" и даёт ложные срабатывания
void handleApiResetThermalModel(AsyncWebServerRequest *request) {
    if (config.settingsLocked) { 
        request->send(423, "application/json", "{\"error\":\"Settings are locked\"}"); 
        return; 
    }
    
    if (!config.adaptationPerformed) {
        request->send(400, "application/json", "{\"error\":\"Adaptation not performed, model has no baseline\"}");
        return;
    }
    
    LOG_INFO("Сброс термальной модели к значениям адаптации");
    addNotificationToLog("🔄 Термальная модель сброшена");
    
    resetThermalModel();
    request->send(200, "application/json", "{\"success\":true,\"message\":\"Model reset to adaptation baseline\"}");
}

// ========== POST /api/calibrate-max6675?temp=XX - КАЛИБРОВКА MAX6675 ==========
// Выполняет калибровку термопары по эталонной температуре
// Параметры: temp — эталонная температура в °C (измеренная внешним термометром)
// Вызывается: после установки нагревателя, при обнаружении расхождения показаний
// Особенности:
//   - Требует разблокировки настроек
//   - Проверяет что датчик подключён
//   - Сохраняет новое смещение в конфигурацию
void handleApiCalibrateMAX6675(AsyncWebServerRequest *request) {
    // ----- 1. ПРОВЕРКА БЛОКИРОВКИ -----
    if (config.settingsLocked) {
        request->send(423, "application/json", "{\"error\":\"Settings are locked\"}");
        return;
    }
    
    // ----- 2. ВАЛИДАЦИЯ -----
    if (!request->hasParam("temp")) {
        request->send(400, "application/json", "{\"error\":\"Missing 'temp' parameter\"}");
        return;
    }
    
    float refTemp = request->getParam("temp")->value().toFloat();
    
    if (refTemp < 0.0f || refTemp > 400.0f) {
        char err[64];
        snprintf(err, sizeof(err), "{\"error\":\"Reference temp must be 0..400°C, got %.1f\"}", refTemp);
        request->send(400, "application/json", err);
        return;
    }
    
    if (errors.max6675Disconnected) {
        request->send(400, "application/json", "{\"error\":\"MAX6675 disconnected, cannot calibrate\"}");
        return;
    }
    
    // ----- 3. КАЛИБРОВКА -----
    LOG_INFO("Калибровка MAX6675 по эталону %.1f°C", refTemp);
    calibrateMAX6675(refTemp);
    
    char json[64];
    snprintf(json, sizeof(json), "{\"success\":true,\"offset\":%.2f}", config.max6675Offset);
    request->send(200, "application/json", json);
}

// ========== POST /api/moonraker-shutdown - НАСТРОЙКА MOONRAKER АВТООТКЛЮЧЕНИЯ ==========
// Настраивает автоотключение нагрева после завершения печати через Moonraker
// Параметры:
//   - enable: 0 или 1 (включить/выключить функцию)
//   - minutes: 5-120 (минут ожидания после печати перед отключением)
// Вызывается: веб-интерфейсом (Настройки → Moonraker)
void handleApiMoonrakerShutdown(AsyncWebServerRequest *request) {
    bool changed = false;
    
    // ----- 1. ВКЛЮЧЕНИЕ/ВЫКЛЮЧЕНИЕ -----
    if (request->hasParam("enable")) {
        bool enable = (request->getParam("enable")->value() == "1");
        if (config.autoShutdownEnabled != enable) {
            config.autoShutdownEnabled = enable;
            changed = true;
            LOG_INFO("Moonraker автоотключение: %s", enable ? "ВКЛ" : "ВЫКЛ");
        }
    }
    
    // ----- 2. ВРЕМЯ ОЖИДАНИЯ -----
    if (request->hasParam("minutes")) {
        int minutes = request->getParam("minutes")->value().toInt();
        if (minutes >= 5 && minutes <= 120) {  // Изменено: 5-120 минут (не 1-480)
            if (config.autoShutdownMinutes != minutes) {
                config.autoShutdownMinutes = minutes;
                changed = true;
                LOG_INFO("Moonraker таймер: %d мин", minutes);
            }
        } else {
            request->send(400, "application/json", "{\"error\":\"Minutes must be 5..120\"}");
            return;
        }
    }
    
    // ----- 3. СОХРАНЕНИЕ -----
    if (changed) {
        saveConfig();
        addNotificationToLog(config.autoShutdownEnabled ? 
            "🌙 Moonraker автоотключение включено (" + String(config.autoShutdownMinutes) + " мин после печати)" :
            "🌙 Moonraker автоотключение выключено");
    }
    
    char json[96];
    snprintf(json, sizeof(json),
        "{\"success\":true,\"enabled\":%s,\"minutes\":%d}",
        config.autoShutdownEnabled ? "true" : "false",
        config.autoShutdownMinutes);
    request->send(200, "application/json", json);
}

// ========== POST /api/manual-timer - РУЧНОЙ ТАЙМЕР ==========
// Запускает или останавливает ручной таймер отключения нагрева
// Параметры:
//   - enable: 0 или 1 (выключить/включить таймер)
//   - minutes: 30-600 (минут до отключения нагрева, только если enable=1)
// Вызывается: веб-интерфейсом (главный экран)
void handleApiManualTimer(AsyncWebServerRequest *request) {
    // ----- 1. ПРОВЕРКА ПАРАМЕТРОВ -----
    if (!request->hasParam("enable")) {
        request->send(400, "application/json", "{\"error\":\"Missing 'enable' parameter\"}");
        return;
    }
    
    bool enable = (request->getParam("enable")->value() == "1");
    
    // ----- 2. ОСТАНОВКА ТАЙМЕРА -----
    if (!enable) {
        manualTimerActive = false;
        manualTimerEndTime = 0;
        request->send(200, "application/json", "{\"success\":true,\"active\":false}");
        LOG_INFO("Ручной таймер остановлен");
        return;
    }
    
    // ----- 3. ЗАПУСК ТАЙМЕРА (нужны минуты) -----
    if (!request->hasParam("minutes")) {
        request->send(400, "application/json", "{\"error\":\"Missing 'minutes' parameter\"}");
        return;
    }
    
    int minutes = request->getParam("minutes")->value().toInt();
    
    // Валидация: от 30 до 600 минут (0.5 - 10 часов)
    if (minutes < 30 || minutes > 600) {
        request->send(400, "application/json", "{\"error\":\"Minutes must be 30-600\"}");
        return;
    }
    
    // Запускаем таймер
    manualTimerEndTime = millis() + (minutes * 60 * 1000UL);
    manualTimerActive = true;
    
    char json[128];
    snprintf(json, sizeof(json),
        "{\"success\":true,\"active\":true,\"minutes\":%d,\"endTime\":%lu}",
        minutes, manualTimerEndTime);
    request->send(200, "application/json", json);
    
    LOG_INFO("Ручной таймер запущен: %d минут, отключение в %lu", minutes, manualTimerEndTime);
}

// ============================================================================
// WEBSOCKET ФУНКЦИИ (REAL-TIME КОММУНИКАЦИЯ)
// ============================================================================

// ========== ОБРАБОТЧИК СОБЫТИЙ WEBSOCKET ==========
// Вызывается: при подключении, отключении клиента или получении данных
// Регистрируется: server.onEvent() в setup()
void onWebSocketEvent(AsyncWebSocket *server, AsyncWebSocketClient *client, 
                      AwsEventType type, void *arg, uint8_t *data, size_t len) {
    switch (type) {
        case WS_EVT_CONNECT:
            LOG_DEBUG("WebSocket клиент %u подключен", client->id());
            // Отправляем историю только если буфер не пуст
            if (trendIndex > 0 || trendBufferFilled) {
                // Небольшая задержка — даём старым соединениям закрыться
                vTaskDelay(100 / portTICK_PERIOD_MS);
                // Проверяем что клиент ещё подключен
                if (client->status() == WS_CONNECTED) {
                    sendHistoryToClient(client);
                }
            }
            break;
            
        case WS_EVT_DISCONNECT:
            LOG_DEBUG("WebSocket клиент %u отключен", client->id()); 
            break;
            
        case WS_EVT_DATA:
            handleWebSocketMessage(client, data, len); 
            break;
            
        default: 
            break;
    }
}

// ========== ОБРАБОТКА ВХОДЯЩИХ WEBSOCKET СООБЩЕНИЙ ==========
// Поддерживаемые команды:
// - "get_updates:<timestamp>" - запросить обновления с указанного времени
// - "get_history" - запросить полную историю
void handleWebSocketMessage(AsyncWebSocketClient *client, uint8_t *data, size_t len) {
    String message = String((char*)data).substring(0, len);
    
    if (message.startsWith("get_updates:")) { 
        unsigned long timestamp = message.substring(12).toInt(); 
        sendUpdatesSince(client, timestamp);
    }
    else if (message == "get_history") { 
        sendHistoryToClient(client);
    }
}

// ========== ОТПРАВКА МЕТРИК ВСЕМ ПОДКЛЮЧЁННЫМ КЛИЕНТАМ ==========
// Формирует компактный JSON с текущими показаниями
// Вызывается: controlTask() каждую секунду
// Содержит: температуры, состояния, uptime, статус Klipper, данные термальной модели
void sendMetricsToClients() {
    if (ws.count() == 0) return;     // Нет подключённых клиентов - не отправляем
    
    // Получаем снапшот из критической секции
    SystemSnapshot s;
    portENTER_CRITICAL(&snapshotMux);
    s = snapshot;
    portEXIT_CRITICAL(&snapshotMux);
    
    // Ручное построение JSON (быстрее чем ArduinoJson для частых обновлений)
    static char jsonBuffer[1024];    // Статический буфер (без динамической аллокации)
    int offset = 0;
    
    // Базовые метрики
    offset += snprintf(jsonBuffer + offset, sizeof(jsonBuffer) - offset,
                       "{\"type\":\"metrics\",\"a\":%.1f,\"h\":%.1f,\"tg\":%.1f,\"hs\":%d,\"fs\":%d,\"u\":%lu,\"fp\":%d",
                       s.airTemp, s.heaterTemp, s.targetTemp, 
                       heaterState ? 1 : 0, fanState ? 1 : 0, s.uptime, actualFanDuty);
    
    // Статус блокировки системы
    if (errors.isSystemLocked()) {
        offset += snprintf(jsonBuffer + offset, sizeof(jsonBuffer) - offset,
                          ",\"systemLocked\":1,\"lockMessage\":\"%s\"",
                          errors.getLockMessage().c_str());
    } else {
        offset += snprintf(jsonBuffer + offset, sizeof(jsonBuffer) - offset, ",\"systemLocked\":0");
    }
    
    // Статус Klipper (без String::toString — не фрагментирует кучу)
    if (s.klipperDetected) {
        char ipBuf[16];
        snprintf(ipBuf, sizeof(ipBuf), "%u.%u.%u.%u", 
                 klipperStatus.ip[0], klipperStatus.ip[1], 
                 klipperStatus.ip[2], klipperStatus.ip[3]);
        offset += snprintf(jsonBuffer + offset, sizeof(jsonBuffer) - offset,
                          ",\"klipper\":{\"detected\":1,\"ip\":\"%s\",\"lastSeen\":%lu,\"requestCount\":%lu}",
                          ipBuf,
                          (unsigned long)((millis() - klipperStatus.lastSeen) / 1000),
                          (unsigned long)klipperStatus.requestCount);
    } else {
        offset += snprintf(jsonBuffer + offset, sizeof(jsonBuffer) - offset,
                          ",\"klipper\":{\"detected\":0,\"ip\":\"0.0.0.0\",\"lastSeen\":0,\"requestCount\":0}");
    }
    
    // Данные термальной модели (если активна)
    offset += snprintf(jsonBuffer + offset, sizeof(jsonBuffer) - offset,
                      ",\"thermalEnabled\":%d", config.enableThermalModel ? 1 : 0);
    
    if (config.enableThermalModel && adaptiveModel.initialized) {
        offset += snprintf(jsonBuffer + offset, sizeof(jsonBuffer) - offset,
                          ",\"thermal\":{\"confidence\":%d,\"error\":%.2f,\"threshold\":%.2f,\"heaterRate\":%.1f,\"coolingRate\":%.2f}",
                          (int)(adaptiveModel.confidence * 100),
                          adaptiveModel.totalError / max(1, adaptiveModel.samplesCollected),
                          adaptiveModel.noiseFloor * 3 * config.thermalModelSensitivity,
                          adaptiveModel.heaterRate,
                          adaptiveModel.coolingRate);
    }
    
    // Статус Moonraker автоотключения
    offset += snprintf(jsonBuffer + offset, sizeof(jsonBuffer) - offset,
                      ",\"moonrakerShutdownActive\":%d,\"moonrakerShutdownMinutes\":%d}",
                      config.autoShutdownEnabled ? 1 : 0,
                      config.autoShutdownMinutes);
    
    // Отправляем всем подключённым клиентам
    ws.textAll(jsonBuffer);
}

// ============================================================================
// ОБНОВЛЕНИЕ СНАПШОТА ДЛЯ БЫСТРОГО API ОТВЕТА
// ============================================================================

// Формирует компактную структуру со всеми текущими состояниями системы
// Защищена мьютексом snapshotMux для безопасного доступа из разных задач
// Вызывается: controlTask() по таймеру (каждую секунду)
// Особенности:
//   - Не аллоцирует динамическую память (все поля на стеке или фиксированные)
//   - Критические секции минимальны (только копирование финальной структуры)
//   - IP адрес упаковывается в uint32_t для экономии места в JSON
void updateSnapshot() {
    SystemSnapshot s;                                      // Локальный экземпляр на стеке (быстро)
    
    // ========== ОСНОВНЫЕ ПАРАМЕТРЫ (БЕЗ КРИТИЧЕСКИХ СЕКЦИЙ — ЧИТАЕМ КАК ЕСТЬ) ==========
    s.targetTemp = targetTemp;                             // Целевая температура воздуха
    s.airTemp = airTemp;                                   // Текущая температура воздуха (DS18B20)
    s.heaterTemp = heaterTemp;                             // Текущая температура нагревателя (MAX6675)
    s.state = (heaterState ? 1 : 0) | (fanState ? 2 : 0);  // Бит0=нагрев, Бит1=вентилятор
    s.locked = errors.isSystemLocked() ? 1 : 0;            // Статус блокировки системы
    s.uptime = (millis() - deviceStartTime) / 1000;        // Аптайм в секундах
    
    // ========== СТАТУС KLIPPER (УПАКОВКА IP В UINT32) ==========
    s.klipperDetected = klipperStatus.detected ? 1 : 0;

    // ========== СТАТУС MOONRAKER ==========
    s.moonrakerDetected = (moonrakerHost.length() > 0) ? 1 : 0;
    
    if (klipperStatus.detected) {
        IPAddress ip = klipperStatus.ip;
        // Упаковка IP адреса в 32-битное целое: A.B.C.D → (A<<24)|(B<<16)|(C<<8)|D
        s.klipperIp = ((uint32_t)ip[0] << 24) | ((uint32_t)ip[1] << 16) | ((uint32_t)ip[2] << 8) | ip[3];
        s.klipperLastSeen = (millis() - klipperStatus.lastSeen) / 1000;   // Секунд с последнего ответа
        s.klipperRequestCount = klipperStatus.requestCount;               // Всего ответов получено
    } else {
        s.klipperIp = 0;
        s.klipperLastSeen = 0;
        s.klipperRequestCount = 0;
    }
    
    // ========== ТЕРМАЛЬНАЯ МОДЕЛЬ (ТОЛЬКО ЕСЛИ АКТИВНА) ==========
    if (config.enableThermalModel && adaptiveModel.initialized) {
        s.thermalConfidence = (uint8_t)(adaptiveModel.confidence * 100.0f + 0.5f);   // 0-100% с округлением
        s.thermalHeaterRate = adaptiveModel.heaterRate;                              // °C/мин
        s.thermalCoolingRate = adaptiveModel.coolingRate;                            // °C/сек
        s.thermalNoiseFloor = adaptiveModel.noiseFloor;                              // °C шума
        
        // Средняя ошибка за последние 10 измерений
        float avgError = 0;
        for (int i = 0; i < 10; i++) {
            avgError += adaptiveModel.recentErrors[i];
        }
        s.thermalError = avgError * 0.1f;            // Деление на 10 через умножение (быстрее)
    } else {
        // Модель не активна — заполняем нулями
        s.thermalConfidence = 0;
        s.thermalHeaterRate = 0;
        s.thermalCoolingRate = 0;
        s.thermalNoiseFloor = 0;
        s.thermalError = 0;
    }
    
    // ========== КОЛИЧЕСТВО КРИТИЧЕСКИХ ОШИБОК (ЗАЩИЩЕНО МЬЮТЕКСОМ) ==========
    s.errorCount = 0;
    taskENTER_CRITICAL(&errorLogMux);
    for (const auto& entry : errorLog) {
        if (entry.isCritical) {                     // Сравнение bool быстрее чем String
            s.errorCount++;
        }
    }
    taskEXIT_CRITICAL(&errorLogMux);
    
    s.version++;                                    // Инкремент версии для отслеживания изменений
    
    // ========== АТОМАРНОЕ СОХРАНЕНИЕ В ГЛОБАЛЬНЫЙ СНАПШОТ ==========
    portENTER_CRITICAL(&snapshotMux);
    memcpy(&snapshot, &s, sizeof(SystemSnapshot));  // Одно копирование вместо попарного присваивания
    portEXIT_CRITICAL(&snapshotMux);
}

// ============================================================================
// ОТПРАВКА ПОЛНОЙ ИСТОРИИ ТРЕНДОВ КЛИЕНТУ ПРИ ПОДКЛЮЧЕНИИ
// ============================================================================
// Вызывается: onWebSocketEvent() при событии WS_EVT_CONNECT
// Отправляет все накопленные данные трендов новому клиенту
// 
// ОСОБЕННОСТИ РЕАЛИЗАЦИИ:
// - Данные отправляются чанками (по 30 точек) для избежания переполнения
//   WebSocket-буфера и блокировки других задач
// - Используется StaticJsonDocument на стеке (4096 байт) — без фрагментации кучи
// - Сериализация в String напрямую, без промежуточного статического буфера
// - Критическая секция (trendBufferMux) защищает чтение кольцевого буфера,
//   но освобождается на время отправки каждого чанка
// - Между чанками вызывается vTaskDelay(10ms) для кооперативной многозадачности
// - Точки отправляются в хронологическом порядке (от старых к новым)
// - Дубликаты исключаются на стороне клиента (фильтрация по timestamp)
//
// РАСЧЁТ РАЗМЕРА ЧАНКА:
//   Одна точка в JSON: ~59 байт (с pred) или ~46 байт (без pred)
//   Заголовок чанка: ~60 байт
//   30 точек × 59 байт + 60 байт = 1830 байт — гарантированно влезает в 4096
//   600 точек / 30 = 20 чанков на всю историю
// ============================================================================
void sendHistoryToClient(AsyncWebSocketClient *client) {
    // ========== 1. ВХОД В КРИТИЧЕСКУЮ СЕКЦИЮ ==========
    // Защищаем trendBuffer от одновременной записи (из webTask) и чтения (здесь)
    taskENTER_CRITICAL(&trendBufferMux);
    
    // ========== 2. ОПРЕДЕЛЕНИЕ КОЛИЧЕСТВА ДОСТУПНЫХ ТОЧЕК ==========
    // Если буфер полностью заполнен (хотя бы один оборот) — используем весь размер
    // Если ещё не заполнен — берём только записанные точки (trendIndex)
    int totalCount = trendBufferFilled ? TREND_BUFFER_SIZE : trendIndex;
    
    // ========== 3. БЫСТРЫЙ ВЫХОД ПРИ ПУСТОМ БУФЕРЕ ==========
    if (totalCount == 0) {
        taskEXIT_CRITICAL(&trendBufferMux);  // Не забываем выйти из мьютекса!
        return;
    }
    
    // ========== 4. РАСЧЁТ КОЛИЧЕСТВА ЧАНКОВ ==========
    // CHUNK_SIZE = 30 подобрано так, чтобы JSON гарантированно влезал в 4096 байт
    // Формула: (totalCount + CHUNK_SIZE - 1) / CHUNK_SIZE — округление вверх
    const int CHUNK_SIZE = 30;
    int chunks = (totalCount + CHUNK_SIZE - 1) / CHUNK_SIZE;
    
    // ========== 5. ОСНОВНОЙ ЦИКЛ ОТПРАВКИ ЧАНКОВ ==========
    for (int chunk = 0; chunk < chunks; chunk++) {
        
        // ----- 5.1. СОЗДАНИЕ JSON ДОКУМЕНТА НА СТЕКЕ -----
        // StaticJsonDocument НЕ аллоцирует память в куче — живёт на стеке
        // 4096 байт достаточно для 30 точек + заголовок + запас
        StaticJsonDocument<4096> doc;
        
        // ----- 5.2. ЗАГОЛОВОК ЧАНКА -----
        doc["type"] = "history_chunk";   // Тип сообщения для WebSocket-клиента
        doc["chunk"] = chunk;            // Номер текущего чанка (0, 1, 2, ...)
        doc["total"] = chunks;           // Общее количество чанков
        
        // ----- 5.3. МАССИВ ДАННЫХ -----
        JsonArray data = doc.createNestedArray("data");
        
        // ----- 5.4. ГРАНИЦЫ ТЕКУЩЕГО ЧАНКА -----
        int start = chunk * CHUNK_SIZE;
        int end = min(start + CHUNK_SIZE, totalCount);  // Последний чанк может быть меньше
        
        // ----- 5.5. ЗАПОЛНЕНИЕ ЧАНКА ТОЧКАМИ ДАННЫХ -----
        // Точки отправляются в хронологическом порядке: от старых к новым
        // Это гарантирует, что клиент получит их в правильном порядке
        for (int i = start; i < end; i++) {
            
            // ----- 5.5.1. ВЫЧИСЛЕНИЕ ИНДЕКСА В КОЛЬЦЕВОМ БУФЕРЕ -----
            int idx;
            if (trendBufferFilled) {
                // Буфер заполнен полностью: читаем от старейшей точки (trendIndex)
                // по кругу. trendIndex указывает на СЛЕДУЮЩУЮ ячейку для записи,
                // значит старейшая точка лежит в trendIndex
                idx = (trendIndex + i) % TREND_BUFFER_SIZE;
            } else {
                // Буфер ещё не заполнен: точки лежат линейно от 0 до trendIndex-1
                idx = i;
            }
            
            // ----- 5.5.2. СОЗДАНИЕ ОБЪЕКТА ТОЧКИ -----
            JsonObject point = data.createNestedObject();
            
            // Временная метка в миллисекундах от запуска устройства
            point["t"] = trendBuffer[idx].timestamp;
            
            // Температуры с округлением до 0.1°C
            // round(x * 10) / 10.0f — быстрее чем snprintf("%.1f")
            point["a"]  = round(trendBuffer[idx].getAirTemp() * 10.0f) / 10.0f;
            point["h"]  = round(trendBuffer[idx].getHeaterTemp() * 10.0f) / 10.0f;
            point["tg"] = round(trendBuffer[idx].getTargetTemp() * 10.0f) / 10.0f;
            
            // ----- 5.5.3. ПРЕДСКАЗАНИЕ ТЕРМАЛЬНОЙ МОДЕЛИ (ЕСЛИ АКТИВНА) -----
            if (config.enableThermalModel && adaptiveModel.initialized) {
                point["pred"] = round(trendBuffer[idx].getPredictedTemp() * 10.0f) / 10.0f;
            }
        }
        
        // ----- 5.6. ВЫХОД ИЗ КРИТИЧЕСКОЙ СЕКЦИИ НА ВРЕМЯ ОТПРАВКИ -----
        taskEXIT_CRITICAL(&trendBufferMux);
        
        // ----- 5.7. СЕРИАЛИЗАЦИЯ И ОТПРАВКА -----
        // Сериализуем напрямую в String — без промежуточного буфера
        String output;
        serializeJson(doc, output);
        client->text(output);
        
        // ----- 5.8. ПОДГОТОВКА К СЛЕДУЮЩЕМУ ЧАНКУ -----
        if (chunk < chunks - 1) {
            vTaskDelay(10 / portTICK_PERIOD_MS);      // 10 мс пауза между чанками
            taskENTER_CRITICAL(&trendBufferMux);      // Вход для следующей итерации
        }
    }
    
    // ========== 6. КОНЕЦ ФУНКЦИИ ==========
    // После выхода из цикла мы ГАРАНТИРОВАННО находимся ВНЕ критической секции:
    // - Если был хотя бы один чанк: вышли на шаге 5.6 в последней итерации
    // - Если chunks == 0: вышли на шаге 3
    // Поэтому НЕ вызываем taskEXIT_CRITICAL здесь — это был бы двойной выход!
}

// ========== ОТПРАВКА ОБНОВЛЕНИЙ С УКАЗАННОГО ВРЕМЕНИ ==========
// Используется для синхронизации графика после переподключения
// Клиент отправляет "get_updates:<timestamp>" с временем последней полученной точки
// Вызывается: handleWebSocketMessage() при команде "get_updates"
void sendUpdatesSince(AsyncWebSocketClient *client, unsigned long timestamp) {
    taskENTER_CRITICAL(&trendBufferMux);
    
    int totalCount = trendBufferFilled ? TREND_BUFFER_SIZE : trendIndex;
    if (totalCount == 0) { 
        taskEXIT_CRITICAL(&trendBufferMux); 
        return; 
    }
    
    StaticJsonDocument<4096> doc;                    // 4KB достаточно для ~30 точек
    doc["type"] = "history_update";
    doc["lastTimestamp"] = millis() - deviceStartTime;
    JsonArray data = doc.createNestedArray("data");
    
    // Проходим по буферу от новых к старым
    for (int i = 0; i < totalCount; i++) {
        int idx;
        if (trendBufferFilled) {
            // Идём в обратном порядке (от новых к старым)
            idx = (trendIndex - 1 - i + TREND_BUFFER_SIZE) % TREND_BUFFER_SIZE;
        } else {
            idx = totalCount - 1 - i;
        }
        
        // Добавляем только точки новее запрошенного времени
        if (trendBuffer[idx].timestamp > timestamp) {
            JsonObject point = data.createNestedObject();
            point["t"] = trendBuffer[idx].timestamp;
            point["a"] = trendBuffer[idx].getAirTemp();
            point["h"] = trendBuffer[idx].getHeaterTemp();
            point["tg"] = trendBuffer[idx].getTargetTemp();
            if (config.enableThermalModel && adaptiveModel.initialized) {
                point["pred"] = trendBuffer[idx].getPredictedTemp();
            }
        } else {
            break;  // Так как идём от новых к старым, дальше все точки старее
        }
    }
    
    if (data.size() == 0) {
        // Нет новых точек — отправляем текущее состояние как одну точку
        JsonObject point = data.createNestedObject();
        point["t"] = millis() - deviceStartTime;
        point["a"] = airTemp;
        point["h"] = heaterTemp;
        point["tg"] = targetTemp;
    }

    taskEXIT_CRITICAL(&trendBufferMux);
    
    // Отправляем только если есть новые данные
    if (data.size() > 0) { 
        String output; 
        serializeJson(doc, output); 
        client->text(output); 
    }
}

// ============================================================================
// УПРАВЛЕНИЕ НАГРЕВОМ И ВЕНТИЛЯТОРОМ
// ============================================================================
// Основная функция управления нагревателем
// Вызывается: controlTask() по таймеру heaterControlInterval (200 мс)
// Реализует два режима: классический (по воздуху) и щадящий (по нагревателю с гистерезисом)
void updateHeaterControl() {
    unsigned long now = millis();
    
    // ========== 1. АДАПТАЦИЯ АКТИВНА ==========
    // Во время адаптации управление нагревателем полностью отключается
    // (адаптация сама управляет нагревом по своему алгоритму)
    if (adaptationInProgress) {
        return;
    }
    
    // ========== 2. АВТООТКЛЮЧЕНИЕ ПО СТАТУСУ ПЕЧАТИ ==========
    // Если печать завершена и прошло заданное время - выключаем нагрев
    if (shouldShutdownByPrintStatus()) {
        if (heaterState) {
            digitalWrite(config.pinSsr, config.invertHeaterSignal ? HIGH : LOW);  // Выключаем SSR
            heaterState = false;
            targetReachedFlag = false;
        }
        targetTemp = 0;                          // Сбрасываем целевую температуру
        
        // Сохраняем выключенное состояние
        Preferences prefs;
        if (prefs.begin("flook", false)) { 
            prefs.putFloat("lastTarget", 0.0f);
            prefs.end();
        }
        
        printEndTime = 0;  // Сбрасываем таймер
        addNotificationToLog("⏰ Автоотключение нагрева (печать завершена " + 
                            String(config.autoShutdownMinutes) + " мин назад)");
        return;
    }
    
    // ========== 3. ПРОВЕРКА КРИТИЧЕСКИХ ОШИБОК ==========
    // При любой критической ошибке нагреватель должен быть выключен
    // Особое внимание: errors.unexpectedHeat блокирует включение (нагрев при выключенном SSR)
    if (errors.hasCriticalError() || runawayTriggered || criticalOverheatLock || 
        airOverheatLock || errors.unexpectedHeat || errors.isSystemLocked() || 
        heaterTemp >= config.criticalTemp || airTemp >= config.maxAirTemp) {
        
        if (heaterState) { 
            digitalWrite(config.pinSsr, config.invertHeaterSignal ? HIGH : LOW);  // Выключаем
            heaterState = false;
            targetReachedFlag = false;
        }
        return;
    }
    
    // ========== 4. УПРАВЛЕНИЕ НАГРЕВАТЕЛЕМ ==========
    if (targetTemp > 0) {
        // Проверяем, нужно ли включать нагрев по температуре воздуха
        bool needHeatingByAir = (airTemp <= targetTemp - config.hysteresis);
        
        // ========== РЕЖИМ 1: УПРАВЛЕНИЕ ПО НАГРЕВАТЕЛЮ С ГИСТЕРЕЗИСОМ ==========
        // Щадящий режим для SSR: включает нагрев только когда нагреватель остыл ниже порога
        // Это снижает частоту переключений и продлевает ресурс реле
        if (config.enableHeaterHysteresis) {
            // --- ВКЛЮЧЕНИЕ ---
            // Условия: нужно греть воздух И нагреватель выключен И температура нагревателя 
            //          ниже (maxHeaterTemp - гистерезис)
            if (needHeatingByAir && !heaterState && 
                heaterTemp < config.maxHeaterTemp - config.heaterHysteresis) {
                digitalWrite(config.pinSsr, config.invertHeaterSignal ? LOW : HIGH);  // Включаем
                heaterState = true;
                targetReachedFlag = false;
            }
            // --- ВЫКЛЮЧЕНИЕ ---
            // Условия: нагреватель включён И (температура нагревателя достигла максимума 
            //          ИЛИ воздух перегрелся относительно цели)
            else if (heaterState && (heaterTemp >= config.maxHeaterTemp + config.heaterHysteresis || 
                     airTemp >= targetTemp + config.hysteresis)) {
                digitalWrite(config.pinSsr, config.invertHeaterSignal ? HIGH : LOW);  // Выключаем
                heaterState = false;
                targetReachedFlag = false;
            }
        } 
        // ========== РЕЖИМ 2: КЛАССИЧЕСКОЕ УПРАВЛЕНИЕ ПО ВОЗДУХУ ==========
        // Включает/выключает нагрев только по температуре воздуха с гистерезисом
        else {
            bool needHeating = (airTemp <= targetTemp - config.hysteresis);   // Нужно греть
            bool needStopping = (airTemp >= targetTemp + config.hysteresis);  // Нужно остановить
            
            if (needHeating && !heaterState) {
                digitalWrite(config.pinSsr, config.invertHeaterSignal ? LOW : HIGH);  // Включаем
                heaterState = true;
                targetReachedFlag = false;
            }
            else if (needStopping && heaterState) {
                digitalWrite(config.pinSsr, config.invertHeaterSignal ? HIGH : LOW);  // Выключаем
                heaterState = false;
                targetReachedFlag = false;
            }
        }
    } 
    // ========== 5. ЦЕЛЕВАЯ ТЕМПЕРАТУРА = 0 (НАГРЕВ ВЫКЛЮЧЕН) ==========
    else if (heaterState) {
        digitalWrite(config.pinSsr, config.invertHeaterSignal ? HIGH : LOW);  // Выключаем
        heaterState = false;
        targetReachedFlag = false;
        
        // Также выключаем вентилятор (он включится снова при превышении fanOnTemp)
        setFanDuty(0);
        currentDynamicDuty = 0;
        fanState = false;
    }
}

// ============================================================================
// HEARTBEAT (СТОРОЖЕВОЙ ТАЙМЕР ESP01S)
// ============================================================================

// Генерация импульсов на пине сторожевого таймера (GPIO26)
// Сигнал используется для внешней схемы (ESP01S или аппаратный watchdog)
// Вызывается: heartbeatTask() каждые 10 мс
// 
// Логика работы:
// - При активном нагреве (targetTemp > 0) и отсутствии ошибок генерируются импульсы
// - Внешний watchdog ожидает перепады HIGH→LOW→HIGH в течение заданного интервала
// - При зависании прошивки импульсы прекращаются → внешняя схема отключает питание
void updateHeartbeat() {
    static unsigned long lastPulseStart = 0;    // Время начала текущего импульса/паузы
    static bool pulseIsActive = false;          // Флаг: true = идёт импульс (LOW), false = пауза (HIGH)
    unsigned long now = millis();
    
    // ========== ОПРЕДЕЛЕНИЕ НЕОБХОДИМОСТИ ГЕНЕРАЦИИ HEARTBEAT ==========
    // Heartbeat генерируется ТОЛЬКО когда:
    // 1. Установлена целевая температура (идёт нагрев или поддержание)
    // 2. Нет критических ошибок (система работает штатно)
    bool shouldHeartbeat = (targetTemp > 0) && 
                           !errors.isSystemLocked() &&          // Система не заблокирована
                           !errors.max6675Disconnected &&       // MAX6675 на месте
                           !errors.max6675Stuck &&              // MAX6675 не завис
                           !errors.ds18b20Disconnected &&       // DS18B20 на месте
                           !errors.criticalOverheat &&          // Нет перегрева
                           !errors.airOverheat &&               // Нет перегрева воздуха
                           !errors.thermalRunaway &&            // Нет Thermal Runaway
                           !errors.unexpectedHeat;              // Нет неожиданного нагрева
    
    // ========== РЕЖИМ ОСТАНОВА (HEARTBEAT НЕ НУЖЕН) ==========
    // Держим пин в HIGH (неактивное состояние)
    // Внешний watchdog при отсутствии импульсов перезагрузит систему
    if (!shouldHeartbeat) {
        digitalWrite(config.pinWatchdog, HIGH);
        pulseIsActive = false;
        return;
    }
    
    // ========== ГЕНЕРАЦИЯ ПУЛЬСОВ (активный режим) ==========
    // Последовательность: HIGH (пауза) → LOW (импульс) → HIGH (пауза) → ...
    // Длительность паузы: heartbeatPauseMs (по умолч. 900 мс)
    // Длительность импульса: heartbeatPulseMs (по умолч. 100 мс)
    
    if (!pulseIsActive) {
        // --- ФАЗА ПАУЗЫ (HIGH уровень) ---
        // Проверяем, прошла ли пауза
        if (now - lastPulseStart >= (unsigned long)config.heartbeatPauseMs) {
            digitalWrite(config.pinWatchdog, LOW);    // Начинаем импульс (LOW)
            lastPulseStart = now;
            pulseIsActive = true;                     // Переходим в фазу импульса
        }
    } else {
        // --- ФАЗА ИМПУЛЬСА (LOW уровень) ---
        // Проверяем, прошла ли длительность импульса
        if (now - lastPulseStart >= (unsigned long)config.heartbeatPulseMs) {
            digitalWrite(config.pinWatchdog, HIGH);   // Заканчиваем импульс (HIGH)
            pulseIsActive = false;                    // Переходим в фазу паузы
        }
    }
}

// ============================================================================
// UDP DISCOVERY (ОБНАРУЖЕНИЕ Klipper)
// ============================================================================

// Обрабатывает UDP-пакеты от Klipper для обнаружения устройства в сети.
// Протокол: Klipper отправляет широковещательный запрос.
//
// Формат запроса:  FLOOK_DISCOVERY:<requested_device_id>
//
// Формат ответа:  FLOOK32:TRUE:<IP>:<uptime>:<T_air>:<device_id>
//                 FLOOK32:FALSE:<IP>:<uptime>:<T_air>:<device_id>
//
// Логика:
//   - Если в запросе указан ID, сравниваем со своим.
//     Совпадает → отвечаем TRUE, сохраняем IP отправителя как IP Klipper,
//     и дополнительно сохраняем его в NVS для восстановления после перезагрузки.
//     Не совпадает → отвечаем FALSE и НЕ сохраняем IP.
//   - Если ID не указан → отвечаем без TRUE/FALSE и не сохраняем IP.
//
// Вызывается: webTask() по таймеру (каждые 5000 мс)
void handleUDPDiscovery() {
    // ========== ОГРАНИЧЕНИЕ ЧАСТОТЫ ОТВЕТОВ ==========
    // Защита от флуда discovery-запросами
    static unsigned long lastDiscoveryTime = 0;
    if (millis() - lastDiscoveryTime < config.discoveryRetryInterval) return;
    lastDiscoveryTime = millis();
    
    // ========== ПРИЁМ UDP-ПАКЕТА ==========
    int packetSize = udp.parsePacket();
    if (!packetSize) return;                    // Нет данных
    
    char incomingPacket[128];                   // Увеличенный буфер для ID в запросе
    int len = udp.read(incomingPacket, sizeof(incomingPacket) - 1);
    if (len > 0) incomingPacket[len] = '\0';
    
    String message = String(incomingPacket);
    IPAddress remoteIP = udp.remoteIP();        // IP отправителя (Klipper)
    
    // ========== ПРОВЕРКА ЗАПРОСА ОБНАРУЖЕНИЯ ==========
    if (message.indexOf("FLOOK_DISCOVERY") >= 0) {
        lastKlipperDiscoveryResponse = millis();
        
        // ========== ЧТЕНИЕ УНИКАЛЬНОГО ID УСТРОЙСТВА ==========
        Preferences prefs_id;
        prefs_id.begin("flook", true);
        uint32_t device_id = prefs_id.getUInt("device_id", 0);
        prefs_id.end();
        
        String myId = String(device_id, HEX);
        myId.toUpperCase();                     // Приводим к верхнему регистру для сравнения
        
        // ========== ОПРЕДЕЛЕНИЕ ФОРМАТА ЗАПРОСА ==========
        bool hasRequestedId = false;
        String requestedId = "";
        bool idMatches = false;
        
        // Проверяем, содержит ли запрос ID устройства
        // Формат: "FLOOK_DISCOVERY:1234ABCD"
        int colonIndex = message.indexOf(':');
        if (colonIndex > 0 && colonIndex < message.length() - 1) {
            requestedId = message.substring(colonIndex + 1);
            requestedId.trim();                 // Убираем пробелы и переводы строк
            requestedId.toUpperCase();
            hasRequestedId = true;
            idMatches = (requestedId == myId);
            
            LOG_DEBUG("UDP запрос с ID: %s (мой: %s, совпадение: %s)", 
                     requestedId.c_str(), myId.c_str(), idMatches ? "ДА" : "НЕТ");
        }
        
        // ========== ФОРМИРОВАНИЕ ОТВЕТА ==========
        String response;
        
        if (hasRequestedId) {
            // Новый формат с TRUE/FALSE
            if (idMatches) {
                // ========== ID СОВПАЛ — СОХРАНЯЕМ IP KLIPPER ==========
                // 1. Обновляем IP в оперативной памяти
                klipperStatus.update(remoteIP);
                
                // 2. Сохраняем IP в NVS для восстановления после перезагрузки
                //    Теперь FLOOK32 будет знать IP Klipper даже после ребута,
                //    и плагину не нужно слать периодические UDP-запросы
                Preferences prefs;
                if (prefs.begin("flook", false)) {
                    prefs.putString("klipper_ip", remoteIP.toString());
                    prefs.end();
                    LOG_DEBUG("IP Klipper сохранён в NVS: %s", remoteIP.toString().c_str());
                }
                
                response = "FLOOK32:TRUE:" + WiFi.localIP().toString() + ":" + 
                          String((millis() - deviceStartTime) / 1000) + ":" + 
                          String(airTemp, 1) + ":" + myId;
                LOG_INFO("Klipper обнаружен (ID совпал), IP: %s", remoteIP.toString().c_str());
            } else {
                // ID не совпал — это чужой Klipper, НЕ сохраняем IP
                response = "FLOOK32:FALSE:" + WiFi.localIP().toString() + ":" + 
                          String((millis() - deviceStartTime) / 1000) + ":" + 
                          String(airTemp, 1) + ":" + myId;
                LOG_DEBUG("Чужой Klipper (ID не совпал), IP: %s", remoteIP.toString().c_str());
            }
        } else {
            // Формат без ID — отвечаем, но НЕ сохраняем IP Klipper
            // (иначе все FLOOK в сети запомнят этот IP как свой)
            response = "FLOOK32:" + WiFi.localIP().toString() + ":" + 
                      String((millis() - deviceStartTime) / 1000) + ":" + 
                      String(airTemp, 1) + ":" + myId;
            LOG_DEBUG("UDP запрос без ID, IP не сохранён: %s", remoteIP.toString().c_str());
        }
        
        // ========== ОТПРАВКА ОТВЕТА ==========
        udp.beginPacket(remoteIP, UDP_PORT);
        udp.print(response);
        udp.endPacket();
        
        LOG_DEBUG("Ответ на discovery: %s", response.c_str());
    }
}

// ============================================================================
// ЗАЩИТНЫЕ ФУНКЦИИ (ВЫЗЫВАЮТСЯ ИЗ controlTask)
// ============================================================================

// ========== UNEXPECTED HEAT - НЕОЖИДАННЫЙ НАГРЕВ ПРИ ВЫКЛЮЧЕННОМ SSR ==========
// Обнаруживает ситуацию, когда температура нагревателя не падает, хотя SSR выключен
// Это может указывать на: залипшее реле, обрыв цепи управления или неисправность SSR
// Вызывается: controlTask() по таймеру unexpectedCheckInterval (2000 мс)
void checkUnexpectedHeat() {
    // Пропускаем если: адаптация отключила защиты, защита выключена в конфиге, система заблокирована
    if (adaptTempDisableProtections || errors.protectionsDisabled || 
        !config.enableUnexpectedHeatProtection || errors.isSystemLocked()) return;
    
    unsigned long now = millis();
    
    // ========== РАСЧЁТ АДАПТИВНОГО ПОРОГА ==========
    // Базовый порог: maxHeaterTemp - unexpectedHeatThreshold (например 110-15=95°C)
    float baseThreshold = config.maxHeaterTemp - config.unexpectedHeatThreshold;
    float activeThreshold = baseThreshold;
    
    // Адаптивный порог (корректируется в зависимости от температуры воздуха)
    if (config.enableUnexpectedHeatAdaptive) {
        float tempDiff = airTemp - config.adaptiveBaseTemp;  // Отклонение от базовой T_возд
        activeThreshold = baseThreshold - tempDiff * config.adaptiveCoefficient;
        float minThreshold = config.maxHeaterTemp - config.adaptiveMinOffset;  // Минимальный порог
        if (activeThreshold < minThreshold) activeThreshold = minThreshold;
        if (activeThreshold > baseThreshold) activeThreshold = baseThreshold;
    }
    
    float triggerThreshold = activeThreshold;  // Порог срабатывания
    float resetThreshold = activeThreshold - config.unexpectedHeatHysteresis;  // Порог сброса
    
    // ========== ОСНОВНАЯ ЛОГИКА ПРОВЕРКИ ==========
    // Условие: нагреватель выключен, вентилятор включён, температура выше порога
    if (!heaterState && fanState && heaterTemp > triggerThreshold) {
        // ---- ФАЗА 1: ОБНАРУЖЕНИЕ НАЧАЛА АНОМАЛИИ ----
        if (!unexpectedHeatDetected) { 
            unexpectedHeatStart = now; 
            tempAtUnexpectedStart = heaterTemp; 
            unexpectedHeatDetected = true; 
            errors.unexpectedHeatLockTime = 0; 
        }
        
        // ---- ФАЗА 2: ПРОВЕРКА ПО ИСТЕЧЕНИИ ТАЙМАУТА ----
        if (now - unexpectedHeatStart > (unsigned long)(config.unexpectedHeatTimeout * 1000)) {
            // Ожидаемая температура при нормальном охлаждении (с вентилятором)
            float expectedCoolingRate = config.minCoolingRate * 1.5;  // Учитываем наличие вентилятора
            float expectedTemp = tempAtUnexpectedStart - (expectedCoolingRate * config.unexpectedHeatTimeout);
            if (expectedTemp < 0) expectedTemp = 0;
            
            // Реальная температура выше ожидаемой → проблема с охлаждением
            if (heaterTemp >= expectedTemp) {
                // Увеличиваем счётчик ошибок в пределах временного окна
                if (now - errors.lastUnexpectedHeatTime < config.errorWindowMinutes * 60000UL) {
                    errors.unexpectedHeatCount++;
                } else {
                    errors.unexpectedHeatCount = 1;
                }
                errors.lastUnexpectedHeatTime = now;
                
                // Блокировка системы при превышении лимита ошибок
                if (errors.unexpectedHeatCount >= config.maxErrorRetries) {
                    errors.lockSystem("Многократный неожиданный нагрев", "unexpected_heat");
                } else { 
                    // Аварийное отключение и форсирование вентилятора
                    errors.unexpectedHeat = true; 
                    runawayTriggered = true; 
                    errors.unexpectedHeatLockTime = now; 
                    digitalWrite(config.pinSsr, config.invertHeaterSignal ? HIGH : LOW);  // Выключаем SSR
                    heaterState = false; 
                    errors.unexpectedHeatLogged = false;     // Разрешаем логирование
                }
            } else {
                // Медленное остывание - предупреждение, но не ошибка
                addNotificationToLog("⚠️ Медленное остывание: " + 
                    String((tempAtUnexpectedStart - heaterTemp) / config.unexpectedHeatTimeout, 2) + "°C/сек");
            }
            unexpectedHeatDetected = false;  // Сбрасываем флаг для следующего цикла
        }
    } 
    // ========== ВОССТАНОВЛЕНИЕ ПОСЛЕ ОШИБКИ ==========
    // Условие сброса: нагреватель выключен, температура упала ниже порога
    else if (!heaterState && heaterTemp < resetThreshold) {
        unexpectedHeatDetected = false;
        
        if (errors.unexpectedHeat) {
            errors.unexpectedHeat = false;
            errors.unexpectedHeatLogged = false;
            runawayTriggered = false;
            addNotificationToLog("✅ Ошибка неожиданного нагрева сброшена");
        }
    }
}

// ========== THERMAL RUNAWAY - ТРЁХФАЗНЫЙ КОНТРОЛЬ НАГРЕВА ==========
// Обнаруживает аварийные ситуации с нагревом:
// - Фаза 1: нагреватель греется слишком медленно (неисправность нагревателя или SSR)
// - Фаза 2: воздух в камере греется слишком медленно (плохая циркуляция или открытая камера)
// - Фаза 3: слишком долго достигается целевая температура (низкая эффективность системы)
// Вызывается: controlTask() по таймеру runawayCheckInterval (5000 мс)
void checkThermalRunaway() {
    // Пропускаем если: адаптация отключила защиты, защита выключена, система заблокирована
    if (adaptTempDisableProtections || errors.protectionsDisabled || 
        !config.enableThermalRunawayProtection || errors.isSystemLocked()) return;
    
    unsigned long now = millis();
    
    // ========== ОГРАНИЧЕНИЕ ЧАСТОТЫ ПРОВЕРОК ==========
    static unsigned long lastRunawayCheck = 0;
    // При активной термальной модели проверяем реже (в 6 раз), т.к. модель сама обнаруживает аномалии
    unsigned long checkInterval = protectionOverride.thermalModelActive ? 
                                   config.runawayCheckInterval * 6 : 
                                   config.runawayCheckInterval;
    if (now - lastRunawayCheck < checkInterval) return;
    lastRunawayCheck = now;
    
    // При активной термальной модели дополнительно проверяем скорость нагрева воздуха
    if (protectionOverride.thermalModelActive && !errors.thermalRunaway) {
        checkAirHeatingRate();
    }
    
    // ========== ЗАГРУЗКА ПАРАМЕТРОВ (С УЧЁТОМ ПЕРЕОПРЕДЕЛЕНИЙ) ==========
    // Если термальная модель активна - пороги смягчаются (коэффициенты из protectionOverride)
    float minHeaterRise = (protectionOverride.runawayMinHeaterRiseOverride > 0) ? 
                          protectionOverride.runawayMinHeaterRiseOverride : 
                          config.runawayMinHeaterRisePerMin;
    float minAirRise = (protectionOverride.runawayMinAirRiseOverride > 0) ? 
                       protectionOverride.runawayMinAirRiseOverride : 
                       config.runawayMinAirRisePerMin;
    float maxTimeToTarget = (protectionOverride.runawayMaxTimeToTargetOverride > 0) ? 
                            protectionOverride.runawayMaxTimeToTargetOverride : 
                            config.runawayMaxTimeToTarget;
    int phase1Time = (protectionOverride.runawayPhase1TimeOverride > 0) ? 
                     protectionOverride.runawayPhase1TimeOverride : 
                     config.runawayPhase1Time;
    int phase2Time = (protectionOverride.runawayPhase2TimeOverride > 0) ? 
                     protectionOverride.runawayPhase2TimeOverride : 
                     config.runawayPhase2Time;
    
    // ========== УСЛОВИЯ ДЛЯ ЗАПУСКА МОНИТОРИНГА ==========
    // Мониторинг не нужен если: цель не задана, температура уже достигнута, нагреватель выключен
    if (targetTemp <= 0 || heaterTemp >= targetTemp - config.hysteresis || !heaterState) {
        runawayMonitoring = false;
        return;
    }
    
    // ========== ЗАПУСК МОНИТОРИНГА ==========
    if (heaterState && !runawayMonitoring && !errors.thermalRunaway) {
        runawayMonitoring = true;
        runawayStartTime = now;
        runawayStartHeaterTemp = heaterTemp;
        runawayStartAirTemp = airTemp;
        runawayTargetTemp = targetTemp;
        runawayPhase = 1;
        return;
    }
    
    // Выход если мониторинг не активен или ошибка уже зафиксирована
    if (!runawayMonitoring || errors.thermalRunaway) return;
    
    // ========== ОПРЕДЕЛЕНИЕ ТЕКУЩЕЙ ФАЗЫ ==========
    unsigned long elapsed = now - runawayStartTime;
    unsigned long elapsedMin = elapsed / 60000;
    int newPhase = 0;
    
    if (elapsed < 45000) {
        newPhase = 0;
    } else if (elapsedMin < (unsigned long)phase1Time) {
        newPhase = 1;
    } else if (elapsedMin < (unsigned long)phase2Time) {
        newPhase = 2;
    } else {
        newPhase = 3;
    }
    
    if (newPhase != runawayPhase) runawayPhase = newPhase;
    
    // ========== ПРОВЕРКА УСЛОВИЙ ПО ФАЗАМ ==========
    bool alarm = false;
    String reason = "";
    
    switch (runawayPhase) {
        case 0:  // ФАЗА 0: БЫСТРАЯ ПРОВЕРКА НАГРЕВАТЕЛЯ
            if (elapsed >= 45000 && heaterTemp < config.runawayQuickCheckTemp) {
                alarm = true;
                reason = "нагреватель не достиг " + String(config.runawayQuickCheckTemp, 0) + "°C за 45 сек (фаза 0)";
            }
            break;
            
        case 1:  // ФАЗА 1: КОНТРОЛЬ НАГРЕВАТЕЛЯ
            // Нагреватель растёт слишком медленно
            if (heaterTemp - runawayStartHeaterTemp < minHeaterRise * elapsedMin - config.runawayHysteresis) {
                alarm = true;
                reason = "нагреватель растёт слишком медленно";
            }
            break;
            
        case 2:  // ФАЗА 2: КОНТРОЛЬ ВОЗДУХА
            // Условие 1: температура нагревателя упала (отключился нагрев)
            if (runawayStartHeaterTemp - heaterTemp > config.runawayMaxHeaterDrop && 
                heaterTemp < targetTemp + 20) {
                alarm = true;
                reason = "нагреватель упал";
            }
            // Условие 2: воздух нагревается слишком медленно
            else if (airTemp - runawayStartAirTemp < minAirRise * (elapsedMin - phase1Time) - config.runawayHysteresis) {
                alarm = true;
                reason = "воздух растёт слишком медленно";
            }
            break;
            
        case 3:  // ФАЗА 3: КОНТРОЛЬ ВРЕМЕНИ ДО ЦЕЛИ
            {
                float timeDiff = (float)(elapsedMin - phase1Time);
                float divisor = (timeDiff > 1.0f) ? timeDiff : 1.0f;
                float currentRate = (airTemp - runawayStartAirTemp) / divisor;  // Текущая скорость (°C/мин)
                
                // Оставшееся время до цели при текущей скорости превышает допустимое
                if (currentRate > 0 && (targetTemp - airTemp) / currentRate > maxTimeToTarget) {
                    alarm = true;
                    reason = "слишком долго до цели";
                }
            }
            break;
    }
    
    // ========== ОБРАБОТКА АЛАРМЫ ==========
    if (alarm) {
        // Увеличиваем счётчик ошибок в пределах временного окна
        if (now - errors.lastThermalRunawayTime < config.errorWindowMinutes * 60000UL) {
            errors.thermalRunawayCount++;
        } else {
            errors.thermalRunawayCount = 1;
        }
        errors.lastThermalRunawayTime = now;
        
        // Блокировка системы при превышении лимита ошибок
        if (errors.thermalRunawayCount >= config.maxErrorRetries) {
            errors.lockSystem("Многократный Thermal Runaway", "thermal");
        } else {
            // Аварийное отключение нагревателя
            errors.thermalRunaway = true;
            runawayTriggered = true;
            runawayMonitoring = false;
            errors.thermalRunawayLockTime = now;
            digitalWrite(config.pinSsr, config.invertHeaterSignal ? HIGH : LOW);  // Выключаем SSR
            heaterState = false;
            errors.thermalRunawayLogged = false;  // Разрешаем логирование
        }
    }
}

// ========== ПРОВЕРКА СКОРОСТИ НАГРЕВА ВОЗДУХА ==========
// Проверяет, достаточно ли быстро прогревается воздух в камере
// Если скорость слишком низкая (<30% от minAirRise) → выдаётся предупреждение
// Вызывается: checkThermalRunaway()
void checkAirHeatingRate() {
    // ========== ПРОВЕРКА УСЛОВИЙ АКТИВАЦИИ ==========
    // Выход если: нагреватель выключен или температура воздуха уже близка к цели (<5°C)
    if (!heaterState || airTemp > targetTemp - 5) { 
        protectionOverride.airCheckActive = false; 
        return; 
    }
    
    unsigned long now = millis();
    
    // ========== ФАЗА 1: ЗАПУСК ИЗМЕРЕНИЯ ==========
    if (!protectionOverride.airCheckActive) { 
        protectionOverride.airCheckActive = true;
        protectionOverride.airCheckStartTime = now;      // Запоминаем время начала
        protectionOverride.airStartTemp = airTemp;       // Запоминаем начальную температуру
        protectionOverride.lastAirCheckTime = now;
        return; 
    }
    
    // ========== ФАЗА 2: ОЖИДАНИЕ ДОСТАТОЧНОГО ВРЕМЕНИ ==========
    // Ждём минимум 60 секунд для накопления данных
    if (now - protectionOverride.airCheckStartTime < 60000) return;
    
    // ========== ФАЗА 3: РАСЧЁТ И АНАЛИЗ СКОРОСТИ ==========
    // Берём порог из конфигурации (с учётом переопределений термальной модели)
    float minAirRise = (protectionOverride.runawayMinAirRiseOverride > 0) ? 
                       protectionOverride.runawayMinAirRiseOverride : 
                       config.runawayMinAirRisePerMin;
    
    // Расчёт реальной скорости нагрева воздуха (°C/мин)
    // Формула: (изменение температуры) * 60 / (время в секундах)
    float elapsedSec = (now - protectionOverride.airCheckStartTime) / 1000.0;
    float risePerMin = (airTemp - protectionOverride.airStartTemp) * 60.0 / elapsedSec;
    
    // ========== ФАЗА 4: ЛОГИРОВАНИЕ ПРЕДУПРЕЖДЕНИЯ ==========
    // Если скорость меньше 30% от минимально допустимой → проблема с циркуляцией воздуха
    if (risePerMin < minAirRise * 0.3) {
        static unsigned long lastAirWarning = 0;
        
        // Предупреждение не чаще чем раз в 5 минут (300000 мс)
        if (now - lastAirWarning > 300000) { 
            addErrorToLog("⚠️ Медленный прогрев камеры: " + String(risePerMin, 1) + "°C/мин", 
                         false, true, 0); 
            lastAirWarning = now; 
        }
    }
    
    // ========== ФАЗА 5: ЗАВЕРШЕНИЕ ПРОВЕРКИ ==========
    protectionOverride.airCheckActive = false;
}

// ========== КОНТРОЛЬ ПЕРЕГРЕВА НАГРЕВАТЕЛЯ ==========
// Мониторинг температуры нагревателя с многоуровневой защитой
// Порог срабатывания: heaterTemp > criticalTemp (по умолчанию 120°C)
// Действия: выключение SSR, блокировка при 3 перегревах
// Вызывается: controlTask() (часто, в составе timerProtections)
void checkHeaterOverheat() {
    // Пропускаем если: адаптация отключила защиты, защиты выключены, MAX6675 отключён, система заблокирована
    if (adaptTempDisableProtections || errors.protectionsDisabled || 
        errors.max6675Disconnected || errors.isSystemLocked()) {
        return;
    }
    
    unsigned long now = millis();
    static unsigned long lastHeaterCheck = 0;
    
    // Ограничение частоты проверок (controlInterval = 1000 мс по умолчанию)
    if (now - lastHeaterCheck < config.controlInterval) return;
    lastHeaterCheck = now;
    
    // ========== ОБНАРУЖЕНИЕ ПЕРЕГРЕВА ==========
    if (heaterTemp > config.criticalTemp) {
        float tempAtOverheat = heaterTemp;
        
        // Увеличиваем счётчик перегревов в пределах временного окна (errorWindowMinutes)
        if (now - errors.lastCriticalOverheatTime < config.errorWindowMinutes * 60000UL) {
            errors.criticalOverheatCount++;
        } else {
            errors.criticalOverheatCount = 1;
        }
        errors.lastCriticalOverheatTime = now;
        
        // Логируем событие перегрева с трендами для последующего анализа
        addErrorToLog("⚠️ КРИТИЧЕСКИЙ ПЕРЕГРЕВ НАГРЕВАТЕЛЯ! T=" + 
                      String(tempAtOverheat, 1) + "°C", 
                      true, true, errors.criticalOverheatCount);
        
        // НЕМЕДЛЕННЫЕ ДЕЙСТВИЯ ПРИ ПЕРЕГРЕВЕ:
        
        // ========== ПРОВЕРКА НА БЛОКИРОВКУ (3 ПЕРЕГРЕВА) ==========
        if (errors.criticalOverheatCount >= config.maxErrorRetries) {
            addErrorToLog("🔒 ПОЛНАЯ БЛОКИРОВКА! Тройной перегрев нагревателя (" + 
                          String(errors.criticalOverheatCount) + "/" + 
                          String(config.maxErrorRetries) + ")", 
                          true, true, errors.criticalOverheatCount);
            
            errors.lockSystem("Тройной перегрев нагревателя", "overheat");
            errors.criticalOverheat = true;
            digitalWrite(config.pinSsr, config.invertHeaterSignal ? HIGH : LOW);  // Выключаем SSR
            heaterState = false;
            return;
        }
        
        // ========== ОДИНОЧНЫЙ ПЕРЕГРЕВ (НЕ БЛОКИРОВКА) ==========
        criticalOverheatLock = true;                     // Включаем блокировку нагрева
        errors.criticalOverheat = true;                  // Устанавливаем флаг ошибки
        digitalWrite(config.pinSsr, config.invertHeaterSignal ? HIGH : LOW);  // Выключаем SSR
        heaterState = false;
        errors.criticalOverheatLogged = false;           // Разрешаем логирование при снятии ошибки
        
    } 
    // ========== СБРОС ПЕРЕГРЕВА ПРИ ОХЛАЖДЕНИИ ==========
    // Условие сброса: блокировка активна И температура упала ниже (criticalTemp - criticalHysteresis)
    else if (criticalOverheatLock && heaterTemp < config.criticalTemp - config.criticalHysteresis) {
        criticalOverheatLock = false;
        errors.criticalOverheat = false;
        errors.criticalOverheatLogged = false;
        addNotificationToLog("✅ Перегрев нагревателя устранён! Температура: " + 
                            String(heaterTemp, 1) + "°C");
    }
}

// ========== КОНТРОЛЬ ПЕРЕГРЕВА ВОЗДУХА В КАМЕРЕ ==========
// Мониторинг температуры воздуха в печатной камере
// Порог срабатывания: airTemp > maxAirTemp (по умолчанию 70°C)
// Действия: выключение SSR, блокировка при 3 перегревах
// Вызывается: controlTask() (часто, в составе timerProtections)
void checkAirOverheat() {
    // Пропускаем если: адаптация отключила защиты, защиты выключены, система заблокирована
    if (adaptTempDisableProtections || errors.protectionsDisabled || errors.isSystemLocked()) return;
    
    unsigned long now = millis();
    static unsigned long lastAirCheck = 0;
    
    // Ограничение частоты проверок (controlInterval = 1000 мс по умолчанию)
    if (now - lastAirCheck < config.controlInterval) return;
    lastAirCheck = now;
    
    // ========== ОБНАРУЖЕНИЕ ПЕРЕГРЕВА ВОЗДУХА ==========
    if (airTemp > config.maxAirTemp && !airOverheatLock) {
        // НЕМЕДЛЕННЫЕ ДЕЙСТВИЯ ПРИ ПЕРЕГРЕВЕ:
        
        // 1. Блокируем дальнейший нагрев
        airOverheatLock = true; 
        errors.airOverheat = true;
        digitalWrite(config.pinSsr, config.invertHeaterSignal ? HIGH : LOW);  // Выключаем SSR
        heaterState = false;
        
        // 2. Увеличиваем счётчик перегревов в пределах временного окна
        if (now - errors.lastAirOverheatTime < config.errorWindowMinutes * 60000UL) {
            errors.airOverheatCount++;
        } else {
            errors.airOverheatCount = 1;
        }
        errors.lastAirOverheatTime = now;
        
        // 3. Проверка на блокировку (3 перегрева воздуха)
        if (errors.airOverheatCount >= config.maxErrorRetries) {
            errors.lockSystem("Тройной перегрев воздуха", "air_overheat");
        }
        // Примечание: ошибка не логируется здесь, это делает checkAndLogErrors()
        
    } 
    // ========== СБРОС ПЕРЕГРЕВА ПРИ ОХЛАЖДЕНИИ ==========
    // Условие сброса: блокировка активна И температура упала ниже (maxAirTemp - airHysteresis)
    else if (airOverheatLock && airTemp < config.maxAirTemp - config.airHysteresis) {
        airOverheatLock = false; 
        errors.airOverheat = false; 
        errors.airOverheatLogged = false;
        addNotificationToLog("✅ Перегрев воздуха устранён! Температура: " + 
                            String(airTemp, 1) + "°C");
        
    }
}

// ========== КОНТРОЛЬ ЭФФЕКТИВНОСТИ РАБОТЫ ВЕНТИЛЯТОРА ==========
// Проверяет, достаточно ли эффективно вентилятор охлаждает нагреватель
// Если за заданное время температура падает слишком медленно → предупреждение
// Это может указывать на: забитый вентилятор, плохой обдув, неисправность вентилятора
// Вызывается: controlTask() (часто, в составе timerProtections)
void checkFanEfficiency() {
    // Пропускаем если: проверка эффективности выключена, система заблокирована, вентилятор не активен
    if (!config.enableFanEfficiencyCheck || errors.isSystemLocked() || !fanState) { 
        fanOnTimeAtOverheat = 0;                 // Сбрасываем таймер
        fanEfficiencyWarningShown = false;       // Сбрасываем флаг предупреждения
        return; 
    }
    
    unsigned long now = millis();
    
    // ========== УСЛОВИЯ ДЛЯ ПРОВЕРКИ ==========
    // Проверяем эффективность ТОЛЬКО когда нагреватель выключен (идет охлаждение)
    bool shouldBeCooling = (!heaterState);
    
    // ========== СБРОС ТАЙМЕРА ПРИ ВЫКЛЮЧЕНИИ НАГРЕВАТЕЛЯ ==========
    static bool lastHeaterState = true;
    if (lastHeaterState && !heaterState) {
        // Нагреватель только что выключился - начинаем измерение охлаждения
        fanOnTimeAtOverheat = now;               // Запоминаем время начала охлаждения
        tempAtFanOn = heaterTemp;                // Запоминаем начальную температуру
        fanEfficiencyWarningShown = false;       // Сбрасываем флаг для нового измерения
    }
    lastHeaterState = heaterState;
    
    // ========== ОСНОВНАЯ ПРОВЕРКА ==========
    // Условия: идёт охлаждение И температура всё ещё высокая (близка к maxAirTemp)
    if (shouldBeCooling && heaterTemp > config.maxAirTemp - 10) {
        // Инициализация таймера если ещё не был установлен
        if (fanOnTimeAtOverheat == 0) { 
            fanOnTimeAtOverheat = now; 
            tempAtFanOn = heaterTemp; 
            fanEfficiencyWarningShown = false; 
        }
        
        // ========== РАСЧЁТ ПАДЕНИЯ ТЕМПЕРАТУРЫ ==========
        unsigned long elapsed = (now - fanOnTimeAtOverheat) / 1000;   // Прошедшие секунды
        float tempDrop = tempAtFanOn - heaterTemp;                    // Падение температуры
        
        // Если температура выросла вместо падения - сбрасываем счётчик и начинаем заново
        if (tempDrop < 0) { 
            fanOnTimeAtOverheat = now; 
            tempAtFanOn = heaterTemp; 
            return; 
        }
        
        // ========== ПРОВЕРКА УСЛОВИЙ ЭФФЕКТИВНОСТИ ==========
        // Если прошло достаточно времени, а температура упала меньше порога
        if (elapsed >= (unsigned long)config.fanEfficiencyTimeout && 
            tempDrop < config.fanEfficiencyThreshold && 
            !fanEfficiencyWarningShown) {
            
            // Формируем сообщение в зависимости от ситуации
            String message = "⚠️ Вентилятор неэффективен! " + 
                            (tempDrop < 0 ? String("Температура выросла на ") + String(-tempDrop, 1) + "°C" : 
                                            String("Слишком медленное охлаждение (падение ") + String(tempDrop, 1) + "°C)") + 
                            " за " + String(elapsed) + "с";
            
            addErrorToLog(message, false, true, 0);   // Логируем как предупреждение (не критично)
            fanEfficiencyWarningShown = true;         // Предотвращаем повторное предупреждение
            fanOnTimeAtOverheat = now;                // Сбрасываем таймер для следующей проверки
            tempAtFanOn = heaterTemp;
        }
    } else {
        // Если условия не выполняются (достаточно остыло или включился нагрев) - сбрасываем таймер
        fanOnTimeAtOverheat = 0;
    }
}

// ========== КОНТРОЛЬ СТАБИЛЬНОСТИ ДАТЧИКА ВОЗДУХА (DS18B20) ==========
// Анализирует историю показаний датчика для выявления нестабильности
// Критерии: размах температур, среднеквадратичное отклонение, частые смены направления
// Также проверяет выход температуры за допустимые пределы
// Вызывается: controlTask() (часто, в составе timerProtections)
void checkAirSensor() {
    // Пропускаем если: защита датчика выключена или система заблокирована
    if (!config.enableAirSensorProtection || errors.isSystemLocked()) return;
    
    // ========== БУФЕР ИСТОРИИ ТЕМПЕРАТУР (КОЛЬЦЕВОЙ) ==========
    static float airHistory[50];                // Буфер для хранения истории (максимум 50 точек)
    static int historyIndex = 0;                // Текущий индекс для записи
    static bool historyFilled = false;          // Флаг заполнения буфера
    
    // Сохраняем текущую температуру в историю
    airHistory[historyIndex] = airTemp;
    historyIndex = (historyIndex + 1) % config.airSensorUnstableWindow;
    if (historyIndex == 0) historyFilled = true;
    
    // Ждём пока буфер заполнится хотя бы один раз
    if (!historyFilled) return;
    
    // ========== СТАТИСТИЧЕСКИЙ АНАЛИЗ ИСТОРИИ ==========
    float minTemp = 1000, maxTemp = -1000, sum = 0;
    int directionChanges = 0, lastDir = 0;
    
    for (int i = 0; i < config.airSensorUnstableWindow; i++) {
        float t = airHistory[i];
        
        // Поиск минимума и максимума
        if (t < minTemp) minTemp = t;
        if (t > maxTemp) maxTemp = t;
        sum += t;
        
        // Подсчёт смен направления изменения температуры
        if (i > 0) {
            int dir = (t > airHistory[i-1] + 0.5f) ? 1 : (t < airHistory[i-1] - 0.5f) ? -1 : 0;
            if (dir != 0 && dir != lastDir && lastDir != 0) directionChanges++;
            if (dir != 0) lastDir = dir;
        }
    }
    
    // Расчёт среднего и максимального отклонения
    float avg = sum / config.airSensorUnstableWindow;
    float maxDeviation = 0;
    for (int i = 0; i < config.airSensorUnstableWindow; i++) { 
        float dev = abs(airHistory[i] - avg); 
        if (dev > maxDeviation) maxDeviation = dev; 
    }
    
    float range = maxTemp - minTemp;            // Размах температур за период
    
    // ========== ОПРЕДЕЛЕНИЕ НЕСТАБИЛЬНОСТИ ==========
    bool unstable = false; 
    String reason = "";
    
    // Критерий 1: слишком большой размах температур
    if (range > config.airSensorUnstableRange) { 
        unstable = true; 
        reason = "размах " + String(range, 1) + "°C"; 
    }
    // Критерий 2: слишком большое отклонение от среднего
    else if (maxDeviation > config.airSensorUnstableDeviation) { 
        unstable = true; 
        reason = "отклонение " + String(maxDeviation, 1) + "°C"; 
    }
    // Критерий 3: слишком частые смены направления
    else if (directionChanges > config.airSensorDirectionChanges) { 
        unstable = true; 
        reason = "смен направления " + String(directionChanges); 
    }
    
    // ========== ОБРАБОТКА НЕСТАБИЛЬНОСТИ ==========
    if (unstable) {
        static unsigned long lastUnstableLog = 0;
        // Логируем не чаще 1 раза в 30 секунд (избегаем спама)
        if (millis() - lastUnstableLog > 30000) { 
            addErrorToLog("⚠️ Датчик воздуха нестабилен: " + reason, false, true, 0); 
            lastUnstableLog = millis(); 
        }
        errors.airSensorUnstable = true;        // Устанавливаем флаг нестабильности
    } else { 
        errors.airSensorUnstable = false; 
        errors.airSensorUnstableLogged = false; // Сбрасываем флаг логирования
    }
    
    // ========== ПРОВЕРКА ВЫХОДА ЗА ДОПУСТИМЫЙ ДИАПАЗОН ==========
    if (airTemp < config.airSensorMinTemp || airTemp > config.airSensorMaxTemp) {
        static unsigned long lastRangeLog = 0;
        // Логируем не чаще 1 раза в 30 секунд
        if (millis() - lastRangeLog > 30000) { 
            addErrorToLog("⚠️ Температура воздуха вне диапазона: " + String(airTemp, 1) + "°C", 
                         false, true, 0); 
            lastRangeLog = millis(); 
        }
        errors.airSensorOutOfRange = true;        // Устанавливаем флаг выхода за диапазон
    } else { 
        errors.airSensorOutOfRange = false; 
        errors.airSensorOutOfRangeLogged = false; // Сбрасываем флаг логирования
    }
}

// ========== КОНТРОЛЬ АНОМАЛЬНО БЫСТРОГО НАГРЕВА ==========
// Обнаруживает ситуации, когда температура нагревателя растёт слишком быстро
// Это может указывать на: короткое замыкание SSR, неисправность регулятора, 
//                         неправильную настройку или обрыв термопары (ложные скачки)
// Вызывается: controlTask() по таймеру rateCheckInterval (1000 мс)
void checkHeatingRate() {
    // Пропускаем если: контроль аномальной скорости выключен в настройках
    if (!config.enableAbnormalRate) return;
    
    unsigned long now = millis();
    static unsigned long lastHeatingRateCheck = 0;
    
    // Ограничение частоты проверок (rateCheckInterval = 1000 мс по умолчанию)
    if (now - lastHeatingRateCheck < config.rateCheckInterval) return;
    lastHeatingRateCheck = now;
    
    // ========== РАСЧЁТ ТЕКУЩЕЙ СКОРОСТИ НАГРЕВА ==========
    unsigned long timeDiff = now - lastRateCheck;
    
    // Проверяем, что интервал между замерами приблизительно 1 секунда (900-1100 мс)
    // Если интервал сильно отличается - сбрасываем базовое значение
    if (timeDiff < 900 || timeDiff > 1100) { 
        lastTempForRate = heaterTemp; 
        lastRateCheck = now; 
        return; 
    }
    
    // Валидация значений температуры (защита от некорректных данных)
    if (lastTempForRate == 0 || lastTempForRate < -100 || lastTempForRate > 500 || 
        heaterTemp < -100 || heaterTemp > 500 || isnan(heaterTemp) || isinf(heaterTemp)) { 
        lastTempForRate = heaterTemp; 
        lastRateCheck = now; 
        return; 
    }
    
    // Расчёт изменения температуры
    float tempDiff = heaterTemp - lastTempForRate;
    
    // Если температура не растёт - сбрасываем и выходим
    if (tempDiff <= 0) { 
        lastTempForRate = heaterTemp; 
        lastRateCheck = now; 
        return; 
    }
    
    // Расчёт скорости роста в °C/секунду
    // Формула: (изменение температуры) * 1000 / (интервал в миллисекундах)
    float rateOfRise = (tempDiff * 1000.0) / timeDiff;
    
    // Защита от бесконечных и нечисловых значений (на всякий случай)
    if (isinf(rateOfRise) || isnan(rateOfRise)) { 
        lastTempForRate = heaterTemp; 
        lastRateCheck = now; 
        return; 
    }
    
    // ========== ПРОВЕРКА ПРЕВЫШЕНИЯ ПОРОГА ==========
    // Если нагреватель включён И скорость выше порога (по умолч. 5°C/сек)
    if (heaterState && rateOfRise > config.abnormalRateThreshold) {
        static unsigned long lastAbnormalLog = 0;
        
        // Логируем предупреждение не чаще 1 раза в 10 секунд (избегаем спама)
        if (now - lastAbnormalLog > 10000) { 
            addErrorToLog("⚠️ Аномально быстрый рост температуры: " + 
                         String(rateOfRise, 1) + "°C/сек", 
                         false, true, 0); 
            lastAbnormalLog = now; 
        }
    }
    
    // ========== СОХРАНЕНИЕ ТЕКУЩИХ ЗНАЧЕНИЙ ДЛЯ СЛЕДУЮЩЕЙ ИТЕРАЦИИ ==========
    lastTempForRate = heaterTemp;
    lastRateCheck = now;
}

// ============================================================================
// ЛОГИРОВАНИЕ ОШИБОК И УВЕДОМЛЕНИЙ
// ============================================================================

// ========== ДОБАВЛЕНИЕ ОШИБКИ В ЖУРНАЛ ==========
// Основная функция логирования ошибок и предупреждений
// Параметры:
//   - message: текст ошибки
//   - isCritical: критическая ошибка (требует внимания, сохраняются тренды)
//   - includeTrends: добавлять ли историю температур (только для критических)
//   - errorCountFromCaller: счётчик повторов (для отображения в логе)
// Вызывается: всеми защитными функциями при срабатывании
void addErrorToLog(String message, bool isCritical, bool includeTrends, int errorCountFromCaller) {
    // Если система заблокирована - новые ошибки не логируем
    if (errors.isSystemLocked()) {
        return;
    }
    
    unsigned long now = millis();
    uint32_t hash = calculateErrorHash(message);
    
    // ========== ДЕДУПЛИКАЦИЯ НЕКРИТИЧЕСКИХ ОШИБОК ==========
    // Для некритических ошибок: если такая же ошибка была меньше minTimeBetweenSameErrors назад - пропускаем
    if (!isCritical && hash == lastErrorHash && now - lastErrorTime < config.minTimeBetweenSameErrors) {
        return;
    }
    
    // ========== ЗАПОЛНЕНИЕ СТРУКТУРЫ ЗАПИСИ ==========
    int repeatCount = errorCountFromCaller;
    if (repeatCount <= 0) repeatCount = 1;
    
    ErrorLogEntry entry;
    entry.timestamp = now;
    entry.message = message;
    entry.isCritical = isCritical;
    entry.hash = hash;
    entry.errorCount = repeatCount;
    
    // Определение уровня серьёзности
    if (isCritical) {
        entry.severity = "critical";
    } else if (repeatCount >= config.maxErrorRetries) {
        entry.severity = "critical";
    } else if (repeatCount > 0) {
        entry.severity = "warning";
    } else if (message.indexOf("⚠️") != -1 || message.indexOf("🔥") != -1) {
        entry.severity = "warning";
    } else {
        entry.severity = "info";
    }
    
    // ========== СОХРАНЕНИЕ ТРЕНДОВ (ТОЛЬКО ДЛЯ КРИТИЧЕСКИХ ОШИБОК) ==========
    entry.trendData = "";
    if (includeTrends && isCritical) {
        // Вспомогательная структура для временного хранения трендов
        struct TempTrendEntry {
            uint32_t timestamp;
            float airTemp;
            float heaterTemp;
            float targetTemp;
            bool heaterState;
            bool fanState;
        };
        
        const int MAX_TREND_COPY = 30;          // Максимум 30 точек тренда
        TempTrendEntry tempTrends[MAX_TREND_COPY];
        int actualCount = 0;
        
        // Копируем тренды из защищённого буфера
        taskENTER_CRITICAL(&trendBufferMux);
        
        int totalCount = trendBufferFilled ? TREND_BUFFER_SIZE : trendIndex;
        int entriesToTake = min(MAX_TREND_COPY, totalCount);
        
        if (entriesToTake > 0) {
            int currentPos = trendBufferFilled ? trendIndex : trendIndex;
            int startPos = (currentPos - entriesToTake + TREND_BUFFER_SIZE) % TREND_BUFFER_SIZE;
            
            for (int i = 0; i < entriesToTake && actualCount < MAX_TREND_COPY; i++) {
                int idx = (startPos + i) % TREND_BUFFER_SIZE;
                
                if (trendBuffer[idx].timestamp == 0) continue;
                
                tempTrends[actualCount].timestamp = trendBuffer[idx].timestamp;
                tempTrends[actualCount].airTemp = trendBuffer[idx].getAirTemp();
                tempTrends[actualCount].heaterTemp = trendBuffer[idx].getHeaterTemp();
                tempTrends[actualCount].targetTemp = trendBuffer[idx].getTargetTemp();
                tempTrends[actualCount].heaterState = trendBuffer[idx].getHeaterState();
                tempTrends[actualCount].fanState = trendBuffer[idx].getFanState();
                actualCount++;
            }
        }
        
        taskEXIT_CRITICAL(&trendBufferMux);
        
        // Формируем текстовое представление трендов
        if (actualCount > 0) {
            String trendDataStr;
            trendDataStr.reserve(3500);         // Резервируем память для эффективности
            
            trendDataStr += "=== ТРЕНДЫ ПЕРЕД АВАРИЕЙ ===\n";
            
            for (int i = 0; i < actualCount; i++) {
                unsigned long seconds = tempTrends[i].timestamp / 1000;
                unsigned long hours = seconds / 3600;
                unsigned long minutes = (seconds % 3600) / 60;
                unsigned long secs = seconds % 60;
                
                char line[128];
                snprintf(line, sizeof(line),
                         "%02lu:%02lu:%02lu Воздух:%.1f°C Нагр:%.1f°C Цель:%.1f°C H:%d F:%d\n",
                         hours, minutes, secs,
                         tempTrends[i].airTemp,
                         tempTrends[i].heaterTemp,
                         tempTrends[i].targetTemp,
                         tempTrends[i].heaterState ? 1 : 0,
                         tempTrends[i].fanState ? 1 : 0);
                trendDataStr += line;
                
                // Ограничиваем длину
                if (trendDataStr.length() > MAX_TREND_DATA_LEN) break;
            }
            
            trendDataStr += "=== КОНЕЦ ТРЕНДОВ ===\n";
            
            // Обрезаем если слишком длинный
            if (trendDataStr.length() > MAX_TREND_DATA_LEN) {
                trendDataStr = trendDataStr.substring(0, MAX_TREND_DATA_LEN);
            }
            
            entry.trendData = trendDataStr;
        } else {
            entry.trendData = "=== НЕТ ДАННЫХ (буфер пуст) ===\n";
        }
    }
    
    // ========== ДОБАВЛЕНИЕ В ЖУРНАЛ (ПОД ЗАЩИТОЙ МЬЮТЕКСА) ==========
    taskENTER_CRITICAL(&errorLogMux);
    
    // Финальная проверка дублирования (в течение последней минуты)
    bool duplicate = false;
    for (const auto& existingEntry : errorLog) {
        if (existingEntry.hash == hash && now - existingEntry.timestamp < 60000) {
            duplicate = true;
            break;
        }
    }
    
    if (!duplicate) {
        // Добавляем в начало (самые свежие сверху)
        errorLog.insert(errorLog.begin(), entry);
        
        // Ограничиваем размер журнала (FIFO)
        while (errorLog.size() > MAX_ERROR_LOG) {
            errorLog.pop_back();
        }
        
        // Сохраняем для дедупликации
        lastErrorMessage = message;
        lastErrorTime = now;
        lastErrorHash = hash;
    }
    
    taskEXIT_CRITICAL(&errorLogMux);
    
    // ========== ВЫВОД В СЕРИЙНЫЙ ПОРТ ==========
    unsigned long seconds = (now - deviceStartTime) / 1000;
    unsigned long hours = seconds / 3600;
    unsigned long minutes = (seconds % 3600) / 60;
    unsigned long secs = seconds % 60;
    
    char logBuffer[256];
    snprintf(logBuffer, sizeof(logBuffer),
             "📝 [%02lu:%02lu:%02lu] [%s] %s\n",
             hours, minutes, secs,
             entry.severity.c_str(),
             message.c_str());
    Serial.print(logBuffer);
    
    // ========== ЗВУКОВОЕ ОПОВЕЩЕНИЕ ==========
    if (shouldPlayForError(isCritical)) {
        playMelody(config.buzzerMelody, false);
    }
}

// ========== ДОБАВЛЕНИЕ ИНФОРМАЦИОННОГО СООБЩЕНИЯ В ЖУРНАЛ ==========
// Для некритичных уведомлений (успешные действия, смена состояний)
// Не вызывает звуковой сигнал, не сохраняет тренды
// Вызывается: при успешных операциях, автосбросе ошибок, изменении режимов
void addNotificationToLog(String message) {
    // Если система заблокирована - уведомления не логируем
    if (errors.isSystemLocked()) {
        return;
    }
    
    unsigned long now = millis();
    static uint32_t lastNotifHash = 0;
    static unsigned long lastNotifTime = 0;
    uint32_t hash = calculateErrorHash(message);
    
    // Дедупликация: одинаковые уведомления не чаще 30 секунд
    if (hash == lastNotifHash && now - lastNotifTime < 30000) {
        return;
    }
    
    lastNotifHash = hash;
    lastNotifTime = now;
    
    // Формируем запись (добавляем эмодзи для визуального выделения)
    ErrorLogEntry entry;
    entry.timestamp = now - deviceStartTime;
    entry.message = message;
    entry.trendData = "";
    entry.isCritical = false;
    entry.hash = calculateErrorHash("ℹ️ " + message);
    entry.severity = "info";
    entry.errorCount = 1;
    
    // Добавляем в журнал под защитой мьютекса
    taskENTER_CRITICAL(&errorLogMux);
    
    // Проверка дублирования в течение последних 30 секунд
    for (const auto& e : errorLog) {
        if (e.hash == entry.hash && now - e.timestamp < 30000) {
            taskEXIT_CRITICAL(&errorLogMux);
            return;
        }
    }
    
    // Добавляем в начало (самые свежие сверху)
    errorLog.insert(errorLog.begin(), entry);
    
    // Ограничиваем размер журнала
    while (errorLog.size() > MAX_ERROR_LOG) {
        errorLog.pop_back();
    }
    
    taskEXIT_CRITICAL(&errorLogMux);
}

// ============================================================================
// ТРЕНДЫ (ИСТОРИЯ ТЕМПЕРАТУР ДЛЯ ГРАФИКА)
// ============================================================================

// Добавляет текущие показания в кольцевой буфер трендов
// Использует компактную структуру для экономии памяти (16 байт на точку)
// При активной термальной модели добавляет предсказанную температуру
// Также отправляет обновления через WebSocket всем подключённым клиентам
// Вызывается: webTask() по таймеру trendInterval (3000 мс по умолчанию)
void addToTrendBuffer() {
    // ========== РАСЧЁТ ВРЕМЕНИ РАБОТЫ ==========
    unsigned long uptime = millis() - deviceStartTime;   // Время в миллисекундах от запуска
    
    // ========== ПРЕДСКАЗАНИЕ ТЕРМАЛЬНОЙ МОДЕЛИ (ЕСЛИ АКТИВНА) ==========
    float predicted = 0;
    if (config.enableThermalModel && adaptiveModel.initialized) {
        // Предсказываем температуру через 5 секунд
        predicted = adaptiveModel.predict(heaterTemp, targetTemp, 
                                          heaterState ? 1.0 : 0.0, 
                                          fanState ? 1.0 : 0.0, 
                                          5.0);
    }
    
    // ========== ФОРМИРОВАНИЕ КОМПАКТНОЙ ЗАПИСИ ==========
    CompactTrendEntry newEntry;
    newEntry.timestamp = uptime;                                    // Временная метка (мс)
    newEntry.airTemp = (int16_t)(airTemp * 10);                     // T_воздух * 10 (точность 0.1°C)
    newEntry.heaterTemp = (int16_t)(heaterTemp * 10);               // T_нагревателя * 10
    newEntry.targetTemp = (int16_t)(targetTemp * 10);               // Целевая T * 10
    newEntry.predictedTemp = (int16_t)(predicted * 10);             // Предсказанная T * 10
    newEntry.flags = (heaterState ? 1 : 0) | (fanState ? 2 : 0);    // Битовая маска состояний
    
    // ========== СОХРАНЕНИЕ В КОЛЬЦЕВОЙ БУФЕР (ЗАЩИЩЁННАЯ СЕКЦИЯ) ==========
    taskENTER_CRITICAL(&trendBufferMux);
    
    // Проверка переполнения буфера (кольцевой буфер)
    if (trendIndex >= TREND_BUFFER_SIZE) {
        trendIndex = 0;                         // Сбрасываем индекс в начало
        trendBufferFilled = true;               // Отмечаем что буфер полностью заполнен
    }
    
    // Сохраняем новую точку
    trendBuffer[trendIndex] = newEntry;
    trendIndex++;                               // Перемещаем указатель
    
    taskEXIT_CRITICAL(&trendBufferMux);
    
    // ========== ОТПРАВКА ОБНОВЛЕНИЙ ЧЕРЕЗ WEBSOCKET ==========
    // Отправляем только если есть подключённые клиенты
    if (ws.count() > 0) {
        // Используем ArduinoJson для формирования JSON (небольшой документ, 512 байт)
        StaticJsonDocument<512> doc;
        doc["type"] = "history_update";                     // Тип сообщения
        JsonArray data = doc.createNestedArray("data");     // Массив данных (одна точка)
        JsonObject point = data.createNestedObject();
        
        point["t"] = uptime;                                // Время (мс)
        point["a"] = airTemp;                               // T_воздух (°C)
        point["h"] = heaterTemp;                            // T_нагревателя (°C)
        point["tg"] = targetTemp;                           // Целевая T (°C)
        point["fp"] = actualFanDuty;                        // Текущая мощность вентилятора (duty)
        
        // Добавляем предсказание от термальной модели если доступно
        if (config.enableThermalModel && adaptiveModel.initialized) {
            point["pred"] = predicted;                      // Предсказанная T (°C)
        }
        
        // Сериализуем и отправляем всем клиентам
        String output;
        serializeJson(doc, output);
        ws.textAll(output);
    }
}

// ============================================================================
// АДАПТАЦИЯ (САМОНАСТРОЙКА СИСТЕМЫ)
// ============================================================================

// ========== ЗАПУСК АДАПТАЦИИ ==========
// Инициирует процесс самонастройки системы под конкретный принтер
// Параметры: targetUserTemp - целевая температура адаптации (40-70°C)
// Вызывается: API /api/adapt/start
// Процесс включает: измерение шумов датчиков, калибровку вентилятора,
//                   определение скорости нагрева/охлаждения, расчёт оптимальных порогов защит
void startAdaptation(float targetUserTemp) {
    // ========== ПРЕДВАРИТЕЛЬНЫЕ ПРОВЕРКИ ==========
    float oldTarget = targetTemp;
    targetTemp = 1.0;                           // Временно устанавливаем цель для индикации
    
    if (adaptationInProgress) return;           // Уже запущена
    resetAdaptationBlock();                     // Сбрасываем блокировки
    
    // Проверка блокировки системы
    if (errors.isSystemLocked()) { 
        adaptStatusMessage = "❌ Система заблокирована!"; 
        adaptationBlockReason = "Система заблокирована"; 
        adaptationBlocked = true; 
        return; 
    }
    
    // ========== УСТАНОВКА ПАРАМЕТРОВ АДАПТАЦИИ ==========
    adaptTargetTemp = constrain(targetUserTemp, 40, 70);    // Цель адаптации (ограничена 40-70°C)
    
    // Сохраняем начальные температуры для расчётов
    adaptStats.initialAirTemp = airTemp; 
    adaptStats.initialHeaterTemp = heaterTemp;
    
    // ========== ВРЕМЕННОЕ ОТКЛЮЧЕНИЕ ЗАЩИТ ==========
    // На время адаптации защиты отключаются, т.к. будут измеряться экстремальные режимы
    errors.protectionsDisabled = true; 
    adaptationInProgress = true; 
    adaptTempDisableProtections = true;
    
    // ========== НАЧАЛЬНАЯ ФАЗА ==========
    currentAdaptPhase = ADAPT_WAITING_STABLE;               // Фаза 1: ожидание стабилизации
    adaptPhaseStartTime = millis(); 
    adaptProgressPercent = 0;
    
    // Выключаем нагрев и вентилятор для исходного состояния
    digitalWrite(config.pinSsr, config.invertHeaterSignal ? HIGH : LOW);  // SSR выключен
    heaterState = false;
    digitalWrite(config.pinFan, config.invertFanSignal ? HIGH : LOW);     // Вентилятор выключен
    fanState = false;
    
    // Логируем запуск
    addNotificationToLog("🚀 Запущена адаптация системы");
    LOG_INFO("=== НАЧАЛО АДАПТАЦИИ: Tн=%.1f°C, Tв=%.1f°C, цель=%.0f°C ===", 
            heaterTemp, airTemp, adaptTargetTemp);
}

// ========== ОСНОВНОЙ КОНЕЧНЫЙ АВТОМАТ АДАПТАЦИИ ==========
// Вызывается: controlTask() по таймеру (каждые 500 мс) если adaptationInProgress == true
// Реализует 9 фаз самонастройки системы (см. описание фаз в начале файла)
void processAdaptation() {
    if (!adaptationInProgress) return;
    
    unsigned long now = millis();
    unsigned long phaseElapsed = now - adaptPhaseStartTime;
    
    static int lastProgress = 0;            // Предыдущее значение прогресса (для защиты от уменьшения)
    
    switch (currentAdaptPhase) {
        // ========== ФАЗА 0: ОЖИДАНИЕ СТАБИЛИЗАЦИИ ==========
        case ADAPT_WAITING_STABLE: {
            adaptStatusMessage = "Ожидание стабилизации... " + String(phaseElapsed/1000) + "с";
            int newProgress = map(phaseElapsed, 0, ADAPT_STABLE_TIME, 0, 5);
            adaptProgressPercent = constrain(newProgress, 0, 5);
            
            float tempDiff = abs(heaterTemp - airTemp);
            bool ready = true;
            String reason = "";
            
            // Проверка выравнивания температур
            if (tempDiff > TEMP_EQUALIZATION_THRESHOLD) {
                ready = false;
                reason = "❌ Температуры не выровнены. Разница: " + String(tempDiff,1) + "°C";
            }
            // Проверка на слишком высокую температуру (безопасность)
            else if (heaterTemp > 35 || airTemp > 35) {
                ready = false;
                reason = "❌ Слишком высокая температура. Нужно <35°C";
            }
            // Проверка на слишком низкую температуру
            else if (heaterTemp < 5 || airTemp < 5) {
                ready = false;
                reason = "❌ Слишком низкая температура. Нужно >5°C";
            }
            
            if (!ready) {
                adaptStatusMessage = reason;
                adaptPhaseStartTime = now;          // Сбрасываем таймер при неготовности
                break;
            }
            
            // Проверка стабильности температуры нагревателя
            static float lastStableTemp = heaterTemp;
            static int stableCount = 0;
            static unsigned long lastStabilityCheck = 0;

            if (now - lastStabilityCheck >= STABILITY_CHECK_INTERVAL) {
                lastStabilityCheck = now;
                
                if (abs(heaterTemp - lastStableTemp) < STABILITY_THRESHOLD) {
                    stableCount++;
                } else {
                    stableCount = 0;
                }
                lastStableTemp = heaterTemp;   // обновляем ТОЛЬКО в момент проверки
            }
            // ИНАЧЕ НИЧЕГО НЕ ДЕЛАЕМ — ни обнуления, ни обновления lastStableTemp

            // Переход к следующей фазе при достаточной стабильности
            if (stableCount >= STABILITY_REQUIRED_COUNT) {
                currentAdaptPhase = ADAPT_MEASURE_NOISE;
                adaptPhaseStartTime = now;
                lastProgress = 0;
            }
            break;
        }

        // ========== ФАЗА 1: ИЗМЕРЕНИЕ ШУМОВ ДАТЧИКОВ ==========
        case ADAPT_MEASURE_NOISE: {
            static float heaterSamples[50];
            static float airSamples[50];
            static int sampleCount = 0;
            
            if (phaseElapsed < 1000) {
                sampleCount = 0;
                addNotificationToLog("📊 Измерение шумов датчиков (система в покое)");
            }
            
            // Сохраняем показания
            heaterSamples[sampleCount] = heaterTemp;
            airSamples[sampleCount] = airTemp;
            sampleCount++;
            
            // По окончании сбора данных вычисляем среднеквадратичное отклонение
            if (phaseElapsed > ADAPT_NOISE_MEASURE_TIME && sampleCount > 10) {
                // Расчёт среднего
                float heaterMean = 0, airMean = 0;
                for (int i = 0; i < sampleCount; i++) {
                    heaterMean += heaterSamples[i];
                    airMean += airSamples[i];
                }
                heaterMean /= sampleCount;
                airMean /= sampleCount;
                
                // Расчёт дисперсии
                float heaterVariance = 0, airVariance = 0;
                for (int i = 0; i < sampleCount; i++) {
                    heaterVariance += pow(heaterSamples[i] - heaterMean, 2);
                    airVariance += pow(airSamples[i] - airMean, 2);
                }
                
                // Среднеквадратичное отклонение (σ)
                adaptStats.heaterSensorNoiseLevel = sqrt(heaterVariance / sampleCount);
                adaptStats.airSensorNoiseLevel = sqrt(airVariance / sampleCount);
                
                addNotificationToLog("✅ Измерение шумов: MAX6675 σ=" + 
                                    String(adaptStats.heaterSensorNoiseLevel, 3) + "°C, DS18B20 σ=" + 
                                    String(adaptStats.airSensorNoiseLevel, 3) + "°C");
                
                currentAdaptPhase = ADAPT_MEASURE_BASELINE;
                adaptPhaseStartTime = now;
                lastProgress = 0;
            }
            break;
        }
        
        // ========== ФАЗА 2: ИЗМЕРЕНИЕ БАЗОВЫХ ПАРАМЕТРОВ ==========
        case ADAPT_MEASURE_BASELINE: {
            adaptStatusMessage = "Измерение базовых параметров... " + String(phaseElapsed/1000) + "с";
            int newProgress = map(phaseElapsed, 0, ADAPT_BASELINE_TIME, 5, 10);
            adaptProgressPercent = constrain(newProgress, 5, 10);
            
            // Измерение максимальных скачков температуры
            static float lastBaselineHeater = heaterTemp, lastBaselineAir = airTemp;
            float heaterJump = abs(heaterTemp - lastBaselineHeater);
            float airJump = abs(airTemp - lastBaselineAir);
            if (heaterJump > adaptStats.heaterSensorMaxJump) adaptStats.heaterSensorMaxJump = heaterJump;
            if (airJump > adaptStats.airSensorMaxJump) adaptStats.airSensorMaxJump = airJump;
            lastBaselineHeater = heaterTemp;
            lastBaselineAir = airTemp;
            
            if (phaseElapsed > ADAPT_BASELINE_TIME) {
                currentAdaptPhase = ADAPT_FAN_CALIBRATION;
                adaptPhaseStartTime = now;
                adaptStats.calibrated = false;
                lastProgress = 0;
                addNotificationToLog("🔧 Адаптация: калибровка вентилятора...");
            }
            break;
        }
        
        // ========== ФАЗА 3: КАЛИБРОВКА ВЕНТИЛЯТОРА ==========
        // Подбирает оптимальную мощность вентилятора и температуру включения
        case ADAPT_FAN_CALIBRATION: {
            adaptStatusMessage = "Калибровка вентилятора...";
            fanControlEnabled = false;                // Отключаем автоматическое управление
            adaptProgressPercent = 15;
            
            // Статические переменные для хранения состояния калибровки
            static int subPhase = 0;                  // 0=оптимальная мощность, 1=температура включения
            static int testDuty = 1023;
            static int stage = 0;
            static unsigned long lastChangeTime = 0;
            static float stableTemp = 0;
            static int stableCount = 0;
            static int finalOptimalDuty = 1023;
            static int finalMinDuty = 1023;
            static float baseTemp = 0;
            static int step = 100;
            static float targetTemp = 0;
            
            static int testFanOnTemp = 30;
            static int stepTemp = 5;
            static int testPhase = 0;
            static unsigned long testStartTime = 0;
            static float maxTemp = 0;
            static int finalFanOnTemp = 55;
            
            // Инициализация при входе в фазу
            if (phaseElapsed < 1000) {
                digitalWrite(config.pinSsr, config.invertHeaterSignal ? LOW : HIGH);  // Включаем нагрев
                heaterState = true;
                
                if (config.enableFanAutoLimit) {
                    // Подфаза 0: поиск оптимальной мощности
                    subPhase = 0;
                    testDuty = 1023;
                    stage = 0;
                    step = 100;
                    finalOptimalDuty = 1023;
                    finalMinDuty = 1023;
                    baseTemp = heaterTemp;
                    stableCount = 0;
                    targetTemp = config.maxHeaterTemp - 5;
                    lastChangeTime = now;
                    stableTemp = heaterTemp;
                    setFanDuty(testDuty);
                    currentDynamicDuty = testDuty;
                    addNotificationToLog("🔥 Калибровка вентилятора: поиск оптимальной мощности");
                } else {
                    // Подфаза 1: поиск температуры включения
                    subPhase = 1;
                    testFanOnTemp = 30;
                    stepTemp = 5;
                    finalFanOnTemp = 55;
                    testPhase = 0;
                    testStartTime = now;
                    maxTemp = 0;
                    setFanDuty(0);
                    currentDynamicDuty = 0;
                    addNotificationToLog("🔥 Калибровка вентилятора: поиск температуры включения");
                }
                break;
            }
            
            // ========== ПОДФАЗА 0: ПОИСК ОПТИМАЛЬНОЙ МОЩНОСТИ ==========
            if (subPhase == 0 && config.enableFanAutoLimit) {
                adaptProgressPercent = 15 + map(constrain(phaseElapsed, 0, 180000), 0, 180000, 0, 20);
                adaptProgressPercent = constrain(adaptProgressPercent, 15, 35);
                
                // Ждём стабилизации температуры
                if (abs(heaterTemp - stableTemp) < 0.5) stableCount++;
                else { stableCount = 0; stableTemp = heaterTemp; }
                
                if (stableCount >= 3 && (now - lastChangeTime) >= 15000 && stage != 4) {
                    lastChangeTime = now;
                    stableCount = 0;
                    
                    float error = heaterTemp - targetTemp;
                    
                    // Этап 0: быстрое снижение мощности
                    if (stage == 0) {
                        if (heaterTemp - baseTemp >= 15 || heaterTemp > targetTemp - 20) {
                            stage = 1; step = 20;
                        } else {
                            int newDuty = constrain(testDuty - step, 100, 1023);
                            if (newDuty != testDuty) {
                                testDuty = newDuty;
                                setFanDuty(testDuty);
                                currentDynamicDuty = testDuty;
                            } else { stage = 1; step = 20; }
                        }
                    }
                    // Этап 1: грубая подстройка
                    else if (stage == 1) {
                        if (abs(error) <= 15) { stage = 2; step = 1; }
                        else if (error > 15 && testDuty < 1023) {
                            testDuty = min(1023, testDuty + 20);
                            setFanDuty(testDuty);
                            currentDynamicDuty = testDuty;
                        }
                        else if (error < -15 && testDuty > 100) {
                            testDuty = max(100, testDuty - 20);
                            setFanDuty(testDuty);
                            currentDynamicDuty = testDuty;
                        }
                        else { stage = 2; step = 1; }
                    }
                    // Этап 2: точная подстройка
                    else if (stage == 2) {
                        if (error >= -2 && error <= 2) {
                            finalOptimalDuty = testDuty;
                            stage = 3;
                        }
                        else if (error > 2 && testDuty < 1023) {
                            testDuty = min(1023, testDuty + 1);
                            setFanDuty(testDuty);
                            currentDynamicDuty = testDuty;
                        }
                        else if (error < -2 && testDuty > 100) {
                            testDuty = max(100, testDuty - 1);
                            setFanDuty(testDuty);
                            currentDynamicDuty = testDuty;
                        }
                        else { finalOptimalDuty = testDuty; stage = 3; }
                    }
                    // Этап 3: поиск минимальной мощности
                    else if (stage == 3) {
                        if (heaterTemp > config.maxHeaterTemp + 10 || testDuty <= 100) {
                            finalMinDuty = testDuty;
                            stage = 4;
                        } else {
                            testDuty = testDuty - 1;
                            setFanDuty(testDuty);
                            currentDynamicDuty = testDuty;
                        }
                    }
                    
                    // Завершение подфазы 0
                    if (stage == 4) {
                        config.maxFanDuty = finalOptimalDuty;
                        config.fanAutoLimitMinDuty = finalMinDuty;
                        saveConfig();
                        adaptStats.optimalPower = finalOptimalDuty;
                        adaptStats.calibratedMinDuty = finalMinDuty;
                        adaptStats.calibrated = true;
                        
                        subPhase = 1;
                        testFanOnTemp = 30;
                        stepTemp = 5;
                        finalFanOnTemp = 55;
                        testPhase = 0;
                        testStartTime = now;
                        maxTemp = 0;
                        setFanDuty(0);
                        currentDynamicDuty = 0;
                    }
                }
            }
            
            // ========== ПОДФАЗА 1: ПОИСК ТЕМПЕРАТУРЫ ВКЛЮЧЕНИЯ ==========
            if (subPhase == 1) {
                adaptProgressPercent = 35 + map(constrain(phaseElapsed, 0, 300000), 0, 300000, 0, 15);
                adaptProgressPercent = constrain(adaptProgressPercent, 35, 50);
                
                // Тест 0: нагрев до порога включения
                if (testPhase == 0) {
                    if (!heaterState) {
                        digitalWrite(config.pinSsr, config.invertHeaterSignal ? LOW : HIGH);
                        heaterState = true;
                    }
                    setFanDuty(0);
                    
                    if (heaterTemp >= testFanOnTemp) {
                        int fanPower = (config.enableFanAutoLimit && finalOptimalDuty > 0) ? finalOptimalDuty : 1023;
                        setFanDuty(fanPower);
                        currentDynamicDuty = fanPower;
                        testPhase = 1;
                        testStartTime = now;
                        maxTemp = heaterTemp;
                        stableCount = 0;
                    }
                }
                // Тест 1: стабилизация и измерение максимальной температуры
                else if (testPhase == 1) {
                    if (heaterTemp > maxTemp) maxTemp = heaterTemp;
                    
                    static float lastStableTemp = heaterTemp;
                    if (abs(heaterTemp - lastStableTemp) < 0.5) stableCount++;
                    else stableCount = 0;
                    lastStableTemp = heaterTemp;
                    
                    if (stableCount >= 3 || (now - testStartTime) > 45000) {
                        if (maxTemp <= config.maxHeaterTemp - 5) {
                            int newTemp = testFanOnTemp + stepTemp;
                            if (newTemp <= 80) {
                                testFanOnTemp = newTemp;
                                testPhase = 2;
                                testStartTime = now;
                            } else {
                                finalFanOnTemp = testFanOnTemp - (stepTemp * 2);
                                config.fanOnTemp = finalFanOnTemp;
                                config.fanOffHysteresis = 5;
                                saveConfig();
                                subPhase = 2;
                            }
                        } else {
                            finalFanOnTemp = testFanOnTemp - (stepTemp * 3);
                            if (finalFanOnTemp < 30) finalFanOnTemp = 30;
                            config.fanOnTemp = finalFanOnTemp;
                            config.fanOffHysteresis = 5;
                            saveConfig();
                            subPhase = 2;
                        }
                    }
                }
                // Тест 2: охлаждение
                else if (testPhase == 2) {
                    if (heaterState) {
                        digitalWrite(config.pinSsr, config.invertHeaterSignal ? HIGH : LOW);
                        heaterState = false;
                    }
                    setFanDuty(1023);
                    currentDynamicDuty = 1023;
                    
                    if (heaterTemp <= 35 || phaseElapsed > ADAPT_COOLDOWN_PHASE2_TIME * 1000UL) {
                        testPhase = 0;
                        setFanDuty(0);
                        currentDynamicDuty = 0;
                        testStartTime = now;
                        maxTemp = 0;
                        stableCount = 0;
                    }
                }
            }
            
            // Переход к следующей основной фазе
            if (subPhase == 2) {
                setFanDuty(0);
                currentDynamicDuty = 0;
                digitalWrite(config.pinSsr, config.invertHeaterSignal ? HIGH : LOW);
                heaterState = false;
                currentAdaptPhase = ADAPT_HEATING_PHASE;
                adaptPhaseStartTime = now;
                lastProgress = 0;
                addNotificationToLog("🔥 Переходим к нагреву с вентилятором");
            }
            break;
        }

        // ========== ФАЗА 4: НАГРЕВ С ВЕНТИЛЯТОРОМ ==========
        case ADAPT_HEATING_PHASE: {
            static int step = 0;
            static float startHeatTemp = 0;
            static float prevTemp = heaterTemp;
            static unsigned long lastChangeTime = now;
            static bool heatingStarted = false;
            static float maxHeatingRate = 0;
            static unsigned long lastRateTime = 0;
            static float lastRateTemp = 0;
            
            static unsigned long heatingStartTime = 0;
            static float first30secRate = 0;
            static bool first30secDone = false;
            
            // Инициализация
            if (phaseElapsed < 1000) {
                step = 0;
                heatingStarted = false;
                maxHeatingRate = 0;
                lastRateTime = 0;
                lastRateTemp = 0;
                heatingStartTime = 0;
                first30secRate = 0;
                first30secDone = false;
                adaptStats.profile.heatingCount = 0;
                adaptStats.profile.startTemp = heaterTemp;
                addNotificationToLog("🔥 Подготовка к измерению скорости нагрева");
            }
            
            // Шаг 0: охлаждение перед тестом
            if (step == 0) {
                setFanDuty(1023);
                currentDynamicDuty = 1023;
                digitalWrite(config.pinSsr, config.invertHeaterSignal ? HIGH : LOW);
                heaterState = false;
                
                if (heaterTemp <= 35 || phaseElapsed > ADAPT_HEATING_PHASE1_TIMEOUT * 1000UL) {
                    step = 1;
                    startHeatTemp = heaterTemp;
                    heatingStarted = false;
                    maxHeatingRate = 0;
                    lastRateTime = 0;
                    lastRateTemp = 0;
                    heatingStartTime = 0;
                    first30secRate = 0;
                    first30secDone = false;
                    addNotificationToLog("✅ Охлаждение завершено, T=" + String(heaterTemp,1) + "°C");
                    addNotificationToLog("🔥 Начинаем нагрев с вентилятором");
                }
                adaptStatusMessage = "Охлаждение перед тестом: " + String(heaterTemp, 1) + "°C";
                int newProgress = map(constrain(heaterTemp, 35, 80), 35, 80, 50, 55);
                adaptProgressPercent = constrain(newProgress, 50, 55);
            }
            // Шаг 1: нагрев и измерение скорости
            else if (step == 1) {
                static unsigned long lastProfileSec = 0;
                fanControlEnabled = true;
                if (!heaterState) {
                    digitalWrite(config.pinSsr, config.invertHeaterSignal ? LOW : HIGH);
                    heaterState = true;
                }

                if (heatingStartTime == 0) {
                    heatingStartTime = now;
                    lastProfileSec = 0;
                }

                // Запись профиля разогрева каждую секунду
                unsigned long sec = (now - heatingStartTime) / 1000;
                if (sec < PROFILE_SIZE && sec != lastProfileSec && adaptStats.profile.heatingCount < PROFILE_SIZE) {
                    adaptStats.profile.heatingWithFan[sec] = heaterTemp;
                    adaptStats.profile.airDuringHeating[sec] = airTemp;
                    lastProfileSec = sec;
                    adaptStats.profile.heatingCount = sec + 1;
                    adaptStats.profile.startTemp = startHeatTemp;
                    adaptStats.profile.targetTemp = adaptTargetTemp;
                }
                
                float elapsedMin = phaseElapsed / 60000.0;
                if (elapsedMin < 0.1) elapsedMin = 0.1;
                
                // Аварийная остановка при перегреве
                if (heaterTemp > config.maxHeaterTemp + 20) {
                    adaptStatusMessage = "❌ Аварийное прерывание!";
                    addErrorToLog(adaptStatusMessage, true, false, 0);
                    currentAdaptPhase = ADAPT_FAILED;
                    adaptPhaseStartTime = now;
                    break;
                }
                
                // Средняя скорость нагрева (°C/мин)
                float heaterRise = heaterTemp - startHeatTemp;
                adaptStats.heatingRateHeater = heaterRise / elapsedMin;
                
                // Пиковая мгновенная скорость
                if (lastRateTime == 0) {
                    lastRateTime = now;
                    lastRateTemp = heaterTemp;
                } else {
                    unsigned long elapsedMs = now - lastRateTime;
                    if (elapsedMs >= 500) {
                        float ratePerSec = (heaterTemp - lastRateTemp) * 1000.0 / elapsedMs;
                        if (ratePerSec > maxHeatingRate) {
                            maxHeatingRate = ratePerSec;
                        }
                        lastRateTime = now;
                        lastRateTemp = heaterTemp;
                    }
                }
                
                // Скорость за первые 30 секунд
                unsigned long heatingElapsed = (now - heatingStartTime) / 1000;
                if (!first30secDone && heatingElapsed >= 30) {
                    float tempRise30sec = heaterTemp - startHeatTemp;
                    first30secRate = tempRise30sec * 60.0 / 30.0;
                    first30secDone = true;
                    addNotificationToLog("📊 Средняя скорость за первые 30 секунд: " + String(first30secRate, 1) + "°C/мин");
                }
                
                // Ожидание стабилизации
                if (!heatingStarted && heaterTemp > startHeatTemp + 15) {
                    heatingStarted = true;
                    lastChangeTime = now;
                    addNotificationToLog("🌡️ Нагрев активен, ждём стабилизации...");
                }
                
                if (heatingStarted) {
                    if (abs(heaterTemp - prevTemp) < ADAPT_TEMP_TOLERANCE) {
                        if (now - lastChangeTime > 5000) {
                            digitalWrite(config.pinSsr, config.invertHeaterSignal ? HIGH : LOW);
                            heaterState = false;
                            currentAdaptPhase = ADAPT_WAITING_USER;
                            adaptPhaseStartTime = now;
                            adaptWaitingForUser = true;
                            adaptUserWaitStartTime = 0;
                            lastProgress = 0;
                            addNotificationToLog("✅ Температура стабилизировалась на " + String(heaterTemp, 1) + "°C");
                            addNotificationToLog("📈 Средняя скорость нагрева (общая): " + String(adaptStats.heatingRateHeater, 1) + "°C/мин");
                            addNotificationToLog("📈 Средняя скорость за первые 30 сек: " + String(first30secRate, 1) + "°C/мин");
                            addNotificationToLog("📈 Максимальная мгновенная скорость: " + String(maxHeatingRate, 1) + "°C/сек");
                            
                            adaptStats.maxHeatingRate = maxHeatingRate;
                            adaptStats.first30secHeatingRate = first30secRate;
                            adaptStats.timeToMaxHeaterTemp = (now - heatingStartTime) / 1000.0;  // Время до макс. T нагревателя (сек)
                            adaptStats.maxHeaterTempStable = heaterTemp;
                            adaptStats.heaterAirDelta = heaterTemp - airTemp;                            
                            break;
                        }
                    } else {
                        lastChangeTime = now;
                    }
                }
                
                prevTemp = heaterTemp;
                
                // Обновление прогресса
                int maxTempForProgress = startHeatTemp + 40;
                if (maxTempForProgress > config.maxHeaterTemp) maxTempForProgress = config.maxHeaterTemp;
                int newProgress = map(constrain(heaterTemp, startHeatTemp, maxTempForProgress), 
                                    startHeatTemp, maxTempForProgress, 55, 70);
                adaptProgressPercent = constrain(newProgress, 55, 70);
                adaptStatusMessage = "Нагрев с вентилятором: " + String(heaterTemp, 1) + "°C" + 
                                    (heatingStarted ? " (стабилизация...)" : " (набор температуры...)");
            }
            break;
        }

        // ========== ФАЗА 5: ОЖИДАНИЕ ПОЛЬЗОВАТЕЛЯ ==========
        case ADAPT_WAITING_USER: {
            adaptStatusMessage = "⏸️ ОЖИДАНИЕ ПОЛЬЗОВАТЕЛЯ: Опустите стол, включите нагрев стола 100-110°C, затем закройте камеру и нажмите 'ПРОДОЛЖИТЬ'";
            adaptProgressPercent = 85;  // Явно устанавливаем прогресс
            
            if (adaptUserWaitStartTime == 0) {
                adaptUserWaitStartTime = now;
                addNotificationToLog("🔍 Таймер ожидания запущен");
            }
            
            // Таймаут 30 минут
            if ((now - adaptUserWaitStartTime) > 1800000) {
                addNotificationToLog("❌ Таймаут ожидания пользователя (30 минут). Адаптация прервана.");
                currentAdaptPhase = ADAPT_FAILED;
                adaptPhaseStartTime = now;
                adaptWaitingForUser = false;
                lastProgress = 85;  // Сохраняем текущий прогресс как последний
                adaptUserWaitStartTime = 0;
            }
            break;
        }
        
        // ========== ФАЗА 6: НАГРЕВ КАМЕРЫ (ОСНОВНАЯ) ==========
        // Самая длительная фаза адаптации. Измеряет скорость нагрева воздуха,
        // калибрует параметры управления вентилятором и ждёт достижения целевой температуры.
        case ADAPT_HEATING_PHASE2: {
            fanControlEnabled = false;               // Отключаем автоматическое управление вентилятором
            
            // ========== ПЕРЕМЕННЫЕ ДЛЯ ИЗМЕРЕНИЯ СКОРОСТИ ВОЗДУХА ==========
            static float maxAirHeatingRate = 0;      // Максимальная скорость нагрева воздуха (°C/сек)
            static unsigned long lastAirRateTime = 0;
            static float lastAirTemp = 0;
            static bool airRateInitialized = false;
            
            // ========== ПЕРЕМЕННЫЕ ДЛЯ РЕЖИМА ОХЛАЖДЕНИЯ ==========
            static bool cooldownMode = false;        // Флаг режима охлаждения после достижения цели
            static float coolStartTemp = 0;          // Температура в начале охлаждения
            static unsigned long coolStartTime = 0;  // Время начала охлаждения
            
            // ========== ПЕРЕМЕННЫЕ ДЛЯ КАЛИБРОВКИ ПАРАМЕТРОВ ВЕНТИЛЯТОРА ==========
            static int calibrationPhase = 0;          // 0=поиск, 1=тестирование
            static int testStep = 5;                  // Текущий тестируемый шаг коррекции
            static int testInterval = 3000;           // Текущий тестируемый интервал (мс)
            static int testHysteresis = 2;            // Текущий тестируемый гистерезис (°C)
            static int testStableCount = 3;           // Текущий тестируемый счётчик стабильности
            static unsigned long calibrationStartTime = 0;
            static unsigned long lastAdjustTime = 0;
            static int bestStep = 5;                  // Лучший найденный шаг
            static int bestInterval = 3000;           // Лучший найденный интервал
            static int bestHysteresis = 2;            // Лучший найденный гистерезис
            static int bestStableCount = 3;           // Лучший найденный счётчик стабильности
            static float bestOscillation = 999;       // Лучший размах температуры (минимальный)
            static float tempHistory[20] = {0};       // История температур для оценки стабильности
            static int tempHistoryIndex = 0;
            static int tempHistoryCount = 0;
            static float maxTemp = 0;                 // Максимальная температура при текущем тесте
            static float minTemp = 999;               // Минимальная температура при текущем тесте
            static unsigned long stabilityStartTime = 0;
            static bool targetReached = false;        // Достигнута ли цель по вентилятору
            static int paramSetIndex = 0;             // Индекс перебираемой комбинации параметров
            
            // ========== ВКЛЮЧЕНИЕ НАГРЕВА (ЕСЛИ НЕ В РЕЖИМЕ ОХЛАЖДЕНИЯ) ==========
            if (!cooldownMode && !heaterState) {
                digitalWrite(config.pinSsr, config.invertHeaterSignal ? LOW : HIGH);
                heaterState = true;
                addNotificationToLog("🔥 Нагрев включён для фазы нагрева камеры");
            }
            
            // ========== РЕЖИМ ОХЛАЖДЕНИЯ ==========
            // Активируется после достижения целевой температуры воздуха
            if (cooldownMode) {
                float fanOffThreshold = config.fanOnTemp - config.fanOffHysteresis;
                
                // Охлаждение завершено - переходим к финальной фазе
                if (heaterTemp <= fanOffThreshold) {
                    float coolEndTemp = heaterTemp;
                    float elapsedSec = (now - coolStartTime) / 1000.0;
                    float coolingRate = (coolStartTemp - coolEndTemp) / elapsedSec;
                    adaptStats.coolingRateWithFan = coolingRate;
                    addNotificationToLog("📊 Скорость охлаждения нагревателя: " + String(coolingRate, 2) + "°C/сек");
                    
                    setFanDuty(0);
                    currentDynamicDuty = 0;
                    fanState = false;
                    
                    cooldownMode = false;
                    currentAdaptPhase = ADAPT_COMPLETE;    // Переход к завершению
                    adaptPhaseStartTime = now;
                    lastProgress = 0;
                    saveDutyTable();                       // Сохраняем таблицу duty
                    break;
                }
                
                // Обновление прогресса охлаждения
                float totalDrop = coolStartTemp - fanOffThreshold;
                float currentDrop = coolStartTemp - heaterTemp;
                if (totalDrop > 0) {
                    int progressPercent = 85 + constrain((int)(currentDrop / totalDrop * 13), 0, 13);
                    adaptProgressPercent = constrain(progressPercent, 85, 98);
                } else {
                    adaptProgressPercent = 85;
                }
                adaptStatusMessage = "Охлаждение нагревателя: " + String(heaterTemp, 1) + "°C (цель " + String(fanOffThreshold, 1) + "°C)";
                break;
            }
            
            // ========== ИНИЦИАЛИЗАЦИЯ ПРИ ВХОДЕ В ФАЗУ ==========
            if (phaseElapsed < 1000) {
                maxAirHeatingRate = 0;
                airRateInitialized = false;
                lastAirRateTime = 0;
                lastAirTemp = 0;
                cooldownMode = false;
                
                calibrationPhase = 0;
                bestOscillation = 999;
                targetReached = false;
                paramSetIndex = 0;
            }
            
            // ========== ИЗМЕРЕНИЕ СКОРОСТИ НАГРЕВА ВОЗДУХА ==========
            if (!airRateInitialized) {
                lastAirRateTime = now;
                lastAirTemp = airTemp;
                airRateInitialized = true;
            } else {
                unsigned long elapsedMs = now - lastAirRateTime;
                if (elapsedMs >= 1000) {
                    float ratePerSec = (airTemp - lastAirTemp) * 1000.0 / elapsedMs;
                    if (ratePerSec > maxAirHeatingRate) {
                        maxAirHeatingRate = ratePerSec;      // Сохраняем пиковую скорость
                    }
                    lastAirRateTime = now;
                    lastAirTemp = airTemp;
                }
            }
            
            // ========== КАЛИБРОВКА ПАРАМЕТРОВ ВЕНТИЛЯТОРА (ЕСЛИ ВКЛЮЧЕНО) ==========
            // Этот блок перебирает различные комбинации параметров управления вентилятором
            // (шаг коррекции, интервал проверки, гистерезис) и выбирает те,
            // которые обеспечивают минимальный размах температуры.
            if (config.enableFanAutoLimit) {
                float fanOffThreshold = config.fanOnTemp - config.fanOffHysteresis;
                bool needFan = (heaterTemp > config.fanOnTemp) ||
                            (heaterTemp > config.maxHeaterTemp) ||
                            (fanState && heaterTemp > fanOffThreshold);
                
                static int targetDuty = 0;
                static unsigned long lastDutyAdjust = 0;
                
                // Инициализация при старте калибровки
                if (phaseElapsed < 1000) {
                    targetDuty = config.maxFanDuty;
                    lastDutyAdjust = now;
                    setFanDuty(targetDuty);
                    currentDynamicDuty = targetDuty;
                    if (targetDuty > 0) fanState = true;
                    calibrationStartTime = now;
                    tempHistoryIndex = 0;
                    tempHistoryCount = 0;
                    maxTemp = 0;
                    minTemp = 999;
                    bestOscillation = 999;
                    targetReached = false;
                    
                    testStep = constrain(config.fanAutoLimitAdjustStep, 1, 20);
                    testInterval = constrain(config.fanAutoLimitCheckInterval, 1000, 10000);
                    testHysteresis = constrain(config.fanAutoLimitHysteresis, 1, 10);
                    testStableCount = constrain(config.fanAutoLimitStableCount, 2, 10);
                    
                    addNotificationToLog("🔧 Начинаем калибровку параметров вентилятора");
                    addNotificationToLog(String("   Текущие: шаг=") + testStep + ", интервал=" + testInterval + "мс, гистерезис=" + testHysteresis + "°C");
                }
                
                // ---- УПРАВЛЕНИЕ ВЕНТИЛЯТОРОМ В РЕЖИМЕ КАЛИБРОВКИ ----
                if (fanState && calibrationPhase == 1) {
                    if ((now - lastDutyAdjust) >= testInterval) {
                        lastDutyAdjust = now;
                        int newDuty = targetDuty;
                        float error = heaterTemp - config.maxHeaterTemp;
                        
                        if (error > testHysteresis) {
                            newDuty = min(1023, targetDuty + testStep);
                        } else if (error < -testHysteresis) {
                            newDuty = max(config.fanAutoLimitMinDuty, targetDuty - testStep);
                        }
                        
                        if (newDuty != targetDuty) {
                            targetDuty = newDuty;
                            setFanDuty(targetDuty);
                            currentDynamicDuty = targetDuty;
                        }
                    }
                } else if (!fanState && needFan) {
                    targetDuty = config.maxFanDuty;
                    setFanDuty(targetDuty);
                    currentDynamicDuty = targetDuty;
                    fanState = true;
                    fanTurnedOnTime = millis();
                    lastDutyAdjust = now;
                } else if (fanState && !needFan && (millis() - fanTurnedOnTime > config.fanMinOnTime * 1000UL)) {
                    setFanDuty(0);
                    currentDynamicDuty = 0;
                    fanState = false;
                }
                
                // ---- АНАЛИЗ СТАБИЛЬНОСТИ ПРИ ТЕКУЩИХ ПАРАМЕТРАХ ----
                if (fanState && calibrationPhase == 1 && heaterTemp > config.maxHeaterTemp - 5) {
                    tempHistory[tempHistoryIndex] = heaterTemp;
                    tempHistoryIndex = (tempHistoryIndex + 1) % 20;
                    if (tempHistoryCount < 20) tempHistoryCount++;
                    
                    if (heaterTemp > maxTemp) maxTemp = heaterTemp;
                    if (heaterTemp < minTemp) minTemp = heaterTemp;
                    
                    static int stableCount = 0;
                    static float lastTemp = heaterTemp;
                    
                    if (abs(heaterTemp - lastTemp) < 1.0) {
                        stableCount++;
                        if (stableCount >= testStableCount && stabilityStartTime == 0) {
                            stabilityStartTime = now;
                            addNotificationToLog(String("📊 Система стабилизировалась с параметрами: шаг=") + testStep + ", интервал=" + testInterval + "мс");
                        }
                    } else {
                        stableCount = 0;
                        stabilityStartTime = 0;
                    }
                    lastTemp = heaterTemp;
                    
                    // ---- ЗАПОЛНЕНИЕ ТАБЛИЦЫ DUTY (T_воздух → мощность) ----
                    static float lastRecordedTemp = 0;
                    static int lastRecordedDuty = 0;
                    
                    if (abs(airTemp - lastRecordedTemp) >= 5.0 && fanState && targetDuty != lastRecordedDuty) {
                        lastRecordedTemp = airTemp;
                        lastRecordedDuty = targetDuty;
                        
                        if (dutyTableSize < MAX_DUTY_TABLE_SIZE) {
                            dutyTable[dutyTableSize].airTemp = airTemp;
                            dutyTable[dutyTableSize].duty = targetDuty;
                            dutyTableSize++;
                            
                            addNotificationToLog(String("📊 Таблица duty: при Tвозд=") + airTemp + "°C → duty=" + targetDuty);
                            
                            // Сортировка по температуре
                            for (int i = 0; i < dutyTableSize - 1; i++) {
                                for (int j = i + 1; j < dutyTableSize; j++) {
                                    if (dutyTable[i].airTemp > dutyTable[j].airTemp) {
                                        DutyTableEntry temp = dutyTable[i];
                                        dutyTable[i] = dutyTable[j];
                                        dutyTable[j] = temp;
                                    }
                                }
                            }
                        }
                    }
                    
                    // ---- ОЦЕНКА КАЧЕСТВА ТЕКУЩИХ ПАРАМЕТРОВ ----
                    if (stabilityStartTime > 0 && (now - stabilityStartTime) >= 120000) {
                        float oscillation = maxTemp - minTemp;
                        addNotificationToLog(String("📊 Оценка параметров: размах температуры=") + oscillation + "°C");
                        
                        if (oscillation < bestOscillation) {
                            bestOscillation = oscillation;
                            bestStep = testStep;
                            bestInterval = testInterval;
                            bestHysteresis = testHysteresis;
                            bestStableCount = testStableCount;
                            addNotificationToLog(String("⭐ Найдены лучшие параметры! Размах=") + oscillation + "°C");
                            
                            config.fanAutoLimitAdjustStep = bestStep;
                            config.fanAutoLimitCheckInterval = bestInterval;
                            config.fanAutoLimitHysteresis = bestHysteresis;
                            config.fanAutoLimitStableCount = bestStableCount;
                            config.fanAutoLimitAdapted = true;
                            saveConfig();
                            
                            targetReached = true;
                            calibrationPhase = 0;
                            break;
                        }
                        
                        calibrationPhase = 0;
                        stabilityStartTime = 0;
                        maxTemp = 0;
                        minTemp = 999;
                        tempHistoryCount = 0;
                        tempHistoryIndex = 0;
                    }
                }
                
                // ---- ПЕРЕБОР КОМБИНАЦИЙ ПАРАМЕТРОВ ----
                if (calibrationPhase == 0 && !targetReached && phaseElapsed > 30000) {
                    // Все возможные значения параметров для перебора
                    const int stepValues[] = {1, 2, 3, 5, 10, 15, 20};
                    const int intervalValues[] = {1000, 2000, 3000, 5000, 7000, 10000};
                    const int hysteresisValues[] = {1, 2, 3, 5, 7, 10};
                    const int stableCountValues[] = {2, 3, 5, 7, 10};
                    
                    static int totalSets = sizeof(stepValues)/sizeof(stepValues[0]) * 
                                        sizeof(intervalValues)/sizeof(intervalValues[0]) * 
                                        sizeof(hysteresisValues)/sizeof(hysteresisValues[0]) * 
                                        sizeof(stableCountValues)/sizeof(stableCountValues[0]);
                    
                    if (paramSetIndex == 0) {
                        addNotificationToLog("🔍 Начинаем поиск оптимальных параметров управления вентилятором");
                        addNotificationToLog(String("   Всего комбинаций: ") + totalSets);
                    }
                    
                    if (paramSetIndex < totalSets) {
                        int stepCount = sizeof(stepValues)/sizeof(stepValues[0]);
                        int intervalCount = sizeof(intervalValues)/sizeof(intervalValues[0]);
                        int hysteresisCount = sizeof(hysteresisValues)/sizeof(hysteresisValues[0]);
                        int stableCountCount = sizeof(stableCountValues)/sizeof(stableCountValues[0]);
                        
                        int s = paramSetIndex % stepCount;
                        int i = (paramSetIndex / stepCount) % intervalCount;
                        int h = (paramSetIndex / (stepCount * intervalCount)) % hysteresisCount;
                        int sc = paramSetIndex / (stepCount * intervalCount * hysteresisCount);
                        
                        testStep = stepValues[s];
                        testInterval = intervalValues[i];
                        testHysteresis = hysteresisValues[h];
                        testStableCount = stableCountValues[sc];
                        
                        addNotificationToLog(String("🔄 Тест ") + (paramSetIndex+1) + "/" + totalSets + 
                                            ": шаг=" + testStep + ", интервал=" + testInterval + 
                                            "мс, гистерезис=" + testHysteresis + "°C, стабильных=" + testStableCount);
                        
                        calibrationPhase = 1;
                        paramSetIndex++;
                        
                        maxTemp = 0;
                        minTemp = 999;
                        tempHistoryCount = 0;
                        tempHistoryIndex = 0;
                        stabilityStartTime = 0;
                    } else {
                        addNotificationToLog("✅ Калибровка параметров вентилятора завершена!");
                        addNotificationToLog(String("🏆 Лучшие параметры: шаг=") + bestStep + 
                                            ", интервал=" + bestInterval + "мс, гистерезис=" + bestHysteresis + 
                                            "°C, размах температуры=" + bestOscillation + "°C");
                        
                        config.fanAutoLimitAdjustStep = bestStep;
                        config.fanAutoLimitCheckInterval = bestInterval;
                        config.fanAutoLimitHysteresis = bestHysteresis;
                        config.fanAutoLimitStableCount = bestStableCount;
                        config.fanAutoLimitAdapted = true;
                        saveConfig();
                        
                        targetReached = true;
                    }
                }
            }
            
            // ========== УПРАВЛЕНИЕ ВЕНТИЛЯТОРОМ (ЕСЛИ КАЛИБРОВКА ОТКЛЮЧЕНА) ==========
            if (!config.enableFanAutoLimit) {
                float fanOffThreshold = config.fanOnTemp - config.fanOffHysteresis;
                bool needFan = (heaterTemp > config.fanOnTemp) ||
                            (heaterTemp > config.maxHeaterTemp) ||
                            (fanState && heaterTemp > fanOffThreshold);
                
                static int targetDuty = 0;
                static unsigned long lastDutyAdjust = 0;
                
                if (phaseElapsed < 1000) {
                    targetDuty = config.maxFanDuty;
                    lastDutyAdjust = now;
                    setFanDuty(targetDuty);
                    currentDynamicDuty = targetDuty;
                    if (targetDuty > 0) fanState = true;
                }
                
                if (!fanState && needFan) {
                    targetDuty = config.maxFanDuty;
                    setFanDuty(targetDuty);
                    currentDynamicDuty = targetDuty;
                    fanState = true;
                    fanTurnedOnTime = millis();
                    lastDutyAdjust = now;
                } else if (fanState && !needFan && (millis() - fanTurnedOnTime > config.fanMinOnTime * 1000UL)) {
                    setFanDuty(0);
                    currentDynamicDuty = 0;
                    fanState = false;
                }
            }
            
            // ========== ОСНОВНАЯ ЛОГИКА НАГРЕВА ==========
            float elapsedMin = phaseElapsed / 60000.0;
            if (elapsedMin < 0.1) elapsedMin = 0.1;
            
            static float startHeaterTemp = heaterTemp;
            static float airTempAtPhaseStart = airTemp;
            static unsigned long airCheckStart = phaseElapsed;
            
            // Аварийные проверки безопасности
            if (heaterTemp > config.maxHeaterTemp + 20) {
                adaptStatusMessage = "❌ Аварийное прерывание! Превышен безопасный порог нагревателя.";
                addErrorToLog(adaptStatusMessage, true, false, 0);
                currentAdaptPhase = ADAPT_FAILED;
                adaptPhaseStartTime = now;
                break;
            }
            if (airTemp > config.maxAirTemp) {
                adaptStatusMessage = "❌ Аварийное прерывание! Перегрев воздуха.";
                addErrorToLog(adaptStatusMessage, true, false, 0);
                currentAdaptPhase = ADAPT_FAILED;
                adaptPhaseStartTime = now;
                break;
            }
            
            // Проверка прогрева воздуха (5 минут без изменений → ошибка)
            if (phaseElapsed > 300000 && (phaseElapsed - airCheckStart) > 300000 && airTemp - airTempAtPhaseStart < 1.0) {
                adaptStatusMessage = "❌ Воздух не прогревается! Проверьте камеру или датчик DS18B20.";
                addErrorToLog(adaptStatusMessage, true, false, 0);
                currentAdaptPhase = ADAPT_FAILED;
                adaptPhaseStartTime = now;
                break;
            }
            
            // Измерение скорости нагрева воздуха на стабильном участке
            // Используем скользящее окно 120 секунд для фильтрации шума
            static float airTemp2minAgo = airTemp;
            static unsigned long lastAirSpeedCheck = 0;
            
            if (now - lastAirSpeedCheck >= 120000) {     // Каждые 2 минуты
                float airRise2min = airTemp - airTemp2minAgo;
                float airSpeed2min = airRise2min / 2.0;  // °C/мин за последние 2 минуты
                
                if (airSpeed2min > adaptStats.airHeatingRateStable) {
                    adaptStats.airHeatingRateStable = airSpeed2min;  // Сохраняем лучшую скорость
                }
                
                airTemp2minAgo = airTemp;
                lastAirSpeedCheck = now;
            }
            
            // Средняя скорость за всё время (для справки)
            if (airTemp > adaptStats.initialAirTemp + 2) {
                float airRise = airTemp - adaptStats.initialAirTemp;
                adaptStats.heatingRateAir = airRise / elapsedMin;
            }
            if (heaterTemp > adaptStats.maxHeaterTemp) adaptStats.maxHeaterTemp = heaterTemp;
            if (airTemp > adaptStats.maxAirTemp) adaptStats.maxAirTemp = airTemp;
            
            // ========== ДОСТИЖЕНИЕ ЦЕЛЕВОЙ ТЕМПЕРАТУРЫ ==========
            if (airTemp >= adaptTargetTemp) {
                adaptStats.targetReached = true;
                adaptStats.timeToReachTarget = phaseElapsed / 1000.0;
                adaptStats.heatingEndTime = now;
                adaptStats.maxAirHeatingRate = maxAirHeatingRate;
                
                // Выключаем нагрев
                digitalWrite(config.pinSsr, config.invertHeaterSignal ? HIGH : LOW);
                heaterState = false;
                
                // Включаем вентилятор на максимальную мощность для охлаждения
                int coolDuty = config.maxFanDuty;
                if (coolDuty <= 0) coolDuty = 1023;
                setFanDuty(coolDuty);
                currentDynamicDuty = coolDuty;
                fanState = true;
                
                // Запускаем режим охлаждения
                cooldownMode = true;
                coolStartTemp = heaterTemp;
                coolStartTime = now;
                adaptPhaseStartTime = now;
                
                addNotificationToLog("🎯 Целевая температура воздуха достигнута: " + String(airTemp,1) + "°C");
                addNotificationToLog("⏱️ Время нагрева воздуха: " + String(adaptStats.timeToReachTarget/60.0, 1) + " мин");
                addNotificationToLog("📊 Макс. скорость нагрева воздуха: " + String(maxAirHeatingRate, 2) + "°C/сек");
                addNotificationToLog("🌬️ Охлаждение нагревателя до " + String(config.fanOnTemp - config.fanOffHysteresis, 1) + "°C");
                break;
            }
            // ========== ТАЙМАУТ НАГРЕВА ==========
            else if (phaseElapsed > ADAPT_HEATING_PHASE2_TIMEOUT * 1000UL) {
                adaptStats.targetReached = false;
                adaptStats.maxAirHeatingRate = maxAirHeatingRate;
                currentAdaptPhase = ADAPT_COMPLETE;
                adaptPhaseStartTime = now;
                lastProgress = 0;
                digitalWrite(config.pinSsr, config.invertHeaterSignal ? HIGH : LOW);
                heaterState = false;
                addNotificationToLog("⏰ Таймаут нагрева, адаптация завершена");
                addNotificationToLog("📊 Макс. скорость нагрева воздуха: " + String(maxAirHeatingRate, 2) + "°C/сек");
                
                saveDutyTable();
            }
            
            // Статус калибровки для отображения
            String calibStatus = "";
            if (config.enableFanAutoLimit) {
                if (calibrationPhase == 0 && !targetReached && phaseElapsed > 30000) {
                    calibStatus = " 🔍 поиск параметров...";
                } else if (calibrationPhase == 1) {
                    calibStatus = " 🔧 тест шаг=" + String(testStep) + " инт=" + String(testInterval/1000) + "с гис=" + String(testHysteresis) + "°C";
                }
            }
            
            // Обновление прогресса (85-98%)
            int newProgress = map(constrain(airTemp, adaptStats.initialAirTemp, adaptTargetTemp), 
                                adaptStats.initialAirTemp, adaptTargetTemp, 85, 98);
            adaptProgressPercent = constrain(newProgress, 85, 98);
            adaptStatusMessage = "Нагрев камеры: " + String(airTemp, 1) + "°C (цель " + String(adaptTargetTemp, 0) + "°C)" + calibStatus;
            break;
        }

        // ========== ФАЗА 7: ЗАВЕРШЕНИЕ ==========
        case ADAPT_COMPLETE: {
            fanControlEnabled = false;
            adaptProgressPercent = 100;
            adaptStatusMessage = "Адаптация завершена!";
            if (phaseElapsed > 3000) {
                applyAdaptationResults();
            }
            break;
        }

        // ========== ФАЗА 8: ОШИБКА ==========
        case ADAPT_FAILED: {
            fanControlEnabled = false;
            adaptProgressPercent = 100;
            adaptStatusMessage = "Ошибка адаптации!";
            if (phaseElapsed > 5000) finishAdaptation(false);
            break;
        }

        default: break;
    }
    
    // Защита от уменьшения прогресса (кроме финальных фаз)
    if (adaptProgressPercent < lastProgress && 
        currentAdaptPhase != ADAPT_COMPLETE && 
        currentAdaptPhase != ADAPT_FAILED) {
        adaptProgressPercent = lastProgress;
    }
    lastProgress = adaptProgressPercent;
}

// ========== ПРИМЕНЕНИЕ РЕЗУЛЬТАТОВ АДАПТАЦИИ К КОНФИГУРАЦИИ ==========
// Вызывается: processAdaptation() при успешном завершении (ADAPT_COMPLETE)
// Рассчитывает оптимальные параметры защит на основе собранной статистики
// Все формулы основаны на физике тепловых процессов и практических тестах
void applyAdaptationResults() {
    // Сохраняем текущие настройки защит (чтобы не выключать их во время адаптации)
    bool oldThermalRunawayEnabled = config.enableThermalRunawayProtection;
    bool oldUnexpectedHeatEnabled = config.enableUnexpectedHeatProtection;
    bool oldAbnormalRateEnabled = config.enableAbnormalRate;
    
    // Валидация результатов (проверка на разумность)
    if (!validateAdaptationResults()) { 
        finishAdaptation(false); 
        return; 
    }
    
    // =====================================================================
    // 1. ОСНОВНЫЕ ТЕПЛОВЫЕ ПАРАМЕТРЫ
    // =====================================================================
    
    // Скорость нагрева нагревателя (°C/мин)
    if (adaptStats.heatingRateHeater > 0) {
        config.adaptedHeaterRiseRate = constrain(adaptStats.heatingRateHeater, 1.0, 300.0);
        
        // Порог для Thermal Runaway: 50% от измеренной скорости.
        // Это даёт достаточный запас для нормальной работы, но сработает
        // при серьёзном падении эффективности нагрева (отвалился датчик, сгорел ТЭН).
        config.runawayMinHeaterRisePerMin = constrain(
            adaptStats.heatingRateHeater * 0.5, 1.0, 150.0);
        
        LOG_INFO("Скорость нагревателя: %.1f°C/мин, порог Runaway: %.1f°C/мин",
                 adaptStats.heatingRateHeater, config.runawayMinHeaterRisePerMin);
    }

    // Гистерезис Runaway: 3× шум датчика нагревателя (минимум 0.5°C, максимум 5°C)
    if (adaptStats.heaterSensorNoiseLevel > 0) {
        config.runawayHysteresis = constrain(
            adaptStats.heaterSensorNoiseLevel * 3.0, 0.5, 5.0);
    }

    // Максимальное падение нагревателя: разница T_нагр - T_возд + 20% запас
    if (adaptStats.heaterAirDelta > 0) {
        config.runawayMaxHeaterDrop = constrain(
            adaptStats.heaterAirDelta * 1.2, 10, 50);
        
        LOG_INFO("Разница нагреватель-воздух: %.1f°C, порог падения: %.1f°C",
                 adaptStats.heaterAirDelta, config.runawayMaxHeaterDrop);
    }
    
    // Скорость нагрева воздуха (°C/мин) — используем стабильную скорость
    float effectiveAirRate = (adaptStats.airHeatingRateStable > 0) ? 
                              adaptStats.airHeatingRateStable : 
                              adaptStats.heatingRateAir;
    
    if (effectiveAirRate > 0) {
        config.adaptedAirRiseRate = constrain(effectiveAirRate, 0.1, 20.0);
        
        // Порог для фазы 2: 50% от измеренной скорости
        config.runawayMinAirRisePerMin = constrain(
            effectiveAirRate * 0.5, 0.2, 20.0);
        
        LOG_INFO("Скорость воздуха: %.1f°C/мин (стабильная: %.1f), порог Runaway: %.1f°C/мин",
                 adaptStats.heatingRateAir, adaptStats.airHeatingRateStable, 
                 config.runawayMinAirRisePerMin);
    }
    
    // Скорость охлаждения с вентилятором (°C/сек)
    if (adaptStats.coolingRateWithFan > 0) {
        config.adaptedCoolingRate = constrain(adaptStats.coolingRateWithFan, 0.05, 10.0);
        
        // Минимальная скорость охлаждения: 30% от измеренной.
        // Если вентилятор охлаждает медленнее этого — он неэффективен.
        config.minCoolingRate = constrain(
            adaptStats.coolingRateWithFan * 0.15, 0.05, 2.0);
        
        // Вентилятор эффективен если охлаждает быстрее 0.2°C/сек
        config.fanEffective = (adaptStats.coolingRateWithFan > 0.2);
        
        LOG_INFO("Скорость охлаждения: %.2f°C/сек, порог: %.2f°C/сек, эффективен: %s",
                 adaptStats.coolingRateWithFan, config.minCoolingRate,
                 config.fanEffective ? "да" : "нет");
    }
    
    // Временные параметры для Thermal Runaway
    // Фаза 1: время выхода нагревателя на режим + 50% запас
    if (adaptStats.timeToMaxHeaterTemp > 0) {
        float heaterTimeMin = adaptStats.timeToMaxHeaterTemp / 60.0;
        config.runawayPhase1Time = constrain(round(heaterTimeMin * 1.5), 2, 10);
        
        LOG_INFO("Время выхода нагревателя: %.1f мин, фаза1=%d мин",
                 heaterTimeMin, config.runawayPhase1Time);
    }
    
    // Фаза 2 и maxTimeToTarget: от времени до цели по воздуху
    if (adaptStats.timeToReachTarget > 0) {
        float timeToTargetMin = adaptStats.timeToReachTarget / 60.0;
        config.adaptedTimeToTarget = timeToTargetMin;
        
        // Максимальное время до цели: измеренное + 50% запас
        config.runawayMaxTimeToTarget = constrain(timeToTargetMin * 1.5, 15, 180);
        
        // Фаза 2: 70% от времени до цели по воздуху
        config.runawayPhase2Time = constrain(round(timeToTargetMin * 0.7), 5, 30);
        
        LOG_INFO("Время до цели (воздух): %.1f мин, фаза2=%d мин, макс=%d мин",
                 timeToTargetMin, config.runawayPhase2Time, config.runawayMaxTimeToTarget);
    }
    
    // =====================================================================
    // 2. ЗАЩИТА ОТ НЕОЖИДАННОГО НАГРЕВА (UNEXPECTED HEAT)
    // =====================================================================
    
    // Таймаут ожидания остывания: 60 секунд + 10× постоянная времени
    if (config.minCoolingRate > 0 && config.adaptedCoolingRate > 0) {
        // Постоянная времени: 1°C / скорость_охлаждения
        float timeConstant = 1.0 / config.adaptedCoolingRate;
        config.unexpectedHeatTimeout = constrain(60.0 + timeConstant * 15.0, 90, 300);
    }
    
    // Порог срабатывания: на 15°C ниже максимальной температуры нагревателя
    // Это даёт запас на инерцию нагревателя после выключения
    if (config.maxHeaterTemp > 0) {
        config.unexpectedHeatThreshold = constrain(
            config.maxHeaterTemp * 0.25, 15, 100);  // 25% от макс. температуры
    }
    
    // Гистерезис Unexpected Heat: 3× шум датчика
    if (adaptStats.heaterSensorNoiseLevel > 0) {
        config.unexpectedHeatHysteresis = constrain(
            adaptStats.heaterSensorNoiseLevel * 3.0, 1.0, 10.0);
    }
    
    // =====================================================================
    // 3. ЭФФЕКТИВНОСТЬ ВЕНТИЛЯТОРА
    // =====================================================================
    
    // Таймаут проверки эффективности: зависит от скорости охлаждения
    // За это время температура должна упасть минимум на порог
    if (config.adaptedCoolingRate > 0) {
        config.fanEfficiencyTimeout = constrain(
            2.0 / config.adaptedCoolingRate, 60, 300);  // Время падения на 2°C при измеренной скорости
    }
    
    // Порог эффективности: должен упасть хотя бы на 2°C за время проверки
    config.fanEfficiencyThreshold = constrain(
        config.adaptedCoolingRate * config.fanEfficiencyTimeout * 0.7, 1.0, 15.0);
    
    // =====================================================================
    // 4. ЗАЩИТА ДАТЧИКА НАГРЕВАТЕЛЯ (MAX6675)
    // =====================================================================
    
    if (adaptStats.maxHeatingRate > 0) {
        // Порог скачка: 3× пиковая скорость (запас на реальные флуктуации)
        config.max6675TempJumpThreshold = constrain(
            adaptStats.maxHeatingRate * 3.0, 5.0, 50.0);
        
        LOG_INFO("Порог скачка MAX6675: %.1f°C (пиковая скорость: %.2f°C/сек)", 
                 config.max6675TempJumpThreshold, adaptStats.maxHeatingRate);
    } else {
        config.max6675TempJumpThreshold = 15.0;
    }
    
    // Стабильные чтения: адаптивно от уровня шума
    if (adaptStats.heaterSensorNoiseLevel > 0) {
        if (adaptStats.heaterSensorNoiseLevel < 0.3)
            config.max6675StabilitySamples = 3;
        else if (adaptStats.heaterSensorNoiseLevel < 0.8)
            config.max6675StabilitySamples = 4;
        else
            config.max6675StabilitySamples = 5;
    }
    
    // =====================================================================
    // 5. ЗАЩИТА ДАТЧИКА ВОЗДУХА (DS18B20)
    // =====================================================================
    
    if (adaptStats.maxAirHeatingRate > 0) {
        // Порог скачка: 2× пиковая скорость воздуха
        config.airSensorTempJumpThreshold = constrain(
            adaptStats.maxAirHeatingRate * 2.0, 2.0, 10.0);
        
        // Диапазон нестабильности: 3× порог скачка
        config.airSensorUnstableRange = constrain(
            config.airSensorTempJumpThreshold * 3.0, 2.0, 15.0);
        
        // Гистерезис управления: 2× шум датчика воздуха
        config.hysteresis = constrain(
            adaptStats.airSensorNoiseLevel * 2.0, 0.3, 2.0);
    } else {
        // Fallback: используем уровень шума
        config.airSensorTempJumpThreshold = constrain(
            adaptStats.airSensorNoiseLevel * 5.0, 2.0, 10.0);
        config.airSensorUnstableRange = constrain(
            config.airSensorTempJumpThreshold * 2.0, 2.0, 15.0);
        config.hysteresis = constrain(
            adaptStats.airSensorNoiseLevel * 2.0, 0.3, 2.0);
    }
    
    // Параметры нестабильности
    if (adaptStats.airSensorNoiseLevel > 0) {
        config.airSensorUnstableDeviation = constrain(
            config.airSensorUnstableRange * 0.5, 0.5, 10.0);
        
        config.airSensorDirectionChanges = 
            (adaptStats.airSensorNoiseLevel < 0.3) ? 4 : 5;
        
        config.airSensorStabilitySamples = 
            (adaptStats.airSensorNoiseLevel < 0.3) ? 5 : 
            (adaptStats.airSensorNoiseLevel < 0.6) ? 7 : 10;
        
        config.airSensorUnstableWindow = 
            (adaptStats.airSensorNoiseLevel < 0.3) ? 10 : 
            (adaptStats.airSensorNoiseLevel < 0.6) ? 12 : 15;
    }
    
    // =====================================================================
    // 6. ПОРОГ АНОМАЛЬНОЙ СКОРОСТИ НАГРЕВА
    // =====================================================================
    
    if (adaptStats.maxHeatingRate > 0) {
        // Аномальный рост: 3× пиковая скорость (должен быть явный выброс)
        config.abnormalRateThreshold = constrain(
            adaptStats.maxHeatingRate * 3.0, 10, 50);
        
        LOG_INFO("Порог аномального роста: %.1f°C/сек (пиковая: %.2f°C/сек)", 
                 config.abnormalRateThreshold, adaptStats.maxHeatingRate);
    } else if (adaptStats.heatingRateHeater > 0) {
        // Fallback: 5× средняя скорость в секунду
        config.abnormalRateThreshold = constrain(
            (adaptStats.heatingRateHeater / 60.0) * 5.0, 10, 50);
    }
    
    // =====================================================================
    // 7. СИСТЕМНЫЕ ПАРАМЕТРЫ
    // =====================================================================
    
    // Количество ошибок до блокировки: зависит от стабильности системы
    float maxNoise = max(adaptStats.heaterSensorNoiseLevel, adaptStats.airSensorNoiseLevel);
    if (maxNoise > 0.8)
        config.maxErrorRetries = 3;  // Шумная система — быстро блокируем
    else if (maxNoise > 0.3)
        config.maxErrorRetries = 4;  // Средняя стабильность
    else
        config.maxErrorRetries = 5;  // Стабильная система — больше tolerance
    
    // Окно ошибок: 3× время до цели (минимум 10 минут)
    config.errorWindowMinutes = constrain(
        config.adaptedTimeToTarget * 3.0, 10, 120);
    
    // Интервал между перегревами: время остывания на 5°C
    if (config.minCoolingRate > 0) {
        config.minTimeBetweenOverheatCounts = constrain(
            (5.0 / config.minCoolingRate) * 1000.0, 3000, 15000);
    }
    
    // Интервал трендов: 2× интервал чтения датчиков
    config.trendInterval = constrain(config.readInterval * 2, 1000, 5000);
    
    // =====================================================================
    // 8. ФАЗА 0 THERMAL RUNAWAY (быстрая проверка)
    // =====================================================================
    
    // Минимальная температура через 45 секунд после включения нагрева.
    // За 45 секунд нагреватель должен уйти выше этого порога.
    // Если нет — датчик отвалился от радиатора или нагреватель неисправен.
    //
    // Расчёт: при скорости X°C/мин, за 0.75 мин нагреватель наберёт X*0.75°C.
    // Берём 50% от этого как минимальный порог.
    // Стартовая температура в фазе 4 — около 35°C (после охлаждения).
    if (adaptStats.heatingRateHeater > 0) {
        float expectedRise45sec = adaptStats.heatingRateHeater * 0.75; // 45 сек = 0.75 мин
        float startTemp = 35.0;  // Типичная температура старта фазы 4 после охлаждения
        config.runawayQuickCheckTemp = constrain(
            startTemp + expectedRise45sec * 0.5,  // 50% от ожидаемого роста
            40.0, 150.0);
        
        LOG_INFO("Фаза 0: мин. температура через 45 сек = %.1f°C (ожидаемый рост: %.1f°C)", 
                 config.runawayQuickCheckTemp, expectedRise45sec);
    }
    
    // =====================================================================
    // 9. ЗАВЕРШЕНИЕ
    // =====================================================================
    
    // Восстанавливаем исходные флаги защит
    config.enableThermalRunawayProtection = oldThermalRunawayEnabled;
    config.enableUnexpectedHeatProtection = oldUnexpectedHeatEnabled;
    config.enableAbnormalRate = oldAbnormalRateEnabled;
    
    // Отмечаем что адаптация выполнена
    config.adaptationPerformed = true;
    // Сохраняем профиль разогрева
    if (adaptStats.profile.heatingCount > 0) {
        config.heatingProfileCount = adaptStats.profile.heatingCount;
        config.heatingProfileStartTemp = adaptStats.profile.startTemp;
        config.heatingProfileTargetTemp = adaptStats.profile.targetTemp;
        for (int i = 0; i < adaptStats.profile.heatingCount; i++) {
            config.heatingProfileTemp[i] = adaptStats.profile.heatingWithFan[i];
            config.heatingProfileAirTemp[i] = adaptStats.profile.airDuringHeating[i];
        }
        LOG_INFO("Профиль разогрева сохранён: %d точек", config.heatingProfileCount);
    }
    config.adaptationTimestamp = millis();
    
    // Валидация и сохранение
    config.validate();
    saveConfig();
    
    // Обновляем переопределения защит
    if (protectionOverride.thermalModelActive) {
        protectionOverride.updateFromConfig(config);
    }
    
    saveDutyTable();
    finishAdaptation(true);
}

// ========== ЗАВЕРШЕНИЕ АДАПТАЦИИ ==========
// Вызывается: applyAdaptationResults() (успех) или processAdaptation() (ошибка)
// Сбрасывает флаги адаптации, восстанавливает нормальный режим работы
void finishAdaptation(bool success) {
    // Логируем результат
    addNotificationToLog(success ? "✅ Адаптация успешно завершена!" : "❌ Адаптация прервана");
    
    // ========== СБРОС ФЛАГОВ ==========
    errors.protectionsDisabled = false;          // Включаем защиты обратно
    adaptationInProgress = false;                // Адаптация больше не активна
    adaptTempDisableProtections = false;         // Защиты больше не отключены
    currentAdaptPhase = ADAPT_IDLE;              // Возвращаемся в режим ожидания
    adaptProgressPercent = 0;
    
    // ========== ВОССТАНОВЛЕНИЕ УПРАВЛЕНИЯ ==========
    fanControlEnabled = true;                    // Включаем автоматическое управление вентилятором
    
    // Сбрасываем форсированный режим вентилятора если был
    if (fanForcedByError) {
        fanForcedByError = false;
        fanStateSaved = false;
        LOG_INFO("Адаптация: сброшен форсированный режим вентилятора");
    }
    
    // ========== ВЫКЛЮЧЕНИЕ ВСЕГО НАГРЕВА ==========
    digitalWrite(config.pinSsr, config.invertHeaterSignal ? HIGH : LOW);  // SSR выключен
    heaterState = false;
    setFanDuty(0);                               // Вентилятор выключен
    fanState = false;
    
    // ========== ФИНАЛЬНЫЕ СООБЩЕНИЯ ==========
    adaptStatusMessage = success ? "✅ Адаптация успешно завершена!" : "❌ Адаптация прервана";
    adaptProgressPercent = 100;
    
    // Сохраняем результат в конфигурацию
    if (success) {
        config.adaptationPerformed = true;
        config.adaptationTimestamp = millis();
        saveConfig();
        LOG_INFO("Адаптация сохранена в конфигурацию");
    }
}

// ========== ПРЕРЫВАНИЕ АДАПТАЦИИ ПОЛЬЗОВАТЕЛЕМ ==========
// Вызывается: API /api/adapt/abort
// Немедленно останавливает адаптацию и возвращает систему в нормальный режим
void abortAdaptation() {
    if (adaptationInProgress) {
        addNotificationToLog("⏹️ Адаптация прервана пользователем");
        
        // Переходим в фазу ошибки (триггер для finishAdaptation)
        currentAdaptPhase = ADAPT_FAILED;
        adaptPhaseStartTime = millis();
        adaptStatusMessage = "Прервано пользователем";
        adaptProgressPercent = 0;
        
        // ========== ВОССТАНОВЛЕНИЕ УПРАВЛЕНИЯ ==========
        fanControlEnabled = true;
        
        // Сбрасываем форсированный режим вентилятора
        if (fanForcedByError) {
            fanForcedByError = false;
            fanStateSaved = false;
            LOG_INFO("Адаптация прервана: сброшен форсированный режим вентилятора");
        }
        
        // ========== ВЫКЛЮЧЕНИЕ ВСЕГО НАГРЕВА ==========
        digitalWrite(config.pinSsr, config.invertHeaterSignal ? HIGH : LOW);
        heaterState = false;
        setFanDuty(0);
        fanState = false;
        
        // ========== СБРОС ФЛАГОВ ==========
        errors.protectionsDisabled = false;
        adaptTempDisableProtections = false;
    }
}

// ========== ВАЛИДАЦИЯ РЕЗУЛЬТАТОВ АДАПТАЦИИ ==========
// Проверяет, что собранные данные разумны и могут быть применены
