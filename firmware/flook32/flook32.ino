    void reset() {
        heatingCount = 0; coolingCount = 0;
        steadyAmplitude = 0; steadyPeriod = 0;
        airLag = 0; airMaxRate = 0;
        startTemp = 0; targetTemp = 0; valid = false;
        memset(heatingNoFan, 0, sizeof(heatingNoFan));
        memset(heatingWithFan, 0, sizeof(heatingWithFan));
        memset(airDuringHeating, 0, sizeof(airDuringHeating));
        memset(coolingWithFan, 0, sizeof(coolingWithFan));
        memset(coolingNoFan, 0, sizeof(coolingNoFan));
    }
};

