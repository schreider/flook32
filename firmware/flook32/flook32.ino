    // ========== СБРОС К ЗНАЧЕНИЯМ ПО УМОЛЧАНИЮ ==========
    // Вызывается: при начале новой адаптации
    void resetToDefaults() {
        memset(this, 0, sizeof(AdaptationStats));   // Обнуляем всю структуру
        // Восстанавливаем нелинейные параметры по умолчанию
        heatRateLow = 15.0; 
        heatRateMid = 12.0; 
        heatRateHigh = 8.0;
        coolRateHigh = 0.8; 
        coolRateMid = 0.5; 
        coolRateLow = 0.3;
        fanBoostHigh = 2.0; 
        fanBoostMid = 1.5; 
        fanBoostLow = 1.2;
        nonlinearDataCollected = false;
        calibrated = false;
        optimalPower = 100;
        profile.reset();                // Сбрасываем профиль
    }
} adaptStats;                           // Глобальный экземпляр статистики адаптации

// ============================================================================
// ФАЗЫ АДАПТАЦИИ (КОНЕЧНЫЙ АВТОМАТ)
