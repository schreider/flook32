// ----------------------------------------------------------------------------
// ТРЕНДЫ (ИСТОРИЯ ТЕМПЕРАТУР)
// ----------------------------------------------------------------------------
void addToTrendBuffer();        // Добавляет текущие показания в кольцевой буфер трендов
                                // Вызывается: webTask по таймеру trendInterval (каждые 3 секунды)
                                // Сохраняет: timestamp, T_air, T_heater, T_target, flags (состояние нагрева/вентилятора)

// ----------------------------------------------------------------------------
// УПРАВЛЕНИЕ НАГРЕВАТЕЛЕМ
// ----------------------------------------------------------------------------
void updateHeaterControl();     // Основная логика управления SSR (нагревателем)
                                // Вызывается: controlTask по таймеру heaterControlInterval (200 мс)
                                // Реализует: PID-подобное управление с гистерезисом,
                                //            проверку ошибок, автоотключение по Moonraker

// ----------------------------------------------------------------------------
// УПРАВЛЕНИЕ ВЕНТИЛЯТОРОМ (PWM)
// ----------------------------------------------------------------------------
void updateFan();               // Основная логика управления вентилятором
                                // Вызывается: controlTask по таймеру fanControlInterval (1000 мс)
                                // Реализует: включение/выключение по порогу,
                                //            динамическую коррекцию duty для поддержания maxHeaterTemp,
                                //            форсированный режим 100% при ошибках

void initFanPWM();              // Инициализация аппаратного ШИМ (LEDC периферия ESP32)
                                // Вызывается: setup() один раз
