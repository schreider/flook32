// ----------------------------------------------------------------------------
// ЗАЩИТНЫЕ ФУНКЦИИ (ВЫЗЫВАЮТСЯ ИЗ controlTask)
// ----------------------------------------------------------------------------
void checkUnexpectedHeat();     // Обнаружение нагрева при выключенном SSR
                                // Вызывается: controlTask по таймеру unexpectedCheckInterval (2000 мс)
                                // Анализирует: скорость остывания, сравнивает с minCoolingRate
                                // При срабатывании: аварийное отключение, блокировка системы

void checkThermalRunaway();     // Контроль Thermal Runaway (3 фазы)
                                // Вызывается: controlTask по таймеру runawayCheckInterval (5000 мс)
                                // Фаза 1: скорость нагрева нагревателя
                                // Фаза 2: скорость нагрева воздуха
                                // Фаза 3: время до достижения цели

void checkHeaterOverheat();     // Контроль перегрева нагревателя
                                // Вызывается: controlTask (часто, в составе timerProtections)
                                // Cрабатывает: при heaterTemp > criticalTemp (120°C)
                                // Действие: выключение SSR, включение вентилятора 100%, блокировка при N=3

void checkAirOverheat();        // Контроль перегрева воздуха в камере
                                // Вызывается: controlTask (часто, в составе timerProtections)
                                // Cрабатывает: при airTemp > maxAirTemp (70°C)
                                // Действие: выключение SSR, вентилятор 100%

void checkHeatingRate();        // Контроль аномально быстрого нагрева
                                // Вызывается: controlTask по таймеру rateCheckInterval (1000 мс)
                                // Измеряет: скорость роста температуры (°C/сек)
                                // Сравнивает: с abnormalRateThreshold (по умолч. 5°C/сек)

void checkFanEfficiency();      // Контроль эффективности вентилятора
                                // Вызывается: controlTask (часто, в составе timerProtections)
                                // Проверяет: падает ли температура при выключенном нагреве
                                // Если за timeout температура упала < threshold → предупреждение

void clearErrorFlags();         // Сброс всех флагов ошибок (кроме блокировки системы)
                                // Вызывается: handleApiUnlock(), после устранения причин
                                // Сбрасывает: критические флаги, форсированный режим вентилятора

// ----------------------------------------------------------------------------
// АДАПТАЦИЯ (САМОНАСТРОЙКА)
// ----------------------------------------------------------------------------
void startAdaptation(float targetUserTemp);     // Запуск процесса адаптации с целевой температурой (40-70°C)
                                                // Вызывается: handleApiStartAdaptation()
                                                // Устанавливает: флаги, сохраняет начальные температуры

void processAdaptation();                       // Главный конечный автомат адаптации (9 фаз)
                                                // Вызывается: controlTask по таймеру (каждые 500 мс) если adaptationInProgress
                                                // Реализует: все шаги самонастройки (см. описание фаз)

void applyAdaptationResults();                  // Применение результатов адаптации к конфигурации
                                                // Вызывается: processAdaptation() при завершении (ADAPT_COMPLETE)
                                                // Обновляет: пороги защит, коэффициенты модели, параметры вентилятора

void finishAdaptation(bool success);            // Завершение адаптации (успех или провал)
                                                // Вызывается: applyAdaptationResults(), processAdaptation() при ошибке
                                                // Сбрасывает: флаги, восстанавливает нормальный режим

void abortAdaptation();                         // Прерывание адаптации пользователем
                                                // Вызывается: handleApiAbortAdaptation()
                                                // Отключает нагрев, сбрасывает флаги, восстанавливает защиты

bool validateAdaptationResults();               // Валидация результатов адаптации (разумность параметров)
                                                // Вызывается: applyAdaptationResults()
                                                // Отбрасывает: аномальные значения, выходящие за пределы

// ----------------------------------------------------------------------------
// ТЕРМАЛЬНАЯ МОДЕЛЬ (МАШИННОЕ ОБУЧЕНИЕ)
// ----------------------------------------------------------------------------
void initThermalModel();        // Инициализация термальной модели
                                // Вызывается: setup() после загрузки конфигурации
                                // Загружает: сохранённые коэффициенты из Preferences
                                // Если адаптация не пройдена - модель не активируется

void checkThermalModel();       // Проверка предсказаний модели (обнаружение аномалий)
                                // Вызывается: controlTask по таймеру thermalModelCheckInterval (2000 мс)
                                // Сравнивает: реальную температуру с предсказанной
                                // При критическом отклонении: аварийное отключение

void resetThermalModel();       // Сброс модели к заводским настройкам (из адаптации)
                                // Вызывается: handleApiResetThermalModel()
                                // Удаляет: накопленную статистику, сбрасывает коэффициенты

void updateProtectionsForThermalModel();    // Адаптация защит при активации термальной модели
                                            // Вызывается: initThermalModel()
                                            // Смягчает: пороги Thermal Runaway (увеличивает таймауты)

// ----------------------------------------------------------------------------
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
// ----------------------------------------------------------------------------
void checkAirHeatingRate();     // Контроль скорости нагрева воздуха (используется моделью)
                                // Вызывается: checkThermalRunaway() при активной модели
                                // Предупреждает: если камера греется слишком медленно

void updateHeartbeat();         // Генерация импульсов на пин Watchdog (GPIO26)
                                // Вызывается: heartbeatTask в бесконечном цикле
                                // Работает только: при T_target > 0 и отсутствии критических ошибок

void checkMemory();             // Мониторинг состояния памяти (heap)
                                // Вызывается: webTask по таймеру heapCheckInterval (30 сек)
                                // При низкой памяти: очищает кэш и старые логи

// ----------------------------------------------------------------------------
// ЛОГИРОВАНИЕ ОШИБОК И УВЕДОМЛЕНИЙ
