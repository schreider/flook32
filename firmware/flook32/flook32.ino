// ============================================================================
// ТЕРМАЛЬНАЯ МОДЕЛЬ v2 (САМООБУЧАЮЩАЯСЯ С НУЛЯ)
// ============================================================================
// Принцип работы:
//   1. После включения модель находится в фазе ОБУЧЕНИЯ (learningMode = true)
//   2. В фазе обучения она только собирает статистику, не выдаёт ошибок
//   3. Через LEARNING_PERIOD минут модель переходит в фазу ЗАЩИТЫ
//   4. В фазе защиты модель предсказывает температуру и сравнивает с реальностью
//   5. Адаптационные данные используются как стартовые значения для ускорения обучения
// ============================================================================

#define LEARNING_PERIOD_MINUTES 5    // Сколько минут модель только учится
#define MIN_SAMPLES_FOR_PROTECTION 30 // Минимум точек для перехода в режим защиты

// ========== ИНИЦИАЛИЗАЦИЯ ==========
void initThermalModel() {
    // Пробуем загрузить сохранённую модель
    adaptiveModel.loadFromPreferences();
    
    if (adaptiveModel.initialized && adaptiveModel.samplesCollected > 10) {
        // Модель была сохранена и имеет данные — продолжаем с ними
        adaptiveModel.learningEnabled = true;
        addNotificationToLog("🧠 Термальная модель загружена (уверенность " + 
                            String((int)(adaptiveModel.confidence * 100)) + "%)");
    } else if (config.adaptationPerformed) {
        // Нет сохранённой модели, но есть адаптация — стартуем с неё
        adaptiveModel.initFromAdaptation();
        adaptiveModel.learningMode = true;
        adaptiveModel.learningStartTime = millis();
        adaptiveModel.confidence = 0.3f;
        addNotificationToLog("🧠 Термальная модель: тёплый старт (адаптация)");
    } else {
        // Ничего нет — холодный старт
        adaptiveModel.reset();
        adaptiveModel.learningMode = true;
        adaptiveModel.learningStartTime = millis();
        addNotificationToLog("🧠 Термальная модель: холодный старт");
    }
    
    adaptiveModel.learningEnabled = true;
    prevPredictionValid = false;
    prevHeaterTemp = heaterTemp;
    prevPower = heaterState ? 1.0f : 0.0f;
    
    updateProtectionsForThermalModel();
}

// ========== ПРОВЕРКА ТЕРМАЛЬНОЙ МОДЕЛИ v3 (С ПРОФИЛЕМ) ==========
void checkThermalModel() {
    if (!config.enableThermalModel || adaptationInProgress || 
        errors.hasCriticalError() || errors.isSystemLocked()) return;
    
    if (targetTemp <= 0) {
        prevPredictionValid = false;
        return;
    }
    
    static unsigned long lastModelCheck = 0;
    unsigned long now = millis();
    if (now - lastModelCheck < (unsigned long)config.thermalModelCheckInterval) return;
    lastModelCheck = now;
    
    // ========== ОТСЛЕЖИВАНИЕ ВКЛЮЧЕНИЯ НАГРЕВА ==========
    static bool wasHeaterOn = false;
    static unsigned long heatingStartedAt = 0;
    static float tempAtHeatingStart = 0;
    
    if (heaterState && !wasHeaterOn) {
        heatingStartedAt = now;
        tempAtHeatingStart = heaterTemp;
        wasHeaterOn = true;
        prevPredictionValid = false;
        LOG_INFO("ТМ: нагрев включён, T=%.1f°C", heaterTemp);
    }
    
    if (!heaterState) {
        wasHeaterOn = false;
        heatingStartedAt = 0;
    }
    
    float currentHeater = heaterTemp;
    float currentPower = heaterState ? 1.0f : 0.0f;
    float currentFanSpeed = fanState ? 1.0f : 0.0f;
    
    // ========== ФАЗА РАЗОГРЕВА — СРАВНЕНИЕ С ПРОФИЛЕМ ==========
    if (heaterState && config.heatingProfileCount > 0) {
        unsigned long elapsedSec = (now - heatingStartedAt) / 1000;
        
        if (elapsedSec < config.heatingProfileCount) {
            float expectedTemp = config.heatingProfileTemp[elapsedSec];
            float error = heaterTemp - expectedTemp;
            
            // Допуск: 10°C + 0.1°C за каждую секунду (шире в начале)
            float allowedError = 10.0f + elapsedSec * 0.1f;
            
            // Обучаем модель на реальных данных
            if (prevPredictionValid) {
                adaptiveModel.update(currentHeater, prevPrediction, prevPower, currentFanSpeed, now);
            }
            
            if (abs(error) > allowedError && elapsedSec > 5) {
                LOG_WARN("ТМ: отклонение от профиля %.1f°C (ожидалось %.1f°C на +%lus)", 
                         error, expectedTemp, elapsedSec);
                // Не блокируем, только предупреждаем — разогрев может отличаться
            }
            
            prevHeaterTemp = currentHeater;
            prevPrediction = expectedTemp;
            prevPower = currentPower;
            prevPredictionTime = now;
            prevPredictionValid = true;
            return;
        }
    }
    
    // ========== ФАЗА ОБУЧЕНИЯ (если профиля нет) ==========
    if (adaptiveModel.learningMode) {
        unsigned long learningElapsed = (now - adaptiveModel.learningStartTime) / 60000;
        
        if (prevPredictionValid) {
            adaptiveModel.update(currentHeater, prevPrediction, prevPower, currentFanSpeed, now);
        }
        
        bool timeReached = (learningElapsed >= LEARNING_PERIOD_MINUTES);
        bool samplesReached = (adaptiveModel.samplesCollected >= MIN_SAMPLES_FOR_PROTECTION);
        
        if (timeReached && samplesReached) {
            adaptiveModel.learningMode = false;
            adaptiveModel.confidence = constrain(adaptiveModel.samplesCollected / 100.0f, 0.3f, 0.9f);
            addNotificationToLog("✅ Термальная модель: обучение завершено, уверенность " + 
                                String((int)(adaptiveModel.confidence * 100)) + "%");
        }
        
        prevHeaterTemp = currentHeater;
        prevPrediction = adaptiveModel.predict(currentHeater, targetTemp, currentPower, 
                                               currentFanSpeed, config.thermalModelCheckInterval / 1000.0f);
        prevPower = currentPower;
        prevPredictionTime = now;
        prevPredictionValid = true;
        return;
    }
    
    // ========== ФАЗА ЗАЩИТЫ ==========
    if (prevPredictionValid) {
        adaptiveModel.update(currentHeater, prevPrediction, prevPower, currentFanSpeed, now);
    }
    
    float predictionHorizon = config.thermalModelCheckInterval / 1000.0f;
    float predicted = adaptiveModel.predict(currentHeater, targetTemp, currentPower, 
                                            currentFanSpeed, predictionHorizon);
    
    if (prevPredictionValid) {
        float error = abs(currentHeater - prevPrediction);
        float noiseFloor = max(adaptiveModel.noiseFloor, 0.3f);
        float confidenceFactor = 1.0f + (1.0f - adaptiveModel.confidence);
        float threshold = noiseFloor * 3.0f * config.thermalModelSensitivity * confidenceFactor;
        
        if (currentPower > 0.01f) threshold *= 0.9f;
        
        float tempChangeRate = abs(currentHeater - prevHeaterTemp) / predictionHorizon;
        if (tempChangeRate > 1.0f) {
            threshold *= (1.0f + tempChangeRate * 0.1f);
        }
        
        if (threshold < 1.5f) threshold = 1.5f;
        if (threshold > 25.0f) threshold = 25.0f;
        
        static float errorWindow[5] = {0};
        static unsigned long errorTimes[5] = {0};
        static int errorIdx = 0;
        
        errorWindow[errorIdx] = error;
        errorTimes[errorIdx] = now;
        errorIdx = (errorIdx + 1) % 5;
        
        float sumError = 0;
        int countInWindow = 0;
        for (int i = 0; i < 5; i++) {
            if (now - errorTimes[i] < 10000) {
                sumError += errorWindow[i];
                countInWindow++;
            }
        }
        float avgError = (countInWindow > 0) ? sumError / countInWindow : 0;
        
        static int anomalyCount = 0;
        
        if (avgError > threshold && countInWindow >= 3) {
            anomalyCount++;
            if (anomalyCount >= 3) {
                if (config.thermalModelLogWarnings) {
                    addErrorToLog("⚠️ THERMAL ANOMALY: откл " + String(avgError, 1) + 
                                 "°C (порог " + String(threshold, 1) + "°C, ув " + 
                                 String((int)(adaptiveModel.confidence * 100)) + "%)", 
                                 false, true, 0);
                }
                if (avgError > threshold * 2.5f) { 
                    digitalWrite(config.pinSsr, config.invertHeaterSignal ? HIGH : LOW);
                    heaterState = false; 
                    errors.thermalModelAnomaly = true;
                    addErrorToLog("🔥 КРИТИЧЕСКОЕ ОТКЛОНЕНИЕ ТМ: " + 
                                 String(avgError, 1) + "°C", true, true, 0); 
                }
                anomalyCount = 0;
            }
        } else {
            if (anomalyCount > 0) anomalyCount--;
        }
        
        if (avgError < threshold * 0.5f && adaptiveModel.confidence < 0.95f) {
            adaptiveModel.confidence += 0.001f;
        }
    }
    
    prevHeaterTemp = currentHeater;
    prevPrediction = predicted;
    prevPower = currentPower;
    prevPredictionTime = now;
    prevPredictionValid = true;
}

// ========== СБРОС МОДЕЛИ ==========
void resetThermalModel() { 
    adaptiveModel.reset();
    adaptiveModel.learningMode = true;
    adaptiveModel.learningStartTime = millis();
    adaptiveModel.samplesCollected = 0;
    adaptiveModel.confidence = 0.0f;
    
    if (config.adaptationPerformed) {
        adaptiveModel.initFromAdaptation();
        adaptiveModel.confidence = 0.3f;
    }
    
    prevPredictionValid = false;
    addNotificationToLog("🔄 Термальная модель сброшена, переобучение"); 
}

// ========== ОБНОВЛЕНИЕ ЗАЩИТ ДЛЯ ТЕРМАЛЬНОЙ МОДЕЛИ ==========
void updateProtectionsForThermalModel() {
    bool wasActive = protectionOverride.thermalModelActive;
    bool nowActive = config.enableThermalModel;
    
    if (nowActive == wasActive && nowActive) { 
        protectionOverride.updateFromConfig(config); 
        return; 
    }
    
    protectionOverride.thermalModelActive = nowActive;
    
    if (nowActive) { 
        protectionOverride.updateFromConfig(config); 
        addNotificationToLog("🔧 Thermal Runaway переведён в режим пониженной чувствительности"); 
    } else { 
        protectionOverride.reset(); 
    }
    
    protectionOverride.airCheckActive = false; 
    protectionOverride.airCheckStartTime = 0;
}

// ============================================================================
// СОХРАНЕНИЕ КОНФИГУРАЦИИ В ЭНЕРГОНЕЗАВИСИМУЮ ПАМЯТЬ
// ============================================================================
// Эта функция:
//   1. Вызывает config.validate() для приведения всех полей к допустимым пределам
//   2. Проверяет системные интервалы и пины (дополнительная страховка)
//   3. Сохраняет ВСЮ структуру Config одной операцией через putBytes()
//   4. Отдельно сохраняет lastTarget (не входит в структуру Config)
//   5. Если изменились настройки Watchdog — перезагружает ESP32
// ============================================================================
void saveConfig() {
    // Сбрасываем кэш API, чтобы следующий запрос получил свежие данные
    configCacheValid = false;

    // Выводим размер структуры для отладки (должен быть стабильным)
    Serial.printf("sizeof(Config) = %d байт\n", sizeof(Config));

    // Валидация всех полей структуры (пороги, диапазоны, булевы флаги)
    config.validate();

    // ========== ДОПОЛНИТЕЛЬНАЯ ВАЛИДАЦИЯ СИСТЕМНЫХ ИНТЕРВАЛОВ ==========
    // Эти проверки дублируют config.validate(), но оставлены для надёжности,
    // потому что некорректные интервалы могут привести к зависанию системы.
    if (config.heapCheckInterval < 5000 || config.heapCheckInterval > 60000)
        config.heapCheckInterval = DEFAULT_HEAP_CHECK_INTERVAL;
    if (config.readInterval < 100 || config.readInterval > 5000)
        config.readInterval = DEFAULT_READ_INTERVAL;
    if (config.trendInterval < 500 || config.trendInterval > 10000)
        config.trendInterval = DEFAULT_TREND_INTERVAL;
    if (config.controlInterval < 1000 || config.controlInterval > 30000)
        config.controlInterval = DEFAULT_CONTROL_INTERVAL;
    if (config.loopWatchdogTimeout < 5000 || config.loopWatchdogTimeout > 60000)
        config.loopWatchdogTimeout = DEFAULT_LOOP_WATCHDOG_TIMEOUT;
    if (config.udpDiscoveryTimeout < 5000 || config.udpDiscoveryTimeout > 60000)
        config.udpDiscoveryTimeout = DEFAULT_UDP_DISCOVERY_TIMEOUT;
    if (config.discoveryRetryInterval < 500 || config.discoveryRetryInterval > 10000)
        config.discoveryRetryInterval = DEFAULT_DISCOVERY_RETRY_INTERVAL;
    if (config.heartbeatPulseMs < 10 || config.heartbeatPulseMs > 1000)
        config.heartbeatPulseMs = DEFAULT_HEARTBEAT_PULSE_MS;
    if (config.heartbeatPauseMs < 100 || config.heartbeatPauseMs > 10000)
        config.heartbeatPauseMs = DEFAULT_HEARTBEAT_PAUSE_MS;
    if (config.fanMinOnTime < 10 || config.fanMinOnTime > 300)
        config.fanMinOnTime = DEFAULT_FAN_MIN_ON_TIME;

    // ========== ВАЛИДАЦИЯ ПИНОВ (ограничение диапазоном 0-39) ==========
    // Пины вне этого диапазона не существуют на ESP32
    config.pinSsr      = constrain(config.pinSsr,      0, 39);
    config.pinFan      = constrain(config.pinFan,      0, 39);
    config.pinWatchdog = constrain(config.pinWatchdog, 0, 39);
    config.pinOneWire  = constrain(config.pinOneWire,  0, 39);
    config.pinMaxSck   = constrain(config.pinMaxSck,   0, 39);
    config.pinMaxSo    = constrain(config.pinMaxSo,    0, 39);
    config.pinMaxCs    = constrain(config.pinMaxCs,    0, 39);
    config.pinBuzzer   = constrain(config.pinBuzzer,   0, 39);
    config.pinLed      = constrain(config.pinLed,      0, 39);
    config.pinButton   = constrain(config.pinButton,   0, 39);

    // ========== ПРОВЕРКА ИЗМЕНЕНИЯ НАСТРОЕК WATCHDOG ==========
    // Если пользователь изменил таймаут или вкл/выкл Watchdog,
    // нужна перезагрузка, потому что эти настройки применяются только при старте
    static bool lastWatchdogEnabled = config.enableLoopWatchdog;
    static int  lastWatchdogTimeout = config.loopWatchdogTimeout;
    bool watchdogChanged = (lastWatchdogEnabled != config.enableLoopWatchdog)
                        || (lastWatchdogTimeout != config.loopWatchdogTimeout);

    // ========== ОТКРЫВАЕМ NVS ДЛЯ ЗАПИСИ ==========
    Preferences prefs;
    if (!prefs.begin("flook", false)) {
        // Критическая ошибка — невозможно сохранить настройки
        Serial.println("❌ Не удалось открыть Preferences для сохранения!");
        return;
    }

    // ========== СОХРАНЯЕМ ВСЮ СТРУКТУРУ CONFIG ОДНОЙ ОПЕРАЦИЕЙ ==========
    // Это гарантирует атомарность: либо все поля сохранятся, либо ни одно.
    // Размер структуры должен быть стабильным (определяется на этапе компиляции).
    prefs.putBytes("config", &config, sizeof(Config));

    // ========== СОХРАНЯЕМ lastTarget ОТДЕЛЬНО ==========
    // Эта переменная не входит в структуру Config, потому что она часто меняется
    // и не относится к настройкам, а к текущему состоянию системы.
    prefs.putFloat("lastTarget", targetTemp);

    // ========== ЗАКРЫВАЕМ NVS ==========
    // ВАЖНО: только после prefs.end() данные физически записываются во флеш-память
    prefs.end();

    // Сбрасываем кэш API после сохранения
    configCacheValid = false;

    Serial.println("✅ Конфигурация сохранена");

    // ========== ПЕРЕЗАГРУЗКА ПРИ ИЗМЕНЕНИИ WATCHDOG ==========
    if (watchdogChanged) {
        // Обновляем статические переменные, чтобы избежать повторной перезагрузки
        lastWatchdogEnabled = config.enableLoopWatchdog;
        lastWatchdogTimeout = config.loopWatchdogTimeout;
        Serial.println("⚠️ Настройки Watchdog изменены, перезагрузка для применения...");
        delay(500);          // Даём время на отправку ответа клиенту
        ESP.restart();       // Программная перезагрузка
    }
}

// ============================================================================
// ЗАГРУЗКА КОНФИГУРАЦИИ ИЗ ЭНЕРГОНЕЗАВИСИМОЙ ПАМЯТИ
// ============================================================================
// Эта функция:
//   1. Пытается загрузить структуру Config из NVS через getBytes()
//   2. Если размер сохранённой структуры >= текущей — загружает полностью
//   3. Если размер меньше (старая версия прошивки) — загружает что есть,
//      новые поля получают значения по умолчанию. Настройки не сбрасываются.
//   4. Отдельно загружает lastTarget (не входит в Config)
//   5. Вызывает config.validate() для приведения всех полей к допустимым пределам
//   6. Выводит подробную отладочную информацию о загруженной конфигурации
// ============================================================================
void loadConfig() {
    configCacheValid = false;

    Preferences prefs;

    if (!prefs.begin("flook", true)) {
        Serial.println("⚠️ Конфигурация не найдена, используются значения по умолчанию");
        Config defaultConfig;
        config = defaultConfig;
        config.validate();
        return;
    }

    // ========== ЗАГРУЗКА КОНФИГУРАЦИИ С ПОДДЕРЖКОЙ СТАРЫХ ВЕРСИЙ ==========
    size_t size = prefs.getBytesLength("config");

    if (size > 0) {
        if (size >= sizeof(Config)) {
            // Структура не меньше текущей — загружаем полностью
            prefs.getBytes("config", &config, sizeof(Config));
            Serial.println("✅ Конфигурация загружена из Preferences");
            Serial.printf("   Размер структуры: %d байт (ожидалось %d)\n", size, sizeof(Config));
        } else {
            // Старая структура меньше — загружаем что есть, хвост = defaults
            Config defaults;
            memset(&config, 0, sizeof(Config));
            prefs.getBytes("config", &config, size);
            memcpy((uint8_t*)&config + size, (uint8_t*)&defaults + size, sizeof(Config) - size);
            Serial.printf("⚠️ Конфигурация обновлена (старый размер %d, новый %d)\n", size, sizeof(Config));
            Serial.println("   Новые поля получили значения по умолчанию, старые сохранены");
        }

        // ========== ЗАГРУЖАЕМ lastTarget ОТДЕЛЬНО ==========
        float savedTarget = prefs.getFloat("lastTarget", config.defaultTargetTemp);
        if (savedTarget > 0 && savedTarget <= config.maxAirTemp) {
            targetTemp = savedTarget;
            Serial.printf("🔄 Восстановлена целевая температура: %.1f°C\n", targetTemp);
        } else {
            targetTemp = config.defaultTargetTemp;
            Serial.printf("🔄 Целевая температура сброшена к значению по умолчанию: %.1f°C\n", targetTemp);
        }
    } else {
        Serial.println("⚠️ Конфигурация не найдена, используются значения по умолчанию");
    }

    prefs.end();

    // ========== ГАРАНТИРУЕМ ТЕРМИНАЛЬНЫЕ НОЛИ ДЛЯ СТРОК ==========
    config.ssid[31]     = '\0';
    config.password[63] = '\0';
    config.unlockPassword[31] = '\0';

    // ========== ВАЛИДАЦИЯ ЗАГРУЖЕННЫХ ДАННЫХ ==========
    config.validate();

    // ========== ДОПОЛНИТЕЛЬНАЯ ВАЛИДАЦИЯ ОТДЕЛЬНЫХ ПОЛЕЙ ==========
    if (config.invertFanSignal != 0 && config.invertFanSignal != 1) {
        config.invertFanSignal = DEFAULT_INVERT_FAN_SIGNAL;
        Serial.println("⚠️ invertFanSignal исправлен (некорректное значение)");
    }
    if (config.invertHeaterSignal != 0 && config.invertHeaterSignal != 1) {
        config.invertHeaterSignal = DEFAULT_INVERT_HEATER_SIGNAL;
        Serial.println("⚠️ invertHeaterSignal исправлен (некорректное значение)");
    }
    if (config.heartbeatPulseMs < 10 || config.heartbeatPulseMs > 1000)
        config.heartbeatPulseMs = DEFAULT_HEARTBEAT_PULSE_MS;
    if (config.heartbeatPauseMs < 100 || config.heartbeatPauseMs > 10000)
        config.heartbeatPauseMs = DEFAULT_HEARTBEAT_PAUSE_MS;
    if (config.fanMinOnTime < 10 || config.fanMinOnTime > 300)
        config.fanMinOnTime = DEFAULT_FAN_MIN_ON_TIME;
    if (config.readInterval < 100 || config.readInterval > 5000)
        config.readInterval = DEFAULT_READ_INTERVAL;
    if (config.trendInterval < 500 || config.trendInterval > 10000)
        config.trendInterval = DEFAULT_TREND_INTERVAL;
    if (config.controlInterval < 1000 || config.controlInterval > 30000)
        config.controlInterval = DEFAULT_CONTROL_INTERVAL;
    if (config.heapCheckInterval < 5000 || config.heapCheckInterval > 60000)
        config.heapCheckInterval = DEFAULT_HEAP_CHECK_INTERVAL;
    if (config.loopWatchdogTimeout < 5000 || config.loopWatchdogTimeout > 60000)
        config.loopWatchdogTimeout = DEFAULT_LOOP_WATCHDOG_TIMEOUT;
    if (config.udpDiscoveryTimeout < 5000 || config.udpDiscoveryTimeout > 60000)
        config.udpDiscoveryTimeout = DEFAULT_UDP_DISCOVERY_TIMEOUT;
    if (config.discoveryRetryInterval < 500 || config.discoveryRetryInterval > 10000)
        config.discoveryRetryInterval = DEFAULT_DISCOVERY_RETRY_INTERVAL;
    if (config.maxFanDuty < 0 || config.maxFanDuty > 1023)
        config.maxFanDuty = DEFAULT_MAX_FAN_DUTY;

    configCacheValid = false;

    // ========== ВЫВОД ОТЛАДОЧНОЙ ИНФОРМАЦИИ ==========
    Serial.println("=== ЗАГРУЖЕНА КОНФИГУРАЦИЯ ===");
    Serial.printf("Пины: SSR=%d, FAN=%d, WATCHDOG=%d, DS18B20=%d\n",
                  config.pinSsr, config.pinFan, config.pinWatchdog, config.pinOneWire);
    Serial.printf("MAX6675: SCK=%d, SO=%d, CS=%d\n",
                  config.pinMaxSck, config.pinMaxSo, config.pinMaxCs);
    Serial.printf("Зуммер: пин=%d, LED: пин=%d\n",
                  config.pinBuzzer, config.pinLed);
    Serial.printf("Инверсия: нагреватель=%d, вентилятор=%d, макс.duty=%d\n",
                  config.invertHeaterSignal, config.invertFanSignal, config.maxFanDuty);
    Serial.printf("Адаптация выполнена: %s\n",
                  config.adaptationPerformed ? "да" : "нет");
    Serial.printf("Heartbeat: pulse=%d ms, pause=%d ms\n",
                  config.heartbeatPulseMs, config.heartbeatPauseMs);
    Serial.printf("Интервалы: read=%d, trend=%d, control=%d, heapCheck=%d\n",
                  config.readInterval, config.trendInterval,
                  config.controlInterval, config.heapCheckInterval);
    Serial.printf("Интервалы: loopWDT=%d, udpTimeout=%d, udpRetry=%d\n",
                  config.loopWatchdogTimeout, config.udpDiscoveryTimeout,
                  config.discoveryRetryInterval);
    Serial.printf("Термальная модель: %s, чувствительность=%.1f\n",
                  config.enableThermalModel ? "вкл" : "выкл",
                  config.thermalModelSensitivity);
    Serial.printf("LED: %s, кол-во=%d, яркость=%d\n",
                  config.ledEnabled ? "вкл" : "выкл",
                  config.ledCount, config.ledBrightness);
    Serial.printf("Зуммер: %s, некрит.сигналы=%s, мелодия=%d\n",
                  config.buzzerEnabled ? "вкл" : "выкл",
                  config.buzzerNonCriticalEnabled ? "вкл" : "выкл",
                  config.buzzerMelody);
    Serial.printf("Автоотключение: %s, минут=%d\n",
                  config.autoShutdownEnabled ? "вкл" : "выкл",
                  config.autoShutdownMinutes);
    Serial.printf("Wi-Fi: %s, SSID=%s\n",
                  config.wifiConfigured ? "настроен" : "не настроен",
                  config.ssid);
    Serial.printf("Target restored: %.1f°C\n", targetTemp);
    Serial.println("==============================");
}

// ============================================================================
// ТАБЛИЦА DUTY (ЗАВИСИМОСТЬ МОЩНОСТИ ВЕНТИЛЯТОРА ОТ ТЕМПЕРАТУРЫ)
// ============================================================================

// ========== СОХРАНЕНИЕ ТАБЛИЦЫ DUTY В PREFERENCES ==========
// Сохраняет таблицу соответствия температуры воздуха и мощности вентилятора
// Таблица используется при автоограничении мощности для плавного управления
// Вызывается: при завершении адаптации, при изменении таблицы через API
void saveDutyTable() {
    Preferences prefs;
    if (!prefs.begin("dutyTable", false)) {
        LOG_ERROR("Не удалось сохранить таблицу duty");
        return;
    }
    
    // Сохраняем размер таблицы
    prefs.putInt("size", dutyTableSize);
    
    // Сохраняем каждую точку таблицы (температура → duty)
    for (int i = 0; i < dutyTableSize; i++) {
        prefs.putFloat(("temp_" + String(i)).c_str(), dutyTable[i].airTemp);
        prefs.putInt(("duty_" + String(i)).c_str(), dutyTable[i].duty);
    }
    
    prefs.end();
    LOG_DEBUG("Таблица duty сохранена (%d записей)", dutyTableSize);
}

// ========== ЗАГРУЗКА ТАБЛИЦЫ DUTY ИЗ PREFERENCES ==========
// Загружает ранее сохранённую таблицу соответствия
// Вызывается: setup() после загрузки основной конфигурации
void loadDutyTable() {
    Preferences prefs;
    if (!prefs.begin("dutyTable", true)) {
        LOG_WARN("Таблица duty не найдена");
        return;
    }
    
    // Загружаем размер таблицы
    dutyTableSize = prefs.getInt("size", 0);
    
    // Загружаем каждую точку (ограничивая MAX_DUTY_TABLE_SIZE)
    for (int i = 0; i < dutyTableSize && i < MAX_DUTY_TABLE_SIZE; i++) {
        dutyTable[i].airTemp = prefs.getFloat(("temp_" + String(i)).c_str(), 0);
        dutyTable[i].duty = prefs.getInt(("duty_" + String(i)).c_str(), config.maxFanDuty);
        LOG_DEBUG("Загружена точка duty: T=%.1f°C -> duty=%d", dutyTable[i].airTemp, dutyTable[i].duty);
    }
    
    prefs.end();
}

// ========== ПОЛУЧЕНИЕ СТАРТОВОГО DUTY ПО ТЕМПЕРАТУРЕ ВОЗДУХА ==========
// Определяет начальную мощность вентилятора при включении
// Использует линейную интерполяцию между точками таблицы
// Если таблица пуста - возвращает максимальную мощность
// Вызывается: updateFan() при включении вентилятора
int getStartupDutyByAirTemp(float airTemp) {
    // Если таблица пуста - используем максимальную мощность
    if (dutyTableSize == 0) return config.maxFanDuty;
    
    // Линейная интерполяция между соседними точками таблицы
    // Таблица должна быть отсортирована по температуре
    for (int i = 0; i < dutyTableSize - 1; i++) {
        if (airTemp >= dutyTable[i].airTemp && airTemp <= dutyTable[i+1].airTemp) {
            // Расчёт коэффициента интерполяции (0..1)
            float ratio = (airTemp - dutyTable[i].airTemp) / 
                         (dutyTable[i+1].airTemp - dutyTable[i].airTemp);
            int result = dutyTable[i].duty + ratio * (dutyTable[i+1].duty - dutyTable[i].duty);
            LOG_DEBUG("Интерполяция duty: T=%.1f°C -> duty=%d", airTemp, result);
            return result;
        }
    }
    
    // Если температура ниже минимальной в таблице
    if (airTemp <= dutyTable[0].airTemp) return dutyTable[0].duty;
    
    // Если температура выше максимальной в таблице
    if (airTemp >= dutyTable[dutyTableSize-1].airTemp) return dutyTable[dutyTableSize-1].duty;
    
    // Fallback - максимальная мощность
    return config.maxFanDuty;
}

// ============================================================================
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
// ============================================================================

// ========== ЗАГРУЗКА СОСТОЯНИЯ БЛОКИРОВКИ ==========
// Обёртка для errors.loadLockState()
// Вызывается: setup() после инициализации ошибок
void loadLockState() { 
    errors.loadLockState(); 
}

// ========== ПЕРЕЗАГРУЗКА ВСЕХ УСТРОЙСТВ ==========
// Алиас для ESP.restart()
// Вызывается: API /api/reboot-all, /api/reboot
void rebootAll() { 
    ESP.restart(); 
}

// ========== СБРОС ВСЕХ ФЛАГОВ ОШИБОК ==========
// Сбрасывает временные флаги ошибок (не блокировку системы)
// Восстанавливает нормальный режим работы вентилятора
// Вызывается: handleApiUnlock() после разблокировки системы
void clearErrorFlags() {
    // Не сбрасываем ошибки если система заблокирована
    if (errors.isSystemLocked()) return;
    
    // ========== СБРОС ОСНОВНЫХ ФЛАГОВ ОШИБОК ==========
    errors.criticalOverheat = false; 
    errors.criticalOverheatLogged = false;
    errors.airOverheat = false; 
    errors.airOverheatLogged = false;
    errors.thermalRunaway = false; 
    errors.thermalRunawayLogged = false;
    errors.unexpectedHeat = false; 
    errors.unexpectedHeatLogged = false;
    errors.thermalModelAnomaly = false; 
    errors.thermalModelAnomalyLogged = false;
    
    // ========== СБРОС ФЛАГОВ ОШИБОК ДАТЧИКОВ ==========
    errors.max6675Disconnected = false; 
    errors.max6675DisconnectedLogged = false;
    errors.max6675Stuck = false; 
    errors.max6675StuckLogged = false;
    
    // ========== СБРОС ЛОКАЛЬНЫХ ФЛАГОВ ==========
    criticalOverheatLock = false; 
    airOverheatLock = false; 
    runawayTriggered = false; 
    unexpectedHeatDetected = false;
    
    // ========== СБРОС ФОРСИРОВАННОГО РЕЖИМА ВЕНТИЛЯТОРА ==========
    if (fanForcedByError) {
        fanForcedByError = false;
        fanStateSaved = false;
        setFanDuty(0);                      // Выключаем вентилятор
        currentDynamicDuty = 0;
        fanState = false;
    }
}

// ============================================================================
// КНОПКА СБРОСА К ЗАВОДСКИМ НАСТРОЙКАМ
// ============================================================================

// Инициализация пина кнопки сброса
// Пин: GPIO17, режим INPUT_PULLUP (LOW при нажатии)
// Вызывается: setup() один раз
void initButton() {
    pinMode(config.pinButton, INPUT_PULLUP);     // Вход с подтяжкой к питанию
}

// ============================================================================
// ОБРАБОТКА НАЖАТИЯ И УДЕРЖАНИЯ КНОПКИ СБРОСА
// ============================================================================

// Обработка нажатия и удержания кнопки сброса к заводским настройкам
// Вызывается: webTask() в каждом цикле (каждые 10 мс)
// Логика:
//   - Короткое нажатие (< 5 сек): ничего не происходит
//   - Удержание 5 секунд: полный сброс Preferences и перезагрузка
//   - Индикация: светодиодная лента заполняется оранжевым по мере удержания
// Аппаратно: кнопка подключена к config.pinButton с INPUT_PULLUP
void checkButton() {
    static unsigned long pressStartTime = 0;     // Время начала нажатия (мс)
    static bool wasPressed = false;              // Состояние кнопки в предыдущем цикле
    static bool buttonActive = false;            // Флаг: кнопка сейчас обрабатывается (блокирует updateLEDs)
    
    bool pressed = (digitalRead(config.pinButton) == LOW);   // LOW = нажата (INPUT_PULLUP)
    
    // ========== 1. КНОПКА ТОЛЬКО ЧТО НАЖАТА (ФРОНТ) ==========
    if (pressed && !wasPressed) {
        pressStartTime = millis();               // Запоминаем время нажатия
        buttonActive = true;                     // Блокируем updateLEDs
    }
    
    // ========== 2. КНОПКА УДЕРЖИВАЕТСЯ ==========
    else if (pressed && wasPressed) {
        unsigned long holdDuration = millis() - pressStartTime;
        
        // Прогресс-бар на светодиодах (заполняется оранжевым)
        if (pStrip && config.ledEnabled && holdDuration < BUTTON_HOLD_TIME) {
            float progress = (float)holdDuration / BUTTON_HOLD_TIME * 100.0f;
            int total = pStrip->numPixels();
            int filledLeds = (int)(progress * total / 100.0f);
            
            pStrip->clear();
            for (int i = 0; i < total; i++) {
                if (i < filledLeds) {
                    pStrip->setPixelColor(i, 255, 80, 0);    // Оранжевый (заполнено)
                } else if (i == filledLeds) {
                    // Мигающий последний светодиод
                    bool blink = (millis() / 200) % 2;       // Мигание 2.5 Гц
                    pStrip->setPixelColor(i, blink ? 255 : 20, blink ? 80 : 0, 0);
                } else {
                    pStrip->setPixelColor(i, 20, 0, 0);      // Тёмно-красный фон
                }
            }
            pStrip->show();
        }
        
        // Проверяем достижение порога удержания (5 секунд)
        if (holdDuration >= BUTTON_HOLD_TIME && !buttonPressDetected) {
            buttonPressDetected = true;          // Отмечаем что сброс выполнен
            
            // ----- СВЕТОДИОДНАЯ ИНДИКАЦИЯ ЗАВЕРШЕНИЯ -----
            if (pStrip) {
                // Тройная вспышка белым
                for (int flash = 0; flash < 3; flash++) {
                    setAllLED(255, 255, 255);    // Белый
                    delay(150);
                    setAllLED(0, 0, 0);          // Выключено
                    delay(150);
                }
            }
            
            // ----- ОЧИСТКА ВСЕХ НАСТРОЕК -----
            Preferences prefs;
            
            // 1. Очищаем основную конфигурацию (namespace "flook")
            prefs.begin("flook", false);
            prefs.clear();                       // Удаляем все ключи
            prefs.end();
            
            // 2. Очищаем таблицу duty (namespace "dutyTable")
            prefs.begin("dutyTable", false);
            prefs.clear();
            prefs.end();
            
            // 3. Очищаем термальную модель (namespace "thermal")
            prefs.begin("thermal", false);
            prefs.clear();
            prefs.end();
            
            // ----- ЗАВЕРШЕНИЕ СБРОСА -----
            delay(1000);                         // Даём время на отправку WebSocket сообщения
            ESP.restart();                       // Перезагрузка с чистыми настройками
        }
    }
    
    // ========== 3. КНОПКА ОТПУЩЕНА ==========
    else if (!pressed && wasPressed) {
        // Если сброс не был выполнен - уведомляем
        if (!buttonPressDetected) {
            unsigned long heldFor = millis() - pressStartTime;
            if (heldFor > 500) {                 // Игнорируем случайные касания < 0.5 сек
                addNotificationToLog("🔘 Кнопка отпущена (удерживалась " + String(heldFor / 1000.0f, 1) + " сек, сброс не выполнен)");
            }
        }
        
        buttonActive = false;                    // Разрешаем updateLEDs снова
        pressStartTime = 0;                      // Сбрасываем таймер
        buttonPressDetected = false;             // Сбрасываем флаг для следующего нажатия
    }
    
    // Сохраняем состояние для следующей итерации
    wasPressed = pressed;
}

// ============================================================================
// КОНТРОЛЬ ПАМЯТИ (HEAP MONITORING)
// ============================================================================

// Мониторинг состояния кучи (heap) для предотвращения критической фрагментации
// Вызывается: webTask() по таймеру heapCheckInterval (по умолчанию 30 секунд)
// При низком уровне памяти: очищает журнал ошибок и кэш конфигурации
void checkMemory() {
    unsigned long now = millis();
    
    // Ограничение частоты проверок (heapCheckInterval из конфигурации)
    if (now - lastHeapCheck < config.heapCheckInterval) return;
    lastHeapCheck = now;
    
    // ========== 1. СБОР СТАТИСТИКИ ПАМЯТИ ==========
    uint32_t freeHeap = ESP.getFreeHeap();          // Свободная куча (байт)
    uint32_t maxBlock = ESP.getMaxAllocHeap();      // Максимальный непрерывный блок (байт)
    
    // ========== 2. СТАТИСТИКА ЖУРНАЛА ОШИБОК ==========
    size_t trendBufferSize = TREND_BUFFER_SIZE * sizeof(CompactTrendEntry);  // 600 * 16 = 9600 байт
    size_t errorLogBytes = 0;
    int errorLogEntries = 0;
    
    taskENTER_CRITICAL(&errorLogMux);
    errorLogEntries = errorLog.size();
    for (const auto& e : errorLog) {
        // Учитываем: длину сообщения, данные трендов и размер самой структуры
        errorLogBytes += e.message.length() + e.trendData.length() + sizeof(ErrorLogEntry);
    }
    taskEXIT_CRITICAL(&errorLogMux);
    
    // ========== 3. СТАТИСТИКА БУФЕРА ТРЕНДОВ ==========
    taskENTER_CRITICAL(&trendBufferMux);
    int trendCount = trendBufferFilled ? TREND_BUFFER_SIZE : trendIndex;
    
    unsigned long oldestTimestamp = 0, newestTimestamp = 0;
    if (trendCount > 0) {
        int oldestIdx = trendBufferFilled ? trendIndex : 0;
        int newestIdx = (trendIndex - 1 + TREND_BUFFER_SIZE) % TREND_BUFFER_SIZE;
        oldestTimestamp = trendBuffer[oldestIdx].timestamp;
        newestTimestamp = trendBuffer[newestIdx].timestamp;
    }
    taskEXIT_CRITICAL(&trendBufferMux);
    
    // Длительность сохранённой истории в секундах
    unsigned long historySec = (newestTimestamp > oldestTimestamp) ? 
                               (newestTimestamp - oldestTimestamp) / 1000 : 0;
    
    // ========== 4. ВЫВОД СТАТИСТИКИ В СЕРИЙНЫЙ ПОРТ ==========
    LOG_DEBUG("Memory: free=%u, maxBlock=%u", freeHeap, maxBlock);
    LOG_DEBUG("configCacheValid: %d", configCacheValid);
    LOG_DEBUG("errorLog: %d entries, %zu bytes", errorLogEntries, errorLogBytes);
    LOG_DEBUG("trendBuffer: %zu bytes (%d/%d entries, history %lu sec / %.1f min)", 
            trendBufferSize, trendCount, TREND_BUFFER_SIZE, historySec, historySec / 60.0);
    
    // ========== 5. ЭКСТРЕННАЯ ОЧИСТКА ПРИ КРИТИЧЕСКОМ НИЗКОМ УРОВНЕ ПАМЯТИ ==========
    // Критерии: свободной памяти < LOW_MEMORY_THRESHOLD ИЛИ нет непрерывного блока MIN_FREE_HEAP
    if (freeHeap < LOW_MEMORY_THRESHOLD || maxBlock < MIN_FREE_HEAP) {
        LOG_ERROR("КРИТИЧЕСКИ НИЗКАЯ ПАМЯТЬ! Экстренная очистка...");
        
        // Сбрасываем кэш конфигурации (освобождаем JSON документ)
        configCacheValid = false;
        
        // Очищаем журнал ошибок (самый большой потребитель динамической памяти)
        taskENTER_CRITICAL(&errorLogMux);
        errorLog.clear();                       // Полная очистка вектора
        taskEXIT_CRITICAL(&errorLogMux);
        
        // Небольшая задержка для стабилизации
        delay(100);
        
        // Примечание: буфер трендов не очищается (это статическая память)
        // Примечание: dutyTable не очищается (тоже статическая)
    }
}

// ============================================================================
// СБРОС ТАЙМЕРА АКТИВНОСТИ (ДЛЯ АВТОПЕРЕЗАГРУЗКИ)
// ============================================================================

// Сбрасывает таймер активности устройства
// Вызывается: при любом действии пользователя (установка цели, нажатие кнопки, API запрос)
// Сбрасывает все флаги, связанные с автоматической перезагрузкой
void resetActivityTimer() {
    lastActivityTime = millis();        // Обновляем время последней активности
    rebootTimerActive = true;           // Активируем таймер (на случай если был отключён)
    rebootInProgress = false;           // Сбрасываем флаг выполнения перезагрузки
    autoRebootPending = false;          // Сбрасываем флаг отложенной перезагрузки
}

// ========== ВЫПОЛНЕНИЕ АВТОМАТИЧЕСКОЙ ПЕРЕЗАГРУЗКИ ==========
// Вызывается: controlTask() при достижении таймаута бездействия (24 часа)
// Устанавливает флаг в Preferences и перезагружает ESP32
// При следующем запуске флаг проверяется и мелодия приветствия НЕ играется
void performAutoReboot() {
    LOG_INFO("Выполняется автоматическая перезагрузка по бездействию");
    
    // Сохраняем флаг в энергонезависимую память
    Preferences prefs;
    if (prefs.begin("flook", false)) {
        prefs.putBool(PREF_AUTO_REBOOT_FLAG, true);   // Флаг "перезагрузка была автоматической"
        prefs.end();
    }
    
    // Небольшая задержка перед перезагрузкой (для отправки сообщений)
    delay(500);
    
    // Перезагружаем устройство
    ESP.restart();
}

// ============================================================================
// SETUP - ГЛАВНАЯ ФУНКЦИЯ ИНИЦИАЛИЗАЦИИ
// ============================================================================

void setup() {
    // ========== 1. ИНИЦИАЛИЗАЦИЯ СЕРИЙНОГО ПОРТА ==========
    Serial.begin(115200);
    delay(100);  // Ждём стабилизации UART
    
    // ========== 1.1. ПРОВЕРКА OTA-ОБНОВЛЕНИЯ ==========
    Preferences prefsOTA;
    prefsOTA.begin("flook", true);
    bool otaPending = prefsOTA.getBool("ota_pending", false);
    int otaAttempts = prefsOTA.getInt("ota_attempts", 0);
    String otaUrl = prefsOTA.getString("ota_url", "");
    prefsOTA.end();
    
    // Защита от бесконечного цикла перезагрузок
    if (otaPending && otaAttempts > 3) {
        Serial.println("[OTA] Слишком много попыток, сброс флага OTA");
        prefsOTA.begin("flook", false);
        prefsOTA.remove("ota_pending");
        prefsOTA.remove("ota_url");
        prefsOTA.putInt("ota_attempts", 0);
        prefsOTA.end();
        otaPending = false;
    }
    
    if (otaPending) {
        // Увеличиваем счётчик попыток
        prefsOTA.begin("flook", false);
        prefsOTA.putInt("ota_attempts", otaAttempts + 1);
        prefsOTA.end();
        
        Serial.println("[OTA] Флаг обнаружен, запуск OTA...");
        Serial.printf("[OTA] Попытка %d из 4\n", otaAttempts + 1);
        
        // Читаем SSID и пароль напрямую из бинарного дампа Config в NVS
        String otaSSID = "";
        String otaPass = "";
        Preferences prefsWiFi;
        prefsWiFi.begin("flook", true);
        size_t cfgSize = prefsWiFi.getBytesLength("config");
        if (cfgSize == sizeof(Config)) {
            Config tempCfg;
            prefsWiFi.getBytes("config", &tempCfg, sizeof(Config));
            otaSSID = String(tempCfg.ssid);
            otaPass = String(tempCfg.password);
        }
        prefsWiFi.end();
        
        WiFi.mode(WIFI_STA);
        WiFi.begin(otaSSID.c_str(), otaPass.c_str());
        int attempts = 0;
        while (WiFi.status() != WL_CONNECTED && attempts < 40) { delay(500); attempts++; }
        
        if (WiFi.status() == WL_CONNECTED) {
            Serial.println("[OTA] Wi-Fi подключён");
            Serial.println("[OTA] URL: " + otaUrl);
            
            HTTPClient http;
            WiFiClientSecure client;
            client.setInsecure();
            
            if (http.begin(client, otaUrl)) {
                http.addHeader("User-Agent", "FLOOK32-OTA");
                int httpCode = http.GET();
                Serial.printf("[OTA] HTTP код: %d\n", httpCode);
                
                if (httpCode == 200) {
                    int len = http.getSize();
                    Serial.printf("[OTA] Content-Length: %d\n", len);
                    
                    if (len <= 0) len = ESP.getFreeSketchSpace();
                    Serial.printf("[OTA] Начинаю Update.begin(%d)\n", len);
                    
                    if (Update.begin(len)) {
                        int written = Update.writeStream(*http.getStreamPtr());
                        Serial.printf("[OTA] writeStream вернул: %d\n", written);
                        
                        bool ok = Update.end(true);
                        Serial.printf("[OTA] Update.end() = %s\n", ok ? "OK" : "FAIL");
                        if (!ok) Serial.printf("[OTA] Ошибка: %s\n", Update.errorString());
                        
                        // Сбрасываем счётчик при успехе
                        if (ok) {
                            prefsOTA.begin("flook", false);
                            prefsOTA.remove("ota_pending");
                            prefsOTA.remove("ota_url");
                            prefsOTA.putInt("ota_attempts", 0);
                            prefsOTA.end();
                        }
                    } else {
                        Serial.println("[OTA] ОШИБКА: Update.begin() failed");
                    }
                }
                http.end();
            } else {
                Serial.println("[OTA] ОШИБКА: http.begin() failed");
            }
        } else {
            Serial.println("[OTA] ОШИБКА: Wi-Fi не подключён");
        }
        
        Serial.println("[OTA] Перезагрузка...");
        delay(500);
        ESP.restart();
    }
    
    // Информация о версии и причине перезагрузки
    LOG_INFO("========================================");
    LOG_INFO("FLOOK32 v%s (сборка %s)", FW_VERSION, FW_BUILD_DATE);
    LOG_INFO("========================================");
    
    // ========== ОПРЕДЕЛЕНИЕ И ЛОГИРОВАНИЕ ПРИЧИНЫ ПЕРЕЗАГРУЗКИ ==========
    esp_reset_reason_t reason = esp_reset_reason();
    const char* reasonStr = 
        reason == ESP_RST_POWERON ? "Включение питания" :
        reason == ESP_RST_SW ? "Программная перезагрузка" :
        reason == ESP_RST_PANIC ? "Паника (исключение)" :
        reason == ESP_RST_WDT ? "Watchdog таймаут" :
        reason == ESP_RST_DEEPSLEEP ? "Выход из глубокого сна" :
        reason == ESP_RST_BROWNOUT ? "Провал питания (brownout)" :
        "Неизвестно";
    LOG_INFO("Причина перезагрузки: %s", reasonStr);

    // ========== ПРОВЕРКА СВОБОДНОГО МЕСТА В NVS ПРИ ЗАГРУЗКЕ ==========
    // Если свободных записей почти не осталось — конфигурация не сохранится
    nvs_stats_t nvsStats;
    if (nvs_get_stats("nvs", &nvsStats) == ESP_OK) {
        uint32_t freePercent = (nvsStats.total_entries > 0) ? 
                            (nvsStats.free_entries * 100 / nvsStats.total_entries) : 100;
        LOG_INFO("NVS: занято %u из %u записей (свободно %u%%)", 
                nvsStats.used_entries, nvsStats.total_entries, freePercent);
        
        if (freePercent < 5) {
            addErrorToLog("⚠️ Энергонезависимая память заполнена на " + String(100 - freePercent) + "%! Новые данные могут не сохраниться", true, false, 0);
        }
    }

    // Логируем только нештатные причины (паника, watchdog, brownout, неизвестное)
    // Программная перезагрузка и включение питания — штатные, их пропускаем
    if (reason != ESP_RST_POWERON && reason != ESP_RST_SW && reason != ESP_RST_EXT) {
        String msg = "💀 Аварийная перезагрузка: " + String(reasonStr);
        addErrorToLog(msg, true, false, 0);
    }
    
    // ========== 2. ГЕНЕРАЦИЯ/ЗАГРУЗКА УНИКАЛЬНОГО ID УСТРОЙСТВА ==========
    Preferences prefs_id;
    prefs_id.begin("flook", false);
    
    if (!prefs_id.isKey("device_id")) {
        uint64_t mac = ESP.getEfuseMac();
        uint32_t random_num = esp_random();
        uint32_t device_id = (mac & 0xFFFFFFFF) ^ random_num;
        if (device_id == 0) device_id = esp_random() ^ (uint32_t)(micros());
        prefs_id.putUInt("device_id", device_id);
        prefs_id.putULong("device_id_created", millis());
        LOG_INFO("Сгенерирован ID устройства: %08X", device_id);
    }
    
    uint32_t device_id = prefs_id.getUInt("device_id", 0);
    LOG_INFO("ID устройства: %08X", device_id);
    prefs_id.end();
    
    // ========== 4. ЗАГРУЗКА КОНФИГУРАЦИИ ==========
    memset(trendBuffer, 0, sizeof(trendBuffer));
    loadConfig();
    loadDutyTable();
    
    LOG_INFO("Конфигурация загружена:");
    LOG_INFO("  maxHeaterTemp: %.1f°C, criticalTemp: %.1f°C, maxAirTemp: %.1f°C",
             config.maxHeaterTemp, config.criticalTemp, config.maxAirTemp);
    LOG_INFO("  fanOnTemp: %.1f°C, maxFanDuty: %d, heaterHysteresis: %.1f°C",
             config.fanOnTemp, config.maxFanDuty, config.heaterHysteresis);
    LOG_INFO("  readInterval: %d мс, controlInterval: %d мс, trendInterval: %d мс",
             config.readInterval, config.controlInterval, config.trendInterval);
    
    // ========== 5. ИНИЦИАЛИЗАЦИЯ ПИНОВ ==========
    pinMode(config.pinSsr, OUTPUT);
    pinMode(config.pinWatchdog, OUTPUT);
    pinMode(config.pinOneWire, INPUT);
    pinMode(config.pinMaxSck, OUTPUT);
    pinMode(config.pinMaxSo, INPUT);
    pinMode(config.pinMaxCs, OUTPUT);
    pinMode(config.pinBuzzer, OUTPUT);
    pinMode(config.pinLed, OUTPUT);
    
    initFanPWM();
    initButton();
    
    oneWire = new OneWire(config.pinOneWire);
    ds18b20 = new DallasTemperature(oneWire);
    
    digitalWrite(config.pinSsr, config.invertHeaterSignal ? HIGH : LOW);
    digitalWrite(config.pinWatchdog, HIGH);
    digitalWrite(config.pinBuzzer, LOW);
    
    LOG_DEBUG("Пины: SSR=%d, FAN=%d, WDT=%d, 1W=%d, SCK=%d, SO=%d, CS=%d, BZZ=%d, LED=%d",
              config.pinSsr, config.pinFan, config.pinWatchdog, config.pinOneWire,
              config.pinMaxSck, config.pinMaxSo, config.pinMaxCs, config.pinBuzzer, config.pinLed);
    
    // ========== 6. ИНИЦИАЛИЗАЦИЯ СИСТЕМЫ ОШИБОК ==========
    errors.loadLockState();
    initBuzzer();
    initLEDs();
    if (!errors.isSystemLocked()) clearErrorFlags();
    deviceStartTime = millis();
    
    // ========== 7. ИНИЦИАЛИЗАЦИЯ DS18B20 ==========
    ds18b20->begin();
    ds18b20->setResolution(DS18B20_RESOLUTION);
    ds18b20->setWaitForConversion(false);
    
    if (ds18b20->getDeviceCount() == 0) {
        LOG_WARN("DS18B20 не обнаружен!");
        errors.ds18b20Disconnected = true;
    } else {
        ds18b20->requestTemperatures();
        delay(1000);
        float firstTemp = readDS18B20Temperature();
        if (firstTemp != DEVICE_DISCONNECTED_C && firstTemp > -55.0f && firstTemp < 125.0f) {
            ds18b20LastValidTemp = firstTemp;
            airTemp = firstTemp;
            ds18b20Error = false;
            errors.ds18b20Disconnected = false;
            LOG_INFO("DS18B20: %.2f°C (разрешение %d бит)", firstTemp, ds18b20->getResolution());
        } else {
            LOG_WARN("DS18B20: начальное чтение не удалось (%.2f°C)", firstTemp);
            errors.ds18b20Disconnected = true;
        }
    }
    
    // ========== 8. ИНИЦИАЛИЗАЦИЯ MAX6675 ==========
    initMAX6675();
    if (!max6675_initialized) LOG_WARN("MAX6675 не инициализирован!");
    else LOG_INFO("MAX6675 инициализирован, начальная температура: %.2f°C", heaterTemp);
    
    // ========== 9. ИНИЦИАЛИЗАЦИЯ ТЕРМАЛЬНОЙ МОДЕЛИ ==========
    initThermalModel();
    if (config.enableThermalModel) {
        updateProtectionsForThermalModel();
        LOG_INFO("Термальная модель активирована");
    }
    
    // ========== 10. НАСТРОЙКА WI-FI ==========
    bool wifiConnected = false;
    if (strlen(config.ssid) > 0 && config.wifiConfigured) {
        WiFi.mode(WIFI_STA);
        WiFi.begin(config.ssid, config.password);
        // Установка имени устройства в роутере (будет отображаться как "FLOOK32" вместо "esp32-XXXXXX")        
        esp_netif_t *netif = esp_netif_get_handle_from_ifkey("WIFI_STA_DEF");
        if (netif) esp_netif_set_hostname(netif, "FLOOK32");
        LOG_INFO("Подключение к Wi-Fi: %s", config.ssid);
        
        int attempts = 0;
        while (WiFi.status() != WL_CONNECTED && attempts < 40) {
            delay(500);
            attempts++;
        }
        
        if (WiFi.status() == WL_CONNECTED) {
            wifiConnected = true;
            LOG_INFO("Wi-Fi подключён! IP: %s, RSSI: %d dBm", 
                    WiFi.localIP().toString().c_str(), WiFi.RSSI());
        } else {
            LOG_WARN("Не удалось подключиться к %s, создаю точку доступа", config.ssid);
            // НЕ сбрасываем настройки — будем переподключаться в фоне
        }
    }
    
    if (!wifiConnected) {
        WiFi.mode(WIFI_AP);
        String apName = "FLOOK32-" + String((uint32_t)ESP.getEfuseMac(), HEX);
        WiFi.softAP(apName.c_str(), "flook1234");
        LOG_INFO("Точка доступа: %s (пароль: flook1234)", apName.c_str());
        LOG_INFO("IP для настройки: %s", WiFi.softAPIP().toString().c_str());
        
        // Запускаем фоновые попытки переподключения
        if (config.wifiConfigured) {
            LOG_INFO("Буду переподключаться к %s в фоне каждые 60 сек", config.ssid);
        }
    }
    
    WiFi.setSleep(false);
    udp.begin(UDP_PORT);
    udp.setTimeout(config.udpDiscoveryTimeout);
    
    // ========== 11. НАСТРОЙКА ВЕБ-СЕРВЕРА ==========
    DefaultHeaders::Instance().addHeader("Access-Control-Allow-Origin", "*");
    DefaultHeaders::Instance().addHeader("Access-Control-Allow-Methods", "GET, POST, OPTIONS");
    DefaultHeaders::Instance().addHeader("Access-Control-Allow-Headers", "Content-Type");
    
    ws.onEvent(onWebSocketEvent);
    server.addHandler(&ws);
    
    // Статические маршруты
    server.on("/favicon.ico", HTTP_GET, [](AsyncWebServerRequest *request){
        AsyncWebServerResponse *response = request->beginResponse_P(200, "image/x-icon", 
            favicon_ico, favicon_ico_len);
        response->addHeader("Cache-Control", "max-age=31536000, immutable");
        request->send(response);
    });

    server.on("/icon-192.png", HTTP_GET, [](AsyncWebServerRequest *request){
        AsyncWebServerResponse *response = request->beginResponse_P(200, "image/png", 
            icon_192_png_gz, icon_192_png_gz_len);
        response->addHeader("Content-Encoding", "gzip");
        response->addHeader("Cache-Control", "max-age=31536000, immutable");
        request->send(response);
    });
    
    server.on("/", HTTP_GET, [](AsyncWebServerRequest *request){
        if (request->hasHeader("If-None-Match")) {
            String etag = request->header("If-None-Match");
            if (etag == "\"v1\"") { request->send(304); return; }
        }
        size_t offset = 0;
        AsyncWebServerResponse *response = request->beginChunkedResponse("text/html", 
            [offset](uint8_t *buffer, size_t maxLen, size_t index) mutable -> size_t {
                if (offset >= index_html_gz_len) return 0;
                size_t len = min(maxLen, index_html_gz_len - offset);
                memcpy(buffer, index_html_gz + offset, len);
                offset += len;
                return len;
            });
        response->addHeader("Content-Encoding", "gzip");
        response->addHeader("Cache-Control", "max-age=86400, immutable, public");
        response->addHeader("ETag", "\"v1\"");
        response->addHeader("Connection", "close");
        request->send(response);
    });

    server.on("/chart.js", HTTP_GET, [](AsyncWebServerRequest *request){
        AsyncWebServerResponse *response = request->beginResponse_P(200, "application/javascript", 
            chart_min_js_gz, chart_min_js_gz_len);
        response->addHeader("Content-Encoding", "gzip");
        response->addHeader("Cache-Control", "max-age=31536000, immutable");
        request->send(response);
    });

    // chartjs-adapter.js — 1 год кеширования
    server.on("/chartjs-adapter.js", HTTP_GET, [](AsyncWebServerRequest *request){
        AsyncWebServerResponse *response = request->beginResponse_P(200, "application/javascript", 
            chartjs_adapter_gz, chartjs_adapter_gz_len);
        response->addHeader("Content-Encoding", "gzip");
        response->addHeader("Cache-Control", "max-age=31536000, immutable");
        request->send(response);
    });
    
    // ========== API МАРШРУТЫ ==========

    // ========== GET /api/system-info - СИСТЕМНАЯ ИНФОРМАЦИЯ ==========
    server.on("/api/system-info", HTTP_GET, [](AsyncWebServerRequest *request) {
        float chipTemp = temperatureRead();
        
        char json[1024];
        snprintf(json, sizeof(json),
            "{"
            "\"chipTemp\":%.1f,"
            "\"cpuFreq\":%u,"
            "\"freeHeap\":%u,"
            "\"minFreeHeap\":%u,"
            "\"maxAllocHeap\":%u,"
            "\"heapSize\":%u,"
            "\"sketchSize\":%u,"
            "\"freeSketchSpace\":%u,"
            "\"flashSize\":%u,"
            "\"uptime\":%lu,"
            "\"wifiRSSI\":%d,"
            "\"chipModel\":\"%s\","
            "\"chipRevision\":%u,"
            "\"chipCores\":%u,"
            "\"sdkVersion\":\"%s\","
            "\"tasks\":%u"
            "}",
            chipTemp,
            ESP.getCpuFreqMHz(),
            ESP.getFreeHeap(),
            ESP.getMinFreeHeap(),
            ESP.getMaxAllocHeap(),
            ESP.getHeapSize(),
            ESP.getSketchSize(),
            ESP.getFreeSketchSpace(),
            ESP.getFlashChipSize(),
            millis() / 1000,
            WiFi.RSSI(),
            ESP.getChipModel(),
            ESP.getChipRevision(),
            ESP.getChipCores(),
            ESP.getSdkVersion(),
            uxTaskGetNumberOfTasks()
        );
        request->send(200, "application/json", json);
    });

    // ========== GET /api/nvs-health - СТАТИСТИКА СВОБОДНОЙ ПАМЯТИ NVS ==========
    // Показывает, сколько записей занято и сколько ещё доступно
    server.on("/api/nvs-health", HTTP_GET, [](AsyncWebServerRequest *request) {
        nvs_stats_t nvs_stats;
        esp_err_t err = nvs_get_stats("nvs", &nvs_stats);
        
        if (err == ESP_OK) {
            uint32_t used = nvs_stats.used_entries;
            uint32_t free = nvs_stats.free_entries;
            uint32_t total = nvs_stats.total_entries;
            uint32_t percentUsed = (total > 0) ? (used * 100 / total) : 0;
            uint32_t percentFree = 100 - percentUsed;
            
            char json[256];
            snprintf(json, sizeof(json),
                "{\"usedEntries\":%u,\"freeEntries\":%u,\"totalEntries\":%u,"
                "\"percentUsed\":%u,\"percentFree\":%u}",
                used, free, total, percentUsed, percentFree);
            
            request->send(200, "application/json", json);
        } else {
            request->send(500, "application/json", "{\"error\":\"NVS stats unavailable\"}");
        }
    });

    // Таблица duty
    server.on("/api/duty-table", HTTP_GET, [](AsyncWebServerRequest *request) {
        String json = "{\"size\":" + String(dutyTableSize) + ",\"entries\":[";
        for (int i = 0; i < dutyTableSize; i++) {
            if (i > 0) json += ",";
            json += "{\"temp\":" + String(dutyTable[i].airTemp, 1) + 
                    ",\"duty\":" + String(dutyTable[i].duty) + "}";
        }
        json += "]}";
        request->send(200, "application/json", json);
    });
    
    server.on("/api/duty-table/add", HTTP_GET, [](AsyncWebServerRequest *request) {
        if (!request->hasParam("temp") || !request->hasParam("duty")) {
            request->send(400, "text/plain", "Missing temp or duty");
            return;
        }
        
        float temp = request->getParam("temp")->value().toFloat();
        int duty = request->getParam("duty")->value().toInt();
        
        if (dutyTableSize < MAX_DUTY_TABLE_SIZE) {
            dutyTable[dutyTableSize].airTemp = temp;
            dutyTable[dutyTableSize].duty = duty;
            dutyTableSize++;
            
            // Сортировка по температуре
            for (int i = 0; i < dutyTableSize - 1; i++) {
                for (int j = i + 1; j < dutyTableSize; j++) {
                    if (dutyTable[i].airTemp > dutyTable[j].airTemp) {
                        DutyTableEntry t = dutyTable[i];
                        dutyTable[i] = dutyTable[j];
                        dutyTable[j] = t;
                    }
                }
            }
            
            saveDutyTable();
            request->send(200, "text/plain", "OK");
        } else {
            request->send(500, "text/plain", "Table full");
        }
    });
    
    // ID устройства
    server.on("/api/device-id", HTTP_GET, [](AsyncWebServerRequest *request) {
        Preferences prefs_id;
        prefs_id.begin("flook", true);
        uint32_t device_id = prefs_id.getUInt("device_id", 0);
        unsigned long created = prefs_id.getULong("device_id_created", 0);
        prefs_id.end();
        
        char buffer[128];
        snprintf(buffer, sizeof(buffer), 
                "{\"device_id\":\"%08X\",\"created\":%lu,\"uptime\":%lu}",
                device_id, created, (millis() - deviceStartTime) / 1000);
        
        AsyncWebServerResponse *response = request->beginResponse(200, "application/json", buffer);
        response->addHeader("Connection", "close");
        response->addHeader("Cache-Control", "no-cache");
        request->send(response);
    });
    
    // Основные API маршруты
    server.on("/api/all", HTTP_GET, handleApiAllStates);
    server.on("/api/config", HTTP_GET, handleApiConfig);
    server.on("/api/wifi/status", HTTP_GET, handleApiWifiStatus);
    server.on("/api/wifi/scan", HTTP_GET, handleApiWifiScan);
    server.on("/api/wifi/connect", HTTP_GET, handleApiWifiConnect);
    server.on("/api/wifi/reset", HTTP_POST, handleApiWifiReset);
    server.on("/api/error-log", HTTP_GET, handleApiErrorLog);
    server.on("/api/error-log/clear", HTTP_POST, handleApiErrorLogClear);
    server.on("/api/uptime", HTTP_GET, handleApiUptime);
    server.on("/api/target", HTTP_GET, handleApiGetTarget);
    server.on("/api/target", HTTP_POST, handleApiTarget);
    server.on("/api/heater-off", HTTP_POST, handleApiHeaterOff);
    server.on("/api/reboot-all", HTTP_POST, handleApiRebootAll);
    server.on("/api/reboot", HTTP_POST, handleApiReboot);
    server.on("/api/unlock", HTTP_POST, handleApiUnlock);
    server.on("/api/lock-settings", HTTP_POST, handleApiLockSettings);
    server.on("/api/unlock-settings", HTTP_POST, handleApiUnlockSettings);
    server.on("/api/adapt/start", HTTP_POST, handleApiStartAdaptation);
    server.on("/api/adapt/abort", HTTP_POST, handleApiAbortAdaptation);
    server.on("/api/adapt/status", HTTP_GET, handleApiAdaptationStatus);
    server.on("/api/adapt/continue", HTTP_POST, handleApiAdaptContinue);    
    server.on("/api/memory", HTTP_GET, handleApiMemory);
    server.on("/api/config/defaults", HTTP_POST, handleApiConfigDefaults);
    server.on("/api/calibrate-max6675", HTTP_POST, handleApiCalibrateMAX6675);
    server.on("/api/thermal-model/reset", HTTP_POST, handleApiResetThermalModel);
    server.on("/api/moonraker-shutdown", HTTP_POST, handleApiMoonrakerShutdown);
    server.on("/api/manual-timer", HTTP_POST, handleApiManualTimer);
    
    // Статус термальной модели
    server.on("/api/thermal-status", HTTP_GET, [](AsyncWebServerRequest *request) {
        String json = "{";
        json += "\"enabled\":" + String(config.enableThermalModel ? "true" : "false") + ",";
        
        if (config.enableThermalModel && adaptiveModel.initialized) {
            json += "\"initialized\":true,";
            json += "\"confidence\":" + String(adaptiveModel.confidence * 100, 0) + ",";
            json += "\"heaterRate\":" + String(adaptiveModel.heaterRate, 1) + ",";
            json += "\"coolingRate\":" + String(adaptiveModel.coolingRate, 2) + ",";
            json += "\"noiseFloor\":" + String(adaptiveModel.noiseFloor, 2) + ",";
            json += "\"samples\":" + String(adaptiveModel.samplesCollected) + ",";
            json += "\"maxError\":" + String(adaptiveModel.maxError, 1);
        } else {
            json += "\"initialized\":false,";
            json += "\"message\":\"Модель не инициализирована. Требуется адаптация.\"";
        }
        json += "}";
        request->send(200, "application/json", json);
    });
    
    // ========== POST /api/config - ОБНОВЛЕНИЕ КОНФИГУРАЦИИ ==========
    server.on("/api/config", HTTP_POST, [](AsyncWebServerRequest *request) {
        String body;
        
        if (request->_tempObject) {
            body = String((char*)request->_tempObject);
            free(request->_tempObject);
            request->_tempObject = nullptr;
        }
        
        if (body.length() == 0) {
            request->send(400, "text/plain", "No data");
            return;
        }
        
        DynamicJsonDocument doc(8192);
        DeserializationError error = deserializeJson(doc, body);
        
        if (error) {
            request->send(400, "text/plain", "Invalid JSON");
            return;
        }
        
        // Сохраняем старые значения пинов для проверки изменений
        uint8_t oldPinSsr = config.pinSsr;
        uint8_t oldPinFan = config.pinFan;
        uint8_t oldPinWatchdog = config.pinWatchdog;
        uint8_t oldPinOneWire = config.pinOneWire;
        uint8_t oldPinMaxSck = config.pinMaxSck;
        uint8_t oldPinMaxSo = config.pinMaxSo;
        uint8_t oldPinMaxCs = config.pinMaxCs;
        uint8_t oldPinBuzzer = config.pinBuzzer;
        uint8_t oldPinLed = config.pinLed;
        
        // Сохраняем старые значения флагов инверсии сигналов
        bool oldInvertHeater = config.invertHeaterSignal;
        bool oldInvertFan = config.invertFanSignal;
        
        // Сохраняем адаптационные поля и Wi-Fi настройки
        bool savedAdaptationPerformed = config.adaptationPerformed;
        unsigned long savedAdaptationTimestamp = config.adaptationTimestamp;
        float savedHeaterRiseRate = config.adaptedHeaterRiseRate;
        float savedAirRiseRate = config.adaptedAirRiseRate;
        float savedCoolingRate = config.adaptedCoolingRate;
        float savedNoiseThreshold = config.adaptedNoiseThreshold;
        float savedUnstableRange = config.adaptedUnstableRange;
        int savedTimeToTarget = config.adaptedTimeToTarget;
        bool savedFanEffective = config.fanEffective;
        char savedSsid[32];
        char savedPassword[64];
        bool savedWifiConfigured = config.wifiConfigured;
        strncpy(savedSsid, config.ssid, sizeof(savedSsid) - 1);
        savedSsid[sizeof(savedSsid) - 1] = '\0';
        strncpy(savedPassword, config.password, sizeof(savedPassword) - 1);
        savedPassword[sizeof(savedPassword) - 1] = '\0';

        // Обработка всех полей конфигурации
        for (JsonPair kv : doc.as<JsonObject>()) {
            const char* key = kv.key().c_str();
            JsonVariant val = kv.value();
            
            // Температурные пороги
            if (strcmp(key, "mt") == 0) config.maxHeaterTemp = val.as<float>();
            else if (strcmp(key, "ct") == 0) config.criticalTemp = val.as<float>();
            else if (strcmp(key, "ch") == 0) config.criticalHysteresis = val.as<float>();
            else if (strcmp(key, "ma") == 0) config.maxAirTemp = val.as<float>();
            else if (strcmp(key, "ah") == 0) config.airHysteresis = val.as<float>();
            else if (strcmp(key, "hy") == 0) config.hysteresis = val.as<float>();
            else if (strcmp(key, "hh") == 0) config.heaterHysteresis = val.as<float>();
            else if (strcmp(key, "eH") == 0) config.enableHeaterHysteresis = val.as<bool>();
            else if (strcmp(key, "dt") == 0) config.defaultTargetTemp = val.as<float>();
            else if (strcmp(key, "iF") == 0) config.invertFanSignal = val.as<bool>();
            else if (strcmp(key, "iH") == 0) config.invertHeaterSignal = val.as<bool>();
            else if (strcmp(key, "mFD") == 0) config.maxFanDuty = val.as<int>();
            else if (strcmp(key, "sl") == 0) config.settingsLocked = val.as<bool>();
            
            // Вентилятор
            else if (strcmp(key, "fT") == 0) config.fanOnTemp = val.as<float>();
            else if (strcmp(key, "fH") == 0) config.fanOffHysteresis = val.as<float>();
            else if (strcmp(key, "fM") == 0) config.fanMinOnTime = val.as<int>();
            else if (strcmp(key, "fE") == 0) config.fanEfficiencyTimeout = val.as<float>();
            else if (strcmp(key, "fF") == 0) config.fanEfficiencyThreshold = val.as<float>();
            else if (strcmp(key, "eF") == 0) config.enableFanEfficiencyCheck = val.as<bool>();
            
            // Thermal Runaway
            else if (strcmp(key, "tR") == 0) config.enableThermalRunawayProtection = val.as<bool>();
            else if (strcmp(key, "r1") == 0) config.runawayPhase1Time = val.as<int>();
            else if (strcmp(key, "r2") == 0) config.runawayPhase2Time = val.as<int>();
            else if (strcmp(key, "rT") == 0) config.runawayMaxTimeToTarget = val.as<float>();
            else if (strcmp(key, "rH") == 0) config.runawayMinHeaterRisePerMin = val.as<float>();
            else if (strcmp(key, "rA") == 0) config.runawayMinAirRisePerMin = val.as<float>();
            else if (strcmp(key, "rD") == 0) config.runawayMaxHeaterDrop = val.as<float>();
            else if (strcmp(key, "rY") == 0) config.runawayHysteresis = val.as<float>();
            else if (strcmp(key, "rR") == 0) config.runawayRecoveryTimeout = val.as<int>();
            else if (strcmp(key, "rF") == 0) config.runawayFanOn = val.as<bool>();
            else if (strcmp(key, "rQC") == 0) config.runawayQuickCheckTemp = val.as<float>();
            
            // Unexpected Heat
            else if (strcmp(key, "uH") == 0) config.enableUnexpectedHeatProtection = val.as<bool>();
            else if (strcmp(key, "uT") == 0) config.unexpectedHeatTimeout = val.as<float>();
            else if (strcmp(key, "uP") == 0) config.unexpectedHeatThreshold = val.as<float>();
            else if (strcmp(key, "mC") == 0) config.minCoolingRate = val.as<float>();
            else if (strcmp(key, "uY") == 0) config.unexpectedHeatHysteresis = val.as<float>();
            else if (strcmp(key, "uC") == 0) config.unexpectedHeatClearTime = val.as<int>();
            else if (strcmp(key, "uS") == 0) config.unexpectedHeatSafeOffset = val.as<float>();
            else if (strcmp(key, "uA") == 0) config.enableUnexpectedHeatAdaptive = val.as<bool>();
            else if (strcmp(key, "aB") == 0) config.adaptiveBaseTemp = val.as<float>();
            else if (strcmp(key, "aC") == 0) config.adaptiveCoefficient = val.as<float>();
            else if (strcmp(key, "aM") == 0) config.adaptiveMinOffset = val.as<float>();
            
            // MAX6675
            else if (strcmp(key, "mO") == 0) config.max6675Offset = val.as<float>();
            else if (strcmp(key, "mP") == 0) config.enableMAX6675Protection = val.as<bool>();
            else if (strcmp(key, "mS") == 0) config.max6675StabilitySamples = val.as<int>();
            else if (strcmp(key, "mJ") == 0) config.max6675TempJumpThreshold = val.as<float>();
            else if (strcmp(key, "mN") == 0) config.max6675MinTemp = val.as<float>();
            else if (strcmp(key, "mX") == 0) config.max6675MaxTemp = val.as<float>();
            
            // DS18B20
            else if (strcmp(key, "dO") == 0) config.ds18b20Offset = val.as<float>();
            else if (strcmp(key, "dS") == 0) config.ds18b20Scale = val.as<float>();
            else if (strcmp(key, "dC") == 0) config.ds18b20CalEnabled = val.as<bool>();
            
            // Защита датчика воздуха
            else if (strcmp(key, "aP") == 0) config.enableAirSensorProtection = val.as<bool>();
            else if (strcmp(key, "aS") == 0) config.airSensorStabilitySamples = val.as<int>();
            else if (strcmp(key, "aJ") == 0) config.airSensorTempJumpThreshold = val.as<float>();
            else if (strcmp(key, "aN") == 0) config.airSensorMinTemp = val.as<float>();
            else if (strcmp(key, "aX") == 0) config.airSensorMaxTemp = val.as<float>();
            else if (strcmp(key, "aU") == 0) config.airSensorUnstableRange = val.as<float>();
            else if (strcmp(key, "aV") == 0) config.airSensorUnstableDeviation = val.as<float>();
            else if (strcmp(key, "aW") == 0) config.airSensorUnstableWindow = val.as<int>();
            else if (strcmp(key, "aD") == 0) config.airSensorDirectionChanges = val.as<int>();
            
            // Система ошибок
            else if (strcmp(key, "mR") == 0) config.maxErrorRetries = val.as<int>();
            else if (strcmp(key, "eW") == 0) config.errorWindowMinutes = val.as<int>();
            else if (strcmp(key, "mE") == 0) config.minTimeBetweenSameErrors = val.as<int>();
            else if (strcmp(key, "mOc") == 0) config.minTimeBetweenOverheatCounts = val.as<int>();
            else if (strcmp(key, "uPw") == 0) { String p = val.as<String>(); strlcpy(config.unlockPassword, p.c_str(), sizeof(config.unlockPassword)); }
            
            // Диагностика
            else if (strcmp(key, "eA") == 0) config.enableAbnormalRate = val.as<bool>();
            else if (strcmp(key, "aT") == 0) config.abnormalRateThreshold = val.as<float>();
            
            // LED
            else if (strcmp(key, "lE") == 0) config.ledEnabled = val.as<bool>();
            else if (strcmp(key, "lC") == 0) config.ledCount = val.as<uint8_t>();
            else if (strcmp(key, "lB") == 0) config.ledBrightness = val.as<uint8_t>();
            else if (strcmp(key, "lP") == 0) config.ledPin = val.as<uint8_t>();
            
            // Heartbeat
            else if (strcmp(key, "hP") == 0) config.heartbeatPulseMs = val.as<int>();
            else if (strcmp(key, "hQ") == 0) config.heartbeatPauseMs = val.as<int>();
            
            // Системные интервалы
            else if (strcmp(key, "rI") == 0) config.readInterval = val.as<int>();
            else if (strcmp(key, "cI") == 0) config.controlInterval = val.as<int>();
            else if (strcmp(key, "tI") == 0) config.trendInterval = val.as<int>();
            else if (strcmp(key, "hI") == 0) config.heapCheckInterval = val.as<int>();
            else if (strcmp(key, "lW") == 0) config.loopWatchdogTimeout = val.as<int>();
            else if (strcmp(key, "uD") == 0) config.udpDiscoveryTimeout = val.as<int>();
            else if (strcmp(key, "dR") == 0) config.discoveryRetryInterval = val.as<int>();
            else if (strcmp(key, "eL") == 0) config.enableLoopWatchdog = val.as<bool>();
            
            // Автоотключение
            else if (strcmp(key, "aSd") == 0) config.autoShutdownEnabled = val.as<bool>();
            else if (strcmp(key, "aSm") == 0) config.autoShutdownMinutes = val.as<int>();
            else if (strcmp(key, "kIp") == 0) {
                String ip = val.as<String>();
                if (ip.length() > 0) {
                    IPAddress manualIp;
                    if (manualIp.fromString(ip)) {
                        klipperStatus.ip = manualIp;
                        klipperStatus.lastSeen = 0;
                        klipperStatus.detected = false;
                        Preferences prefs;
                        if (prefs.begin("flook", false)) {
                            prefs.putString("klipper_ip", ip);
                            prefs.end();
                        }
                        addNotificationToLog("IP Klipper установлен: " + ip + " (ожидание проверки)");
                    }
                }
            }
            
            // Термальная модель
            else if (strcmp(key, "tM") == 0) {
                bool newValue = val.as<bool>();
                if (newValue && !config.adaptationPerformed) {
                    // Нельзя включить модель без адаптации
                    addNotificationToLog("❌ Термальная модель не включена: требуется адаптация");
                } else {
                    config.enableThermalModel = newValue;
                }
            }
            else if (strcmp(key, "tS") == 0) config.thermalModelSensitivity = val.as<float>();
            else if (strcmp(key, "tC") == 0) config.thermalModelCheckInterval = val.as<int>();
            else if (strcmp(key, "tL") == 0) config.thermalModelLogWarnings = val.as<bool>();
            
            // Пины
            else if (strcmp(key, "pS") == 0) config.pinSsr = val.as<uint8_t>();
            else if (strcmp(key, "pF") == 0) config.pinFan = val.as<uint8_t>();
            else if (strcmp(key, "pW") == 0) config.pinWatchdog = val.as<uint8_t>();
            else if (strcmp(key, "pO") == 0) config.pinOneWire = val.as<uint8_t>();
            else if (strcmp(key, "pK") == 0) config.pinMaxSck = val.as<uint8_t>();
            else if (strcmp(key, "pM") == 0) config.pinMaxSo = val.as<uint8_t>();
            else if (strcmp(key, "pC") == 0) config.pinMaxCs = val.as<uint8_t>();
            else if (strcmp(key, "pB") == 0) config.pinBuzzer = val.as<uint8_t>();
            else if (strcmp(key, "pL") == 0) config.pinLed = val.as<uint8_t>();
            else if (strcmp(key, "pBt") == 0) config.pinButton = val.as<uint8_t>();
            
            // Интервалы управления
            else if (strcmp(key, "hC") == 0) config.heaterControlInterval = val.as<int>();
            else if (strcmp(key, "fC") == 0) config.fanControlInterval = val.as<int>();
            else if (strcmp(key, "rC") == 0) config.runawayCheckInterval = val.as<int>();
            else if (strcmp(key, "uCc") == 0) config.unexpectedCheckInterval = val.as<int>();
            else if (strcmp(key, "rAc") == 0) config.rateCheckInterval = val.as<int>();

            // Автоограничение вентилятора
            else if (strcmp(key, "eFAL") == 0) config.enableFanAutoLimit = val.as<bool>();
            else if (strcmp(key, "fALH") == 0) config.fanAutoLimitHysteresis = val.as<float>();
            else if (strcmp(key, "fALA") == 0) config.fanAutoLimitAdjustStep = val.as<int>();
            else if (strcmp(key, "fALM") == 0) config.fanAutoLimitMinDuty = val.as<int>();
            else if (strcmp(key, "fALI") == 0) config.fanAutoLimitCheckInterval = val.as<int>();
            else if (strcmp(key, "fALS") == 0) config.fanAutoLimitStableCount = val.as<int>();

            // Зуммер
            else if (strcmp(key, "bE") == 0) config.buzzerEnabled = val.as<bool>();
            else if (strcmp(key, "bN") == 0) config.buzzerNonCriticalEnabled = val.as<bool>();
            else if (strcmp(key, "bM") == 0) config.buzzerMelody = val.as<int>();
        }

        // Восстанавливаем адаптационные поля и Wi-Fi настройки
        config.adaptationPerformed = savedAdaptationPerformed;
        config.adaptationTimestamp = savedAdaptationTimestamp;
        config.adaptedHeaterRiseRate = savedHeaterRiseRate;
        config.adaptedAirRiseRate = savedAirRiseRate;
        config.adaptedCoolingRate = savedCoolingRate;
        config.adaptedNoiseThreshold = savedNoiseThreshold;
        config.adaptedUnstableRange = savedUnstableRange;
        config.adaptedTimeToTarget = savedTimeToTarget;
        config.fanEffective = savedFanEffective;
        config.wifiConfigured = savedWifiConfigured;
        strncpy(config.ssid, savedSsid, sizeof(config.ssid) - 1);
        config.ssid[sizeof(config.ssid) - 1] = '\0';
        strncpy(config.password, savedPassword, sizeof(config.password) - 1);
        config.password[sizeof(config.password) - 1] = '\0';

        config.validate();
        saveConfig();
        configCacheValid = false;

        // Переинициализация периферии
        initBuzzer();
        initLEDs();
        initFanPWM();

        // Проверка необходимости перезагрузки (изменение пинов или инверсии)
        bool needRestart = false;
        
        if (config.pinSsr != oldPinSsr) needRestart = true;
        if (config.pinFan != oldPinFan) needRestart = true;
        if (config.pinWatchdog != oldPinWatchdog) needRestart = true;
        if (config.pinOneWire != oldPinOneWire) needRestart = true;
        if (config.pinMaxSck != oldPinMaxSck) needRestart = true;
        if (config.pinMaxSo != oldPinMaxSo) needRestart = true;
        if (config.pinMaxCs != oldPinMaxCs) needRestart = true;
        if (config.pinBuzzer != oldPinBuzzer) needRestart = true;
        if (config.pinLed != oldPinLed) needRestart = true;
        
        // Добавляем инверсию сигналов
        if (config.invertHeaterSignal != oldInvertHeater) needRestart = true;
        if (config.invertFanSignal != oldInvertFan) needRestart = true;

        if (needRestart) {
            request->send(200, "text/plain", "OK_RESTART");
            delay(1000);
            ESP.restart();
            return;
        }

        request->send(200, "text/plain", "OK");
    }, nullptr, [](AsyncWebServerRequest *request, uint8_t *data, size_t len, size_t index, size_t total) {
        if (!request->_tempObject) {
            request->_tempObject = malloc(total + 1);
            if (request->_tempObject) {
                memset(request->_tempObject, 0, total + 1);
            }
        }
        if (request->_tempObject) {
            memcpy((char*)request->_tempObject + index, data, len);
        }
    });

    // ========== ДОПОЛНИТЕЛЬНЫЕ API МАРШРУТЫ ==========

    // OTA обновление прошивки
    server.on("/api/update", HTTP_POST, [](AsyncWebServerRequest *request) {
        if (Update.hasError()) {
            request->send(500, "text/plain", "Update failed: " + String(Update.errorString()));
        } else {
            request->send(200, "text/plain", "UPDATE_SUCCESS:" + String(millis()));
            delay(500);
            ESP.restart();
        }
    }, [](AsyncWebServerRequest *request, String filename, size_t index, uint8_t *data, size_t len, bool final) {
        if (!index) {
            uint32_t maxSketchSpace = ESP.getFreeSketchSpace();
            if (!Update.begin(maxSketchSpace)) return;
        }
        Update.write(data, len);
        if (final) Update.end(true);
    });

    // ========== GET /api/check-update - ПРОВЕРКА ОБНОВЛЕНИЙ ==========
    server.on("/api/check-update", HTTP_GET, [](AsyncWebServerRequest *request) {
        String currentVersion = FW_VERSION;
        if (currentVersion.startsWith("v")) currentVersion = currentVersion.substring(1);
        
        bool updateAvailable = false;
        String latestVersion = currentVersion;
        String downloadUrl = "";
        String releaseNotes = "";
        bool forceUpdate = false;
        
        WiFiClientSecure client;
        client.setInsecure();
        client.setTimeout(5000);
        
        HTTPClient http;
        String jsonUrl = "https://raw.githubusercontent.com/schreider/flook32/main/firmware/flook32/latest.json?t=" + String(millis());
        
        LOG_DEBUG("OTA check: requesting %s", jsonUrl.c_str());
        
        if (http.begin(client, jsonUrl)) {
            http.addHeader("User-Agent", "FLOOK32");
            int httpCode = http.GET();
            
            LOG_DEBUG("OTA check: HTTP %d", httpCode);
            
            if (httpCode == 200) {
                String body = http.getString();
                StaticJsonDocument<2048> doc;
                DeserializationError err = deserializeJson(doc, body);
                
                if (!err) {
                    latestVersion = doc["version"].as<String>();
                    if (latestVersion.startsWith("v")) latestVersion = latestVersion.substring(1);
                    
                    downloadUrl = doc["ota_url"].as<String>();
                    releaseNotes = doc["notes"].as<String>();
                    forceUpdate = doc["force"].as<bool>();
                    
                    releaseNotes.replace("\r", "");
                    releaseNotes.replace("\n", "\\n");
                    releaseNotes.replace("\"", "\\\"");
                    
                    updateAvailable = (latestVersion != currentVersion) || forceUpdate;
                    
                    LOG_DEBUG("OTA check: current=%s latest=%s force=%d update=%d", 
                              currentVersion.c_str(), latestVersion.c_str(), forceUpdate, updateAvailable);
                } else {
                    LOG_DEBUG("OTA check: JSON error %s", err.c_str());
                }
            }
            http.end();
        } else {
            LOG_DEBUG("OTA check: http.begin failed");
        }
        
        if (updateAvailable) {
            String msg = "✅ Доступно обновление v" + latestVersion;
            if (forceUpdate) msg += " (принудительное)";
            addNotificationToLog(msg);
        }
        
        char json[3072];
        snprintf(json, sizeof(json),
            "{\"updateAvailable\":%s,\"currentVersion\":\"%s\",\"latestVersion\":\"%s\",\"downloadUrl\":\"%s\",\"releaseNotes\":\"%s\"}",
            updateAvailable ? "true" : "false",
            currentVersion.c_str(),
            latestVersion.c_str(),
            downloadUrl.c_str(),
            releaseNotes.c_str());
        request->send(200, "application/json", json);
    });

    // ========== POST /api/update-ota - АВТООБНОВЛЕНИЕ ==========
    server.on("/api/update-ota", HTTP_POST, [](AsyncWebServerRequest *request) {
        addNotificationToLog("⚡ Запущено автообновление...");
        
        String otaUrl = "";
        WiFiClientSecure client;
        client.setInsecure();
        client.setTimeout(5000);
        HTTPClient http;
        
        if (http.begin(client, "https://raw.githubusercontent.com/schreider/flook32/main/firmware/flook32/latest.json?t=" + String(millis()))) {
            http.addHeader("User-Agent", "FLOOK32");
            if (http.GET() == 200) {
                String body = http.getString();
                StaticJsonDocument<512> doc;
                if (!deserializeJson(doc, body)) {
                    otaUrl = doc["ota_url"].as<String>();
                }
            }
            http.end();
        }
        
        if (otaUrl.isEmpty()) {
            request->send(500, "application/json", "{\"error\":\"Failed to get update URL\"}");
            return;
        }
        
        request->send(200, "application/json", "{\"success\":true,\"message\":\"Rebooting to OTA mode\"}");
        
        Preferences prefsOTA;
        prefsOTA.begin("flook", false);
        prefsOTA.putBool("ota_pending", true);
        prefsOTA.putString("ota_url", otaUrl);
        prefsOTA.putInt("ota_attempts", 0);
        prefsOTA.end();
        
        delay(500);
        ESP.restart();
    });

    // 404 обработчик
    server.onNotFound([](AsyncWebServerRequest *request){ 
        request->send(404, "text/plain", "Not Found"); 
    });

    server.begin();
    LOG_INFO("AsyncWebServer запущен (WebSocket, REST API, OTA)");

    // ========== 12. ФИНАЛЬНЫЕ СООБЩЕНИЯ ==========
    if (errors.isSystemLocked()) {
        LOG_ERROR("СИСТЕМА ЗАБЛОКИРОВАНА: %s", errors.lockReason.c_str());
        addErrorToLog("🔒 Система запущена в заблокированном состоянии: " + errors.lockReason, 
                      true, false, config.maxErrorRetries);
    } else {
        LOG_INFO("Система готова к работе");
        addNotificationToLog("✅ Система запущена v" + String(FW_VERSION));
    }

    LOG_INFO("Свободная куча: %u байт", ESP.getFreeHeap());

    // ========== 13. ПРОВЕРКА ФЛАГА АВТОПЕРЕЗАГРУЗКИ И ВОССТАНОВЛЕНИЕ IP KLIPPER ==========
    Preferences prefs;
    if (prefs.begin("flook", true)) {
        autoRebootPending = prefs.getBool(PREF_AUTO_REBOOT_FLAG, false);
        
        // Восстанавливаем IP Klipper из NVS, но НЕ ставим detected = true
        // Статус будет проверен через TCP в webTask()
        String savedKlipperIp = prefs.getString("klipper_ip", "");
        if (savedKlipperIp.length() > 0) {
            IPAddress savedIp;
            if (savedIp.fromString(savedKlipperIp)) {
                klipperStatus.ip = savedIp;
                klipperStatus.lastSeen = 0;  // Помечаем как "не проверено"
                // klipperStatus.detected оставляем false — ждём TCP-проверки
                LOG_INFO("IP Klipper загружен из NVS: %s (ожидание проверки)", savedKlipperIp.c_str());
            }
        }
        
        prefs.end();
    }
    
    if (autoRebootPending) {
        LOG_INFO("Автоперезагрузка (мелодия отключена)");
        if (prefs.begin("flook", false)) {
            prefs.remove(PREF_AUTO_REBOOT_FLAG);
            prefs.end();
        }
    } else {
        if (config.buzzerEnabled && !errors.isSystemLocked()) {
            playMelody(0, false);
        }
    }

    // ========== 14. ЗАПУСК ЗАДАЧ FREERTOS ==========
    xTaskCreatePinnedToCore(sensorTask, "SensorTask", 4096, NULL, 8, NULL, 1);
    xTaskCreatePinnedToCore(controlTask, "ControlTask", 12288, NULL, 10, &controlTaskHandle, 1);
    xTaskCreatePinnedToCore(webTask, "WebTask", 16384, NULL, 7, &webTaskHandle, 0);
    xTaskCreatePinnedToCore(heartbeatTask, "Heartbeat", 1024, NULL, 5, NULL, 1);
    xTaskCreatePinnedToCore(ledTask, "LEDTask", 2048, NULL, 2, NULL, 0);

    LOG_INFO("FreeRTOS задачи запущены:");
    LOG_INFO("  SensorTask: ядро=1, приоритет=8, стек=4KB");
    LOG_INFO("  ControlTask: ядро=1, приоритет=10, стек=12KB (Watchdog)");
    LOG_INFO("  WebTask: ядро=0, приоритет=9, стек=16KB");
    LOG_INFO("  HeartbeatTask: ядро=1, приоритет=5, стек=1KB");
    LOG_INFO("  LEDTask: ядро=0, приоритет=2, стек=2KB");

    // ========== 15. НАСТРОЙКА WATCHDOG ==========
    if (config.enableLoopWatchdog && controlTaskHandle != NULL) {
        esp_err_t err = esp_task_wdt_add(controlTaskHandle);

        if (err == ESP_OK) {
            LOG_INFO("ControlTask в Watchdog (таймаут %d мс)", config.loopWatchdogTimeout);
        } else if (err == ESP_ERR_INVALID_STATE) {
            esp_task_wdt_config_t wdt_config = {
                .timeout_ms = config.loopWatchdogTimeout,
                .trigger_panic = true
            };
            esp_task_wdt_init(&wdt_config);
            esp_task_wdt_add(controlTaskHandle);
            LOG_INFO("Watchdog инициализирован (таймаут %d мс)", config.loopWatchdogTimeout);
        } else {
            LOG_ERROR("Ошибка Watchdog: %d", err);
        }
    } else {
        LOG_WARN("Watchdog отключен");
    }

    // ========== 16. ЗАВЕРШЕНИЕ ==========
    resetActivityTimer();
    LOG_INFO("Автоперезагрузка через %lu мин бездействия", AUTO_REBOOT_TIMEOUT / 60000);
    LOG_INFO("========================================");

    lastApiCallTime = millis();
    vTaskDelete(NULL);
}

