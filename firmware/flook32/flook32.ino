// ============================================================================
// СТРУКТУРА СТАТУСА KLIPPER
// ============================================================================

// Хранит информацию об обнаруженном сервере Klipper в локальной сети
// Обновляется: handleUDPDiscovery() при получении UDP-пакета "FLOOK_DISCOVERY"
// Используется: API /api/all, /api/config, WebSocket метрики
struct KlipperStatus {
    bool detected = false;          // Флаг обнаружения Klipper в сети
    IPAddress ip;                   // IP адрес обнаруженного сервера Klipper
    unsigned long lastSeen;         // Время последнего обнаружения Klipper в миллисекундах
    int requestCount = 0;           // Счётчик полученных ответов от Klipper
    
    // Обновляет статус Klipper при получении UDP-ответа
    // Вызывается: handleUDPDiscovery() при получении "FLOOK_DISCOVERY"
    void update(IPAddress newIp) {
        ip = newIp;
        detected = true;
        lastSeen = millis();
        requestCount++;
        LOG_INFO("Klipper обнаружен по UDP, IP: %s (запрос #%d)", ip.toString().c_str(), requestCount);
    }
    
    // Возвращает статус Klipper в формате JSON для API ответов
    // Используется: handleApiAllStates(), sendMetricsToClients()
    String getJSON() {
        String json = "{";
        json += "\"detected\":" + String(detected ? "true" : "false") + ",";
        String displayIp = "0.0.0.0";
        if (detected && ip != IPAddress(0,0,0,0)) displayIp = ip.toString();
        json += "\"ip\":\"" + displayIp + "\",";
        json += "\"lastSeen\":" + String((millis() - lastSeen) / 1000) + ",";
        json += "\"requestCount\":" + String(requestCount);
        json += "}";
        return json;
    }
} klipperStatus;                    // Глобальный экземпляр статуса Klipper

