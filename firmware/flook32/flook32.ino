// ============================================================================
// СТРУКТУРА ЗАПИСИ ЖУРНАЛА ОШИБОК
// ============================================================================

// Хранит информацию об ошибке или предупреждении для отображения в веб-интерфейсе
// Защищена мьютексом errorLogMux при доступе из разных задач
struct ErrorLogEntry {
    unsigned long timestamp;    // Время возникновения ошибки в миллисекундах с момента запуска устройства
    String message;             // Текстовое описание ошибки (с эмодзи для визуального выделения)
    String trendData;           // Данные трендов температур перед ошибкой (только для критических ошибок)
    bool isCritical;            // Флаг критичности: true = авария с блокировкой, false = предупреждение
    uint32_t hash;              // Хеш сообщения (алгоритм DJB2) для дедупликации повторяющихся ошибок
    String severity;            // Уровень серьёзности: "critical" (критическая), "warning" (предупреждение), "info" (информация)
    int errorCount;             // Количество повторений данной ошибки (для группировки в логе)
};

std::vector<ErrorLogEntry> errorLog;    // Вектор записей журнала ошибок (FIFO, максимум MAX_ERROR_LOG = 20)
                                        // Доступ: webTask (запись/чтение), controlTask (чтение для метрик)

String lastErrorMessage = "";           // Текст последней добавленной ошибки (для предотвращения дублирования)
unsigned long lastErrorTime = 0;        // Время последней добавленной ошибки в миллисекундах
uint32_t lastErrorHash = 0;             // Хеш последней добавленной ошибки (для сравнения)

// ============================================================================
// КОМПАКТНАЯ ЗАПИСЬ ТРЕНДА (ДЛЯ ГРАФИКА)
// ============================================================================

// Упакованная структура для хранения истории температур с фиксированной точкой
// Занимает 16 байт на точку (против ~32 байт при использовании float)
// Буфер: 600 точек × 16 байт = 9.6 КБ памяти
struct CompactTrendEntry {
    uint32_t timestamp;         // Временная метка в миллисекундах с момента запуска
    int16_t airTemp;            // Температура воздуха, умноженная на 10 (точность 0.1°C)
    int16_t heaterTemp;         // Температура нагревателя, умноженная на 10
    int16_t targetTemp;         // Целевая температура, умноженная на 10
    int16_t predictedTemp;      // Предсказанная термальной моделью температура, умноженная на 10
    uint8_t flags;              // Битовая маска: бит0 = состояние нагревателя, бит1 = состояние вентилятора
    
    // ========== МЕТОДЫ ДОСТУПА С ПРЕОБРАЗОВАНИЕМ ==========
    float getAirTemp() { return airTemp / 10.0; }             // Возвращает температуру воздуха с плавающей точкой
    float getHeaterTemp() { return heaterTemp / 10.0; }       // Возвращает температуру нагревателя
    float getTargetTemp() { return targetTemp / 10.0; }       // Возвращает целевую температуру
    bool getHeaterState() { return flags & 1; }               // Возвращает состояние нагревателя (бит 0)
    float getPredictedTemp() { return predictedTemp / 10.0; } // Возвращает предсказанную температуру
    bool getFanState() { return flags & 2; }                  // Возвращает состояние вентилятора (бит 1)
};

// ========== ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ ТРЕНДОВ ==========

CompactTrendEntry trendBuffer[TREND_BUFFER_SIZE];   // Кольцевой буфер записей трендов (размер = 600 точек)
                                                    // Защищён мьютексом trendBufferMux

int trendIndex = 0;                                 // Текущий индекс для записи в буфер (увеличивается циклически)
bool trendBufferFilled = false;                     // Флаг полного заполнения буфера (после первого оборота)
unsigned long lastTrendUpdate = 0;                  // Время последнего обновления буфера трендов (для отладки)

