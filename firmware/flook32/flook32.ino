enum AdaptationPhase {
    ADAPT_IDLE = 0,                 // Адаптация не активна
    ADAPT_WAITING_STABLE,           // Ожидание стабилизации температур (выравнивание и остывание)
    ADAPT_MEASURE_NOISE,            // Измерение шумов датчиков (среднеквадратичное отклонение)
    ADAPT_MEASURE_BASELINE,         // Измерение базовых параметров (макс. скачки температур)
    ADAPT_FAN_CALIBRATION,          // Калибровка вентилятора (оптимальная мощность и температура включения)
    ADAPT_HEATING_PHASE,            // Фаза нагрева с вентилятором (измерение скорости нагрева)
    ADAPT_WAITING_USER,             // Ожидание подтверждения пользователя (опустить стол, включить нагрев)
    ADAPT_HEATING_PHASE2,           // Фаза нагрева камеры (ожидание прогрева воздуха)
    ADAPT_COMPLETE,                 // Адаптация успешно завершена
    ADAPT_FAILED                    // Адаптация завершилась ошибкой
};

