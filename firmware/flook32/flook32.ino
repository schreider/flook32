// ----------------------------------------------------------------------------
void controlTask(void* parameter);      // Задача управления (ядро 1, приоритет 10)
                                        // Отвечает за: нагреватель, вентилятор, защиты, адаптацию
                                        // Watchdog: контролируется, при зависании → паника

void sensorTask(void* parameter);       // Задача опроса датчиков (ядро 1, приоритет 8)
                                        // Асинхронный опрос: DS18B20 (ожидание конверсии), MAX6675 (SPI)
                                        // Обновляет: airTemp, heaterTemp в критической секции

void webTask(void* parameter);          // Веб-задача (ядро 0, приоритет 9)
                                        // Обрабатывает: HTTP/WebSocket запросы, UDP discovery
                                        // Также: логирование, тренды, LED, зуммер

void heartbeatTask(void* parameter);    // Задача генерации импульсов (ядро 1, приоритет 5)
                                        // Управляет пином Watchdog (GPIO26) для внешней электроники

// ----------------------------------------------------------------------------
// WEBSOCKET ФУНКЦИИ (РЕАЛЬНОЕ ВРЕМЯ)
// ----------------------------------------------------------------------------
void onWebSocketEvent(AsyncWebSocket *server, AsyncWebSocketClient *client, 
                      AwsEventType type, void *arg, uint8_t *data, size_t len);
                                // Обработчик событий WebSocket
                                // Вызывается: при подключении/отключении клиента, получении данных
                                // Типы событий: WS_EVT_CONNECT, WS_EVT_DISCONNECT, WS_EVT_DATA

void handleWebSocketMessage(AsyncWebSocketClient *client, uint8_t *data, size_t len);
                                // Обработка входящих WebSocket сообщений
                                // Команды: "get_updates:<timestamp>" - запросить историю с указанного времени

void sendMetricsToClients();    // Отправка метрик всем подключённым клиентам
                                // Вызывается: controlTask каждую секунду
                                // Содержит: T_air, T_heater, T_target, статусы, uptime, состояние блокировки

void sendHistoryToClient(AsyncWebSocketClient *client);
                                // Отправка полной истории трендов клиенту
                                // Вызывается: onWebSocketEvent() при подключении
                                // Отправляет: порциями (CHUNK_SIZE = 30 точек) для избежания переполнения буфера

void sendUpdatesSince(AsyncWebSocketClient *client, unsigned long timestamp);
                                // Отправка только новых точек (начиная с timestamp)
                                // Вызывается: handleWebSocketMessage() по команде "get_updates"
                                // Оптимизация: не отправляет всю историю заново

