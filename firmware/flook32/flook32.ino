// Уровни логирования: 0=DEBUG, 1=INFO, 2=WARN, 3=ERROR, 4=SILENT
#define LOG_LEVEL 0

// Макросы логирования с проверкой Serial
#if LOG_LEVEL <= 0
  #define LOG_DEBUG(fmt, ...) do { if(Serial) Serial.printf("[DEBUG] " fmt "\n", ##__VA_ARGS__); } while(0)
#else
  #define LOG_DEBUG(fmt, ...) ((void)0)
#endif

#if LOG_LEVEL <= 1
  #define LOG_INFO(fmt, ...)  do { if(Serial) Serial.printf("[INFO]  " fmt "\n", ##__VA_ARGS__); } while(0)
#else
  #define LOG_INFO(fmt, ...)  ((void)0)
#endif

#if LOG_LEVEL <= 2
  #define LOG_WARN(fmt, ...)  do { if(Serial) Serial.printf("[WARN]  " fmt "\n", ##__VA_ARGS__); } while(0)
#else
  #define LOG_WARN(fmt, ...)  ((void)0)
#endif

#if LOG_LEVEL <= 3
  #define LOG_ERROR(fmt, ...) do { if(Serial) Serial.printf("[ERROR] " fmt "\n", ##__VA_ARGS__); } while(0)
#else
  #define LOG_ERROR(fmt, ...) ((void)0)
#endif

// Для критических ошибок (всегда выводятся)
#define LOG_FATAL(fmt, ...) do { if(Serial) Serial.printf("[FATAL] " fmt "\n", ##__VA_ARGS__); } while(0)

