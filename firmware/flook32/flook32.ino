// Собирает и хранит все параметры, измеренные в процессе самонастройки системы
// Заполняется: processAdaptation() на различных фазах
// Используется: applyAdaptationResults() для обновления конфигурации
struct AdaptationStats {
    // ========== БАЗОВЫЕ ТЕМПЕРАТУРНЫЕ ПАРАМЕТРЫ ==========
    float initialAirTemp = 0;           // Начальная температура воздуха в начале адаптации (°C)
    float initialHeaterTemp = 0;        // Начальная температура нагревателя в начале адаптации (°C)
