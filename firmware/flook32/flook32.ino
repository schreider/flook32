// ============================================================================
// СТРУКТУРА ТАЙМЕРА
// ============================================================================

// Удобная обёртка для периодических задач на основе millis()
// Автоматически сбрасывает время последнего запуска при срабатывании
// Используется во всех задачах FreeRTOS для организации периодических вызовов

struct Timer {
    unsigned long lastRun;      // Время последнего срабатывания таймера в миллисекундах
    unsigned long interval;     // Интервал срабатывания таймера в миллисекундах
    
    Timer(unsigned long ms) : lastRun(0), interval(ms) {}
    
    inline bool ready(unsigned long now) {
        if (now - lastRun >= interval) {
            lastRun = now;
            return true;
        }
        return false;
    }
};

