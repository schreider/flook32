    float maxHeaterTemp = 0;            // Максимальная температура нагревателя (°C)
    float minAirTemp = 100;             // Минимальная температура воздуха (°C) (инициализируется завышенным значением)
    float minHeaterTemp = 100;          // Минимальная температура нагревателя (°C)
    float timeToReachTarget = 0;        // Время достижения целевой температуры в секундах
    float timeToMaxHeaterTemp = 0;      // Время достижения макс. температуры нагревателя (сек)
    float maxHeaterTempStable = 0;      // Температура нагревателя при стабилизации в фазе 4
    float heaterAirDelta = 0;           // Разница T_нагр - T_возд в стабильном режиме
    
    // ========== СКОРОСТИ ИЗМЕНЕНИЯ ТЕМПЕРАТУРЫ ==========
    float heatingRateHeater = 0;        // Скорость нагрева нагревателя в градусах Цельсия в минуту
    float heatingRateAir = 0;           // Скорость нагрева воздуха в градусах Цельсия в минуту
    float coolingRateWithFan = 0;       // Скорость охлаждения с включённым вентилятором (°C/сек)
    float coolingRateWithoutFan = 0;    // Скорость охлаждения с выключенным вентилятором (°C/сек)
