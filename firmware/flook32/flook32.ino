    float airSensorUnstableRange     = DEFAULT_AIR_SENSOR_UNSTABLE_RANGE;      // Размах для нестабильности (0.5-20°C)
    float airSensorUnstableDeviation = DEFAULT_AIR_SENSOR_UNSTABLE_DEVIATION;  // Отклонение для нестабильности (0.1-10°C)
    int airSensorUnstableWindow      = DEFAULT_AIR_SENSOR_UNSTABLE_WINDOW;     // Размер окна анализа (3-50)
    int airSensorDirectionChanges    = DEFAULT_AIR_SENSOR_DIRECTION_CHANGES;   // Смен направления = нестабильность (1-20)

    // ========== СИСТЕМА ОШИБОК И БЛОКИРОВОК ==========
    int minTimeBetweenSameErrors     = DEFAULT_MIN_TIME_BETWEEN_SAME_ERRORS;     // Мин. время между ошибками (1000-300000 мс)
    int minTimeBetweenOverheatCounts = DEFAULT_MIN_TIME_BETWEEN_OVERHEAT_COUNTS; // Мин. время между перегревами (1000-60000 мс)
    int maxErrorRetries              = DEFAULT_MAX_ERROR_RETRIES;                // Повторов до полной блокировки (1-20)
    int errorWindowMinutes           = DEFAULT_ERROR_WINDOW_MINUTES;             // Окно подсчёта ошибок (1-240 мин)
    char unlockPassword[32]          = "unlock";                                 // Пароль разблокировки (строка до 31 символа)
    bool enableLoopWatchdog          = DEFAULT_ENABLE_LOOP_WATCHDOG;             // Включить Watchdog задачи
    float abnormalRateThreshold      = DEFAULT_ABNORMAL_RATE_THRESHOLD;          // Порог аномальной скорости (1-500°C/сек)
    bool enableAbnormalRate          = true;                                     // Включить контроль аномальной скорости

    // ========== АДАПТИРОВАННЫЕ ПАРАМЕТРЫ (ЗАПОЛНЯЮТСЯ АВТОМАТИЧЕСКИ) ==========
    bool adaptationPerformed         = false;                            // Флаг выполнения адаптации
    unsigned long adaptationTimestamp = 0;                               // Время адаптации (мс)
    float adaptedHeaterRiseRate      = DEFAULT_ADAPTED_HEATER_RISE_RATE; // Скорость нагрева нагревателя (°C/мин)
    float adaptedAirRiseRate         = DEFAULT_ADAPTED_AIR_RISE_RATE;    // Скорость нагрева воздуха (°C/мин)
    float adaptedCoolingRate         = DEFAULT_ADAPTED_COOLING_RATE;     // Скорость охлаждения (°C/сек)
    float adaptedNoiseThreshold      = DEFAULT_ADAPTED_NOISE_THRESHOLD;  // Порог шума датчиков (°C)
    float adaptedUnstableRange       = DEFAULT_ADAPTED_UNSTABLE_RANGE;   // Диапазон нестабильности (°C)
    int adaptedTimeToTarget          = DEFAULT_ADAPTED_TIME_TO_TARGET;   // Время достижения цели (мин)
    bool fanEffective                = false;                            // Эффективность вентилятора

    // ========== ПРОФИЛЬ НАГРЕВА (ИЗ АДАПТАЦИИ) ==========
    float heatingProfileTemp[PROFILE_SIZE];
    float heatingProfileAirTemp[PROFILE_SIZE];
    int heatingProfileCount = 0;
    float heatingProfileStartTemp = 0;
    float heatingProfileTargetTemp = 0;

    // ========== НЕЛИНЕЙНЫЕ ПАРАМЕТРЫ УПРАВЛЕНИЯ ==========
    float heatRateLow                = DEFAULT_HEAT_RATE_LOW;           // Низкая скорость нагрева (°C/мин)
    float heatRateMid                = DEFAULT_HEAT_RATE_MID;           // Средняя скорость нагрева (°C/мин)
    float heatRateHigh               = DEFAULT_HEAT_RATE_HIGH;          // Высокая скорость нагрева (°C/мин)
    float coolRateHigh               = DEFAULT_COOL_RATE_HIGH;          // Высокая скорость охлаждения (°C/сек)
    float coolRateMid                = DEFAULT_COOL_RATE_MID;           // Средняя скорость охлаждения (°C/сек)
    float coolRateLow                = DEFAULT_COOL_RATE_LOW;           // Низкая скорость охлаждения (°C/сек)
    float fanBoostHigh               = DEFAULT_FAN_BOOST_HIGH;          // Усиление вентилятора на высоких T
    float fanBoostMid                = DEFAULT_FAN_BOOST_MID;           // Усиление вентилятора на средних T
    float fanBoostLow                = DEFAULT_FAN_BOOST_LOW;           // Усиление вентилятора на низких T

    // ========== ЗВУКОВАЯ ИНДИКАЦИЯ (ЗУММЕР) ==========
    bool buzzerEnabled               = true;                            // Включить зуммер
    bool buzzerNonCriticalEnabled    = false;                           // Сигнал на некритические ошибки
    int buzzerMelody                 = 1;                               // Мелодия (0-2)
    int buzzerPin                    = DEFAULT_PIN_BUZZER;              // Пин зуммера

    // ========== WI-FI НАСТРОЙКИ ==========
    char ssid[32]                    = "";                              // Имя сети (макс. 31 символ)
    char password[64]                = "";                              // Пароль сети (макс. 63 символа)
    bool wifiConfigured              = false;                           // Флаг настройки Wi-Fi

    // ========== LED ИНДИКАЦИЯ (NEO_PIXEL) ==========
    uint8_t ledCount                 = DEFAULT_LED_COUNT;               // Количество светодиодов (1-100)
    uint8_t ledBrightness            = DEFAULT_LED_BRIGHTNESS;          // Яркость (0-255)
    uint8_t ledPin                   = DEFAULT_PIN_LED;                 // Пин светодиодной ленты
    bool ledEnabled                  = DEFAULT_LED_ENABLED;             // Включить LED индикацию

    // ========== ТЕРМАЛЬНАЯ МОДЕЛЬ (МАШИННОЕ ОБУЧЕНИЕ) ==========
    bool enableThermalModel          = DEFAULT_ENABLE_THERMAL_MODEL;         // Включить термальную модель
    float thermalModelSensitivity    = DEFAULT_THERMAL_MODEL_SENSITIVITY;    // Чувствительность (0.5-3.0)
    int thermalModelCheckInterval    = DEFAULT_THERMAL_MODEL_CHECK_INTERVAL; // Интервал проверки (500-10000 мс)
    bool thermalModelLogWarnings     = DEFAULT_THERMAL_MODEL_LOG_WARNINGS;   // Логировать предупреждения

    // ========== АППАРАТНЫЕ ПИНЫ ==========
    uint8_t pinSsr                   = DEFAULT_PIN_SSR;                 // Пин нагревателя (SSR)
    uint8_t pinFan                   = DEFAULT_PIN_FAN;                 // Пин вентилятора (ШИМ)
    uint8_t pinWatchdog              = DEFAULT_PIN_WATCHDOG;            // Пин сторожевого таймера
    uint8_t pinOneWire               = DEFAULT_PIN_ONEWIRE;             // Пин DS18B20 (1-Wire)
    uint8_t pinMaxSck                = DEFAULT_PIN_MAX_SCK;             // Пин SCK MAX6675
    uint8_t pinMaxSo                 = DEFAULT_PIN_MAX_SO;              // Пин SO MAX6675
    uint8_t pinMaxCs                 = DEFAULT_PIN_MAX_CS;              // Пин CS MAX6675
    uint8_t pinBuzzer                = DEFAULT_PIN_BUZZER;              // Пин зуммера
    uint8_t pinLed                   = DEFAULT_PIN_LED;                 // Пин светодиодной ленты
    uint8_t pinButton                = DEFAULT_PIN_BUTTON;              // Пин кнопки сброса

    // ========== MOONRAKER АВТООТКЛЮЧЕНИЕ ==========
    bool autoShutdownEnabled         = false;                           // Включить автоотключение после печати
    int autoShutdownMinutes          = 30;                              // Минут ожидания после печати
    unsigned long lastHeaterActivity = 0;                               // Время последней активности нагревателя
    bool printActive                 = false;                           // Флаг активной печати
    unsigned long lastPrintActivity  = 0;                               // Время последней печатной активности

    // ========== АВТООГРАНИЧЕНИЕ МОЩНОСТИ ВЕНТИЛЯТОРА ==========
    bool enableFanAutoLimit          = DEFAULT_ENABLE_FAN_AUTO_LIMIT;         // Включить автоограничение
    float fanAutoLimitHysteresis     = DEFAULT_FAN_AUTO_LIMIT_HYSTERESIS;     // Гистерезис поддержания (0.5-10°C)
    int fanAutoLimitCheckInterval    = DEFAULT_FAN_AUTO_LIMIT_CHECK_INTERVAL; // Интервал коррекции (1000-30000 мс)
    int fanAutoLimitStableCount      = DEFAULT_FAN_AUTO_LIMIT_STABLE_COUNT;   // Стабильных замеров (1-10)
    bool fanAutoLimitAdapted         = false;                                 // Флаг адаптации автоограничения
    unsigned long fanAutoLimitAdaptedTimestamp = 0;                           // Время адаптации
    int maxFanDuty                   = DEFAULT_MAX_FAN_DUTY;                  // Максимальный duty (0-1023)
    int fanAutoLimitAdjustStep       = DEFAULT_FAN_AUTO_LIMIT_ADJUST_STEP;    // Шаг изменения duty (1-20)
    int fanAutoLimitMinDuty          = DEFAULT_FAN_AUTO_LIMIT_MIN_DUTY;       // Минимальный duty (0-1023)
    int actualFanDuty                = 0;                                     // Текущий duty вентилятора

    // ========== ВАЛИДАЦИЯ КОНФИГУРАЦИИ ==========
    // Приводит все параметры к допустимым пределам после загрузки или изменения.
    // Не содержит вызовов saveConfig() — только проверяет и исправляет значения.
    // Вызывается: loadConfig(), saveConfig(), handleApiConfigDefaults()
    void validate() {
        // ----- СИСТЕМНЫЕ ИНТЕРВАЛЫ -----
        if (loopWatchdogTimeout < 5000)  loopWatchdogTimeout = 5000;
        if (loopWatchdogTimeout > 60000) loopWatchdogTimeout = 60000;
        if (udpDiscoveryTimeout < 5000)  udpDiscoveryTimeout = 5000;
        if (udpDiscoveryTimeout > 60000) udpDiscoveryTimeout = 60000;
        if (discoveryRetryInterval < 500)  discoveryRetryInterval = 500;
        if (discoveryRetryInterval > 10000) discoveryRetryInterval = 10000;
        if (heaterControlInterval < 50)    heaterControlInterval = 50;
        if (heaterControlInterval > 1000)  heaterControlInterval = 1000;
        if (fanControlInterval < 500)      fanControlInterval = 500;
        if (fanControlInterval > 5000)     fanControlInterval = 5000;
        if (runawayCheckInterval < 1000)   runawayCheckInterval = 1000;
        if (runawayCheckInterval > 30000)  runawayCheckInterval = 30000;
        if (unexpectedCheckInterval < 500) unexpectedCheckInterval = 500;
        if (unexpectedCheckInterval > 10000) unexpectedCheckInterval = 10000;
        if (rateCheckInterval < 500)       rateCheckInterval = 500;
        if (rateCheckInterval > 5000)      rateCheckInterval = 5000;

        // ----- ТЕМПЕРАТУРНЫЕ ПОРОГИ -----
        if (maxHeaterTemp >= criticalTemp) maxHeaterTemp = criticalTemp - 5.0f;
        if (maxHeaterTemp < 30)  maxHeaterTemp = 30;
        if (maxHeaterTemp > 300) maxHeaterTemp = 300;
        if (criticalTemp < 40)   criticalTemp = 40;
        if (criticalTemp > 350)  criticalTemp = 350;
        if (criticalHysteresis < 1.0f) criticalHysteresis = 1.0f;
        if (criticalHysteresis > 50.0f) criticalHysteresis = 50.0f;
        if (maxAirTemp < 20)     maxAirTemp = 20;
        if (maxAirTemp > 200)    maxAirTemp = 200;
        if (airHysteresis < 1.0f) airHysteresis = 1.0f;
        if (airHysteresis > 50.0f) airHysteresis = 50.0f;
        if (hysteresis < 0.5f)   hysteresis = 0.5f;
        if (hysteresis > 50.0f)  hysteresis = 50.0f;
        if (heaterHysteresis < 1.0f)  heaterHysteresis = 1.0f;
        if (heaterHysteresis > 30.0f) heaterHysteresis = 30.0f;
        if (fanOnTemp >= maxHeaterTemp) fanOnTemp = maxHeaterTemp - 10.0f;
        if (fanOnTemp < 0)  fanOnTemp = 0;
        if (fanOffHysteresis < 1)  fanOffHysteresis = 1;
        if (fanOffHysteresis > 30) fanOffHysteresis = 30;
        if (defaultTargetTemp < 0)   defaultTargetTemp = 0;
        if (defaultTargetTemp > 100) defaultTargetTemp = 100;

        // ----- UNEXPECTED HEAT -----
        if (unexpectedHeatThreshold >= maxHeaterTemp) unexpectedHeatThreshold = maxHeaterTemp * 0.15f;
        if (unexpectedHeatThreshold < 5) unexpectedHeatThreshold = 5;
        if (adaptiveMinOffset > maxHeaterTemp - 10) adaptiveMinOffset = maxHeaterTemp - 15;
        if (adaptiveMinOffset < 10) adaptiveMinOffset = 10;
        if (adaptiveBaseTemp < 10) adaptiveBaseTemp = 10;
        if (adaptiveBaseTemp > 40) adaptiveBaseTemp = 40;
        if (adaptiveCoefficient < 0) adaptiveCoefficient = 0;
        if (adaptiveCoefficient > 1) adaptiveCoefficient = 1;
        if (unexpectedHeatTimeout < 5)   unexpectedHeatTimeout = 5;
        if (unexpectedHeatTimeout > 300) unexpectedHeatTimeout = 300;
        if (minCoolingRate < 0.01f) minCoolingRate = 0.01f;
        if (minCoolingRate > 20)    minCoolingRate = 20;
        if (unexpectedHeatHysteresis < 0.5f) unexpectedHeatHysteresis = 0.5f;
        if (unexpectedHeatHysteresis > 20)   unexpectedHeatHysteresis = 20;
        if (unexpectedHeatClearTime < 5000)   unexpectedHeatClearTime = 5000;
        if (unexpectedHeatClearTime > 600000) unexpectedHeatClearTime = 600000;
        if (unexpectedHeatSafeOffset < 5)  unexpectedHeatSafeOffset = 5;
        if (unexpectedHeatSafeOffset > 50) unexpectedHeatSafeOffset = 50;

        // ----- THERMAL RUNAWAY -----
        if (runawayPhase1Time < 1)  runawayPhase1Time = 1;
        if (runawayPhase1Time > 30) runawayPhase1Time = 30;
        if (runawayPhase2Time < 5)  runawayPhase2Time = 5;
        if (runawayPhase2Time > 60) runawayPhase2Time = 60;
        if (runawayMaxTimeToTarget < 10)  runawayMaxTimeToTarget = 10;
        if (runawayMaxTimeToTarget > 120) runawayMaxTimeToTarget = 120;
        if (runawayMinHeaterRisePerMin < 0.5f) runawayMinHeaterRisePerMin = 0.5f;
        if (runawayMinHeaterRisePerMin > 30)   runawayMinHeaterRisePerMin = 30;
        if (runawayMinAirRisePerMin < 0.1f) runawayMinAirRisePerMin = 0.1f;
        if (runawayMinAirRisePerMin > 10)   runawayMinAirRisePerMin = 10;
        if (runawayMaxHeaterDrop < 5)  runawayMaxHeaterDrop = 5;
        if (runawayMaxHeaterDrop > 50) runawayMaxHeaterDrop = 50;
        if (runawayHysteresis < 0.5f) runawayHysteresis = 0.5f;
        if (runawayHysteresis > 10)   runawayHysteresis = 10;
        if (runawayRecoveryTimeout < 10)  runawayRecoveryTimeout = 10;
        if (runawayRecoveryTimeout > 300) runawayRecoveryTimeout = 300;
        if (runawayQuickCheckTemp < 20) runawayQuickCheckTemp = 20;
        if (runawayQuickCheckTemp > 200) runawayQuickCheckTemp = 200;

        // ----- ВЕНТИЛЯТОР И ЭФФЕКТИВНОСТЬ -----
        if (fanMinOnTime < 10)  fanMinOnTime = 10;
        if (fanMinOnTime > 300) fanMinOnTime = 300;
        if (fanEfficiencyTimeout < 30)  fanEfficiencyTimeout = 30;
        if (fanEfficiencyTimeout > 600) fanEfficiencyTimeout = 600;
        if (fanEfficiencyThreshold < 0.5f) fanEfficiencyThreshold = 0.5f;
        if (fanEfficiencyThreshold > 20)   fanEfficiencyThreshold = 20;

        // ----- MAX6675 -----
        if (max6675Offset < -50) max6675Offset = -50;
        if (max6675Offset > 50)  max6675Offset = 50;
        if (max6675StabilitySamples < 1)  max6675StabilitySamples = 1;
        if (max6675StabilitySamples > 10) max6675StabilitySamples = 10;
        if (max6675TempJumpThreshold < 5.0f)  max6675TempJumpThreshold = 5.0f;
        if (max6675TempJumpThreshold > 50.0f) max6675TempJumpThreshold = 50.0f;
        if (max6675MinTemp < -100) max6675MinTemp = -100;
        if (max6675MinTemp > 0)    max6675MinTemp = 0;
        if (max6675MaxTemp < 100)  max6675MaxTemp = 100;
        if (max6675MaxTemp > 1000) max6675MaxTemp = 1000;

        // ----- DS18B20 -----
        if (ds18b20Scale < 0.9f) ds18b20Scale = 0.9f;
        if (ds18b20Scale > 1.1f) ds18b20Scale = 1.1f;
        if (ds18b20Offset < -10) ds18b20Offset = -10;
        if (ds18b20Offset > 10)  ds18b20Offset = 10;

        // ----- ЗАЩИТА ДАТЧИКА ВОЗДУХА -----
        if (airSensorStabilitySamples < 3)  airSensorStabilitySamples = 3;
        if (airSensorStabilitySamples > 20) airSensorStabilitySamples = 20;
        if (airSensorTempJumpThreshold < 2.0f)  airSensorTempJumpThreshold = 2.0f;
        if (airSensorTempJumpThreshold > 30.0f) airSensorTempJumpThreshold = 30.0f;
        if (airSensorMinTemp < -100) airSensorMinTemp = -100;
        if (airSensorMinTemp > 0)    airSensorMinTemp = 0;
        if (airSensorMaxTemp < 50)   airSensorMaxTemp = 50;
        if (airSensorMaxTemp > 200)  airSensorMaxTemp = 200;
        if (airSensorUnstableRange < 1.0f)  airSensorUnstableRange = 1.0f;
        if (airSensorUnstableRange > 10.0f) airSensorUnstableRange = 10.0f;
        if (airSensorUnstableDeviation < 0.5f) airSensorUnstableDeviation = 0.5f;
        if (airSensorUnstableDeviation > 5.0f) airSensorUnstableDeviation = 5.0f;
        if (airSensorUnstableWindow < 3)  airSensorUnstableWindow = 3;
        if (airSensorUnstableWindow > 50) airSensorUnstableWindow = 50;
        if (airSensorDirectionChanges < 1)  airSensorDirectionChanges = 1;
        if (airSensorDirectionChanges > 20) airSensorDirectionChanges = 20;

        // ----- СИСТЕМА ОШИБОК -----
        if (maxErrorRetries < 1)  maxErrorRetries = 1;
        if (maxErrorRetries > 20) maxErrorRetries = 20;
        if (errorWindowMinutes < 1)   errorWindowMinutes = 1;
        if (errorWindowMinutes > 240) errorWindowMinutes = 240;
        if (minTimeBetweenSameErrors < 1000)    minTimeBetweenSameErrors = 1000;
        if (minTimeBetweenSameErrors > 300000)  minTimeBetweenSameErrors = 300000;
        if (minTimeBetweenOverheatCounts < 1000)   minTimeBetweenOverheatCounts = 1000;
        if (minTimeBetweenOverheatCounts > 60000)  minTimeBetweenOverheatCounts = 60000;
        if (abnormalRateThreshold < 1.0f)  abnormalRateThreshold = 1.0f;
        if (abnormalRateThreshold > 20.0f) abnormalRateThreshold = 20.0f;

        // ----- LED ИНДИКАЦИЯ -----
        if (ledCount < 1 || ledCount > MAX_LEDS) ledCount = DEFAULT_LED_COUNT;
        if (ledBrightness > 255) ledBrightness = 255;
        if (ledPin > 39) ledPin = DEFAULT_PIN_LED;

        // ----- HEARTBEAT -----
        if (heartbeatPulseMs < 10)   heartbeatPulseMs = 10;
        if (heartbeatPulseMs > 1000) heartbeatPulseMs = 1000;
        if (heartbeatPauseMs < 100)    heartbeatPauseMs = 100;
        if (heartbeatPauseMs > 10000)  heartbeatPauseMs = 10000;

        // ----- ТЕРМАЛЬНАЯ МОДЕЛЬ -----
        if (thermalModelSensitivity < 0.5f) thermalModelSensitivity = 0.5f;
        if (thermalModelSensitivity > 3.0f) thermalModelSensitivity = 3.0f;
        if (thermalModelCheckInterval < 500)   thermalModelCheckInterval = 500;
        if (thermalModelCheckInterval > 10000) thermalModelCheckInterval = 10000;

        // ----- АВТООГРАНИЧЕНИЕ ВЕНТИЛЯТОРА -----
        if (maxFanDuty < 0)    maxFanDuty = 0;
        if (maxFanDuty > 1023) maxFanDuty = 1023;
        if (fanAutoLimitMinDuty < 0)    fanAutoLimitMinDuty = 0;
        if (fanAutoLimitMinDuty > 1023) fanAutoLimitMinDuty = 1023;
        if (fanAutoLimitHysteresis < 0.5f)  fanAutoLimitHysteresis = 0.5f;
        if (fanAutoLimitHysteresis > 10.0f) fanAutoLimitHysteresis = 10.0f;
        if (fanAutoLimitAdjustStep < 1)  fanAutoLimitAdjustStep = 1;
        if (fanAutoLimitAdjustStep > 20) fanAutoLimitAdjustStep = 20;
        if (fanAutoLimitCheckInterval < 1000)   fanAutoLimitCheckInterval = 1000;
        if (fanAutoLimitCheckInterval > 30000)  fanAutoLimitCheckInterval = 30000;
        if (fanAutoLimitStableCount < 1)  fanAutoLimitStableCount = 1;
        if (fanAutoLimitStableCount > 10) fanAutoLimitStableCount = 10;

        // ----- ЗУММЕР -----
        if (buzzerMelody < 0 || buzzerMelody > 2) buzzerMelody = 1;
        if (buzzerPin > 39) buzzerPin = DEFAULT_PIN_BUZZER;

        // ----- БУЛЕВЫЕ ФЛАГИ -----
        if (invertFanSignal != 0 && invertFanSignal != 1)    invertFanSignal = DEFAULT_INVERT_FAN_SIGNAL;
        if (invertHeaterSignal != 0 && invertHeaterSignal != 1) invertHeaterSignal = DEFAULT_INVERT_HEATER_SIGNAL;

        // ----- MOONRAKER -----
        if (autoShutdownMinutes < 5)  autoShutdownMinutes = 5;
        if (autoShutdownMinutes > 120) autoShutdownMinutes = 120;

        // ----- ПРОФИЛЬ НАГРЕВА -----
        if (heatingProfileCount < 0 || heatingProfileCount > PROFILE_SIZE) {
            heatingProfileCount = 0;
        }

        // ----- ПИНЫ ESP32 (простая проверка диапазона, без конфликтов) -----
        if (pinSsr > 39)      pinSsr = DEFAULT_PIN_SSR;
        if (pinFan > 39)      pinFan = DEFAULT_PIN_FAN;
        if (pinWatchdog > 39) pinWatchdog = DEFAULT_PIN_WATCHDOG;
        if (pinOneWire > 39)  pinOneWire = DEFAULT_PIN_ONEWIRE;
        if (pinMaxSck > 39)   pinMaxSck = DEFAULT_PIN_MAX_SCK;
        if (pinMaxSo > 39)    pinMaxSo = DEFAULT_PIN_MAX_SO;
        if (pinMaxCs > 39)    pinMaxCs = DEFAULT_PIN_MAX_CS;
        if (pinButton > 39) pinButton = DEFAULT_PIN_BUTTON;
    }
} config;  // Глобальный экземпляр конфигурации

// ============================================================================
// СТРУКТУРА ДЛЯ ВРЕМЕННЫХ ПЕРЕОПРЕДЕЛЕНИЙ ПАРАМЕТРОВ ЗАЩИТ
// ============================================================================

// Позволяет временно изменять пороги срабатывания защит при активации термальной модели
// При включённой термальной модели пороги Thermal Runaway смягчаются (увеличиваются таймауты)
// Это предотвращает ложные срабатывания, так как модель предсказывает и компенсирует аномалии

struct ProtectionOverride {
    // ========== ФЛАГ АКТИВАЦИИ РЕЖИМА ПЕРЕОПРЕДЕЛЕНИЯ ==========
    bool thermalModelActive = false;    // Истина, если термальная модель активна и применяются мягкие пороги
                                        // Устанавливается при включении config.enableThermalModel
    
    // ========== ПЕРЕОПРЕДЕЛЁННЫЕ ПАРАМЕТРЫ THERMAL RUNAWAY ==========
    float runawayMinHeaterRiseOverride = -1;   // Мин. рост нагревателя для фазы 1 (-1 = не переопределено)
    float runawayMinAirRiseOverride = -1;      // Мин. рост воздуха для фазы 2
    float runawayMaxTimeToTargetOverride = -1; // Макс. время до цели для фазы 3
    int runawayPhase1TimeOverride = -1;        // Длительность фазы 1 в минутах
    int runawayPhase2TimeOverride = -1;        // Длительность фазы 2 в минутах
    
    // ========== ПЕРЕМЕННЫЕ ДЛЯ КОНТРОЛЯ СКОРОСТИ НАГРЕВА ВОЗДУХА ==========
    unsigned long lastAirCheckTime = 0;     // Время последней проверки температуры воздуха (мс)
    float airStartTemp = 0;                 // Температура воздуха в начале проверки (°C)
    unsigned long airCheckStartTime = 0;    // Время начала фазы проверки воздуха (мс)
    bool airCheckActive = false;            // Флаг активной проверки скорости нагрева воздуха
    
    // ========== СБРОС ВСЕХ ПЕРЕОПРЕДЕЛЕНИЙ ==========
    // Вызывается: при выключении термальной модели или инициализации системы
    void reset() {
        thermalModelActive = false;
        runawayMinHeaterRiseOverride = -1;
        runawayMinAirRiseOverride = -1;
        runawayMaxTimeToTargetOverride = -1;
        runawayPhase1TimeOverride = -1;
        runawayPhase2TimeOverride = -1;
        airCheckActive = false;
        airCheckStartTime = 0;
        lastAirCheckTime = 0;
    }
    
    // ========== ОБНОВЛЕНИЕ ПЕРЕОПРЕДЕЛЕНИЙ ИЗ КОНФИГУРАЦИИ ==========
    // Вызывается: при включении/выключении термальной модели
    // При активной модели пороги уменьшаются на 50%, таймауты увеличиваются в 2 раза
    void updateFromConfig(const Config& cfg) {
        if (thermalModelActive) {
            // Смягчаем пороги для предотвращения ложных срабатываний
            runawayMinHeaterRiseOverride = cfg.runawayMinHeaterRisePerMin * 0.5;   // В 2 раза ниже
            runawayMinAirRiseOverride = cfg.runawayMinAirRisePerMin * 0.5;         // В 2 раза ниже
            runawayMaxTimeToTargetOverride = cfg.runawayMaxTimeToTarget * 2;       // В 2 раза дольше
            runawayPhase1TimeOverride = cfg.runawayPhase1Time * 2;                 // В 2 раза дольше
            runawayPhase2TimeOverride = cfg.runawayPhase2Time * 2;                 // В 2 раза дольше
        } else {
            // Отключаем переопределения, используем стандартные пороги из конфигурации
            runawayMinHeaterRiseOverride = -1;
            runawayMinAirRiseOverride = -1;
            runawayMaxTimeToTargetOverride = -1;
            runawayPhase1TimeOverride = -1;
            runawayPhase2TimeOverride = -1;
        }
    }
} protectionOverride;  // Глобальный экземпляр переопределений защит

// ============================================================================
// ОБУЧАЕМАЯ ТЕРМАЛЬНАЯ МОДЕЛЬ (МАШИННОЕ ОБУЧЕНИЕ) v2
// ============================================================================

// Адаптивная модель тепловой динамики системы, обучающаяся в реальном времени
// Предсказывает температуру нагревателя и обнаруживает аномалии
// Требует предварительной адаптации (config.adaptationPerformed = true)
// Особенности:
//   - Рассчитана на релейное управление (power = 0.0 или 1.0, без ШИМ)
//   - Защищает нагреватель (heaterTemp), температура воздуха не используется
//   - Обучается ТОЛЬКО при активном нагреве (power > 0.01)
//   - coolingRate не обновляется онлайн (пассивный процесс, не контролируется)
//   - v2: Режим обучения — первые 5 минут только сбор данных, без ошибок
//   - v2: Уверенность растёт динамически, порог зависит от уверенности

struct AdaptiveThermalModel {
    // ========== КОЭФФИЦИЕНТЫ МОДЕЛИ ==========
    float heaterRate;           // Скорость нагрева в градусах Цельсия в минуту (диапазон 1-30)
    float coolingRate;          // Скорость охлаждения в градусах Цельсия в секунду (0.05-5.0)
                                // ВНИМАНИЕ: coolingRate задаётся только при адаптации и НЕ обновляется онлайн
    float noiseFloor;           // Базовый уровень шума системы в градусах Цельсия (0.1-5.0)
    
    // ========== СТАТИСТИКА ОБУЧЕНИЯ ==========
    int samplesCollected;       // Общее количество собранных обучающих сэмплов
    float totalError;           // Суммарная ошибка предсказаний (для расчёта средней)
    float maxError;             // Максимальная зафиксированная ошибка предсказания
    
    // ========== БУФЕР ОШИБОК (ДЛЯ СГЛАЖИВАНИЯ) ==========
    float recentErrors[10];     // Кольцевой буфер последних 10 ошибок предсказания
    int errorIndex;             // Текущий индекс для записи в буфер ошибок
    
    // ========== ВРЕМЕННЫЕ МЕТКИ ==========
    unsigned long lastSignificantUpdate;   // Время последнего значимого обновления коэффициентов (мс)
    unsigned long lastSaveTime;            // Время последнего автосохранения модели (мс)
    
    // ========== УВЕРЕННОСТЬ МОДЕЛИ ==========
    float confidence;           // Уверенность модели от 0.0 до 1.0 (растёт при малых ошибках)
    
    // ========== РЕЖИМ ОБУЧЕНИЯ (v2) ==========
    bool learningMode;          // true = только сбор данных, без выдачи ошибок
    unsigned long learningStartTime;  // Время начала фазы обучения (мс)
    
    // ========== ФЛАГИ СОСТОЯНИЯ ==========
    bool initialized;           // Инициализирована ли модель (коэффициенты загружены)
    bool learningEnabled;       // Разрешено ли онлайн-обучение (всегда true если модель активна)
    
    // ========== КОНСТРУКТОР ==========
    // Устанавливает значения по умолчанию (защитные, до прохождения адаптации)
    AdaptiveThermalModel() : heaterRate(15.0), coolingRate(0.5), noiseFloor(0.5),
        samplesCollected(0), totalError(0), maxError(0), errorIndex(0), lastSignificantUpdate(0),
        lastSaveTime(0), confidence(0.0), initialized(false), learningEnabled(true),
        learningMode(true), learningStartTime(0) {
        memset(recentErrors, 0, sizeof(recentErrors));  // Обнуляем буфер ошибок
    }
    
    // ========== ПОЛНЫЙ СБРОС МОДЕЛИ (v2) ==========
    // Сбрасывает ВСЕ коэффициенты и статистику к нулю
    // Вызывается: resetThermalModel(), initThermalModel() при холодном старте
    void reset() {
        heaterRate = 15.0;
        coolingRate = 0.5;
        noiseFloor = 0.5;
        samplesCollected = 0;
        totalError = 0;
        maxError = 0;
        errorIndex = 0;
        lastSignificantUpdate = 0;
        lastSaveTime = 0;
        confidence = 0.0;
        learningMode = true;
        learningStartTime = millis();
        initialized = false;
        memset(recentErrors, 0, sizeof(recentErrors));
    }
    
    // ========== ИНИЦИАЛИЗАЦИЯ ИЗ АДАПТАЦИИ ==========
    // Загружает коэффициенты из результатов адаптации (config.adapted*)
    // Вызывается: при включении термальной модели после успешной адаптации
    void initFromAdaptation() {
        heaterRate = config.adaptedHeaterRiseRate;
        if (heaterRate < 1.0) heaterRate = 15.0;           // Защита от некорректных значений
        coolingRate = config.adaptedCoolingRate;
        if (coolingRate < 0.1) coolingRate = 0.5;          // Минимальная скорость охлаждения
        noiseFloor = config.adaptedNoiseThreshold;
        if (noiseFloor < 0.1) noiseFloor = 0.5;            // Минимальный уровень шума
        confidence = 0.3;                                  // Начальная уверенность 30%
        samplesCollected = 0;
        totalError = 0;
        maxError = 0;
        errorIndex = 0;
        lastSignificantUpdate = millis();
        lastSaveTime = millis();
        learningMode = true;                               // Начинаем с обучения
        learningStartTime = millis();
        initialized = true;
        memset(recentErrors, 0, sizeof(recentErrors));
        LOG_INFO("Термальная модель инициализирована из адаптации (режим обучения)");
    }
    
    // ========== ОБУЧЕНИЕ МОДЕЛИ ==========
    // Обновляет коэффициент скорости нагрева на основе ошибки предсказания
    // Вызывается: checkThermalModel() каждые thermalModelCheckInterval мс
    // Параметры:
    //   - actualTemp: реальная температура нагревателя сейчас
    //   - expectedTemp: предсказанная температура (с предыдущего шага)
    //   - power: мощность нагревателя (0.0 = выкл, 1.0 = вкл, релейное управление)
    //   - fanSpeed: скорость вентилятора (0.0 = выкл, 1.0 = макс, информативно)
    //   - now: текущее время millis()
    // Особенности:
    //   - Обучается ТОЛЬКО при активном нагреве (power > 0.01)
    //   - coolingRate НЕ обновляется (пассивное охлаждение не контролируется моделью)
    //   - Использует экспоненциальное сглаживание для noiseFloor
    //   - Градиентный шаг коррекции heaterRate = 0.001 °C/мин (очень консервативный)
    void update(float actualTemp, float expectedTemp, float power, float fanSpeed, unsigned long now) {
        if (!initialized || !learningEnabled) return;
        
        // НЕ ОБУЧАЕМСЯ, ЕСЛИ НАГРЕВ ВЫКЛЮЧЕН (нет теплового воздействия)
        if (power < 0.01) return;
        
        float error = actualTemp - expectedTemp;    // Ошибка предсказания (+ = недогрев, - = перегрев)
        float absError = abs(error);
        
        // Сохраняем ошибку в кольцевой буфер (для скользящего среднего)
        recentErrors[errorIndex] = absError;
        errorIndex = (errorIndex + 1) % 10;
        
        // Вычисляем среднюю ошибку за последние 10 измерений
        float avgRecentError = 0;
        for (int i = 0; i < 10; i++) avgRecentError += recentErrors[i];
        avgRecentError /= 10.0;
        
        // Обновляем статистику
        samplesCollected++;
        totalError += absError;
        if (absError > maxError) maxError = absError;
        
        // Экспоненциальное сглаживание уровня шума (быстрая адаптация к выбросам)
        // Фильтр: 99.5% старого значения + 0.5% нового
        // Игнорируем аномально большие ошибки (> 5 * noiseFloor) как выбросы датчика
        if (absError < noiseFloor * 5) {
            noiseFloor = noiseFloor * 0.995 + absError * 0.005;
        }
        
        // Корректируем скорость нагрева только при значительной ошибке и достаточной уверенности
        // Условия:
        //   - Ошибка больше 2 * noiseFloor (статистически значимо)
        //   - Уверенность модели > 30% (есть накопленная статистика)
        if (absError > noiseFloor * 2 && confidence > 0.3) {
            // Градиентный шаг коррекции: 0.001 °C/мин на каждую итерацию
            // При интервале 2000 мс и типичной ошибке 2°C:
            //   За час: 3600/2 * 0.001 * 2 = 3.6 °C/мин скорректируется
            heaterRate += error * 0.001;
            heaterRate = constrain(heaterRate, 1.0, 150.0); 
            lastSignificantUpdate = now;
            
            // Адаптация уверенности модели на основе средней ошибки
            if (avgRecentError < noiseFloor * 1.5) {
                // Ошибки стабильно маленькие → повышаем уверенность
                if (confidence < 1.0) confidence += 0.001;
                if (confidence > 1.0) confidence = 1.0;
            } else {
                // Ошибки большие → снижаем уверенность (экспоненциально)
                confidence *= 0.99;;
                if (confidence < 0.1) confidence = 0.1;
            }
        }
        
        // Автосохранение модели в энергонезависимую память раз в 30 минут
        if (now - lastSaveTime > 1800000) { // 30 минут
            lastSaveTime = now;
            saveToPreferences();
            addNotificationToLog("💾 Термальная модель сохранена (уверенность " + String((int)(confidence * 100)) + "%)");
        }
    }
    
    // ========== СОХРАНЕНИЕ В ЭНЕРГОНЕЗАВИСИМУЮ ПАМЯТЬ ==========
    // Сохраняет текущие коэффициенты модели в Preferences (namespace "thermal")
    // Вызывается: автосохранение раз в час, при выключении модели, при сбросе
    void saveToPreferences() {
        if (!initialized) return;
        Preferences prefs;
        if (!prefs.begin("thermal", false)) return;
        prefs.putFloat("heaterRate", heaterRate);
        prefs.putFloat("coolingRate", coolingRate);
        prefs.putFloat("noiseFloor", noiseFloor);
        prefs.putFloat("confidence", confidence);
        prefs.putInt("samples", samplesCollected);
        prefs.putBool("learningMode", learningMode);
        prefs.putULong("learnStart", learningStartTime);
        prefs.putULong("lastUpdate", lastSignificantUpdate);
        prefs.end();
    }
    
    // ========== ЗАГРУЗКА ИЗ ЭНЕРГОНЕЗАВИСИМОЙ ПАМЯТИ ==========
    // Загружает ранее сохранённые коэффициенты модели
    // Вызывается: при включении термальной модели после перезагрузки
    // Если сохранённых данных нет — используются значения из адаптации
    void loadFromPreferences() {
        Preferences prefs;
        if (!prefs.begin("thermal", true)) return;
        
        heaterRate = prefs.getFloat("heaterRate", config.adaptedHeaterRiseRate);
        coolingRate = prefs.getFloat("coolingRate", config.adaptedCoolingRate);
        noiseFloor = prefs.getFloat("noiseFloor", config.adaptedNoiseThreshold);
        confidence = prefs.getFloat("confidence", 0.3);
        samplesCollected = prefs.getInt("samples", 0);
        learningMode = prefs.getBool("learningMode", true);
        learningStartTime = prefs.getULong("learnStart", millis());
        lastSignificantUpdate = prefs.getULong("lastUpdate", 0);
        prefs.end();
        
        // Валидация загруженных коэффициентов (защита от битых данных)
        if (heaterRate < 1.0 || heaterRate > 150.0) heaterRate = config.adaptedHeaterRiseRate;
        if (coolingRate < 0.05 || coolingRate > 5.0) coolingRate = config.adaptedCoolingRate;
        if (noiseFloor < 0.1 || noiseFloor > 5.0) noiseFloor = config.adaptedNoiseThreshold;
        if (confidence < 0.0 || confidence > 1.0) confidence = 0.3;
        
        initialized = true;
    }
    
    // ========== ПОЛУЧЕНИЕ СТАТУСА МОДЕЛИ (ДЛЯ API) ==========
    // Возвращает строку с текущими параметрами модели для веб-интерфейса
    // Используется: /api/thermal-status
    String getStatus() {
        if (!initialized) return "Не инициализирована";
        char buffer[256];
        snprintf(buffer, sizeof(buffer), 
                 "Уверенность: %.0f%%, Скорость: %.1f°C/мин, Охл: %.2f°C/сек, Шум: %.2f°C, Режим: %s", 
                 confidence * 100, heaterRate, coolingRate, noiseFloor,
                 learningMode ? "обучение" : "защита");
        return String(buffer);
    }
    
    // ========== СБРОС К ЗНАЧЕНИЯМ ИЗ АДАПТАЦИИ ==========
    // Сбрасывает обученные коэффициенты к исходным (из адаптации)
    // Вызывается: handleApiResetThermalModel()
    void resetToAdaptation() { 
        initFromAdaptation(); 
        saveToPreferences(); 
    }
    
    // ========== ПРЕДСКАЗАНИЕ ТЕМПЕРАТУРЫ ==========
    // Предсказывает температуру нагревателя через timeSeconds секунд
    // Вызывается: checkThermalModel(), addToTrendBuffer()
    // Параметры:
    //   - currentTemp: текущая температура нагревателя (°C)
    //   - targetTemp: целевая температура (для коррекции скорости вблизи цели)
    //   - power: мощность (0.0 или 1.0 для реле)
    //   - fanSpeed: скорость вентилятора (информативно, не используется в расчёте)
    //   - timeSeconds: горизонт предсказания в секундах
    // Возвращает: предсказанную температуру через timeSeconds
    // Формула: T_pred = T_current + (heaterRate/60 * время * мощность * коррекция_близости_к_цели)
    float predict(float currentTemp, float targetTemp, float power, float fanSpeed, float timeSeconds) {
        if (!initialized || power < 0.01) {
            return currentTemp;                      // Модель не готова или нагрев выключен
        }
        
        float ratePerSec = heaterRate / 60.0;        // Переводим °C/мин → °C/сек
                                                     // heaterRate >= 1.0 гарантировано constrain()
        
        // Коррекция скорости в зависимости от близости к целевой температуре
        // Физика: чем ближе к цели, тем медленнее растёт температура
        // (тепловое сопротивление растёт с уменьшением разницы температур)
        float tempDiffToTarget = targetTemp - currentTemp;
        float correction = 1.0;                      // По умолчанию полная скорость
        
        if (tempDiffToTarget < 10.0 && tempDiffToTarget > 0) {
            correction = tempDiffToTarget / 10.0;    // Линейное снижение при приближении к цели
        }
        if (correction < 0.3) correction = 0.3;      // Минимальная скорость 30% от номинала
        
        return currentTemp + (ratePerSec * timeSeconds * power * correction);
    }
} adaptiveModel;  // Глобальный экземпляр термальной модели (доступен из любого места)

// ============================================================================
// Errors - ПОЛНАЯ СИСТЕМА ОШИБОК
// ============================================================================

// Централизованная структура для управления всеми ошибками и состояниями системы
// Обеспечивает: обнаружение ошибок, подсчёт повторов, полную блокировку системы, автосброс
// Доступ: все задачи через глобальный экземпляр 'errors'

struct Errors {
    // ========== ФЛАГИ ОШИБОК (КРИТИЧЕСКИЕ) ==========
    bool criticalOverheat = false;      // Критический перегрев нагревателя (>criticalTemp)
    bool airOverheat = false;           // Перегрев воздуха в камере (>maxAirTemp)
    bool thermalRunaway = false;        // Thermal Runaway (слишком медленный нагрев)
    bool unexpectedHeat = false;        // Неожиданный нагрев при выключенном нагревателе
    bool thermalModelAnomaly = false;   // Критическое отклонение термальной модели
    
    // ========== ФЛАГИ ОШИБОК ДАТЧИКА НАГРЕВАТЕЛЯ (MAX6675) ==========
    bool ds18b20Disconnected = false;   // Датчик воздуха DS18B20 отключён (обрыв)
    bool max6675Disconnected = false;   // MAX6675 не отвечает по SPI
    bool max6675Noise = false;          // MAX6675 даёт шумные показания (скачки)
    bool max6675OutOfRange = false;     // Температура вне диапазона min/max
    bool max6675Unstable = false;       // Нестабильные показания (частые изменения)
    bool max6675Stuck = false;          // Зависание (температура не меняется длительное время)
    
    // ========== ФЛАГИ ОШИБОК ДАТЧИКА ВОЗДУХА (DS18B20) ==========
    bool airSensorNoise = false;        // Датчик воздуха шумит (скачки температуры)
    bool airSensorOutOfRange = false;   // Температура воздуха вне диапазона min/max
    bool airSensorUnstable = false;     // Нестабильные показания (большой размах)
    bool emergencyStop = false;         // Аварийная остановка (пользователь)

    // ========== СЧЁТЧИКИ ПОПЫТОК ВОССТАНОВЛЕНИЯ ДАТЧИКОВ ==========
    unsigned long max6675DisconnectedStart = 0;   // Время начала проблем с MAX6675
    unsigned long ds18b20DisconnectedStart = 0;   // Время начала проблем с DS18B20
    static const unsigned long SENSOR_RECOVERY_TIMEOUT = 15000; // 15 секунд
    
    // ========== ФЛАГИ ЛОГИРОВАНИЯ (ДЛЯ ПРЕДОТВРАЩЕНИЯ ДУБЛИРОВАНИЯ) ==========
    bool criticalOverheatLogged = false;
    bool airOverheatLogged = false;
    bool thermalRunawayLogged = false;
    bool unexpectedHeatLogged = false;
    bool ds18b20DisconnectedLogged = false;
    bool max6675DisconnectedLogged = false;
    bool max6675NoiseLogged = false;
    bool max6675OutOfRangeLogged = false;
    bool max6675UnstableLogged = false;
    bool max6675StuckLogged = false;
    bool airSensorNoiseLogged = false;
    bool airSensorOutOfRangeLogged = false;
    bool airSensorUnstableLogged = false;
    bool thermalModelAnomalyLogged = false;
    
    // ========== СЧЁТЧИКИ ПОВТОРОВ ОШИБОК ==========
    int criticalOverheatCount = 0;      // Количество перегревов нагревателя
    int airOverheatCount = 0;           // Количество перегревов воздуха
    int thermalRunawayCount = 0;        // Количество Thermal Runaway
    int unexpectedHeatCount = 0;        // Количество неожиданных нагревов
    int max6675DisconnectedCount = 0;   // Количество отключений MAX6675
    int max6675StuckCount = 0;          // Количество зависаний MAX6675
    int ds18b20DisconnectedCount = 0;   // Счётчик отключений DS18B20
    
    // ========== ВРЕМЕННЫЕ МЕТКИ ПОСЛЕДНИХ ОШИБОК ==========
    unsigned long lastCriticalOverheatTime = 0;
    unsigned long lastAirOverheatTime = 0;
    unsigned long lastThermalRunawayTime = 0;
    unsigned long lastUnexpectedHeatTime = 0;
    
    // ========== ВРЕМЯ БЛОКИРОВКИ ПОСЛЕ СРАБАТЫВАНИЯ ==========
    unsigned long thermalRunawayLockTime = 0;   // Время срабатывания Thermal Runaway (для автосброса)
    unsigned long unexpectedHeatLockTime = 0;   // Время срабатывания Unexpected Heat
    
    // ========== ПОЛНАЯ БЛОКИРОВКА СИСТЕМЫ ==========
    bool systemLocked = false;          // Флаг полной блокировки (требуется разблокировка паролем)
    unsigned long systemLockTime = 0;   // Время блокировки в миллисекундах
    String lockReason = "";             // Причина блокировки (текст с количеством ошибок)
    String lockErrorType = "";          // Тип ошибки: "overheat", "air_overheat", "thermal", etc.
    
    // ========== ВСПОМОГАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ ДЛЯ ВОССТАНОВЛЕНИЯ ==========
    int maxRecoverySuccessCount = 0;    // Счётчик успешных чтений после ошибки MAX6675
    bool protectionsDisabled = false;   // Флаг отключения защит (используется при адаптации)
    
    // ========== ДАННЫЕ ДЛЯ АНАЛИЗА СТАБИЛЬНОСТИ ДАТЧИКА ВОЗДУХА ==========
    float lastStableAirTemp = 25.0;     // Последняя стабильная температура воздуха
    int stableAirCounter = 0;           // Счётчик последовательных стабильных измерений
    float lastRawAirTemp = 25.0;        // Последнее сырое значение с датчика воздуха
    float airTempHistory[10] = {0};     // Кольцевой буфер истории температур (для анализа)
    int airHistoryIndex = 0;            // Текущий индекс в буфере истории
    bool airHistoryFilled = false;      // Флаг заполнения буфера истории
    int noiseCounter = 0;               // Счётчик обнаруженных шумов
    unsigned long lastUnstableLog = 0;  // Время последнего логирования нестабильности
    
    // ========== СБРОС ВСЕХ ФЛАГОВ ОШИБОК ==========
    // Вызывается: при разблокировке системы, при инициализации
    // Очищает всю структуру, восстанавливает начальные значения
    void clear() { 
        memset(this, 0, sizeof(Errors)); 
        lastStableAirTemp = 25.0; 
        lastRawAirTemp = 25.0; 
    }
    
    // ========== ПРОВЕРКА НАЛИЧИЯ ЛЮБОЙ ОШИБКИ ==========
    // Возвращает: true если есть хотя бы одна ошибка (критическая или предупреждение)
    bool hasError() {
        return criticalOverheat || airOverheat || thermalRunaway || unexpectedHeat || ds18b20Disconnected ||
               airSensorNoise || airSensorOutOfRange || airSensorUnstable || max6675Disconnected ||
               max6675Noise || max6675OutOfRange || max6675Unstable || max6675Stuck || emergencyStop;
    }
    
    // ========== ПРОВЕРКА НАЛИЧИЯ КРИТИЧЕСКОЙ ОШИБКИ ==========
    // Возвращает: true только для ошибок, требующих немедленного отключения нагрева
    bool hasCriticalError() {
        return criticalOverheat || airOverheat || thermalRunaway || unexpectedHeat || 
               max6675Disconnected || ds18b20Disconnected || thermalModelAnomaly;
    }
    
    // ========== ПРОВЕРКА БЛОКИРОВКИ СИСТЕМЫ ==========
    bool isSystemLocked() { 
        return systemLocked; 
    }
    
    // ========== ПОЛНАЯ БЛОКИРОВКА СИСТЕМЫ ==========
    // Вызывается: после превышения config.maxErrorRetries одинаковых ошибок
    // Сохраняет состояние в Preferences для восстановления после перезагрузки
    void lockSystem(String reason, String errorType) {
        // Добавляем в сообщение счётчик ошибок и максимально допустимое количество
        String fullReason = reason;
        if (errorType == "overheat") fullReason += " (" + String(criticalOverheatCount) + "/" + String(config.maxErrorRetries) + ")";
        else if (errorType == "air_overheat") fullReason += " (" + String(airOverheatCount) + "/" + String(config.maxErrorRetries) + ")";
        else if (errorType == "thermal") fullReason += " (" + String(thermalRunawayCount) + "/" + String(config.maxErrorRetries) + ")";
        else if (errorType == "unexpected_heat") fullReason += " (" + String(unexpectedHeatCount) + "/" + String(config.maxErrorRetries) + ")";
        else if (errorType == "max6675_stuck") fullReason += " (" + String(max6675StuckCount) + "/" + String(config.maxErrorRetries) + ")";
        else if (errorType == "max6675_disconnected") fullReason += " (" + String(max6675DisconnectedCount) + "/" + String(config.maxErrorRetries) + ")";
        else if (errorType == "ds18b20_disconnected") fullReason += " (" + String(ds18b20DisconnectedCount) + "/" + String(config.maxErrorRetries) + ")";
        
        lockReason = fullReason;
        lockErrorType = errorType;
        
        // ВАЖНО: логируем ДО установки systemLocked = true
        addErrorToLog("🔒 ПОЛНАЯ БЛОКИРОВКА! " + fullReason, true, true, config.maxErrorRetries);
        
        // Только теперь ставим флаг блокировки
        systemLocked = true;
        systemLockTime = millis();
        
        // Сохраняем состояние в энергонезависимую память
        Preferences prefs;
        if (!prefs.begin("flook", false)) return;
        prefs.putBool("systemLocked", true);
        prefs.putString("lockReason", fullReason);
        prefs.putULong("lockTime", systemLockTime);
        prefs.putString("lockErrorType", errorType);
        prefs.putInt("criticalOverheatCount", criticalOverheatCount);
        prefs.putInt("airOverheatCount", airOverheatCount);
        prefs.putInt("thermalRunawayCount", thermalRunawayCount);
        prefs.putInt("unexpectedHeatCount", unexpectedHeatCount);
        prefs.putInt("max6675DisconnectedCount", max6675DisconnectedCount);
        prefs.putInt("max6675StuckCount", max6675StuckCount);
        prefs.putInt("ds18b20DisconnectedCount", ds18b20DisconnectedCount);
        prefs.end();
    }
    
    // ========== РАЗБЛОКИРОВКА СИСТЕМЫ ==========
    // Вызывается: API /api/unlock при правильном пароле
    // Сбрасывает все счётчики и удаляет сохранённое состояние блокировки
    void unlockSystem() {
        systemLocked = false; 
        systemLockTime = 0; 
        lockReason = ""; 
        lockErrorType = "";
        criticalOverheatCount = 0; 
        airOverheatCount = 0; 
        thermalRunawayCount = 0;
        unexpectedHeatCount = 0; 
        max6675DisconnectedCount = 0; 
        max6675StuckCount = 0; 
        maxRecoverySuccessCount = 0;
        max6675DisconnectedStart = 0;  
        ds18b20DisconnectedStart = 0;  
        
        // Удаляем сохранённое состояние блокировки
        Preferences prefs;
        if (!prefs.begin("flook", false)) return;
        prefs.putBool("systemLocked", false);
        prefs.remove("lockReason"); 
        prefs.remove("lockTime"); 
        prefs.remove("lockErrorType");
        prefs.remove("criticalOverheatCount"); 
        prefs.remove("airOverheatCount");
        prefs.remove("thermalRunawayCount"); 
        prefs.remove("unexpectedHeatCount");
        prefs.remove("max6675DisconnectedCount"); 
        prefs.remove("max6675StuckCount");
        prefs.remove("ds18b20DisconnectedCount");
        prefs.end();
        
        addNotificationToLog("🔓 Система разблокирована");
    }
    
    // ========== ЗАГРУЗКА СОСТОЯНИЯ БЛОКИРОВКИ ПРИ ЗАПУСКЕ ==========
    // Вызывается: setup() после инициализации ошибок
    // Восстанавливает состояние после перезагрузки, если система была заблокирована
    void loadLockState() {
        Preferences prefs;
        if (!prefs.begin("flook", true)) return;
        
        systemLocked = prefs.getBool("systemLocked", false);
        if (systemLocked) {
            lockReason = prefs.getString("lockReason", "Причина неизвестна");
            systemLockTime = prefs.getULong("lockTime", millis());
            lockErrorType = prefs.getString("lockErrorType", "");
            criticalOverheatCount = prefs.getInt("criticalOverheatCount", 0);
            airOverheatCount = prefs.getInt("airOverheatCount", 0);
            thermalRunawayCount = prefs.getInt("thermalRunawayCount", 0);
            unexpectedHeatCount = prefs.getInt("unexpectedHeatCount", 0);
            max6675DisconnectedCount = prefs.getInt("max6675DisconnectedCount", 0);
            max6675StuckCount = prefs.getInt("max6675StuckCount", 0);
            ds18b20DisconnectedCount = prefs.getInt("ds18b20DisconnectedCount", 0);
        }
        prefs.end();
    }
    
    // ========== ПОЛУЧЕНИЕ ТЕКСТА СООБЩЕНИЯ О БЛОКИРОВКЕ ==========
    // Возвращает: сформированное сообщение с причиной и временем блокировки
    // Используется: API /api/all, WebSocket метрики
    String getLockMessage() {
        if (!systemLocked) return "";
        
        unsigned long now = millis();
        
        // Форматируем время с момента блокировки
        unsigned long diff = now - systemLockTime;
        unsigned long minutes = diff / 60000UL;
        String timeStr = (minutes < 1) ? "только что" : 
                        (minutes < 60) ? String(minutes) + " мин назад" : 
                        String(minutes / 60) + " ч " + String(minutes % 60) + " мин назад";
        
        // Возвращаем сообщение в зависимости от типа ошибки
        if (criticalOverheatCount >= config.maxErrorRetries) 
            return "🔒 Многократный перегрев нагревателя (" + String(criticalOverheatCount) + "/" + String(config.maxErrorRetries) + ", " + timeStr + ")";
        if (airOverheatCount >= config.maxErrorRetries) 
            return "🔒 Многократный перегрев воздуха (" + String(airOverheatCount) + "/" + String(config.maxErrorRetries) + ", " + timeStr + ")";
        if (thermalRunawayCount >= config.maxErrorRetries) 
            return "🔒 Многократный Thermal Runaway (" + String(thermalRunawayCount) + "/" + String(config.maxErrorRetries) + ", " + timeStr + ")";
        if (unexpectedHeatCount >= config.maxErrorRetries) 
            return "🔒 Многократный неожиданный нагрев (" + String(unexpectedHeatCount) + "/" + String(config.maxErrorRetries) + ", " + timeStr + ")";
        if (max6675DisconnectedCount >= config.maxErrorRetries) 
            return "🔒 MAX6675 постоянно неисправен (" + String(max6675DisconnectedCount) + "/" + String(config.maxErrorRetries) + ", " + timeStr + ")";
        if (max6675StuckCount >= config.maxErrorRetries) 
            return "🔒 MAX6675 завис (" + String(max6675StuckCount) + "/" + String(config.maxErrorRetries) + ", " + timeStr + ")";

        if (max6675DisconnectedCount >= config.maxErrorRetries) 
            return "🔒 MAX6675 не отвечает (" + String(max6675DisconnectedCount) + "/" + String(config.maxErrorRetries) + ", " + timeStr + ")";
        if (ds18b20DisconnectedCount >= config.maxErrorRetries) 
            return "🔒 DS18B20 не отвечает (" + String(ds18b20DisconnectedCount) + "/" + String(config.maxErrorRetries) + ", " + timeStr + ")";
        
        if (lockErrorType == "max6675_disconnected")
            return "🔒 MAX6675 не отвечает " + String(SENSOR_RECOVERY_TIMEOUT / 1000) + " сек";
        if (lockErrorType == "ds18b20_disconnected")
            return "🔒 DS18B20 не отвечает " + String(SENSOR_RECOVERY_TIMEOUT / 1000) + " сек";
        
        return "🔒 Аварийная блокировка (" + timeStr + ")";
    }
    
    // ========== АВТОМАТИЧЕСКИЙ СБРОС ОШИБОК ПРИ ВОССТАНОВЛЕНИИ ==========
    // Вызывается: webTask по таймеру timerErrorCheck (каждые 5 секунд)
    // Сбрасывает ошибки если условия их вызвавшие устранены
    // Блокирует систему при длительном отсутствии датчиков (15 секунд)
    void checkAutoClear() {
        unsigned long now = millis();
        
        // ========== 1. АВТОСБРОС THERMAL RUNAWAY ==========
        if (thermalRunaway && !systemLocked && thermalRunawayLockTime > 0 && 
            now - thermalRunawayLockTime > (unsigned long)config.runawayRecoveryTimeout * 1000UL) {
            thermalRunaway = false; 
            thermalRunawayLogged = false; 
            thermalRunawayLockTime = 0; 
            runawayTriggered = false;
            addNotificationToLog("✅ Thermal Runaway автоматически снят");
        }
        
        // ========== 2. АВТОСБРОС НЕОЖИДАННОГО НАГРЕВА ==========
        if (unexpectedHeat && !systemLocked) {
            float safetyThreshold = config.maxHeaterTemp - config.unexpectedHeatThreshold - config.unexpectedHeatSafeOffset;
            if (heaterTemp < safetyThreshold) {
                if (unexpectedHeatLockTime == 0) unexpectedHeatLockTime = now;
                else if (now - unexpectedHeatLockTime > (unsigned long)config.unexpectedHeatClearTime) {
                    unexpectedHeat = false; 
                    unexpectedHeatLogged = false; 
                    unexpectedHeatLockTime = 0; 
                    runawayTriggered = false;
                    addNotificationToLog("✅ Неожиданный нагрев устранён автоматически");
                }
            } else {
                unexpectedHeatLockTime = 0;  // Сбрасываем таймер если температура поднялась
            }
        }
        
        // ========== 3. БЛОКИРОВКА ПРИ ДОЛГОМ ОТСУТСТВИИ MAX6675 ==========
        // Если датчик отключён более SENSOR_RECOVERY_TIMEOUT (15 сек) — блокировка системы.
        // При восстановлении датчика (readMAX6675Temperature сбрасывает флаг) таймер обнуляется.
        if (max6675Disconnected && !systemLocked) {
            if (max6675DisconnectedStart == 0) {
                max6675DisconnectedStart = now;              // Запоминаем время начала проблем
            } else if (now - max6675DisconnectedStart >= SENSOR_RECOVERY_TIMEOUT) {
                lockSystem("Датчик нагревателя (MAX6675) не отвечает " + 
                        String(SENSOR_RECOVERY_TIMEOUT / 1000) + " сек", 
                        "max6675_disconnected");
                max6675DisconnectedStart = 0;
            }
        } else if (!max6675Disconnected) {
            max6675DisconnectedStart = 0;                    // Датчик работает — сбрасываем таймер
        }
        
        // ========== 4. БЛОКИРОВКА ПРИ ДОЛГОМ ОТСУТСТВИИ DS18B20 ==========
        // Если датчик отключён более SENSOR_RECOVERY_TIMEOUT (15 сек) — блокировка системы.
        // При восстановлении датчика (sensorTask сбрасывает флаг) таймер обнуляется.
        if (ds18b20Disconnected && !systemLocked) {
            if (ds18b20DisconnectedStart == 0) {
                ds18b20DisconnectedStart = now;              // Запоминаем время начала проблем
            } else if (now - ds18b20DisconnectedStart >= SENSOR_RECOVERY_TIMEOUT) {
                lockSystem("Датчик воздуха (DS18B20) не отвечает " + 
                        String(SENSOR_RECOVERY_TIMEOUT / 1000) + " сек", 
                        "ds18b20_disconnected");
                ds18b20DisconnectedStart = 0;
            }
        } else if (!ds18b20Disconnected) {
            ds18b20DisconnectedStart = 0;                    // Датчик работает — сбрасываем таймер
        }
    }
    
    // ========== ПРОВЕРКА И ЛОГИРОВАНИЕ АКТИВНЫХ ОШИБОК ==========
    // Вызывается: webTask по таймеру timerErrorCheck
    // Логирует каждую активную ошибку (один раз при возникновении)
    void checkAndLogErrors() {
        unsigned long now = millis();
        
        // Критические ошибки
        if (criticalOverheat && !criticalOverheatLogged) {
            addErrorToLog("⚠️ КРИТИЧЕСКИЙ ПЕРЕГРЕВ НАГРЕВАТЕЛЯ! T=" + String(heaterTemp, 1) + "°C", true, true, criticalOverheatCount);
            criticalOverheatLogged = true;
        }
        if (airOverheat && !airOverheatLogged) {
            addErrorToLog("⚠️ ПЕРЕГРЕВ ВОЗДУХА! T=" + String(airTemp, 1) + "°C > " + String(config.maxAirTemp, 1) + "°C", true, true, airOverheatCount);
            airOverheatLogged = true;
        }
        if (thermalRunaway && !thermalRunawayLogged) {
            addErrorToLog("⚠️ THERMAL RUNAWAY: нагрев слишком медленный", true, true, thermalRunawayCount);
            thermalRunawayLogged = true;
        }
        if (unexpectedHeat && !unexpectedHeatLogged) {
            addErrorToLog("⚠️ АВАРИЯ! Температура не падает при выключенном нагревателе", true, true, unexpectedHeatCount);
            unexpectedHeatLogged = true;
        }

        // Термальная модель
        if (thermalModelAnomaly && !thermalModelAnomalyLogged) {
            addErrorToLog("🔥 Термальная модель: критическое отклонение", true, true, 0);
            thermalModelAnomalyLogged = true;
        }
        
        // Ошибки датчиков
        if (ds18b20Disconnected && !ds18b20DisconnectedLogged) {
            addErrorToLog("❌ Датчик воздуха DS18B20 отключён", true, false, 0);
            ds18b20DisconnectedLogged = true;
        }
        if (max6675Disconnected && !max6675DisconnectedLogged) {
            addErrorToLog("❌ MAX6675 неисправен", true, true, max6675DisconnectedCount);
            max6675DisconnectedLogged = true;
        }
        if (max6675Stuck && !max6675StuckLogged) {
            addErrorToLog("⚠️ MAX6675 завис (нет изменений температуры)", true, true, max6675StuckCount);
            max6675StuckLogged = true;
        }
        
        // Предупреждения
        if (max6675Noise && !max6675NoiseLogged) {
            addErrorToLog("⚠️ MAX6675 даёт нестабильные показания", false, true, 0);
            max6675NoiseLogged = true;
        }
        if (max6675Unstable && !max6675UnstableLogged) {
            addErrorToLog("⚠️ Нестабильные показания MAX6675", false, true, 0);
            max6675UnstableLogged = true;
        }
        if (max6675OutOfRange && !max6675OutOfRangeLogged) {
            addErrorToLog("⚠️ Температура нагревателя вне допустимого диапазона: " + String(heaterTemp, 1) + "°C", false, true, 0);
            max6675OutOfRangeLogged = true;
        }
        if (airSensorNoise && !airSensorNoiseLogged) {
            addErrorToLog("⚠️ Датчик воздуха даёт нестабильные показания", false, true, 0);
            airSensorNoiseLogged = true;
        }
        if (airSensorUnstable && !airSensorUnstableLogged) {
            addErrorToLog("⚠️ Нестабильные показания датчика воздуха", false, true, 0);
            airSensorUnstableLogged = true;
        }
        if (airSensorOutOfRange && !airSensorOutOfRangeLogged) {
            addErrorToLog("⚠️ Температура воздуха вне допустимого диапазона: " + String(airTemp, 1) + "°C", false, true, 0);
            airSensorOutOfRangeLogged = true;
        }
    }
    
    // ========== ПОЛУЧЕНИЕ КРАТКОГО СООБЩЕНИЯ О ТЕКУЩЕЙ ОШИБКЕ ==========
    // Возвращает: короткую строку с самой приоритетной активной ошибкой
    // Используется: WebSocket метрики, LED индикация
    String getMessage() {
        if (systemLocked) return "🔒 СИСТЕМА ЗАБЛОКИРОВАНА: " + lockReason;
        
        String msg = "Ошибок нет";
        if (criticalOverheat) msg = "🔥 КРИТИЧЕСКИЙ ПЕРЕГРЕВ НАГРЕВАТЕЛЯ!";
        else if (airOverheat) msg = "🔥 ПЕРЕГРЕВ ВОЗДУХА!";
        else if (thermalRunaway) msg = "🔥 THERMAL RUNAWAY";
        else if (unexpectedHeat) msg = "🔥 АВАРИЯ: температура не падает";
        else if (ds18b20Disconnected) msg = "❌ Датчик воздуха отключён";
        else if (max6675Disconnected) msg = "❌ MAX6675 неисправен";
        else if (max6675Stuck) msg = "❌ MAX6675 завис";
        else if (max6675Noise) msg = "⚠️ Нестабильные показания MAX6675";
        else if (max6675Unstable) msg = "⚠️ Нестабильные показания MAX6675";
        else if (max6675OutOfRange) msg = "⚠️ Температура нагревателя вне диапазона";
        else if (airSensorNoise) msg = "⚠️ Нестабильные показания датчика воздуха";
        else if (airSensorOutOfRange) msg = "⚠️ Температура воздуха вне диапазона";
        else if (airSensorUnstable) msg = "⚠️ Нестабильные показания датчика воздуха";
        
        return msg;
    }
} errors;  // Глобальный экземпляр системы ошибок (доступен из любого места)

// ============================================================================
// ТАБЛИЦА СООТВЕТСТВИЯ ТЕМПЕРАТУРЫ ВОЗДУХА И DUTY ВЕНТИЛЯТОРА
// ============================================================================

// Структура для хранения одной точки таблицы зависимости мощности вентилятора от температуры воздуха
// Используется: при автоограничении мощности вентилятора для плавного управления
struct DutyTableEntry {
    float airTemp;      // Температура воздуха в градусах Цельсия (ключ)
    int duty;           // Соответствующее значение ШИМ вентилятора (0-1023)
};

DutyTableEntry dutyTable[MAX_DUTY_TABLE_SIZE];  // Массив таблицы (максимум 20 точек)
int dutyTableSize = 0;                          // Текущий размер таблицы (количество заполненных точек)
                                                // Точки автоматически сортируются по температуре при добавлении
                                                // Используется линейная интерполяция между точками

// ============================================================================
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
// ============================================================================

// ========== ЭКРАНИРОВАНИЕ СПЕЦИАЛЬНЫХ СИМВОЛОВ ДЛЯ JSON ==========
// Преобразует строку в JSON-совместимый вид, экранируя кавычки, обратные слеши и управляющие символы
// Используется: при формировании JSON ответов API для безопасного включения произвольных строк
// Вызывается: handleApiErrorLog(), handleApiAdaptationStatus()
String escapeJsonString(const String& input) {
    String output = "";
    for (char c : input) {
        if (c == '"') output += "\\\"";       // Экранирование двойной кавычки
        else if (c == '\\') output += "\\\\"; // Экранирование обратного слеша
        else if (c == '\n') output += "\\n";  // Замена перевода строки
        else if (c == '\r') output += "\\r";  // Замена возврата каретки
        else if (c == '\t') output += "\\t";  // Замена табуляции
        else output += c;
    }
    return output;
}

// ========== СБРОС БЛОКИРОВКИ АДАПТАЦИИ ==========
// Сбрасывает флаги, запрещающие запуск адаптации
// Вызывается: startAdaptation(), используется для очистки предыдущих причин блокировки
void resetAdaptationBlock() { 
    adaptationBlocked = false;      // Снимаем блокировку
    adaptationBlockReason = "";     // Очищаем причину блокировки
}

// ========== ПОЛУЧЕНИЕ АДАПТИВНОГО ПОРОГА СКАЧКА ТЕМПЕРАТУРЫ ==========
// Возвращает допустимый порог скачка температуры в зависимости от режима работы
// Используется: для фильтрации выбросов MAX6675
// Логика: если нагреватель выключен → низкий порог (5°C)
//         если далеко от цели → высокий порог (15°C) для пропуска стартовых скачков
//         если близко к цели → средний порог (3°C) для точного контроля
// Вызывается: readMAX6675Temperature() (косвенно, через макросы фильтрации)
float getAdaptiveJumpThreshold() {
    if (!heaterState) return 5.0;   // Нагрев выключен → температура стабильна, порог низкий
    if (abs(heaterTemp - targetTemp) > 10) return 15.0;  // Далеко от цели → возможны большие скачки
    return 3.0;                     // Близко к цели → нужна высокая точность
}

// ========== ВЫЧИСЛЕНИЕ ХЕША СООБЩЕНИЯ (АЛГОРИТМ DJB2) ==========
// Реализует простой и быстрый хеш-алгоритм для дедупликации повторяющихся ошибок
// Параметры: message - входная строка переменной длины
// Возвращает: 32-битный хеш (коллизии маловероятны, но возможны)
// Используется: addErrorToLog() для определения повторяющихся ошибок
// Вызывается: при каждом добавлении ошибки в журнал
uint32_t calculateErrorHash(const String& message) {
    uint32_t hash = 5381;                      // Инициализация хеша (магическое число)
    for (size_t i = 0; i < message.length(); i++) {
        hash = ((hash << 5) + hash) + message[i];  // hash * 33 + c (DJB2 algorithm)
    }
    return hash;
}

// ============================================================================
// УПРАВЛЕНИЕ ВЕНТИЛЯТОРОМ (PWM)
// ============================================================================

// ========== ИНИЦИАЛИЗАЦИЯ АППАРАТНОГО ШИМ ==========
// Настраивает LEDC (LED Control) периферию ESP32 для генерации ШИМ-сигнала
// Частота: 17 кГц (за пределами слышимости человека, не издаёт писк)
// Разрешение: 10 бит (0-1023, шаг ~0.1%)
// Канал: 0, таймер: 0
// Вызывается: setup() один раз при запуске
void initFanPWM() {
    #ifdef ESP32
    // Настройка таймера LEDC
    ledc_timer_config_t ledc_timer = {
        .speed_mode = LEDC_LOW_SPEED_MODE,    // Низкоскоростной режим (до 40 МГц)
        .duty_resolution = LEDC_TIMER_10_BIT, // 10-битное разрешение (0-1023)
        .timer_num = LEDC_TIMER_0,            // Используем таймер 0
        .freq_hz = DEFAULT_FAN_PWM_FREQ,      // Частота из константы (17 кГц, ультразвук)
        .clk_cfg = LEDC_AUTO_CLK              // Автоматический выбор источника тактирования
    };
    ledc_timer_config(&ledc_timer);
    
    // Настройка канала LEDC
    ledc_channel_config_t ledc_channel = {
        .gpio_num = config.pinFan,           // Пин вентилятора (из конфигурации)
        .speed_mode = LEDC_LOW_SPEED_MODE,   // Низкоскоростной режим
        .channel = LEDC_CHANNEL_0,           // Используем канал 0
        .intr_type = LEDC_INTR_DISABLE,      // Прерывания не нужны
        .timer_sel = LEDC_TIMER_0,           // Привязываем к таймеру 0
        .duty = 0,                           // Начальный duty = 0 (выключен)
        .hpoint = 0                          // Точка сравнения (не используется)
    };
    ledc_channel_config(&ledc_channel);
    #endif
    
    // Инициализация глобальных переменных состояния вентилятора
    actualFanDuty = 0;              // Текущий duty (0-1023)
    fanState = false;               // Вентилятор выключен
    fanForcedByError = false;       // Нет форсирования по ошибке
}

// ========== УСТАНОВКА МОЩНОСТИ ВЕНТИЛЯТОРА (DUTY) ==========
// Устанавливает мощность вентилятора, преобразуя duty в ШИМ-сигнал
// Диапазон: 0 = выключен, 1023 = 100% мощность
// Поддерживает инверсию сигнала (для NPN/PNP ключей)
// Вызывается: updateFan(), forceFanFullSpeed(), restoreFanNormalMode()
void setFanDuty(int duty) {
    duty = constrain(duty, 0, 1023);        // Ограничиваем диапазон
    
    #ifdef ESP32
    int finalDuty = duty;
    if (config.invertFanSignal) {
        finalDuty = 1023 - duty;            // Инвертируем сигнал
    }
    ledc_set_duty(LEDC_LOW_SPEED_MODE, LEDC_CHANNEL_0, finalDuty);
    ledc_update_duty(LEDC_LOW_SPEED_MODE, LEDC_CHANNEL_0);
    #endif
    
    // Обновляем глобальные переменные состояния
    actualFanDuty = duty;                   // Для отображения в API и WebSocket
    fanState = (duty > 0);                  // Флаг вращения (логическое состояние)
    
    LOG_DEBUG("setFanDuty: duty=%d, fanState=%d", duty, fanState);
}

// ========== ПРОВЕРКА НАЛИЧИЯ АКТИВНОЙ КРИТИЧЕСКОЙ ОШИБКИ ==========
// Объединяет все возможные источники критических состояний
// Возвращает: true если требуется немедленное отключение нагрева и включение вентилятора на 100%
// Используется: updateFan(), updateHeaterControl()
bool isCriticalErrorActive() {
    return errors.criticalOverheat ||              // Перегрев нагревателя
           errors.airOverheat ||                   // Перегрев воздуха
           errors.thermalRunaway ||                // Thermal Runaway
           errors.unexpectedHeat ||                // Неожиданный нагрев
           errors.max6675Disconnected ||           // Отключение MAX6675
           errors.max6675Stuck ||                  // Зависание MAX6675
           errors.ds18b20Disconnected ||           // Отключение DS18B20
           errors.isSystemLocked() ||              // Полная блокировка системы
           errors.thermalModelAnomaly ||           // Критическое отклонение термальной модели
           criticalOverheatLock ||                 // Флаг блокировки перегрева
           airOverheatLock ||                      // Флаг блокировки перегрева воздуха
           runawayTriggered ||                     // Срабатывание Thermal Runaway
           (heaterTemp >= config.criticalTemp) ||  // Превышение критической температуры нагревателя
           (airTemp >= config.maxAirTemp);         // Превышение максимальной температуры воздуха
}

// ========== ФОРСИРОВАНИЕ ВЕНТИЛЯТОРА НА ПОЛНУЮ МОЩНОСТЬ ==========
// Включает вентилятор на 100% при критических ошибках
// Сохраняет предыдущее состояние для последующего восстановления
// Вызывается: checkHeaterOverheat(), checkAirOverheat(), checkUnexpectedHeat(), checkThermalRunaway()
void forceFanFullSpeed() {
    if (!fanForcedByError) {
        // Сохраняем текущее состояние перед форсированием
        savedFanState = fanState;           // Сохраняем был ли включён вентилятор
        fanStateSaved = true;               // Отмечаем что состояние сохранено
        fanForcedByError = true;            // Устанавливаем флаг форсирования
        LOG_WARN("ФОРСИРОВАНИЕ: вентилятор на 100% (сохранено состояние)");
    }
    setFanDuty(1023);                       // Устанавливаем 100% мощность
}

// ========== ВОССТАНОВЛЕНИЕ НОРМАЛЬНОГО РЕЖИМА ВЕНТИЛЯТОРА ==========
// Сбрасывает форсирование и выключает вентилятор.
// Дальнейшее управление передаётся updateFan(), который сам решит,
// нужно ли включать вентилятор по текущей температуре.
void restoreFanNormalMode() {
    if (!fanForcedByError) return;
    fanForcedByError = false;
    fanStateSaved = false;
    setFanDuty(0);
    fanState = false;
}

// ========== ОСНОВНАЯ ЛОГИКА УПРАВЛЕНИЯ ВЕНТИЛЯТОРОМ ==========
// Вызывается: controlTask по таймеру fanControlInterval (1000 мс)
// Реализует полный цикл управления вентилятором:
//   - Обработка критических ошибок (форсированный режим 100%)
//   - Гистерезис восстановления после ошибок (fanMinOnTime)
//   - Включение по порогу температуры
//   - Выключение с гистерезисом и минимальным временем работы
//   - Динамическая коррекция мощности для поддержания maxHeaterTemp
//   - Автоограничение мощности (опционально)
void updateFan() {
    if (!fanControlEnabled) return;          // Запрет управления (на время адаптации)
    
    unsigned long now = millis();
    
    // ========== 1. СИСТЕМА ЗАБЛОКИРОВАНА ==========
    // При полной блокировке вентилятор всегда 100%, без изменений
    if (errors.isSystemLocked()) {
        if (actualFanDuty != 1023) setFanDuty(1023);
        return;
    }
    
    // ========== 2. КРИТИЧЕСКИЕ ОШИБКИ (ДО БЛОКИРОВКИ) ==========
    // При любой критической ошибке однократно включаем вентилятор на 100%
    // Кроме Thermal Runaway с отключенным форсированием (runawayFanOn = false)
    if (isCriticalErrorActive()) {
        // Если Thermal Runaway, но форсирование вентилятора отключено пользователем — пропускаем
        if (errors.thermalRunaway && !config.runawayFanOn) {
            return;
        }
        if (!fanForcedByError) {
            forceFanFullSpeed();
        }
        return;
    }
    
    // ========== 3. ВОССТАНОВЛЕНИЕ ПОСЛЕ ОШИБКИ С ГИСТЕРЕЗИСОМ ==========
    // Ошибок нет, но вентилятор был форсирован — ждём fanMinOnTime перед восстановлением.
    // Это предотвращает дёргание вентилятора при перемежающихся ошибках датчиков.
    // ВАЖНО: проверяем, что критических ошибок действительно нет
    if (fanForcedByError && !isCriticalErrorActive()) {
        static unsigned long forceEndTime = 0;
        if (forceEndTime == 0) forceEndTime = now;
        if (now - forceEndTime < (unsigned long)config.fanMinOnTime * 1000UL) return;
        forceEndTime = 0;
        restoreFanNormalMode();
    }
    
    // ========== 4. ПОРОГИ ВКЛЮЧЕНИЯ/ВЫКЛЮЧЕНИЯ ==========
    float fanOffThreshold = config.fanOnTemp - config.fanOffHysteresis;
    
    // ========== 5. НАГРЕВ ВЫКЛЮЧЕН ИЛИ ЦЕЛЕВАЯ ТЕМПЕРАТУРА 0 ==========
    // Режим охлаждения: если выключен нагрев, но температура высокая
    if (!heaterState || targetTemp <= 0) {
        // Если температура превышает порог включения - включаем вентилятор на 100% для охлаждения
        if (heaterTemp >= config.fanOnTemp) {
            if (actualFanDuty != 1023) setFanDuty(1023);
        }
        // Если температура упала ниже порога выключения и отработал min время - выключаем
        else if (fanState && heaterTemp <= fanOffThreshold && 
                 (now - fanTurnedOnTime >= config.fanMinOnTime * 1000UL)) {
            setFanDuty(0);
            targetReachedFlag = false;
        }
        return;
    }
    
    // ========== 6. ВКЛЮЧЕНИЕ ВЕНТИЛЯТОРА ==========
    // При превышении порога fanOnTemp включаем вентилятор
    if (!fanState && heaterTemp >= config.fanOnTemp) {
        // Выбор начальной мощности: из таблицы или максимальная
        if (config.enableFanAutoLimit && dutyTableSize > 0) {
            currentDynamicDuty = getStartupDutyByAirTemp(airTemp);
        } else {
            currentDynamicDuty = config.maxFanDuty;
        }
        
        setFanDuty(currentDynamicDuty);
        fanTurnedOnTime = now;
        lastDutyAdjustTime = now;
        targetReachedFlag = false;
        return;
    }
    
    // ========== 7. РАБОТА ВЕНТИЛЯТОРА (уже включён) ==========
    if (fanState) {
        
        // === ВЫКЛЮЧЕНИЕ ВЕНТИЛЯТОРА ===
        // При падении температуры ниже порога и отработке мин. времени
        if (heaterTemp <= fanOffThreshold && 
            (now - fanTurnedOnTime >= config.fanMinOnTime * 1000UL)) {
            setFanDuty(0);
            currentDynamicDuty = 0;
            targetReachedFlag = false;
            return;
        }
        
        // ========== ЕСЛИ АВТООГРАНИЧЕНИЕ ВЫКЛЮЧЕНО ==========
        // Просто держим вентилятор на максимальной мощности
        if (!config.enableFanAutoLimit) {
            if (currentDynamicDuty != config.maxFanDuty) {
                currentDynamicDuty = config.maxFanDuty;
                setFanDuty(currentDynamicDuty);
            }
            return;
        }
        
        // ========== ОЖИДАНИЕ ДОСТИЖЕНИЯ MAXHEATERTEMP ==========
        // Пока температура не достигла максимальной, не корректируем мощность
        // Проверяем "застревание" температуры (30 секунд без изменений) → считаем цель достигнутой
        if (!targetReachedFlag && heaterTemp < config.maxHeaterTemp) {
            static unsigned long lastTempCheck = 0;
            static float stuckTemp = 0;
            
            if (now - lastTempCheck > 30000) {           // Каждые 30 секунд
                lastTempCheck = now;
                if (abs(heaterTemp - stuckTemp) < 1.0) { // Изменение менее 1°C
                    targetReachedFlag = true;            // Считаем что цель достигнута
                }
                stuckTemp = heaterTemp;
            }
        }
        
        // При достижении максимальной температуры переходим в режим поддержания
        if (!targetReachedFlag && heaterTemp >= config.maxHeaterTemp) {
            targetReachedFlag = true;
        }
        
        // ========== ПЛАВНАЯ КОРРЕКТИРОВКА DUTY (ПОДДЕРЖАНИЕ MAXHEATERTEMP) ==========
        // Работает только после достижения целевой температуры
        if (targetReachedFlag && config.enableFanAutoLimit) {
            // Проверяем интервал между корректировками
            if (now - lastDutyAdjustTime >= (unsigned long)config.fanAutoLimitCheckInterval) {
                lastDutyAdjustTime = now;
                
                int newDuty = currentDynamicDuty;
                float error = heaterTemp - config.maxHeaterTemp;  // Ошибка относительно максимума
                
                // Коррекция мощности: если температура превышает порог - увеличиваем мощность
                if (error > config.fanAutoLimitHysteresis) {
                    newDuty = min(1023, currentDynamicDuty + config.fanAutoLimitAdjustStep);
                }
                // Если температура ниже порога - уменьшаем мощность (экономия)
                else if (error < -config.fanAutoLimitHysteresis) {
                    newDuty = max(config.fanAutoLimitMinDuty, currentDynamicDuty - config.fanAutoLimitAdjustStep);
                }
                
                // Применяем новую мощность если она изменилась
                if (newDuty != currentDynamicDuty) {
                    currentDynamicDuty = newDuty;
                    setFanDuty(currentDynamicDuty);
                }
            }
        }
    }
}

// ============================================================================
// СТРУКТУРА СОСТОЯНИЯ MOONRAKER
// ============================================================================

// Хранит состояние подключения к Moonraker для избежания скрытых статических переменных
// Позволяет отслеживать ошибки подключения и автоматически переподключаться
// Обновляется: fetchPrintStatus() при каждом запросе статуса печати
struct MoonrakerState {
    bool discoveryAttempted = false;    // Была ли попытка обнаружения Moonraker
    uint8_t consecutiveErrors = 0;      // Счётчик последовательных ошибок (3 ошибки → сброс discovery)
    bool wasPrinting = false;           // Предыдущее состояние печати (для детекции изменений)
    unsigned long lastFetchTime = 0;    // Время последнего запроса к Moonraker (защита от частых запросов)
    
    // ========== СБРОС СОСТОЯНИЯ ПРИ ПОТЕРЕ СВЯЗИ ==========
    // Вызывается: при 3 последовательных ошибках подключения
    // Очищает хост Moonraker и разрешает повторный поиск
    void reset() {
        moonrakerHost = "";             // Сбрасываем сохранённый адрес Moonraker
        discoveryAttempted = false;     // Разрешаем новый поиск
        consecutiveErrors = 0;          // Обнуляем счётчик ошибок
    }
    
    // ========== ФИКСАЦИЯ ОШИБКИ ПОДКЛЮЧЕНИЯ ==========
    // Вызывается: при неудачном HTTP запросе к Moonraker
    // При накоплении 3 ошибок подряд → автоматический сброс discovery
    void recordError() {
        consecutiveErrors++;
        if (consecutiveErrors >= 3) {
            reset();                    // Переподключаемся заново
            LOG_WARN("Moonraker: 3 ошибки подряд, сброс подключения");
        }
    }
    
    // ========== ФИКСАЦИЯ УСПЕШНОГО ЗАПРОСА ==========
    // Вызывается: при успешном HTTP запросе к Moonraker
    // Сбрасывает счётчик ошибок (успешный запрос восстанавливает доверие)
    void recordSuccess() {
        consecutiveErrors = 0;
    }
} moonrakerState;    // Глобальный экземпляр состояния Moonraker

// ============================================================================
// HTTP GET ЗАПРОС К ПРОИЗВОЛЬНОМУ ХОСТУ (ДЛЯ MOONRAKER)
// ============================================================================

// Выполняет HTTP GET запрос к указанному хосту и порту с таймаутом
// Используется: для связи с Moonraker API (получение статуса печати, обнаружение)
// Параметры:
//   - host: IP адрес или доменное имя сервера
//   - port: TCP порт (обычно 7125 для Moonraker)
//   - path: путь запроса (например, "/server/info")
//   - responseBuf: буфер для сохранения тела ответа (должен быть заранее выделен)
//   - bufSize: размер буфера (защита от переполнения)
//   - timeoutMs: таймаут подключения и ожидания в миллисекундах
// Возвращает: true если получен ответ с телом, false при ошибке
// Особенности:
//   - НЕБЛОКИРУЮЩАЯ: использует vTaskDelay(1) вместо delay(10) для передачи управления RTOS
//   - БЕЗ ФРАГМЕНТАЦИИ КУЧИ: принимает внешний буфер, не создаёт временных String
//   - АППАРАТНЫЙ ТАЙМАУТ: client.setTimeout() вместо программного ожидания
bool httpGetToHost(const String& host, int port, const String& path, 
                   char* responseBuf, size_t bufSize, int timeoutMs) {
    // Проверка параметров
    if (!responseBuf || bufSize == 0) {
        LOG_DEBUG("httpGetToHost: буфер null или размер 0");
        return false;
    }
    responseBuf[0] = '\0';                          // Очищаем буфер
    
    LOG_DEBUG("httpGetToHost: подключение к %s:%d%s (таймаут %d мс)", 
             host.c_str(), port, path.c_str(), timeoutMs);
    
    WiFiClient client;                              // TCP клиент для соединения
    client.setTimeout(timeoutMs);                   // Аппаратный таймаут вместо delay()
    
    // Подключаемся к серверу с таймаутом
    unsigned long connectStart = millis();
    if (!client.connect(host.c_str(), port, timeoutMs)) {
        LOG_DEBUG("httpGetToHost: НЕ УДАЛОСЬ подключиться к %s:%d за %lu мс (ошибка соединения)", 
                 host.c_str(), port, millis() - connectStart);
        return false;                               // Ошибка подключения
    }
    LOG_DEBUG("httpGetToHost: подключено к %s:%d за %lu мс", 
             host.c_str(), port, millis() - connectStart);
    
    // Формируем и отправляем HTTP/1.1 GET запрос
    // Connection: close - сервер закроет соединение после ответа
    client.printf("GET %s HTTP/1.1\r\nHost: %s\r\nConnection: close\r\n\r\n", 
                  path.c_str(), host.c_str());
    
    // Читаем ВЕСЬ ответ в буфер (быстрее и надёжнее)
    unsigned long start = millis();
    size_t totalLen = 0;
    
    while (client.connected() && (millis() - start) < (unsigned long)timeoutMs) {
        if (!client.available()) {
            vTaskDelay(1);
            continue;
        }
        
        int available = client.available();
        if (available > 0) {
            size_t toRead = min((size_t)available, bufSize - totalLen - 1);
            if (toRead == 0) break;
            int bytesRead = client.read((uint8_t*)responseBuf + totalLen, toRead);
            if (bytesRead > 0) {
                totalLen += bytesRead;
                responseBuf[totalLen] = '\0';
            }
        }
    }
    client.stop();                                  // Закрываем соединение
    
    // Вырезаем HTTP-заголовки: ищем \r\n\r\n
    char* body = strstr(responseBuf, "\r\n\r\n");
    if (body) {
        body += 4;                                  // Пропускаем \r\n\r\n
        size_t bodyLen = strlen(body);
        memmove(responseBuf, body, bodyLen + 1);    // Сдвигаем тело в начало буфера
    }
    
    bool hasBody = (strlen(responseBuf) > 0);
    return hasBody;
}

// ============================================================================
// АВТООПРЕДЕЛЕНИЕ MOONRAKER
// ============================================================================

// Ищет сервер Moonraker на IP-адресе обнаруженного Klipper
// Перебирает стандартные порты Moonraker и проверяет ответ /server/info
// Вызывается: fetchPrintStatus() при первом запросе статуса печати
// Результат: сохраняет moonrakerHost и moonrakerPort для последующих запросов
// Особенности:
//   - Использует статический буфер (не фрагментирует кучу)
//   - Проверяет наличие "moonraker" или "klippy" в ответе для идентификации
bool discoverMoonraker() {
    if (!klipperStatus.detected) {
        LOG_DEBUG("discoverMoonraker: Klipper не обнаружен, выход");
        return false;
    }
    
    String host = klipperStatus.ip.toString();
    LOG_DEBUG("discoverMoonraker: поиск на %s", host.c_str());
    
    static char response[512];                      // Статический буфер (не фрагментирует кучу при повторных вызовах)
    
    // Перебираем все стандартные порты Moonraker
    for (int i = 0; i < MOONRAKER_PORTS_COUNT; i++) {
        int port = MOONRAKER_PORTS[i];
        
        LOG_DEBUG("discoverMoonraker: пробую %s:%d/server/info", host.c_str(), port);
        
        // Запрашиваем /server/info для идентификации Moonraker
        if (httpGetToHost(host, port, "/server/info", response, sizeof(response), 2000)) {
            LOG_DEBUG("discoverMoonraker: ответ от %s:%d, длина=%d байт", 
                     host.c_str(), port, strlen(response));
            LOG_DEBUG("discoverMoonraker: первые 100 символов: %.100s", response);
            
            // Проверяем признаки Moonraker в ответе
            bool hasMoonraker = (strstr(response, "moonraker") != nullptr);
            bool hasKlippy = (strstr(response, "klippy") != nullptr);
            
            LOG_DEBUG("discoverMoonraker: moonraker=%d, klippy=%d", hasMoonraker, hasKlippy);
            
            if (hasMoonraker || hasKlippy) {
                moonrakerHost = host;               // Сохраняем хост для последующих запросов
                moonrakerPort = port;               // Сохраняем рабочий порт
                LOG_INFO("Moonraker найден на %s:%d", host.c_str(), port);
                addNotificationToLog("Moonraker найден на " + host + ":" + String(port));
                return true;
            } else {
                LOG_DEBUG("discoverMoonraker: ответ не содержит moonraker/klippy");
            }
        } else {
            LOG_DEBUG("discoverMoonraker: нет ответа от %s:%d", host.c_str(), port);
        }
    }
    
    LOG_WARN("Moonraker не найден на %s (перебрано %d портов)", host.c_str(), MOONRAKER_PORTS_COUNT);
    LOG_WARN("Автоотключение по статусу печати недоступно");
    return false;
}

// ============================================================================
// ПОЛУЧЕНИЕ СТАТУСА ПЕЧАТИ ИЗ MOONRAKER
// ============================================================================

// Запрашивает статус печати через Moonraker API по HTTP GET
// Обнаруживает начало и окончание печати для автоотключения нагрева
// Вызывается: controlTask по таймеру timerPrintStatus (каждые 60 секунд)
// Обновляет: printEndTime (время завершения печати), config.printActive (флаг активности)
// 
// АЛГОРИТМ ОБНАРУЖЕНИЯ MOONRAKER:
//   1. При первом вызове пытается найти Moonraker на IP адресе Klipper
//      перебором стандартных портов (7125, 7126, 7130, 4408, 8000, 8080, 8899)
//   2. При успешном нахождении — сохраняет moonrakerHost и moonrakerPort
//   3. При 3 последовательных ошибках HTTP — сбрасывает host и повторяет поиск
//   4. Если Moonraker не найден сразу — повторяет попытку каждые 5 минут
//
// ОСОБЕННОСТИ РЕАЛИЗАЦИИ:
//   - Защита от частых запросов: не чаще 1 раза в 2 секунды
//     (даже если controlTask вызывает чаще — отрабатывает таймер)
//   - Статический буфер response[1024] — без фрагментации кучи
//   - Статический StaticJsonDocument<512> — безопасен т.к. функция вызывается
//     ТОЛЬКО из controlTask (однопоточный доступ)
//   - Автоматический сброс подключения при 3 ошибках подряд
//     (MoonrakerState.recordError/recordSuccess)
bool fetchPrintStatus() {
    // ========== 1. БЫСТРЫЕ ПРОВЕРКИ ДЛЯ РАННЕГО ВЫХОДА ==========
    
    // 1.1. Функция автоотключения выключена в настройках — не тратим ресурсы
    if (!config.autoShutdownEnabled) return false;
    
    // 1.2. Klipper не обнаружен в сети — Moonraker точно недоступен
    if (!klipperStatus.detected) return false;
    
    // ========== 2. ЗАЩИТА ОТ СЛИШКОМ ЧАСТЫХ ЗАПРОСОВ ==========
    // Ограничение: не чаще 1 раза в 2 секунды (2000 мс)
    // Предотвращает спам запросами при быстром вызове из controlTask
    if (millis() - moonrakerState.lastFetchTime < 2000) {
        return false;
    }
    moonrakerState.lastFetchTime = millis();
    
    // ========== 3. ПОИСК MOONRAKER (ЕСЛИ АДРЕС НЕ ИЗВЕСТЕН) ==========
    if (moonrakerHost.isEmpty()) {
        // 3.1. Первая попытка — пытаемся найти Moonraker на IP адресе Klipper
        if (!moonrakerState.discoveryAttempted) {
            moonrakerState.discoveryAttempted = true;
            if (!discoverMoonraker()) return false;      // Не найден — выходим
        }
        // 3.2. Повторные попытки — раз в 5 минут (300000 мс)
        else if (millis() - moonrakerState.lastFetchTime > 300000) {
            // Сбрасываем флаг для повторного поиска
            moonrakerState.discoveryAttempted = false;
            if (!discoverMoonraker()) return false;      // Всё ещё не найден
        }
        // 3.3. Недавно пытались и не нашли — ждём следующего таймаута
        else {
            return false;
        }
    }
    
    // ========== 4. ПРОВЕРКА ДОСТУПНОСТИ АДРЕСА ==========
    // Если после всех попыток хост пуст — Moonraker недоступен
    if (moonrakerHost.isEmpty()) return false;
    
    // ========== 5. HTTP GET ЗАПРОС К MOONRAKER API ==========
    // Эндпоинт: /printer/objects/query?print_stats
    // Возвращает JSON с состоянием печати (printing/paused/standby/complete/error)
    static char response[1024];  // Статический буфер — не фрагментирует кучу
                                 // 1024 байта достаточно для ответа Moonraker
    String path = "/printer/objects/query?print_stats";
    
    if (!httpGetToHost(moonrakerHost, moonrakerPort, path, response, sizeof(response), 1000)) {
        // 5.1. Ошибка HTTP запроса — фиксируем для подсчёта последовательных ошибок
        moonrakerState.recordError();
        // При 3 ошибках подряд MoonrakerState.reset() обнулит moonrakerHost
        // и в следующем вызове начнётся новый поиск
        return false;
    }
    
    // 5.2. Успешный запрос — сбрасываем счётчик ошибок
    moonrakerState.recordSuccess();
    
    // ========== 6. ПАРСИНГ JSON ОТВЕТА ==========
    // Используем статический документ для избежания фрагментации кучи
    // Безопасность: функция вызывается только из controlTask (один поток)
    static StaticJsonDocument<512> doc;
    doc.clear();  // Очищаем перед повторным использованием
    
    DeserializationError error = deserializeJson(doc, response);
    if (error) return false;  // Ошибка парсинга — некорректный JSON от Moonraker
    
    // ========== 7. ИЗВЛЕЧЕНИЕ СОСТОЯНИЯ ПЕЧАТИ ==========
    // Путь в JSON: result → status → print_stats → state
    // Возможные значения: "standby", "printing", "paused", "complete", "error"
    // Если ключ отсутствует — значение по умолчанию "standby"
    const char* state = doc["result"]["status"]["print_stats"]["state"] | "standby";
    
    // ========== 8. ОПРЕДЕЛЕНИЕ ТЕКУЩЕГО СОСТОЯНИЯ ==========
    bool isPrinting = (strcmp(state, "printing") == 0);  // Идёт печать
    bool isPaused   = (strcmp(state, "paused") == 0);     // Печать на паузе
    
    // ========== 9. ДЕТЕКТИРОВАНИЕ СМЕНЫ СОСТОЯНИЯ ПЕЧАТИ ==========
    
    // ----- 9.1. ПЕЧАТЬ ТОЛЬКО ЧТО ЗАВЕРШИЛАСЬ -----
    // Переход: printing/paused → standby/complete/error
    // Условие: в прошлый раз была печать, сейчас — не печать и не пауза
    if (moonrakerState.wasPrinting && !isPrinting && !isPaused) {
        printEndTime = millis();                         // Запоминаем время завершения
        config.lastPrintActivity = millis();             // Обновляем время последней активности
        addNotificationToLog("📝 Печать завершена, таймер отключения запущен");
    }
    
    // ----- 9.2. ПЕЧАТЬ НАЧАЛАСЬ -----
    // Переход: любое состояние → printing
    // Сбрасываем таймер отключения (печать активна — не выключаем нагрев)
    if (isPrinting && !moonrakerState.wasPrinting) {
        printEndTime = 0;                                // Сбрасываем таймер отключения
        config.printActive = true;                       // Устанавливаем флаг активной печати
    }
    
    // ----- 9.3. ПЕЧАТЬ ЗАВЕРШЕНА ИЛИ НА ПАУЗЕ -----
    // Сбрасываем флаг активной печати
    if (!isPrinting && !isPaused) {
        config.printActive = false;
    }
    
    // ========== 10. СОХРАНЕНИЕ СОСТОЯНИЯ ДЛЯ СЛЕДУЮЩЕЙ ПРОВЕРКИ ==========
    // Используется для детектирования ПЕРЕХОДА между состояниями
    moonrakerState.wasPrinting = isPrinting;
    
    return true;
}

// ============================================================================
// ПРОВЕРКА НЕОБХОДИМОСТИ ОТКЛЮЧЕНИЯ НАГРЕВА ПО СТАТУСУ ПЕЧАТИ
// ============================================================================

// Определяет, нужно ли отключить нагрев после завершения печати
// Вызывается: updateHeaterControl() перед каждым циклом управления нагревателем
// Условия отключения:
//   1. Автоотключение включено в настройках (config.autoShutdownEnabled)
//   2. Печать завершена (printEndTime != 0)
//   3. Прошло заданное количество минут после завершения печати
// Возвращает:
//   - true: требуется отключение нагревателя
//   - false: нагрев должен продолжаться
inline bool shouldShutdownByPrintStatus() {
    if (!config.autoShutdownEnabled || printEndTime == 0) {
        return false;                                    // Функция отключена или печать не завершалась
    }
    
    // Вычисляем сколько минут прошло с момента завершения печати
    unsigned long minutesSinceEnd = (millis() - printEndTime) / 60000UL;
    
    // Если прошло больше заданного в настройках времени - отключаем нагрев
    return (minutesSinceEnd >= (unsigned long)config.autoShutdownMinutes);
}

// ============================================================================
// СТРУКТУРА ШАГА МЕЛОДИИ
// ============================================================================

// Описывает один шаг мелодии: состояние зуммера и длительность
// Используется: массивом melodys[] для описания всех трёх мелодий
struct MelodyStep {
    bool buzzerState;       // true = включить зуммер, false = выключить
    uint16_t durationMs;    // Длительность шага в миллисекундах (до 65 секунд)
};

// ============================================================================
// ТАБЛИЦЫ МЕЛОДИЙ (В ПАМЯТИ ПРОГРАММЫ PROGMEM)
// ============================================================================

// Мелодия 0: короткий писк (1 шаг, 150 мс)
static const MelodyStep MELODY_SHORT[] PROGMEM = {
    {true, 150}             // Писк 150 мс → завершение
};
#define MELODY_SHORT_STEPS 1

// Мелодия 1: двойной писк (3 шага)
static const MelodyStep MELODY_DOUBLE[] PROGMEM = {
    {true,  500},           // Шаг 0: писк 500 мс
    {false, 200},           // Шаг 1: пауза 200 мс
    {true,  500}            // Шаг 2: писк 500 мс → завершение
};
#define MELODY_DOUBLE_STEPS 3

// Мелодия 2: аларма — 6 писков с паузами (13 шагов, но 7 писков для ровного счёта)
static const MelodyStep MELODY_ALARM[] PROGMEM = {
    {true,  800}, {false, 800},    // Писк 1, Пауза 1
    {true,  800}, {false, 800},    // Писк 2, Пауза 2
    {true,  800}, {false, 800},    // Писк 3, Пауза 3
    {true,  800}, {false, 800},    // Писк 4, Пауза 4
    {true,  800}, {false, 800},    // Писк 5, Пауза 5
    {true,  800}, {false, 800},    // Писк 6, Пауза 6
    {true,  800}                   // Писк 7 → завершение
};
#define MELODY_ALARM_STEPS 13

// Массив указателей на таблицы мелодий (индекс = melodyType)
static const MelodyStep* const MELODY_TABLES[] PROGMEM = {
    MELODY_SHORT, MELODY_DOUBLE, MELODY_ALARM
};
static const uint8_t MELODY_STEPS[] PROGMEM = {
    MELODY_SHORT_STEPS, MELODY_DOUBLE_STEPS, MELODY_ALARM_STEPS
};


// ============================================================================
// ФУНКЦИИ ДЛЯ АКТИВНОГО БУЗЗЕРА (ПЬЕЗОИЗЛУЧАТЕЛЬ)
// ============================================================================

// ========== ИНИЦИАЛИЗАЦИЯ ПИНА ЗУММЕРА ==========
// Настраивает пин зуммера как выход и устанавливает низкий уровень (выключено)
// Вызывается: setup() после загрузки конфигурации
void initBuzzer() {
    pinMode(config.pinBuzzer, OUTPUT);
    digitalWrite(config.pinBuzzer, LOW);
}

// ========== УПРАВЛЕНИЕ ЗУММЕРОМ (INLINE ДЛЯ СКОРОСТИ) ==========
inline void buzzerOn()  { digitalWrite(config.pinBuzzer, HIGH); }
inline void buzzerOff() { digitalWrite(config.pinBuzzer, LOW); }

// ========== ЗАПУСК МЕЛОДИИ ПО НОМЕРУ (ЕДИНАЯ ФУНКЦИЯ) ==========
// Параметры:
//   - melody: номер мелодии 0..2 (индекс в MELODY_TABLES)
//   - force: принудительное воспроизведение (игнорирует buzzerEnabled)
// Вызывается: checkLockBeep(), addErrorToLog(), setup(), вместо 3 отдельных функций
void playMelody(int melody, bool force) {
    if ((!config.buzzerEnabled && !force) || melodyStep >= 0) return;
    
    // Проверяем допустимый номер мелодии
    if (melody < 0 || melody > 2) melody = 0;
    
    melodyType = melody;                // Сохраняем тип для updateBuzzer()
    melodyStep = 0;                     // Начинаем с первого шага
    melodyLastTime = millis();
    buzzerOn();                         // Все мелодии начинаются со звука
}

// ========== ПРОВЕРКА НУЖНО ЛИ ПИЩАТЬ ПРИ ОШИБКЕ ==========
// Возвращает: true если ошибка требует звукового оповещения
// Логика: при критических ошибках всегда, при некритических - если включено в настройках
inline bool shouldPlayForError(bool isCritical) {
    return config.buzzerEnabled && (isCritical || config.buzzerNonCriticalEnabled);
}

// ========== ПЕРИОДИЧЕСКАЯ ПРОВЕРКА СИГНАЛА БЛОКИРОВКИ ==========
// Пикает каждые 60 секунд при заблокированной системе (напоминание)
// Вызывается: webTask() каждый цикл
void checkLockBeep() {
    if (!errors.isSystemLocked() || !config.buzzerEnabled) return;
    
    if (millis() - lastLockBeep >= 60000) {
        lastLockBeep = millis();
        playMelody(config.buzzerMelody, true);
    }
}

// ============================================================================
// ОБНОВЛЕНИЕ МЕЛОДИИ (КОНЕЧНЫЙ АВТОМАТ НА ТАБЛИЦЕ ШАГОВ)
// ============================================================================

// Выполняет пошаговое воспроизведение мелодии без блокировки
// Вызывается: webTask() каждый цикл (каждые 10 мс)
// Использует таблицы шагов вместо switch-case
void updateBuzzer() {
    if (melodyStep < 0 || melodyType < 0 || melodyType > 2) return;
    
    // Загружаем таблицу шагов текущей мелодии
    const MelodyStep* steps = MELODY_TABLES[melodyType];
    uint8_t totalSteps = MELODY_STEPS[melodyType];
    
    // Проверяем что не вышли за границы таблицы
    if (melodyStep >= totalSteps) {
        buzzerOff();
        melodyStep = -1;
        melodyType = -1;
        return;
    }
    
    unsigned long elapsed = millis() - melodyLastTime;
    uint16_t stepDuration = steps[melodyStep].durationMs;
    
    // Если длительность шага истекла — переходим к следующему
    if (elapsed >= stepDuration) {
        melodyStep++;
        
        // Проверяем что мелодия не закончилась
        if (melodyStep >= totalSteps) {
            buzzerOff();                    // Завершаем
            melodyStep = -1;
            melodyType = -1;
        } else {
            // Применяем состояние зуммера для нового шага
            if (steps[melodyStep].buzzerState) {
                buzzerOn();
            } else {
                buzzerOff();
            }
            melodyLastTime = millis();      // Сбрасываем таймер для нового шага
        }
    }
}

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║                   LED-ИНДИКАЦИЯ (NEO_PIXEL WS2812B)                      ║
// ╚══════════════════════════════════════════════════════════════════════════╝

// ========== ИНИЦИАЛИЗАЦИЯ СВЕТОДИОДНОЙ ЛЕНТЫ ==========
void initLEDs() {
    if (pStrip != nullptr) { 
        pStrip->clear(); 
        pStrip->show(); 
        delete pStrip; 
        pStrip = nullptr; 
    }
    if (config.ledEnabled && config.ledCount > 0 && config.ledCount <= MAX_LEDS) {
        pStrip = new Adafruit_NeoPixel(config.ledCount, config.pinLed, NEO_GRB + NEO_KHZ800);
        if (pStrip != nullptr) { 
            pStrip->begin(); 
            pStrip->setBrightness(config.ledBrightness); 
            pStrip->clear(); 
            pStrip->show(); 
        }
    }
    ledState.reset();
}

// ========== УСТАНОВКА ЦВЕТА ВСЕХ СВЕТОДИОДОВ ==========
inline void setAllLED(uint8_t r, uint8_t g, uint8_t b) { 
    if (!pStrip || !config.ledEnabled) return;
    pStrip->fill(pStrip->Color(r, g, b));
    pStrip->show(); 
}

// ========== УСТАНОВКА ОДНОГО СВЕТОДИОДА (ДЛЯ БЕГУЩЕГО ОГОНЬКА) ==========
inline void setOneLED(int index, uint8_t r, uint8_t g, uint8_t b) {
    if (!pStrip || !config.ledEnabled) return;
    pStrip->clear();
    if (index >= 0 && index < pStrip->numPixels()) {
        pStrip->setPixelColor(index, r, g, b);
    }
    pStrip->show();
}

// ========== ПЛАВНЫЙ ПЕРЕХОД ЦВЕТА МЕЖДУ РЕЖИМАМИ ==========
void lerpColors() {
    unsigned long elapsed = millis() - ledState.transitionStart;
    float t = (float)elapsed / LEDState::TRANSITION_MS;
    if (t >= 1.0f) {
        ledState.currR = ledState.targetR;
        ledState.currG = ledState.targetG;
        ledState.currB = ledState.targetB;
        return;
    }
    float ease = t < 0.5f ? 4*t*t*t : 1 - pow(-2*t + 2, 3)/2;
    ledState.currR = ledState.currR + (ledState.targetR - ledState.currR) * ease;
    ledState.currG = ledState.currG + (ledState.targetG - ledState.currG) * ease;
    ledState.currB = ledState.currB + (ledState.targetB - ledState.currB) * ease;
}

// ========== ПРИМЕНЕНИЕ РЕЖИМА ПРИ СМЕНЕ СОСТОЯНИЯ ==========
void setLEDMode(uint8_t modeIdx) {
    if (modeIdx >= LED_MODE_COUNT || modeIdx == ledState.currentModeIdx) return;
    
    ledState.currentModeIdx = modeIdx;
    ledState.targetR = LED_MODES[modeIdx].r;
    ledState.targetG = LED_MODES[modeIdx].g;
    ledState.targetB = LED_MODES[modeIdx].b;
    ledState.transitionStart = millis();
    ledState.lastAnimUpdate = 0;
    ledState.blinkState = false;
}

// ========== АНИМАЦИЯ: ДЫХАНИЕ (ПРОСТАЯ СИНУСОИДА) ==========
// Используется: ожидание (синий)
void animBreath(uint16_t periodMs) {
    float phase = (float)(millis() % periodMs) / periodMs;
    float brightness = 0.15f + 0.85f * (sin(phase * 2 * PI) * 0.5f + 0.5f);
    
    setAllLED((uint8_t)(ledState.targetR * brightness),
              (uint8_t)(ledState.targetG * brightness),
              (uint8_t)(ledState.targetB * brightness));
}

// ========== АНИМАЦИЯ: МИГАНИЕ (ПРОСТОЕ РОВНОЕ) ==========
// Используется: ошибки (красный)
void animBlink(uint16_t intervalMs) {
    bool on = (millis() / intervalMs) % 2 == 0;
    
    if (on) {
        setAllLED(ledState.targetR, ledState.targetG, ledState.targetB);
    } else {
        setAllLED(0, 0, 0);
    }
}

// ========== АНИМАЦИЯ: ПРОГРЕСС-БАР (ЧИСТЫЙ ЦВЕТ, ГРАДИЕНТ ЯРКОСТИ) ==========
// Используется: нагрев (белый), цель достигнута (зелёный), адаптация (фиолетовый)
void animProgress() {
    ledState.smoothProgress += (ledState.progress - ledState.smoothProgress) * 0.05f;
    
    int total = pStrip->numPixels();
    float exactLeds = (ledState.smoothProgress * total) / 100.0f;
    int fullLeds = (int)exactLeds;
    float partial = exactLeds - fullLeds;
    
    for (int i = 0; i < total; i++) {
        if (i < fullLeds) {
            // Заполненная часть: градиент от тусклого к яркому
            float posInFill = (float)i / max(fullLeds - 1, 1);
            float gradient = 0.3f + 0.7f * posInFill;
            
            pStrip->setPixelColor(i, 
                (uint8_t)(ledState.targetR * gradient),
                (uint8_t)(ledState.targetG * gradient),
                (uint8_t)(ledState.targetB * gradient));
        } else if (i == fullLeds && partial > 0.05f) {
            // Частично заполненный светодиод на фронте
            pStrip->setPixelColor(i,
                (uint8_t)(ledState.targetR * partial),
                (uint8_t)(ledState.targetG * partial),
                (uint8_t)(ledState.targetB * partial));
        } else {
            // Незаполненная часть: едва заметный фон (10% яркости)
            pStrip->setPixelColor(i, 
                (uint8_t)(ledState.targetR * 0.1f),
                (uint8_t)(ledState.targetG * 0.1f),
                (uint8_t)(ledState.targetB * 0.1f));
        }
    }
    pStrip->show();
}

// ========== АНИМАЦИЯ: БЕГУЩИЙ ОГОНЁК (СО СЛЕДОМ) ==========
// Используется: точка доступа Wi-Fi
void animRunning(uint16_t intervalMs, uint8_t r, uint8_t g, uint8_t b) {
    unsigned long now = millis();
    int total = pStrip->numPixels();
    if (total == 0) return;
    
    if (now - ledState.lastAnimUpdate >= intervalMs) {
        ledState.lastAnimUpdate = now;
        ledState.animPhase = (ledState.animPhase + 1) % total;
    }
    
    pStrip->clear();
    for (int i = 0; i < 4; i++) {
        int pos = (ledState.animPhase - i + total) % total;
        float trailBrightness = 1.0f / (i + 1);
        
        pStrip->setPixelColor(pos, 
            (uint8_t)(r * trailBrightness),
            (uint8_t)(g * trailBrightness),
            (uint8_t)(b * trailBrightness));
    }
    pStrip->show();
}


// ╔══════════════════════════════════════════════════════════════════════════╗
// ║              ОСНОВНАЯ ФУНКЦИЯ ОБНОВЛЕНИЯ LED-ИНДИКАЦИИ                  ║
// ╚══════════════════════════════════════════════════════════════════════════╝

void updateLEDs() {
    if (!config.ledEnabled) {
        if (pStrip) { pStrip->clear(); pStrip->show(); }
        return;
    }
    if (!pStrip) return;

    // Не перебиваем анимацию кнопки сброса
    if (buttonPressDetected || (digitalRead(config.pinButton) == LOW && millis() - buttonPressStart > 0)) {
        return;
    }
    
    // ══════ РЕЖИМ ТОЧКИ ДОСТУПА WI-FI ══════
    if (WiFi.getMode() == WIFI_AP) {
        bool hasClients = (WiFi.softAPgetStationNum() > 0);
        uint16_t speed = hasClients ? 80 : 200;
        uint8_t r = hasClients ? 0 : 255;
        uint8_t g = hasClients ? 255 : 150;
        uint8_t b = hasClients ? 100 : 0;
        animRunning(speed, r, g, b);
        return;
    }
    
    // ══════ АНИМАЦИЯ ПОДКЛЮЧЕНИЯ К WI-FI ══════
    static bool wasDisconnected = true;
    bool isConnected = (WiFi.status() == WL_CONNECTED);
    
    if (isConnected && wasDisconnected) {
        ledState.wifiAnimActive = true;
        ledState.wifiAnimStart = millis();
    }
    wasDisconnected = !isConnected;
    
    if (ledState.wifiAnimActive) {
        unsigned long elapsed = millis() - ledState.wifiAnimStart;
        
        // Фаза 1: бегущая волна (3 секунды)
        if (elapsed < 3000) {
            int total = pStrip->numPixels();
            float progress = (float)elapsed / 3000.0f;
            
            for (int i = 0; i < total; i++) {
                float pos = (float)i / total;
                float wavePos = fmod(pos - progress * 1.5f + 1.0f, 1.0f);
                float brightness = exp(-pow((wavePos - 0.5f) * 4.0f, 2.0f));
                brightness = constrain(brightness, 0.05f, 1.0f);
                
                float hue = 0.33f + wavePos * 0.22f;
                uint32_t color = pStrip->ColorHSV(hue * 65535, 255, 255 * brightness);
                pStrip->setPixelColor(i, color);
            }
            pStrip->show();
            return;
        } 
        // Фаза 2: плавное затухание (0.5 секунды)
        else {
            float fadeOut = 1.0f - constrain((float)(elapsed - 3000) / 500.0f, 0.0f, 1.0f);
            if (fadeOut > 0) {
                for (int i = 0; i < pStrip->numPixels(); i++) {
                    pStrip->setPixelColor(i, 0, 255 * fadeOut, 100 * fadeOut);
                }
                pStrip->show();
                return;
            }
            ledState.wifiAnimActive = false;
        }
    }
    
    // ══════ ВЫБОР РЕЖИМА ПО ПРИОРИТЕТУ ══════
    uint8_t selectedMode = LED_IDX_OFF;
    
    // Статические переменные для отслеживания циклов нагрева
    static float heatStartTemp = 0;
    static bool wasHeating = false;
    static bool targetWasReached = false;  // ← НОВОЕ: флаг первого достижения цели

    if (errors.isSystemLocked() || errors.criticalOverheat || errors.airOverheat ||
        errors.thermalRunaway || errors.unexpectedHeat) {
        selectedMode = LED_IDX_ERROR;
        wasHeating = false;
        targetWasReached = false;
        
    } else if (adaptationInProgress) {
        selectedMode = LED_IDX_ADAPT;
        ledState.progress = adaptProgressPercent;
        wasHeating = false;
        targetWasReached = false;
        
    } else if (targetTemp > 0 && heaterState) {
        // Нагрев включен — возможны два случая:
        // 1. Первый нагрев до цели (ещё не достигали) → БЕЛЫЙ прогресс-бар
        // 2. Поддержание после достижения цели → ЗЕЛЁНЫЙ прогресс-бар
        
        if (!targetWasReached) {
            // ── ПЕРВЫЙ НАГРЕВ: БЕЛЫЙ ПРОГРЕСС-БАР ──
            selectedMode = LED_IDX_HEATING;
            
            if (!wasHeating) {
                // Нагрев только что включился — запоминаем стартовую температуру
                heatStartTemp = airTemp;
                wasHeating = true;
            }
            
            float totalRise = targetTemp - heatStartTemp;
            if (totalRise > 0) {
                ledState.progress = constrain(((airTemp - heatStartTemp) / totalRise) * 100.0f, 0.0f, 100.0f);
            } else {
                ledState.progress = 100.0f;
            }
            
            // Проверка: достигли цели?
            if (airTemp >= targetTemp - config.hysteresis) {
                targetWasReached = true;  // Запоминаем что цель была достигнута
            }
            
        } else {
            // ── ПОДДЕРЖАНИЕ: ЗЕЛЁНЫЙ ПРОГРЕСС-БАР ──
            selectedMode = LED_IDX_TARGET;
            
            // Прогресс: 100% когда airTemp == targetTemp, 0% когда airTemp == targetTemp - hysteresis
            float range = config.hysteresis;
            float pos = airTemp - (targetTemp - config.hysteresis);
            ledState.progress = constrain((pos / range) * 100.0f, 0.0f, 100.0f);
        }
        
    } else if (targetTemp > 0 && !heaterState) {
        // Нагрев выключен, цель задана
        if (targetWasReached) {
            // Остывание после достижения цели — продолжаем зелёный
            selectedMode = LED_IDX_TARGET;
            float range = config.hysteresis;
            float pos = airTemp - (targetTemp - config.hysteresis);
            ledState.progress = constrain((pos / range) * 100.0f, 0.0f, 100.0f);
        } else {
            // Нагрев ещё не включался (переходное состояние)
            selectedMode = LED_IDX_IDLE;
        }
        wasHeating = false;
        
    } else if (targetTemp == 0) {
        // Ожидание
        selectedMode = LED_IDX_IDLE;
        wasHeating = false;
        targetWasReached = false;
        
    } else {
        selectedMode = LED_IDX_IDLE;
    }
    
    // Применяем режим
    setLEDMode(selectedMode);
    lerpColors();
    
    // ══════ ВЫПОЛНЕНИЕ АНИМАЦИИ ══════
    LEDAnimType anim = LED_MODES[selectedMode].animType;
    uint16_t speed = LED_MODES[selectedMode].speed;
    
    switch (anim) {
        case LED_BREATH:
            animBreath(speed);
            break;
            
        case LED_BLINK:
            animBlink(speed);
            break;
            
        case LED_PROGRESS:
            animProgress();
            break;
            
        case LED_RUNNING:
            animRunning(speed, ledState.targetR, ledState.targetG, ledState.targetB);
            break;
            
        case LED_OFF:
        default:
            setAllLED(0, 0, 0);
            break;
    }
}

// ============================================================================
// MAX6675 ФУНКЦИИ (ТЕРМОПАРА K-ТИПА ДЛЯ НАГРЕВАТЕЛЯ)
// ============================================================================

// ========== ЧТЕНИЕ СЫРЫХ ДАННЫХ MAX6675 ПО SPI (БЫСТРАЯ ВЕРСИЯ) ==========
// Выполняет 16-битное чтение через программный SPI интерфейс
// Формат данных: биты D14-D3 = температура (12 бит, 0.25°C на отсчёт)
// Бит D2 = индикатор обрыва термопары (1 = оборвана)
// Бит D15 = всегда 0 (признак корректных данных)
// Оптимизация: delayMicroseconds заменены на NOP (1 такт ~16 нс на ESP32 240 МГц)
// Скорость: ~8 мкс вместо ~160 мкс (ускорение в 20 раз)
// Вызывается: readMAX6675Temperature() из критической секции (max6675Mux)
uint16_t readMAX6675Raw() {
    uint16_t value = 0;
    digitalWrite(config.pinMaxCs, LOW);           // Выбор чипа (активный LOW)
    
    // Программный SPI — бит за битом, MSB first (старший бит первым)
    for (int i = 0; i < 16; i++) {
        digitalWrite(config.pinMaxSck, HIGH);     // Фронт тактового сигнала (LOW→HIGH)
        asm volatile("nop");                      // Минимальная задержка (~16 нс)
        value = (value << 1) | (digitalRead(config.pinMaxSo) ? 1 : 0);  // Читаем бит данных
        digitalWrite(config.pinMaxSck, LOW);      // Спад тактового сигнала (HIGH→LOW)
        asm volatile("nop");                      // Минимальная задержка
    }
    
    digitalWrite(config.pinMaxCs, HIGH);         // Отключаем чип
    return value;
}

// ========== ИНИЦИАЛИЗАЦИЯ MAX6675 ==========
// Настраивает пины и проверяет связь с микросхемой
// Вызывается: setup() при старте, sensorTask() при отсутствии инициализации
// Особенности:
//   - Однократная проверка связи (без повторов — за восстановление отвечает checkAutoClear)
void initMAX6675() {
    
    // Настройка пинов для программного SPI
    pinMode(config.pinMaxCs, OUTPUT);
    pinMode(config.pinMaxSck, OUTPUT);
    pinMode(config.pinMaxSo, INPUT);
    digitalWrite(config.pinMaxCs, HIGH);          // CS не активен (HIGH = чип не выбран)
    digitalWrite(config.pinMaxSck, LOW);          // SCK в исходном состоянии LOW
    
    // Время прогрева MAX6675 после подачи питания (300 мс)
    delay(MAX6675_WARMUP_TIME);                   // delay допустим — однократно при старте
    
    // Однократное чтение для проверки связи
    uint16_t testValue = readMAX6675Raw();
    
    // Валидные данные: не ноль, не все единицы, без бита ошибки (D2)
    if (testValue != 0 && testValue != 0xFFFF && !(testValue & 0x4)) { 
        max6675_initialized = true;               // Датчик готов к работе
        errors.max6675Disconnected = false;       // Сбрасываем флаг отключения
        max6675ErrorCount = 0;                    // Сбрасываем счётчик ошибок
        LOG_INFO("MAX6675 инициализирован успешно");
    } else {
        // Датчик не отвечает — будет переинициализирован при следующем вызове
        errors.max6675Disconnected = true;        // Устанавливаем флаг отключения
        max6675_initialized = false;              // Требуется повторная инициализация
        // Не логируем ошибку — checkAutoClear сам заблокирует систему через 15 секунд
    }
}

// ========== ЧТЕНИЕ ТЕМПЕРАТУРЫ С MAX6675 С ФИЛЬТРАЦИЕЙ ==========
// Основная функция получения температуры нагревателя
// Возвращает: температура в °C или DEVICE_DISCONNECTED_C (-127) при ошибке
// Вызывается: sensorTask() каждые MAX6675_READ_INTERVAL мс (500 мс)
// Особенности:
//   - Медианный фильтр из 3 чтений (подавление одиночных выбросов)
//   - Обнаружение обрыва термопары (бит D2)
//   - Защита от скачков температуры (шумов)
//   - При успешном чтении сразу сбрасывает флаг отключения (датчик работает)
float readMAX6675Temperature() {
    // Повторная инициализация если не была выполнена при старте
    if (!max6675_initialized) { 
        initMAX6675(); 
        return lastValidHeaterTemp; 
    }
    
    // Ограничение частоты опроса (защита от слишком частых вызовов)
    unsigned long now = millis();
    if (now - lastMaxRead < MAX6675_READ_INTERVAL) 
        return lastValidHeaterTemp;
    lastMaxRead = now;
    
    // Тройное чтение для медианного фильтра (подавление шумов)
    taskENTER_CRITICAL(&max6675Mux);              // Защита SPI шины от одновременного доступа
    uint16_t readings[3];
    for (int i = 0; i < 3; i++) {
        readings[i] = readMAX6675Raw();
    }
    taskEXIT_CRITICAL(&max6675Mux);
    
    // Сортировка 3 значений для получения медианы (среднего)
    // Пузырьковая сортировка для n=3 — минимальный оверхед
    if (readings[0] > readings[1]) { uint16_t t = readings[0]; readings[0] = readings[1]; readings[1] = t; }
    if (readings[1] > readings[2]) { uint16_t t = readings[1]; readings[1] = readings[2]; readings[2] = t; }
    if (readings[0] > readings[1]) { uint16_t t = readings[0]; readings[0] = readings[1]; readings[1] = t; }
    
    uint16_t raw = readings[1];                   // Медиана (устойчива к одиночным выбросам)
    
    // Проверка бита обрыва термопары (D2 = 0x4)
    if (raw & 0x4) { 
        max6675ErrorCount++;
        if (max6675ErrorCount >= MAX6675_ERROR_THRESHOLD) {
            errors.max6675Disconnected = true;    // Порог превышен — датчик отключён
        }
        return DEVICE_DISCONNECTED_C;             // Специальное значение "датчик не подключён"
    }
    
    // ========== УСПЕШНОЕ ЧТЕНИЕ — ДАТЧИК РАБОТАЕТ ==========
    max6675ErrorCount = 0;                        // Сброс счётчика ошибок
    errors.max6675Disconnected = false;           // Сброс флага отключения
    // Таймер блокировки сбросится в checkAutoClear() при !max6675Disconnected
    
    // Преобразование сырых данных в температуру
    // Сдвиг на 3 бита вправо (отбрасываем D2-D0), умножаем на 0.25°C/бит
    raw >>= 3;
    float tempC = raw * 0.25f + config.max6675Offset;  // 0.25f — float литерал (без double-конвертации)
    
    // ========== ЗАЩИТА MAX6675 (ЕСЛИ ВКЛЮЧЕНА В НАСТРОЙКАХ) ==========
    if (config.enableMAX6675Protection) {
        // 1. Проверка выхода за допустимый диапазон температур
        if (tempC < config.max6675MinTemp || tempC > config.max6675MaxTemp) {
            errors.max6675OutOfRange = true;
        } else { 
            errors.max6675OutOfRange = false; 
            errors.max6675OutOfRangeLogged = false;  // Сброс флага логирования
        }
        
        // 2. Обнаружение шумов (аномальные скачки температуры)
        // Проверяем ТОЛЬКО если есть предыдущее валидное значение (> -126)
        static int spikeCount = 0;                    // Счётчик последовательных скачков
        if (lastRawHeaterTemp > DEVICE_DISCONNECTED_C + 1 && 
            abs(tempC - lastRawHeaterTemp) > config.max6675TempJumpThreshold) {
            spikeCount++;
            if (spikeCount >= 3) {                    // 3 скачка подряд → шум
                errors.max6675Noise = true; 
                spikeCount = 0; 
                return lastValidHeaterTemp;           // Возвращаем предыдущее валидное значение
            }
        } else { 
            spikeCount = 0;                           // Сброс при нормальных показаниях
            errors.max6675Noise = false; 
            errors.max6675NoiseLogged = false; 
        }
    }
    
    lastRawHeaterTemp = tempC;                        // Сохраняем сырое значение
    lastValidHeaterTemp = tempC;                      // Обновляем последнее валидное
    return tempC;
}

// ========== ЧТЕНИЕ ТЕМПЕРАТУРЫ С DS18B20 С КАЛИБРОВКОЙ ==========
// Возвращает: температура воздуха в °C или DEVICE_DISCONNECTED_C при ошибке
// Вызывается: sensorTask() после завершения асинхронной конверсии датчика
// Калибровка: temp = raw * scale + offset (если включена в настройках)
float readDS18B20Temperature() {
    if (ds18b20 == nullptr) return DEVICE_DISCONNECTED_C;
    
    float raw = ds18b20->getTempCByIndex(0);      // Чтение первого (и единственного) датчика на шине
    
    // Проверка на отключение датчика (возвращает -127 при ошибке)
    if (raw <= DEVICE_DISCONNECTED_C) return DEVICE_DISCONNECTED_C;
    
    // Применяем калибровку если включена (scale — масштаб, offset — смещение)
    if (config.ds18b20CalEnabled) 
        raw = raw * config.ds18b20Scale + config.ds18b20Offset;
    
    return raw;
}

// ========== ОБНАРУЖЕНИЕ ЗАВИСАНИЯ MAX6675 ==========
// Проверяет: меняется ли температура нагревателя при включённом нагреве
// Если температура не меняется дольше MAX6675_STUCK_TIME (120 сек) → ошибка
// Вызывается: checkMAX6675Faults() из sensorTask() после каждого чтения
void checkMAX6675Stuck() {
    static unsigned long lastChange = 0;              // Время последнего изменения температуры
    static float lastTemp = 25.0;                     // Последняя запомненная температура
    
    // Температура изменилась менее чем на 0.5°C
    if (abs(heaterTemp - lastTemp) < 0.5f) {
        // Зависание дольше таймаута И нагреватель включен (только тогда ожидаем рост)
        if (millis() - lastChange > MAX6675_STUCK_TIME && heaterState) {
            errors.max6675StuckCount++;
            if (errors.max6675StuckCount >= 3) 
                errors.max6675Stuck = true;           // 3 раза подряд → подтверждённое зависание
            if (errors.max6675StuckCount >= config.maxErrorRetries) 
                errors.lockSystem("MAX6675 постоянно зависает", "max6675_stuck");
        }
    } else { 
        // Температура изменилась — всё в порядке, сбрасываем счётчики
        lastTemp = heaterTemp; 
        lastChange = millis(); 
        errors.max6675Stuck = false; 
        errors.max6675StuckLogged = false; 
        errors.max6675StuckCount = 0;                 // Сброс счётчика зависаний
    }
}

// ========== ПОПЫТКА ВОССТАНОВЛЕНИЯ MAX6675 ==========
// Периодически проверяет, появилась ли связь после обрыва
// Вызывается: checkMAX6675Faults() из sensorTask() каждые MAX6675_RECOVERY_INTERVAL (30 сек)
void checkMAX6675Recovery() {
    if (!errors.max6675Disconnected) return;          // Датчик работает — нечего восстанавливать
    
    // Проверяем не чаще MAX6675_RECOVERY_INTERVAL (30 секунд)
    if (millis() - max6675LastRecoveryCheck <= MAX6675_RECOVERY_INTERVAL) return;
    max6675LastRecoveryCheck = millis();
    
    // Пробное чтение сырых данных
    taskENTER_CRITICAL(&max6675Mux);
    uint16_t testRaw = readMAX6675Raw();
    taskEXIT_CRITICAL(&max6675Mux);
    
    // Проверка валидности: нет бита ошибки, данные не нулевые, не все единицы
    if (!(testRaw & 0x4) && testRaw != 0 && testRaw != 0xFFFF) {
        float testTemp = (testRaw >> 3) * 0.25f + config.max6675Offset;
        // Температура должна быть в допустимом диапазоне (не мусор)
        if (testTemp > config.max6675MinTemp && testTemp < config.max6675MaxTemp) {
            errors.max6675Disconnected = false; 
            errors.max6675DisconnectedLogged = false; 
            errors.max6675DisconnectedCount = 0;      // Сброс счётчика отключений
            max6675_initialized = true;               // Восстанавливаем флаг инициализации
            addNotificationToLog("✅ MAX6675 восстановлен после обрыва");
        }
    }
}

// ========== ОБЩАЯ ПРОВЕРКА НЕИСПРАВНОСТЕЙ MAX6675 ==========
// Объединяет проверку зависания и попытки восстановления в одну точку вызова
// Вызывается: sensorTask() после каждого чтения температуры
// Пропускает проверки если система заблокирована или защита MAX6675 отключена
void checkMAX6675Faults() { 
    if (!config.enableMAX6675Protection || errors.isSystemLocked()) return; 
    checkMAX6675Stuck();                              // Проверка зависания
    checkMAX6675Recovery();                           // Попытка восстановления
}

// ========== КАЛИБРОВКА MAX6675 ПО ЭТАЛОННОЙ ТЕМПЕРАТУРЕ ==========
// Вычисляет смещение (offset) для корректировки показаний MAX6675
// Параметры: referenceTemp — эталонная температура с внешнего термометра (°C)
// Вызывается: API /api/calibrate-max6675
// Алгоритм: делает серию измерений, усредняет, вычисляет разницу с эталоном
void calibrateMAX6675(float referenceTemp) {
    if (errors.max6675Disconnected) { 
        addErrorToLog("❌ Невозможно калибровать — MAX6675 не отвечает", true, false, 0); 
        return; 
    }
    
    float sum = 0; 
    int validReadings = 0;
    addNotificationToLog("🔄 Калибровка MAX6675 по эталону " + String(referenceTemp, 1) + "°C");
    
    // Делаем MAX6675_CALIBRATION_SAMPLES (10) измерений для усреднения
    for (int i = 0; i < MAX6675_CALIBRATION_SAMPLES; i++) {
        float temp = readMAX6675Temperature();
        if (temp > DEVICE_DISCONNECTED_C + 1) {       // Валидное значение (не -127)
            sum += temp; 
            validReadings++; 
        }
        vTaskDelay(pdMS_TO_TICKS(MAX6675_READ_INTERVAL));  // Ждём между измерениями
    }
    
    // Проверка валидности калибровки (нужно хотя бы половина успешных чтений)
    if (validReadings < MAX6675_CALIBRATION_SAMPLES / 2) { 
        addErrorToLog("❌ Слишком мало корректных чтений для калибровки", true, false, 0); 
        return; 
    }
    
    float averageTemp = sum / validReadings;          // Средняя температура по измерениям
    float newOffset = referenceTemp - averageTemp;    // Вычисляем смещение (offset)
    
    // Предупреждение при аномально большом смещении (>20°C)
    if (abs(newOffset) > 20.0f) 
        addErrorToLog("⚠️ Калибровка дала слишком большой оффсет (" + String(newOffset, 1) + "°C)", 
                     false, true, 0);
    
    // Сохраняем новое смещение в конфигурацию и энергонезависимую память
    config.max6675Offset = newOffset;
    saveConfig();
    addNotificationToLog("✅ MAX6675 откалиброван: offset = " + String(newOffset, 2) + "°C");
}

// ============================================================================
// ЗАДАЧА 1: СЕНСОРЫ (ОПРОС ДАТЧИКОВ)
// ============================================================================

// Задача FreeRTOS для асинхронного опроса датчиков температуры
// Ядро: 1, Приоритет: 8, Стек: 4KB
// Выполняется: постоянно в цикле с задержкой 10 мс
// Особенности:
//   - MAX6675 опрашивается каждый readInterval (медианный фильтр внутри)
//   - DS18B20 опрашивается асинхронно (запрос → ожидание конверсии → чтение)
//   - Критические секции защищают глобальные переменные температуры
void sensorTask(void* parameter) {
    // Таймеры для периодического опроса
    Timer timerMAX6675(config.readInterval);        // MAX6675: интервал из конфига
    Timer timerDS18B20(config.readInterval);        // DS18B20: тот же интервал (упрощено)
    
    // Константы для DS18B20
    static const unsigned long DS_CONVERSION_TIME = 100;      // Время конверсии при 9 бит (~100 мс)
    static const int DS_MAX_CONSECUTIVE_ERRORS = 3;           // Ошибок подряд до объявления отключения
    static const unsigned long DS_ERROR_LOG_INTERVAL = 10000; // Мин. интервал между логами ошибок (10 сек)
    
    // Состояние DS18B20
    static unsigned long lastDSRequest = 0;         // Время последнего запроса конверсии
    static bool dsWaiting = false;                  // Флаг ожидания завершения конверсии
    static int consecutiveDSErrors = 0;             // Счётчик последовательных ошибок
    static unsigned long lastDSErrorTime = 0;       // Время последней залогированной ошибки
    
    while (true) {
        unsigned long now = millis();
        
        // ========== ОПРОС MAX6675 (ТЕРМОПАРА НАГРЕВАТЕЛЯ) ==========
        if (timerMAX6675.ready(now)) {
            float newHeaterTemp = readMAX6675Temperature();
            
            // Сохраняем новое значение только если оно валидное
            if (newHeaterTemp > DEVICE_DISCONNECTED_C) {  // > -127 (не -127 и не меньше)
                ENTER_CRITICAL_TEMP();                    // Вход в критическую секцию
                heaterTemp = newHeaterTemp;               // Обновляем глобальную переменную
                EXIT_CRITICAL_TEMP();                     // Выход из критической секции
            }
            
            // Проверка неисправностей только после чтения
            checkMAX6675Faults();
        }
        
        // ========== ОПРОС DS18B20 (ДАТЧИК ВОЗДУХА) ==========
        // Опрашиваем только если датчик инициализирован
        if (timerDS18B20.ready(now) && ds18b20 != nullptr) {
            
            // ---- ФАЗА 1: ЗАПРОС КОНВЕРСИИ (ЕСЛИ НЕ ЖДЁМ) ----
            if (!dsWaiting) {
                ds18b20->requestTemperatures();     // Запускаем асинхронное измерение
                dsWaiting = true;                   // Переходим в режим ожидания
                lastDSRequest = now;                // Запоминаем время запроса
            }
            
            // ---- ФАЗА 2: ЧТЕНИЕ РЕЗУЛЬТАТА (ПОСЛЕ КОНВЕРСИИ) ----
            if (dsWaiting && (now - lastDSRequest >= DS_CONVERSION_TIME)) {
                float newTemp = readDS18B20Temperature();
                dsWaiting = false;                  // Сбрасываем флаг ожидания
                
                // Валидация: не -127, в физическом диапазоне DS18B20
                bool isValid = (newTemp > DEVICE_DISCONNECTED_C && 
                               newTemp > -55.0f && 
                               newTemp < 125.0f);
                
                if (isValid) {
                    // Успешное чтение — сбрасываем счётчики ошибок
                    consecutiveDSErrors = 0;
                    ds18b20Error = false;
                    errors.ds18b20Disconnected = false;
                    
                    // Обновляем глобальную переменную в критической секции
                    ENTER_CRITICAL_TEMP();
                    airTemp = newTemp;
                    EXIT_CRITICAL_TEMP();
                    
                } else {
                    // Ошибка чтения — накапливаем счётчик
                    consecutiveDSErrors++;
                    ds18b20Error = true;
                    
                    // Логируем ошибку не чаще DS_ERROR_LOG_INTERVAL (10 сек)
                    if (now - lastDSErrorTime >= DS_ERROR_LOG_INTERVAL) {
                        lastDSErrorTime = now;
                        // Логируем только если накопилось 2+ ошибки (не спамим на единичные сбои)
                        if (consecutiveDSErrors >= 2) {
                            addErrorToLog("⚠️ DS18B20: ошибка чтения (" + 
                                         String(consecutiveDSErrors) + " подряд)", 
                                         false, false, 0);
                        }
                    }
                    
                    // После DS_MAX_CONSECUTIVE_ERRORS ошибок подряд — датчик отключён
                    if (consecutiveDSErrors >= DS_MAX_CONSECUTIVE_ERRORS) {
                        if (!errors.ds18b20Disconnected) {  // Логируем только при изменении состояния
                            errors.ds18b20Disconnected = true;
                            addErrorToLog("❌ DS18B20 отключён (" + 
                                         String(consecutiveDSErrors) + " ошибок подряд)", 
                                         true, false, 0);
                        }
                    }
                }
            }
        }
        
        // Задержка 10 мс — предотвращает монополизацию CPU (100 Гц достаточно)
        vTaskDelay(pdMS_TO_TICKS(10));
    }
}

// ============================================================================
// ЗАДАЧА 2: LED ИНДИКАЦИЯ
// ============================================================================

// Задача FreeRTOS для обновления светодиодной индикации
// Ядро: 0, Приоритет: 2, Стек: 2KB, Интервал: LED_INTERVAL (50 мс)
// Выполняется: постоянно, обновляет LED ленту с частотой 20 Гц
void ledTask(void* parameter) {
    while (true) {
        updateLEDs();
        vTaskDelay(pdMS_TO_TICKS(LED_INTERVAL));
    }
}

// ============================================================================
// ЗАДАЧА 3: УПРАВЛЕНИЕ (ОСНОВНАЯ ЛОГИКА)
// ============================================================================

// Главная задача управления системой, выполняет все критические функции
// Ядро: 1, Приоритет: 10 (высокий), Стек: 12KB
// Контролируется аппаратным Watchdog'ом ESP32 (при зависании → паника и перезагрузка)
// Выполняется: постоянно, задержка 10 мс между итерациями (100 Гц)
// Структура: все проверки сгруппированы по приоритету и частоте выполнения
void controlTask(void* parameter) {
    // ========== ОТЛАДКА: НАЧАЛЬНЫЙ РАЗМЕР СТЕКА ==========
    UBaseType_t initialStack = uxTaskGetStackHighWaterMark(NULL);
    LOG_DEBUG("ControlTask initial stack: %u bytes (max %u)", initialStack, 12 * 1024);
    
    // ========== ТАЙМЕРЫ ДЛЯ ПЕРИОДИЧЕСКИХ ЗАДАЧ ==========
    // Сгруппированы по частоте: сверху — самые частые, снизу — редкие
    
    // Высокочастотные (каждые 200-1000 мс)
    Timer timerHeater(config.heaterControlInterval);       // Управление нагревателем (~200 мс)
    Timer timerFan(config.fanControlInterval);             // Управление вентилятором (~1000 мс)
    Timer timerSnapshot(1000);                             // Снапшот для быстрого API (1 сек)
    
    // Защиты среднечастотные (1-2 сек)
    Timer timerProtections(1000);                          // Быстрые защиты: перегрев, эффективность
    Timer timerRate(config.rateCheckInterval);             // Аномальная скорость нагрева (~1000 мс)
    Timer timerThermal(2000);                              // Термальная модель (~2000 мс)
    Timer timerUnexpected(config.unexpectedCheckInterval); // Unexpected Heat (~2000 мс)
    Timer timerAdapt(500);                                 // Адаптация (каждые 500 мс)
    
    // Низкочастотные (5-60 сек)
    Timer timerRunaway(config.runawayCheckInterval);       // Thermal Runaway (~5000 мс)
    Timer timerStackCheck(30000);                          // Проверка стека (30 сек)
    Timer timerAutoReboot(60000);                          // Проверка автоперезагрузки (60 сек)
    
    // ========== ПЕРЕМЕННЫЕ ДЛЯ МОНИТОРИНГА ==========
    unsigned long loopCount = 0;                           // Счётчик итераций для статистики
    unsigned long maxLoopTime = 0;                         // Максимальное время цикла (мкс)
    static unsigned long lastStatsLog = 0;                 // Время последнего вывода статистики
    
    while (true) {
        unsigned long loopStart = micros();                // Замер времени выполнения цикла
        esp_task_wdt_reset();                              // Сброс сторожевого таймера ESP32
        unsigned long now = millis();
        
        // ========== БЛОК 1: КРИТИЧЕСКИ БЫСТРЫЕ ОПЕРАЦИИ (КАЖДЫЙ ЦИКЛ) ==========
        
        // 1.1 Снапшот для быстрого API ответа (раз в секунду)
        if (timerSnapshot.ready(now)) {
            updateSnapshot();
        }
        
        // ========== БЛОК 2: УПРАВЛЕНИЕ ИСПОЛНИТЕЛЬНЫМИ УСТРОЙСТВАМИ ==========
        
        // 2.1 Нагреватель (SSR, вкл/выкл с гистерезисом)
        if (timerHeater.ready(now)) {
            updateHeaterControl();
        }
        
        // 2.2 Вентилятор (ШИМ, динамическая коррекция duty)
        if (timerFan.ready(now)) {
            updateFan();
        }
        
        // ========== БЛОК 3: ЗАЩИТЫ (ПРОПУСКАЮТСЯ ПРИ АДАПТАЦИИ) ==========
        if (!adaptationInProgress) {
            
            // 3.1 Быстрые проверки (каждую секунду)
            if (timerProtections.ready(now)) {
                checkHeaterOverheat();                    // Перегрев нагревателя (>criticalTemp)
                checkAirOverheat();                       // Перегрев воздуха (>maxAirTemp)
                checkFanEfficiency();                     // Эффективность охлаждения вентилятором
                if (config.enableAirSensorProtection) {
                    checkAirSensor();                     // Стабильность датчика воздуха
                }
            }
            
            // 3.2 Аномальная скорость нагрева (каждую секунду)
            if (timerRate.ready(now)) {
                checkHeatingRate();                       // Слишком быстрый рост температуры
            }
            
            // 3.3 Unexpected Heat (каждые ~2 секунды)
            if (timerUnexpected.ready(now)) {
                checkUnexpectedHeat();                    // Нагрев при выключенном SSR
            }
            
            // 3.4 Thermal Runaway (каждые ~5 секунд, 3-фазный контроль)
            if (timerRunaway.ready(now)) {
                checkThermalRunaway();                    // Медленный/отсутствующий нагрев
            }
        }
        
        // ========== БЛОК 4: ТЕРМАЛЬНАЯ МОДЕЛЬ (ЕСЛИ АКТИВНА) ==========
        if (config.enableThermalModel && timerThermal.ready(now)) {
            checkThermalModel();                          // Предсказание + обнаружение аномалий
        }
        
        // ========== БЛОК 5: АДАПТАЦИЯ (ЕСЛИ АКТИВНА) ==========
        if (adaptationInProgress && timerAdapt.ready(now)) {
            processAdaptation();                          // Конечный автомат самонастройки
        }
        
        // ========== БЛОК 6: СЛУЖЕБНЫЕ ПРОВЕРКИ ==========
        
        // 6.1 Автоперезагрузка при длительном бездействии (раз в минуту)
        if (timerAutoReboot.ready(now) && !rebootInProgress && rebootTimerActive) {
            unsigned long idleTime = now - lastActivityTime;
            
            if (idleTime >= AUTO_REBOOT_TIMEOUT) {
                // Перезагружаемся ТОЛЬКО если:
                // 1. Нагрев выключен (безопасно)
                // 2. Нет целевой температуры
                // 3. Система НЕ заблокирована (важно!)
                if (!heaterState && targetTemp == 0 && !errors.isSystemLocked()) {
                    LOG_INFO("Бездействие %lu минут, перезагрузка...", idleTime / 60000);
                    rebootInProgress = true;
                    vTaskDelay(pdMS_TO_TICKS(1000));
                    performAutoReboot();
                } else {
                    resetActivityTimer();
                }
            }
        }
        
        // ========== 6.2 РУЧНОЙ ТАЙМЕР (ПРОВЕРКА КАЖДЫЙ ЦИКЛ) ==========
        // Отключает нагрев по истечении заданного пользователем времени
        // Работает независимо от Moonraker и других защит
        // Логика: пользователь выставил время -> таймер пошёл -> нагрев отключился
        // Не требует никаких дополнительных условий (активность, печать и т.д.)
        if (manualTimerActive && millis() >= manualTimerEndTime) {
            targetTemp = 0;
            
            // --- СБРОС ФЛАГОВ ТАЙМЕРА ---
            manualTimerActive = false;
            manualTimerEndTime = 0;
            
            // --- СОХРАНЕНИЕ СОСТОЯНИЯ В PREFERENCES ---
            // Чтобы после перезагрузки цель не восстановилась
            Preferences prefs;
            if (prefs.begin("flook", false)) {
                prefs.putFloat("lastTarget", 0.0f);
                prefs.end();
            }
            
            // --- ЛОГИРОВАНИЕ В ЖУРНАЛ И SERIAL ---
            addNotificationToLog("⏰ Ручной таймер: нагрев отключён");
            LOG_INFO("Ручной таймер сработал, нагрев выключен");
        }
        
        // 6.4 Проверка стека задачи (каждые 30 секунд)
        if (timerStackCheck.ready(now)) {
            UBaseType_t currentStack = uxTaskGetStackHighWaterMark(NULL);
            
            // Критически мало стека (<1KB) — логируем как ошибку
            if (currentStack < 1000) {
                LOG_WARN("Критически малый стек ControlTask: %u байт", currentStack);
                addErrorToLog("⚠️ Критически мало стека controlTask: " + String(currentStack) + " bytes", 
                             true, false, 0);
            } 
            // Предупреждение при малом стеке (<2KB)
            else if (currentStack < 2000) {
                LOG_WARN("Низкий стек ControlTask: %u байт", currentStack);
            }
            
            // Статистика производительности (раз в 5 минут)
            if (now - lastStatsLog > 300000) {
                lastStatsLog = now;
                LOG_DEBUG("ControlTask: loops=%lu, maxLoop=%lu us, stackFree=%u/%u bytes", 
                        loopCount, maxLoopTime, currentStack, 12 * 1024);
                loopCount = 0;
                maxLoopTime = 0;
            }
        }
        
        // ========== МОНИТОРИНГ ВРЕМЕНИ ЦИКЛА ==========
        unsigned long loopTime = micros() - loopStart;
        if (loopTime > maxLoopTime) maxLoopTime = loopTime;
        if (loopTime > 10000) {                           // >10 мс = аномалия
            LOG_WARN("ControlTask медленный цикл: %lu мкс (макс: %lu мкс)", loopTime, maxLoopTime);
        }
        loopCount++;
        
        // ========== ЗАДЕРЖКА ДЛЯ КООПЕРАТИВНОЙ МНОГОЗАДАЧНОСТИ ==========
        // 10 мс = 100 итераций/сек, достаточно для всех таймеров
        vTaskDelay(pdMS_TO_TICKS(10));
    }
}

// ============================================================================
// ЗАДАЧА 4: ВЕБ-СЕРВЕР И ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
// ============================================================================

// Задача FreeRTOS для обработки веб-запросов, WebSocket, UDP discovery и индикации
// Ядро: 0 (сетевое), Приоритет: 9 (высокий, для отзывчивого веб-интерфейса), Стек: 16KB
// Выполняется: постоянно, задержка 10 мс между итерациями (100 Гц)
// Особенности:
//   - Не управляет нагревателем (безопасность: работает на отдельном ядре)
//   - Обрабатывает некритические задачи: LED, зуммер, UDP, тренды, память
//   - Отправляет WebSocket метрики (sendMetricsToClients) на ядре async_tcp
//   - При низкой памяти экстренно сокращает журнал ошибок
//   - Выводит периодическую статистику для мониторинга (раз в 5 минут)
void webTask(void* parameter) {
    // ========== ТАЙМЕРЫ ДЛЯ ПЕРИОДИЧЕСКИХ ЗАДАЧ ==========
    // Сгруппированы по частоте: сверху — самые частые
    
    Timer timerTrend(config.trendInterval);       // Сохранение трендов (~3 сек по умолчанию)
    Timer timerErrorCheck(5000);                  // Проверка и автосброс ошибок (5 сек)
    Timer timerUDP(UDP_INTERVAL);                 // UDP discovery Klipper (5 сек)
    Timer timerMem(60000);                        // Проверка кучи памяти (1 минута)
    Timer timerMetrics(1000);                     // Отправка WebSocket метрик (1 сек)
    Timer timerKlipperCheck(30000);               // Проверка доступности Klipper (30 сек)
    Timer timerPrintStatus(60000);                // Статус печати Moonraker (60 сек)
    Timer timerWifiReconnect(60000);    // Попытка переподключения Wi-Fi (60 сек)

    
    // ========== ПЕРЕМЕННЫЕ ДЛЯ МОНИТОРИНГА ПАМЯТИ ==========
    static const uint32_t CRITICAL_FREE_HEAP = 20000;   // Порог критически низкой памяти (20KB)
    static const uint32_t CRITICAL_MAX_BLOCK = 20000;   // Порог критической фрагментации (20KB блок)
    static const size_t MAX_ERROR_LOG_EMERGENCY = 10;   // Максимум записей при экстренной очистке
    
    // ========== ПЕРЕМЕННЫЕ ДЛЯ ПЕРИОДИЧЕСКОЙ СТАТИСТИКИ ==========
    static unsigned long lastStatsLog = 0;              // Время последнего вывода статистики
    static const unsigned long STATS_INTERVAL = 300000; // Интервал вывода статистики (5 минут)
    
    while (true) {
        unsigned long loopStart = micros();             // Замер времени цикла для отладки
        unsigned long now = millis();
        
        // ========== БЛОК 1: ВИЗУАЛЬНАЯ И ЗВУКОВАЯ ИНДИКАЦИЯ (КАЖДЫЙ ЦИКЛ) ==========
        // Выполняются всегда для отзывчивого UX (пользовательский опыт)
        // Эти функции быстрые (< 1 мс каждая) и не блокируют задачу
        
        // 1.1 Звуковая индикация через активный зуммер (KY-012)
        updateBuzzer();
        
        // 1.2 Периодический сигнал при блокировке системы
        checkLockBeep();
        
        // ========== БЛОК 2: СЕТЕВЫЕ ОПЕРАЦИИ ==========
        
        // 2.1 Отправка WebSocket метрик (раз в секунду, если есть клиенты)
        if (timerMetrics.ready(now) && ws.count() > 0) {
            sendMetricsToClients();
        }
        
        // 2.2 UDP discovery — обнаружение Klipper в локальной сети (каждые 5 сек)
        if (timerUDP.ready(now)) {
            handleUDPDiscovery();
        }

        // 2.3 Проверка доступности Klipper в сети (каждые 30 сек)
        if (timerKlipperCheck.ready(now)) {
            // Берём IP из NVS только один раз при старте
            static bool nvsChecked = false;
            if (!nvsChecked && !klipperStatus.detected) {
                Preferences prefs;
                if (prefs.begin("flook", true)) {
                    String savedIp = prefs.getString("klipper_ip", "");
                    if (savedIp.length() > 0 && klipperStatus.ip.fromString(savedIp)) {
                        klipperStatus.ip.fromString(savedIp);
                        klipperStatus.lastSeen = 0;  // Не ставим detected, ждём TCP-проверки
                        LOG_INFO("IP Klipper загружен из NVS: %s", savedIp.c_str());
                    }
                    prefs.end();
                }
                nvsChecked = true;
            }
            
            if (klipperStatus.ip != IPAddress(0,0,0,0)) {
                WiFiClient client;
                client.setTimeout(100);
                bool reachable = false;
                int ports[] = {7125, 80, 443, 22};
                for (int port : ports) {
                    if (client.connect(klipperStatus.ip, port)) {
                        reachable = true;
                        client.stop();
                        break;
                    }
                }
                
                if (reachable) {
                    klipperStatus.lastSeen = millis();
                    if (!klipperStatus.detected) {
                        klipperStatus.detected = true;
                        LOG_INFO("Klipper доступен по TCP: %s", klipperStatus.ip.toString().c_str());
                        addNotificationToLog("✅ Связь с Klipper восстановлена: " + klipperStatus.ip.toString());
                    }
                } else {
                    if (millis() - klipperStatus.lastSeen > 60000) {
                        if (klipperStatus.detected) {
                            klipperStatus.detected = false;
                            LOG_WARN("Klipper %s недоступен более 60 сек — статус сброшен", 
                                    klipperStatus.ip.toString().c_str());
                            addErrorToLog("🔌 Потеряна связь с Klipper " + klipperStatus.ip.toString(), 
                                        false,   // isCritical — красная ошибка
                                        false,   // saveToNVS — не нужно, это не блокировка
                                        0);      // retries — 0, не считаем повторы
                        }
                    }
                }
            }
        }

        // 2.4 Статус печати из Moonraker (раз в минуту)
        if (timerPrintStatus.ready(now)) {
            fetchPrintStatus();
        }  

        // 2.5 Фоновое переподключение Wi-Fi
        if (timerWifiReconnect.ready(now) && config.wifiConfigured && WiFi.status() != WL_CONNECTED) {
            LOG_INFO("🔄 Попытка переподключения к %s...", config.ssid);
            WiFi.begin(config.ssid, config.password);
        }

        
        // ========== БЛОК 3: ДИАГНОСТИКА И ЛОГИРОВАНИЕ ==========
        
        // 3.1 Проверка и автоматический сброс ошибок
        if (timerErrorCheck.ready(now)) {
            errors.checkAutoClear();
            errors.checkAndLogErrors();
        }
        
        // 3.2 Сохранение показаний в кольцевой буфер трендов
        if (timerTrend.ready(now)) {
            addToTrendBuffer();
        }
        
        // ========== БЛОК 4: ПОЛЬЗОВАТЕЛЬСКИЙ ВВОД ==========
        
        // 4.1 Обработка аппаратной кнопки сброса (GPIO17)
        checkButton();
        
        // ========== БЛОК 5: КОНТРОЛЬ ПАМЯТИ (РАЗ В МИНУТУ) ==========
        if (timerMem.ready(now)) {
            uint32_t freeHeap = ESP.getFreeHeap();          // Свободная куча в байтах
            uint32_t maxBlock = ESP.getMaxAllocHeap();      // Максимальный непрерывный блок
            
            // ----- 5.0 Расчёт фрагментации -----
            // Если максимальный блок < 30% от свободной кучи — фрагментация критическая
            float fragRatio = (freeHeap > 0) ? (float)maxBlock / freeHeap : 1.0f;
            static int emergencyClears = 0;                 // Счётчик экстренных очисток
            static unsigned long lastEmergencyClear = 0;    // Время последней очистки
            
            // ----- 5.1 Экстренная очистка при критически низкой памяти -----
            // Условия срабатывания:
            //   - Свободной кучи < 20KB ИЛИ
            //   - Нет непрерывного блока размером 20KB (фрагментация) ИЛИ
            //   - Фрагментация > 70% (maxBlock < 30% от freeHeap)
            // Действие: сокращаем журнал ошибок до 10 записей (FIFO)
            if (freeHeap < CRITICAL_FREE_HEAP || maxBlock < CRITICAL_MAX_BLOCK || fragRatio < 0.3f) {
                
                // Формируем причину для лога
                String reason = "";
                if (freeHeap < CRITICAL_FREE_HEAP) reason += "мало памяти(" + String(freeHeap) + "б) ";
                if (maxBlock < CRITICAL_MAX_BLOCK) reason += "малый блок(" + String(maxBlock) + "б) ";
                if (fragRatio < 0.3f) reason += "фрагментация(" + String((int)(fragRatio * 100)) + "%) ";
                
                LOG_WARN("Критическое состояние памяти: %s— очистка логов", reason.c_str());
                
                // Жёлтое предупреждение в журнал ошибок (не чаще раза в 5 минут)
                if (millis() - lastEmergencyClear > 300000) {
                    addErrorToLog("⚠️ Критическое состояние памяти: " + reason + "- логи сокращены",
                                  false, false, 0);
                }
                
                // Критическая секция: защищаем вектор от одновременного доступа
                taskENTER_CRITICAL(&errorLogMux);
                while (errorLog.size() > MAX_ERROR_LOG_EMERGENCY) {
                    errorLog.pop_back();                  // Удаляем самые старые записи (FIFO)
                }
                taskEXIT_CRITICAL(&errorLogMux);
                
                lastEmergencyClear = millis();
                emergencyClears++;
                
                // ----- 5.1b Автоматический ребут при повторяющихся проблемах -----
                // Если за последний час было 5+ экстренных очисток — возможна утечка памяти
                // Автоматическая перезагрузка безопаснее чем зависание
                if (emergencyClears >= 5) {
                    LOG_ERROR("КРИТИЧЕСКАЯ УТЕЧКА ПАМЯТИ: %d очисток за час — принудительная перезагрузка", 
                              emergencyClears);
                    addErrorToLog("💀 Обнаружена утечка памяти! Автоматическая перезагрузка...",
                                  true, true, config.maxErrorRetries);
                    
                    // Даём время на отправку WebSocket-сообщения
                    delay(500);
                    ESP.restart();
                }
                
                // Примечание: кэш конфигурации (cachedConfigDoc) НЕ очищается,
                // так как это заблокирует API /api/config до следующего обновления
            } else {
                // Память в норме — сбрасываем счётчик экстренных очисток
                // (медленно: раз в 10 минут уменьшаем на 1, чтобы не сбрасывать резко)
                static unsigned long lastEmergencyDecay = 0;
                if (millis() - lastEmergencyDecay > 600000 && emergencyClears > 0) {
                    emergencyClears--;
                    lastEmergencyDecay = millis();
                }
            }
            
            // ----- 5.2 Превентивное предупреждение -----
            // Предупреждаем если память приближается к критическому порогу
            // (меньше 40KB свободной кучи)
            // Используем флаг для однократного вывода
            static bool lowMemWarningShown = false;
            if (freeHeap < CRITICAL_FREE_HEAP * 2 && !lowMemWarningShown) {
                lowMemWarningShown = true;
                LOG_WARN("Низкая память: %u байт свободно (maxBlock=%u, фрагментация=%.0f%%)", 
                         freeHeap, maxBlock, (1.0f - fragRatio) * 100);
                addErrorToLog("📉 Низкая память: " + String(freeHeap) + " байт свободно",
                              false, false, 0);
            }
            // Сбрасываем флаг когда память восстановилась
            if (freeHeap >= CRITICAL_FREE_HEAP * 2 && fragRatio > 0.5f) {
                if (lowMemWarningShown) {
                    addNotificationToLog("✅ Память восстановлена: " + String(freeHeap) + " байт свободно");
                }
                lowMemWarningShown = false;
            }
        }
        
        // ========== БЛОК 6: ПЕРИОДИЧЕСКАЯ СТАТИСТИКА (РАЗ В 5 МИНУТ) ==========
        if (now - lastStatsLog > STATS_INTERVAL) {
            lastStatsLog = now;
            
            // Выводим ключевые показатели для мониторинга:
            //   - Свободная куча (байт)
            //   - Количество WebSocket клиентов
            //   - Количество записей в журнале ошибок
            //   - Текущий индекс в буфере трендов
            LOG_INFO("Статистика: куча=%u байт, WS клиентов=%d, ошибок в логе=%d, трендов=%d/%d",
                     ESP.getFreeHeap(),
                     ws.count(),
                     errorLog.size(),
                     trendIndex,
                     TREND_BUFFER_SIZE);
            
            // Дополнительная отладочная информация (только в DEBUG_MODE)
            #ifdef DEBUG_MODE
            LOG_DEBUG("Статистика мьютексов: tempMuxWait=%lu мкс", tempMuxWaitTime);
            LOG_DEBUG("Статистика API: configCache=%s, snapshotVersion=%lu",
                     configCacheValid ? "валиден" : "невалиден",
                     snapshot.version);
            #endif
        }
        
        // ========== МОНИТОРИНГ ВРЕМЕНИ ЦИКЛА (ДЛЯ ОТЛАДКИ) ==========
        // Измеряем сколько времени заняла одна итерация цикла
        // Предупреждаем если > 5 мс (может указывать на проблему)
        #ifdef DEBUG_WEBTASK_PERF
        unsigned long loopTime = micros() - loopStart;
        if (loopTime > 5000) {                             // >5 мс = подозрительно медленно
            LOG_WARN("WebTask: медленный цикл (%lu мкс)", loopTime);
        }
        #endif
        
        // ========== ЗАДЕРЖКА ДЛЯ КООПЕРАТИВНОЙ МНОГОЗАДАЧНОСТИ ==========
        vTaskDelay(pdMS_TO_TICKS(10));
    }
}

// ============================================================================
// ЗАДАЧА 5: HEARTBEAT (СТОРОЖЕВОЙ ТАЙМЕР ESP01S)
// ============================================================================

// Задача FreeRTOS для генерации импульсов на пине сторожевого таймера
// Сигнал используется внешней схемой (ESP01S или внешний аппаратный WDT) для контроля зависаний
// Принцип: пока ESP32 исправна — на пине меандр (HIGH/LOW переключения)
//          при зависании задачи или всей системы — сигнал застывает → внешняя схема перезагружает питание
// Ядро: 1 (управление), Приоритет: 5 (средний — ниже чем controlTask и sensorTask), Стек: 1KB
// Выполняется: постоянно, задержка 10 мс между итерациями (100 Гц)
// Особенности:
//   - Использует updateHeartbeat() из основной логики (НЕ дублирует код)
//   - Задержка vTaskDelay даёт работать более приоритетным задачам
//   - Минимальный стек (1KB) — задача простая, памяти нужно мало
void heartbeatTask(void* parameter) {
    while (true) { 
        // Генерация импульсов — переключение HIGH/LOW по таймеру
        // Логика внутри: генерирует импульсы ТОЛЬКО если targetTemp > 0 или есть критические ошибки
        updateHeartbeat();
        
        // Задержка 10 мс — даёт работать controlTask (приоритет 10) и sensorTask (приоритет 8)
        vTaskDelay(pdMS_TO_TICKS(10));
    }
}

// ============================================================================
// API ОБРАБОТЧИКИ (ASYNC WEB SERVER)
// ============================================================================

// ========== GET /api/all - БЫСТРЫЙ ОТВЕТ СО ВСЕМИ СОСТОЯНИЯМИ ==========
// Возвращает компактный JSON со всеми текущими параметрами системы
// Использует кэшированный снапшот (updateSnapshot раз в секунду) для максимальной скорости
// Вызывается: веб-интерфейсом для получения всех данных одним запросом (~1KB ответа)
// Особенности:
//   - Не блокирует другие задачи (берёт готовый снапшот из критической секции)
//   - Распаковывает IP Klipper из uint32_t обратно в строку
//   - Не аллоцирует динамическую память (snprintf в стековый буфер)
void handleApiAllStates(AsyncWebServerRequest *request) {
    // Атомарное чтение снапшота (защищено мьютексом от одновременной записи controlTask)
    SystemSnapshot s;
    portENTER_CRITICAL(&snapshotMux);
    s = snapshot;
    portEXIT_CRITICAL(&snapshotMux);
    
    // Чтение уникального ID устройства из энергонезависимой памяти
    // Используется для идентификации в Moonraker/Mainsail
    Preferences prefs_id;
    prefs_id.begin("flook", true);                    // true = только чтение
    uint32_t device_id = prefs_id.getUInt("device_id", 0);
    prefs_id.end();
    
    // Распаковка IP адреса Klipper из uint32_t в человекочитаемый формат
    char ipStr[16] = "0.0.0.0";
    if (s.klipperDetected && s.klipperIp != 0) {
        uint32_t ip = s.klipperIp;
        snprintf(ipStr, sizeof(ipStr), "%u.%u.%u.%u", 
                 (ip >> 24) & 0xFF,                    // Октет A
                 (ip >> 16) & 0xFF,                    // Октет B
                 (ip >> 8) & 0xFF,                     // Октет C
                 ip & 0xFF);                           // Октет D
    }
    
    // Формирование компактного JSON ответа (без пробелов для экономии трафика)
    // Поля: t=targetTemp, a=airTemp, h=heaterTemp, s=state, l=locked, u=uptime,
    //       e=errorCount, k=klipperDetected, i=klipperIP, m=thermalConfidence,
    //       hr=heaterRate, cr=coolingRate, nf=noiseFloor, er=avgError,
    //       id=deviceID(hex), fp=fanPower(0-1023), md=moonrakerDetected,
    //       v=version (FW_VERSION)
    char buffer[1152];  // Увеличен на 128 байт для поля v
    int len = snprintf(buffer, sizeof(buffer),
        "{\"t\":%.1f,\"a\":%.1f,\"h\":%.1f,\"s\":%u,\"l\":%u,\"u\":%lu,"
        "\"e\":%u,\"k\":%u,\"i\":\"%s\",\"m\":%u,\"hr\":%.1f,\"cr\":%.2f,"
        "\"nf\":%.2f,\"er\":%.2f,\"id\":\"%08X\",\"fp\":%d,\"md\":%u,\"v\":\"%s\"}",
        s.targetTemp, s.airTemp, s.heaterTemp, s.state, s.locked, 
        (unsigned long)s.uptime,
        s.errorCount, s.klipperDetected, ipStr, s.thermalConfidence,
        s.thermalHeaterRate, s.thermalCoolingRate, s.thermalNoiseFloor, s.thermalError,
        device_id, actualFanDuty, s.moonrakerDetected,
        FW_VERSION);  // Добавлена версия прошивки
    
    // Проверка на переполнение буфера (безопасность)
    if (len >= (int)sizeof(buffer)) {
        LOG_WARN("/api/all ответ обрезан! %d >= %u", len, sizeof(buffer));
    }
    
    // Отправка ответа
    AsyncWebServerResponse *response = request->beginResponse(200, "application/json", buffer);
    response->addHeader("Connection", "close");        // Закрываем соединение после ответа
    response->addHeader("Cache-Control", "no-cache");   // Запрещаем кэширование браузером
    request->send(response);
}

// ========== GET /api/config - ПОЛУЧЕНИЕ ВСЕЙ КОНФИГУРАЦИИ ==========
// Возвращает полный JSON со всеми настройками системы (~100 полей, ~5-7KB)
// Поддерживает кэширование (2 секунды) для снижения нагрузки на ESP32
// Вызывается: веб-интерфейсом при загрузке страницы настроек
// Особенности:
//   - Короткие ключи (2-3 символа) для экономии трафика
//   - Кэш валиден API_CACHE_MS (2000 мс), сбрасывается при изменении настроек
//   - Поддерживает принудительное обновление через Cache-Control: no-cache
void handleApiConfig(AsyncWebServerRequest *request) {
    unsigned long now = millis();
    
    // ========== 1. ПРОВЕРКА ЗАГОЛОВКА CACHE-CONTROL ==========
    // Клиент может запросить свежие данные мимо кэша
    bool noCache = false;
    if (request->hasHeader("Cache-Control")) {
        String cacheControl = request->header("Cache-Control");
        noCache = (cacheControl.indexOf("no-cache") >= 0 || 
                   cacheControl.indexOf("no-store") >= 0);
    }
    
    // ========== 2. ВОЗВРАТ КЭШИРОВАННОГО ОТВЕТА (ЕСЛИ ВАЛИДЕН) ==========
    if (!noCache && configCacheValid && (now - configCacheTime < API_CACHE_MS)) {
        AsyncResponseStream *response = request->beginResponseStream("application/json");
        response->addHeader("X-Cache", "HIT");            // Заголовок для отладки кэша
        serializeJson(cachedConfigDoc, *response);
        request->send(response);
        return;
    }
    
    // ========== 3. ФОРМИРОВАНИЕ СВЕЖЕГО JSON ==========
    // StaticJsonDocument фиксированного размера — без фрагментации кучи
    StaticJsonDocument<MAX_JSON_SIZE> doc;                // 8KB для всех полей
    
    // Группировка полей по смыслу для читаемости
    
    // ----- 3.1 Температурные пороги и гистерезисы -----
    doc["mt"] = config.maxHeaterTemp;
    doc["ct"] = config.criticalTemp;
    doc["ch"] = config.criticalHysteresis;
    doc["ma"] = config.maxAirTemp;
    doc["ah"] = config.airHysteresis;
    doc["hy"] = config.hysteresis;
    doc["hh"] = config.heaterHysteresis;
    doc["eH"] = config.enableHeaterHysteresis;
    doc["dt"] = config.defaultTargetTemp;
    doc["iF"] = config.invertFanSignal;
    doc["iH"] = config.invertHeaterSignal;
    doc["mFD"] = config.maxFanDuty;
    doc["sl"] = config.settingsLocked;
    
    // ----- 3.2 Вентилятор -----
    doc["fT"] = config.fanOnTemp;
    doc["fH"] = config.fanOffHysteresis;
    doc["fM"] = config.fanMinOnTime;
    doc["fE"] = config.fanEfficiencyTimeout;
    doc["fF"] = config.fanEfficiencyThreshold;
    doc["eF"] = config.enableFanEfficiencyCheck;
    
    // ----- 3.3 Thermal Runaway -----
    doc["tR"] = config.enableThermalRunawayProtection;
    doc["r1"] = config.runawayPhase1Time;
    doc["r2"] = config.runawayPhase2Time;
    doc["rT"] = config.runawayMaxTimeToTarget;
    doc["rH"] = config.runawayMinHeaterRisePerMin;
    doc["rA"] = config.runawayMinAirRisePerMin;
    doc["rD"] = config.runawayMaxHeaterDrop;
    doc["rY"] = config.runawayHysteresis;
    doc["rR"] = config.runawayRecoveryTimeout;
    doc["rF"] = config.runawayFanOn;
    doc["rQC"] = config.runawayQuickCheckTemp;
    
    // ----- 3.4 Unexpected Heat -----
    doc["uH"] = config.enableUnexpectedHeatProtection;
    doc["uT"] = config.unexpectedHeatTimeout;
    doc["uP"] = config.unexpectedHeatThreshold;
    doc["mC"] = config.minCoolingRate;
    doc["uY"] = config.unexpectedHeatHysteresis;
    doc["uC"] = config.unexpectedHeatClearTime;
    doc["uS"] = config.unexpectedHeatSafeOffset;
    doc["uA"] = config.enableUnexpectedHeatAdaptive;
    doc["aB"] = config.adaptiveBaseTemp;
    doc["aC"] = roundf(config.adaptiveCoefficient * 1000.0f) * 0.001f;  // Округление до 3 знаков
    doc["aM"] = config.adaptiveMinOffset;
    
    // ----- 3.5 MAX6675 (термопара) -----
    doc["mO"] = config.max6675Offset;
    doc["mP"] = config.enableMAX6675Protection;
    doc["mS"] = config.max6675StabilitySamples;
    doc["mJ"] = config.max6675TempJumpThreshold;
    doc["mN"] = config.max6675MinTemp;
    doc["mX"] = config.max6675MaxTemp;
    
    // ----- 3.6 DS18B20 (воздух) -----
    doc["dO"] = config.ds18b20Offset;
    doc["dS"] = config.ds18b20Scale;
    doc["dC"] = config.ds18b20CalEnabled;
    
    // ----- 3.7 Защита датчика воздуха -----
    doc["aP"] = config.enableAirSensorProtection;
    doc["aS"] = config.airSensorStabilitySamples;
    doc["aJ"] = config.airSensorTempJumpThreshold;
    doc["aN"] = config.airSensorMinTemp;
    doc["aX"] = config.airSensorMaxTemp;
    doc["aU"] = config.airSensorUnstableRange;
    doc["aV"] = config.airSensorUnstableDeviation;
    doc["aW"] = config.airSensorUnstableWindow;
    doc["aD"] = config.airSensorDirectionChanges;
    
    // ----- 3.8 Система ошибок -----
    doc["mR"] = config.maxErrorRetries;
    doc["eW"] = config.errorWindowMinutes;
    doc["mE"] = config.minTimeBetweenSameErrors;
    doc["mOc"] = config.minTimeBetweenOverheatCounts;
    doc["uPw"] = config.unlockPassword;
    
